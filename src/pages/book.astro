<script>
  document.addEventListener('DOMContentLoaded', () => {
    // 0. Region selector switcher
    const btnIntl = document.getElementById('btn-region-international');
    const btnPk = document.getElementById('btn-region-pakistan');

    function updateRegionUI(region: string) {
      document.documentElement.setAttribute('data-pricing-region', region);
      try {
        localStorage.setItem('rabbia_pricing_region', region);
      } catch (e) {}

      if (region === 'pakistan') {
        btnPk?.classList.add('bg-white', 'text-brand-navy', 'shadow-2xs');
        btnPk?.classList.remove('text-gray-600');
        btnIntl?.classList.remove('bg-white', 'text-brand-navy', 'shadow-2xs');
        btnIntl?.classList.add('text-gray-600');
      } else {
        btnIntl?.classList.add('bg-white', 'text-brand-navy', 'shadow-2xs');
        btnIntl?.classList.remove('text-gray-600');
        btnPk?.classList.remove('bg-white', 'text-brand-navy', 'shadow-2xs');
        btnPk?.classList.add('text-gray-600');
      }
    }

    const initialRegion = document.documentElement.getAttribute('data-pricing-region') || 'international';
    updateRegionUI(initialRegion);

    btnIntl?.addEventListener('click', () => updateRegionUI('international'));
    btnPk?.addEventListener('click', () => updateRegionUI('pakistan'));

    // 1. Auto-fill form from URL query parameters (e.g. from Screener or Services)
    const urlParams = new URLSearchParams(window.location.search);
    const serviceParam = urlParams.get('service');
    const ageParam = urlParams.get('age');
    const locationParam = urlParams.get('location');

    if (serviceParam) {
      const serviceSelect = document.getElementById('book-service') as HTMLSelectElement;
      if (serviceSelect) {
        for (let i = 0; i < serviceSelect.options.length; i++) {
          if (serviceSelect.options[i].text.toLowerCase().includes(serviceParam.toLowerCase()) || serviceParam.toLowerCase().includes(serviceSelect.options[i].value.toLowerCase())) {
            serviceSelect.selectedIndex = i;
            break;
          }
        }
      }
    }

    if (ageParam) {
      const ageSelect = document.getElementById('book-child-age') as HTMLSelectElement;
      if (ageSelect) {
        for (let i = 0; i < ageSelect.options.length; i++) {
          if (ageSelect.options[i].value.includes(ageParam.split(' ')[0])) {
            ageSelect.selectedIndex = i;
            break;
          }
        }
      }
    }

    if (locationParam) {
      const locSelect = document.getElementById('book-location') as HTMLSelectElement;
      if (locSelect) {
        for (let i = 0; i < locSelect.options.length; i++) {
          if (locSelect.options[i].value.toLowerCase().includes(locationParam.toLowerCase()) || locationParam.toLowerCase().includes(locSelect.options[i].value.toLowerCase())) {
            locSelect.selectedIndex = i;
            break;
          }
        }
      }
    }

    // 2. WhatsApp Session Submission Trigger
    const btnWhatsApp = document.getElementById('btn-send-whatsapp-booking');
    btnWhatsApp?.addEventListener('click', () => {
      const parentNameInput = document.getElementById('book-parent-name') as HTMLInputElement;
      const parentName = parentNameInput?.value.trim() || '';
      const email = (document.getElementById('book-email') as HTMLInputElement)?.value.trim() || 'Not specified';
      const phone = (document.getElementById('book-whatsapp') as HTMLInputElement)?.value.trim() || '';
      const country = (document.getElementById('book-location') as HTMLSelectElement)?.value || 'International';
      const childAge = (document.getElementById('book-child-age') as HTMLSelectElement)?.value || 'Not specified';
      const service = (document.getElementById('book-service') as HTMLSelectElement)?.value || '50-Min Consultation';
      const timeSlot = (document.getElementById('book-time-slot') as HTMLSelectElement)?.value || 'Earliest Available';
      const notes = (document.getElementById('book-notes') as HTMLTextAreaElement)?.value.trim() || 'None provided';

      if (!parentName) {
        parentNameInput?.focus();
        if (statusDiv) {
          statusDiv.className = 'p-3 rounded-xl text-xs font-bold text-center mt-3 bg-rose-50 text-rose-700 block';
          statusDiv.innerText = 'Please enter parent full name to continue to WhatsApp.';
        }
        return;
      }

      // Format WhatsApp Message for session booking
      const message = `Hi Rabbia, I would like to book an online consultation session.\n\n• Parent Name: ${parentName}\n• Country: ${country}\n• Child Age: ${childAge}\n• Service Focus: ${service}\n• Preferred Time: ${timeSlot}\n• Email: ${email}\n• WhatsApp/Phone: ${phone}\n• Notes: ${notes}\n\nPlease share your earliest available session slots.`;

      // Background email logging to psychologistrabbia@gmail.com
      try {
        const bgData = {
          parent_name: parentName,
          email: email,
          phone: phone,
          country: country,
          child_age: childAge,
          service: service,
          preferred_time: timeSlot,
          message: notes,
          _subject: `[WhatsApp Booking Initiated] - ${parentName} (${country})`,
          _template: 'table'
        };
        fetch('https://formsubmit.co/ajax/psychologistrabbia@gmail.com', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify(bgData)
        }).catch(() => {});
      } catch (e) {}

      if (statusDiv) {
        statusDiv.className = 'p-3 rounded-xl text-xs font-bold text-center mt-3 bg-emerald-50 text-emerald-800 block';
        statusDiv.innerText = '✓ Opening WhatsApp with your session details...';
      }

      window.open(`https://wa.me/923364114002?text=${encodeURIComponent(message)}`, '_blank');
    });

    // 3. Online FormSubmit.co Submission Trigger
    const form = document.getElementById('booking-request-form') as HTMLFormElement;
    const statusDiv = document.getElementById('booking-form-status');

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!statusDiv) return;

      const submitBtn = document.getElementById('btn-submit-online-booking') as HTMLButtonElement;
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.innerText = 'Submitting Request...';
      }

      statusDiv.className = 'p-4 rounded-xl text-xs font-bold text-center mt-3 bg-blue-50 text-brand-navy block';
      statusDiv.innerText = 'Submitting your consultation request...';

      try {
        const formData = new FormData(form);
        const object = Object.fromEntries(formData);

        const response = await fetch('https://formsubmit.co/ajax/psychologistrabbia@gmail.com', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          },
          body: JSON.stringify(object)
        });
        const result = await response.json();

        if (response.ok || result.success === "true" || result.success === true) {
          statusDiv.className = 'p-4 rounded-xl text-xs font-bold text-center mt-3 bg-green-50 text-green-800 border border-green-200 block';
          statusDiv.innerHTML = '✓ Booking request received! Rabbia has received your request at psychologistrabbia@gmail.com and will contact you via WhatsApp and email within 24 hours with confirmed time slots.';
          form.reset();
        } else {
          // Fallback to WhatsApp
          statusDiv.className = 'p-4 rounded-xl text-xs font-bold text-center mt-3 bg-amber-50 text-amber-800 border border-amber-200 block';
          statusDiv.innerHTML = 'Thank you! For fastest confirmation, please click "Send via WhatsApp" above or message directly at +92 336 4114002.';
        }
      } catch (err) {
        statusDiv.className = 'p-4 rounded-xl text-xs font-bold text-center mt-3 bg-amber-50 text-amber-800 border border-amber-200 block';
        statusDiv.innerHTML = 'Form submitted. Please also confirm on WhatsApp (+92 336 4114002) for immediate scheduling.';
      } finally {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.innerText = 'Submit Request Online';
        }
      }
    });
  });
</script>
