---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { regionalPricing } from '../data/pricing';

const breadcrumbs = [
  { name: 'Home', href: '/' },
  { name: 'Book Consultation', href: '/book/' }
];

const intlPrice = regionalPricing.parentGuidance.international.price;
const pkPrice = regionalPricing.parentGuidance.pakistan.price;
---

<Layout 
  title="Book an Online Consultation | Clinical Psychologist Rabbia Ashraf"
  description="Schedule an online consultation for ADHD support, autism guidance, behaviour planning, and psychological report reviews. Serving families in the UK, USA, UAE, Canada, Australia, and Pakistan."
  canonicalURL="https://www.rabbiapsychologist.com/book/"
>
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 py-8 max-w-5xl">
    <Breadcrumbs paths={breadcrumbs} />

    <!-- Hero Header -->
    <div class="mt-6 mb-12 text-center max-w-3xl mx-auto">
      <div class="inline-flex items-center gap-2 bg-blue-50 border border-blue-200 text-brand-navy text-xs font-bold px-3.5 py-1.5 rounded-full uppercase tracking-wider mb-4">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        Global Telehealth Consultations Available
      </div>
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-brand-navy mb-4 leading-tight">
        Book Your Consultation with Clinical Psychologist Rabbia Ashraf
      </h1>
      <p class="text-base sm:text-lg text-gray-700 leading-relaxed mb-6">
        Practical, evidence-based parent guidance and child development strategies tailored for families worldwide. Choose the booking pathway that works best for your schedule and time zone.
      </p>

      <!-- Global Country Flags & Trust Badges -->
      <div class="flex flex-wrap items-center justify-center gap-2.5 text-xs text-gray-600 font-medium">
        <span class="bg-gray-100 px-3 py-1.5 rounded-full border border-gray-200">🇬🇧 United Kingdom</span>
        <span class="bg-gray-100 px-3 py-1.5 rounded-full border border-gray-200">🇺🇸 United States</span>
        <span class="bg-gray-100 px-3 py-1.5 rounded-full border border-gray-200">🇦🇪 UAE &amp; Gulf</span>
        <span class="bg-gray-100 px-3 py-1.5 rounded-full border border-gray-200">🇨🇦 Canada</span>
        <span class="bg-gray-100 px-3 py-1.5 rounded-full border border-gray-200">🇦🇺 Australia</span>
        <span class="bg-gray-100 px-3 py-1.5 rounded-full border border-gray-200">🇵🇰 Pakistan</span>
      </div>
    </div>

    <!-- Live Time Zone Availability Banner -->
    <div class="bg-gradient-to-r from-brand-navy via-[#18395e] to-brand-navy text-white rounded-2xl p-6 shadow-md mb-12">
      <div class="flex flex-col md:flex-row items-center justify-between gap-6">
        <div>
          <div class="flex items-center gap-2 text-xs font-bold text-brand-gold uppercase tracking-wider mb-1">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            Worldwide Time Zone Compatibility
          </div>
          <h2 class="text-xl font-bold text-white mb-1">Flexible Evening &amp; Weekend Online Slots</h2>
          <p class="text-xs text-blue-100/90 max-w-xl">
            Sessions are held securely over Google Meet or Zoom. Our schedule accommodates UK evenings, Gulf time zones, and US/Canada mornings.
          </p>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5 text-center shrink-0 w-full md:w-auto">
          <div class="bg-white/10 px-3 py-2 rounded-xl border border-white/15">
            <div class="text-[10px] text-gray-300 font-bold uppercase">London (BST)</div>
            <div class="text-sm font-extrabold text-white">9am – 6pm</div>
          </div>
          <div class="bg-white/10 px-3 py-2 rounded-xl border border-white/15">
            <div class="text-[10px] text-gray-300 font-bold uppercase">Dubai (GST)</div>
            <div class="text-sm font-extrabold text-white">12pm – 9pm</div>
          </div>
          <div class="bg-white/10 px-3 py-2 rounded-xl border border-white/15">
            <div class="text-[10px] text-gray-300 font-bold uppercase">New York (EST)</div>
            <div class="text-sm font-extrabold text-white">8am – 1pm</div>
          </div>
          <div class="bg-white/10 px-3 py-2 rounded-xl border border-white/15">
            <div class="text-[10px] text-gray-300 font-bold uppercase">Islamabad (PKT)</div>
            <div class="text-sm font-extrabold text-white">1pm – 10pm</div>
          </div>
        </div>
      </div>
    </div>

    <!-- 3 Simple Booking Options Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mb-16">
      
      <!-- Option 1: On-Page Consultation Request Form (7 cols) -->
      <div class="lg:col-span-7 bg-white rounded-3xl p-6 sm:p-8 shadow-sm border border-gray-200">
        <div class="flex items-center justify-between mb-4">
          <span class="bg-brand-cream text-brand-navy text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider">
            Option 1: Direct Request
          </span>
          <span class="text-xs text-emerald-700 font-bold flex items-center gap-1">
            <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
            Fast Response (Under 24 hrs)
          </span>
        </div>

        <h2 class="text-2xl font-bold text-brand-navy mb-2">Request an Appointment Slot</h2>
        <p class="text-xs sm:text-sm text-gray-600 mb-6">
          Fill in your details below. You can submit directly online or send instantly via WhatsApp.
        </p>

        <form id="booking-request-form" class="space-y-4">
          <input type="hidden" name="access_key" value={import.meta.env.PUBLIC_WEB3FORMS_KEY || ''} />
          <input type="hidden" name="subject" value="New International Consultation Booking Request" />

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="book-parent-name" class="block text-xs font-bold text-gray-700 uppercase mb-1">Parent Full Name *</label>
              <input
                type="text"
                id="book-parent-name"
                name="parent_name"
                required
                placeholder="e.g. Sarah Ahmed"
                class="w-full px-3.5 py-2.5 text-sm border border-gray-300 rounded-xl focus:ring-2 focus:ring-brand-navy focus:outline-none"
              />
            </div>

            <div>
              <label for="book-email" class="block text-xs font-bold text-gray-700 uppercase mb-1">Email Address *</label>
              <input
                type="email"
                id="book-email"
                name="email"
                required
                placeholder="name@example.com"
                class="w-full px-3.5 py-2.5 text-sm border border-gray-300 rounded-xl focus:ring-2 focus:ring-brand-navy focus:outline-none"
              />
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="book-whatsapp" class="block text-xs font-bold text-gray-700 uppercase mb-1">WhatsApp / Phone *</label>
              <input
                type="tel"
                id="book-whatsapp"
                name="phone"
                required
                placeholder="+44 7123 456789"
                class="w-full px-3.5 py-2.5 text-sm border border-gray-300 rounded-xl focus:ring-2 focus:ring-brand-navy focus:outline-none"
              />
            </div>

            <div>
              <label for="book-location" class="block text-xs font-bold text-gray-700 uppercase mb-1">Country of Residence *</label>
              <select
                id="book-location"
                name="country"
                required
                class="w-full px-3.5 py-2.5 text-sm border border-gray-300 rounded-xl focus:ring-2 focus:ring-brand-navy focus:outline-none bg-white"
              >
                <option value="">Select your country...</option>
                <option value="United Kingdom">United Kingdom (UK)</option>
                <option value="United States">United States (USA)</option>
                <option value="United Arab Emirates">United Arab Emirates (UAE)</option>
                <option value="Saudi Arabia">Saudi Arabia (KSA)</option>
                <option value="Canada">Canada</option>
                <option value="Australia">Australia</option>
                <option value="Pakistan">Pakistan</option>
                <option value="Qatar">Qatar</option>
                <option value="Other International">Other International</option>
              </select>
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="book-child-age" class="block text-xs font-bold text-gray-700 uppercase mb-1">Child's Age *</label>
              <select
                id="book-child-age"
                name="child_age"
                required
                class="w-full px-3.5 py-2.5 text-sm border border-gray-300 rounded-xl focus:ring-2 focus:ring-brand-navy focus:outline-none bg-white"
              >
                <option value="">Select age bracket...</option>
                <option value="2-4 years (Toddler / Preschool)">2–4 years (Toddler / Preschool)</option>
                <option value="5-7 years (Early Primary)">5–7 years (Early Primary)</option>
                <option value="8-11 years (Middle Childhood)">8–11 years (Middle Childhood)</option>
                <option value="12-16 years (Adolescent / Teen)">12–16 years (Adolescent / Teen)</option>
              </select>
            </div>

            <div>
              <label for="book-service" class="block text-xs font-bold text-gray-700 uppercase mb-1">Consultation Focus *</label>
              <select
                id="book-service"
                name="service"
                required
                class="w-full px-3.5 py-2.5 text-sm border border-gray-300 rounded-xl focus:ring-2 focus:ring-brand-navy focus:outline-none bg-white"
              >
                <option value="ADHD & Executive Function Support">ADHD &amp; Executive Function Guidance</option>
                <option value="Autism Spectrum & Social Communication">Autism Spectrum &amp; Social Communication</option>
                <option value="Behaviour ABC & Meltdown Intervention">Behaviour ABC &amp; Meltdown Support</option>
                <option value="School Meeting & IEP Accommodation">School IEP &amp; Classroom Advocacy</option>
                <option value="Psychological Report Review">Psychological Report Review &amp; Debrief</option>
                <option value="Pediatric Sleep & Routine Scaffolding">Pediatric Sleep &amp; Routine Scaffolding</option>
                <option value="General Child Development Guidance">General Child Development Guidance</option>
              </select>
            </div>
          </div>

          <div>
            <label for="book-time-slot" class="block text-xs font-bold text-gray-700 uppercase mb-1">Preferred Time Preference</label>
            <select
              id="book-time-slot"
              name="preferred_time"
              class="w-full px-3.5 py-2.5 text-sm border border-gray-300 rounded-xl focus:ring-2 focus:ring-brand-navy focus:outline-none bg-white"
            >
              <option value="Weekday Evening (After School / Work)">Weekday Evening (After School / Work)</option>
              <option value="Weekday Morning / Midday">Weekday Morning / Midday</option>
              <option value="Weekend (Saturday / Sunday)">Weekend (Saturday / Sunday)</option>
              <option value="Earliest Available Slot">Earliest Available Slot</option>
            </select>
          </div>

          <div>
            <label for="book-notes" class="block text-xs font-bold text-gray-700 uppercase mb-1">Brief Context / Key Questions (Optional)</label>
            <textarea
              id="book-notes"
              name="message"
              rows="3"
              placeholder="e.g. Struggling with morning transitions and task initiation. Previous speech delay report available."
              class="w-full px-3.5 py-2.5 text-sm border border-gray-300 rounded-xl focus:ring-2 focus:ring-brand-navy focus:outline-none"
            ></textarea>
          </div>

          <div class="text-[11px] text-gray-500 leading-relaxed">
            By submitting, you agree to our <a href="/terms-and-disclaimer/" class="underline text-brand-navy">Terms</a> and <a href="/privacy-policy/" class="underline text-brand-navy">Privacy Policy</a>. All sessions are confidential educational telehealth consultations.
          </div>

          <!-- Dual Form Action Buttons -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2">
            <button
              type="button"
              id="btn-send-whatsapp-booking"
              class="w-full inline-flex items-center justify-center gap-2 bg-[#25D366] text-white text-sm font-bold py-3.5 px-4 rounded-xl hover:bg-[#1EBE5D] transition-colors shadow-2xs cursor-pointer text-center"
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg>
              <span>Send via WhatsApp</span>
            </button>

            <button
              type="submit"
              id="btn-submit-online-booking"
              class="w-full inline-flex items-center justify-center gap-2 bg-brand-navy text-white text-sm font-bold py-3.5 px-4 rounded-xl hover:bg-blue-900 transition-colors shadow-2xs cursor-pointer text-center"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
              <span>Submit Request Online</span>
            </button>
          </div>

          <div id="booking-form-status" class="hidden p-4 rounded-xl text-xs font-bold text-center mt-3"></div>
        </form>
      </div>

      <!-- Right Column: Self-Schedule Google Calendar & Direct WhatsApp (5 cols) -->
      <div class="lg:col-span-5 space-y-6">
        
        <!-- Option 2: Self-Schedule Google Calendar Card -->
        <div class="bg-white rounded-3xl p-6 sm:p-7 shadow-sm border border-gray-200 text-left">
          <div class="flex items-center justify-between mb-3">
            <span class="bg-blue-100 text-brand-navy text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider">
              Option 2: Self-Schedule
            </span>
            <span class="text-xs text-gray-500 font-medium">Auto Time Zone</span>
          </div>

          <h3 class="text-xl font-bold text-brand-navy mb-2">Live Google Calendar</h3>
          <p class="text-xs sm:text-sm text-gray-600 mb-6 leading-relaxed">
            Prefer selecting an instant slot yourself? Access our real-time calendar. All slots automatically convert to your local computer's time zone.
          </p>

          <a
            href="https://calendar.app.google/zMKejpnpCjh91WRG7"
            target="_blank"
            rel="noopener noreferrer"
            class="w-full inline-flex items-center justify-center gap-2 bg-brand-navy text-white text-sm font-bold py-3 px-4 rounded-xl hover:bg-blue-900 transition-colors shadow-sm text-center mb-4"
          >
            <svg class="w-4 h-4 text-brand-gold" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zm0 5a1 1 0 000 2h8a1 1 0 100-2H6z" clip-rule="evenodd"/></svg>
            <span>Open Google Booking Calendar</span>
          </a>

          <div class="bg-gray-50 p-3.5 rounded-xl border border-gray-100 text-[11px] text-gray-600 space-y-1">
            <div class="font-bold text-gray-700">Calendar Features:</div>
            <div>• Real-time availability updated hourly</div>
            <div>• Instant calendar invite with Google Meet link</div>
            <div>• Automated 24h &amp; 1h appointment reminders</div>
          </div>
        </div>

        <!-- Option 3: Direct WhatsApp Fast-Track -->
        <div class="bg-gradient-to-br from-[#25D366]/10 to-emerald-50 rounded-3xl p-6 sm:p-7 border border-[#25D366]/30 text-left">
          <div class="flex items-center gap-2 mb-2">
            <span class="w-2.5 h-2.5 rounded-full bg-[#25D366] animate-pulse"></span>
            <span class="text-xs font-bold text-emerald-800 uppercase tracking-wider">Fast-Track Clinical Chat</span>
          </div>

          <h3 class="text-lg font-bold text-brand-navy mb-2">Ask a Question Before Booking</h3>
          <p class="text-xs sm:text-sm text-gray-600 mb-4 leading-relaxed">
            Not sure whether your child needs an ADHD assessment debrief, autism consultation, or school IEP checklist? Speak directly with our clinical intake team on WhatsApp.
          </p>

          <a
            href="https://wa.me/923364114002?text=Hi%20Rabbia,%20I%20would%20like%20to%20enquire%20about%20booking%20an%20online%20consultation%20for%20my%20child."
            target="_blank"
            rel="noopener noreferrer"
            class="w-full inline-flex items-center justify-center gap-2 bg-[#25D366] text-white text-sm font-bold py-3 px-4 rounded-xl hover:bg-[#1EBE5D] transition-colors shadow-2xs text-center"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg>
            <span>Chat on WhatsApp (+92 336 4114002)</span>
          </a>
        </div>

        <!-- Pakistan Consultation Fee Box (Hidden for International Visitors) -->
        <div class="price-pakistan bg-gray-50 rounded-3xl p-6 border border-gray-200 text-left">
          <h4 class="text-sm font-bold text-brand-navy uppercase tracking-wider mb-3">Consultation Fee &amp; Details</h4>
          <div class="space-y-2.5 text-xs text-gray-700">
            <div class="flex justify-between items-center pb-2 border-b border-gray-200">
              <span class="font-medium">Online Clinical Consultation (50 min)</span>
              <span class="font-extrabold text-brand-navy text-sm">PKR {pkPrice.toLocaleString()}</span>
            </div>
            <div class="text-[11px] text-gray-500 pt-1">
              💳 <strong>Payment Options:</strong> Raast Instant ID, JazzCash, EasyPaisa, or Online Bank Transfer.
            </div>
          </div>
        </div>

        <!-- International Consultation Fee Box (Hidden for Pakistan Visitors) -->
        <div class="price-international bg-gray-50 rounded-3xl p-6 border border-gray-200 text-left">
          <h4 class="text-sm font-bold text-brand-navy uppercase tracking-wider mb-3">Telehealth Consultation Fee</h4>
          <div class="space-y-2.5 text-xs text-gray-700">
            <div class="flex justify-between items-center pb-2 border-b border-gray-200">
              <span class="font-medium">International Telehealth (50 min)</span>
              <span class="font-extrabold text-brand-navy text-sm">${intlPrice} USD / £50 GBP / 240 AED</span>
            </div>
            <div class="text-[11px] text-gray-500 pt-1">
              💳 <strong>Payment Options:</strong> Visa, Mastercard, Stripe, Wise, or International Bank Wire.
            </div>
          </div>
        </div>

      </div>

    </div>

    <!-- What to Expect / Process Section -->
    <div class="bg-white rounded-3xl p-8 md:p-10 shadow-sm border border-gray-200 mb-16 text-left">
      <h3 class="text-2xl font-bold text-brand-navy mb-6 text-center">What Happens After You Schedule?</h3>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="bg-gray-50 p-6 rounded-2xl border border-gray-100">
          <div class="w-10 h-10 rounded-xl bg-blue-100 text-brand-navy flex items-center justify-center font-extrabold text-lg mb-4">1</div>
          <h4 class="font-bold text-brand-navy text-base mb-2">Pre-Session Intake</h4>
          <p class="text-xs text-gray-600 leading-relaxed">
            You receive a structured intake questionnaire to submit developmental history, school concerns, and prior reports before we meet.
          </p>
        </div>

        <div class="bg-gray-50 p-6 rounded-2xl border border-gray-100">
          <div class="w-10 h-10 rounded-xl bg-amber-100 text-amber-800 flex items-center justify-center font-extrabold text-lg mb-4">2</div>
          <h4 class="font-bold text-brand-navy text-base mb-2">50-Min Video Consultation</h4>
          <p class="text-xs text-gray-600 leading-relaxed">
            Direct online session via Google Meet or Zoom. We break down the root cause of challenging routines, dysregulation, or learning blocks.
          </p>
        </div>

        <div class="bg-gray-50 p-6 rounded-2xl border border-gray-100">
          <div class="w-10 h-10 rounded-xl bg-emerald-100 text-emerald-800 flex items-center justify-center font-extrabold text-lg mb-4">3</div>
          <h4 class="font-bold text-brand-navy text-base mb-2">Written Clinical Roadmap</h4>
          <p class="text-xs text-gray-600 leading-relaxed">
            Within 48 hours, you receive a tailored written summary with concrete accommodations, routine scaffolding, and school action items.
          </p>
        </div>
      </div>
    </div>

    <!-- Clinical Boundaries Disclaimer -->
    <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 text-xs text-gray-600 leading-relaxed text-left max-w-4xl mx-auto">
      <strong class="text-gray-800">Clinical &amp; International Telehealth Notice:</strong> Consultations are provided as evidence-based parent guidance, psychoeducational strategy planning, and support debriefs. They do not constitute emergency psychiatric intervention or replace local in-person medical care where immediate physical evaluation or emergency services are required.
    </div>

  </div>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // 1. Auto-fill form from URL query parameters (e.g. from Screener or Services)
    const urlParams = new URLSearchParams(window.location.search);
    const serviceParam = urlParams.get('service');
    const ageParam = urlParams.get('age');
    const locationParam = urlParams.get('location');

    if (serviceParam) {
      const serviceSelect = document.getElementById('book-service') as HTMLSelectElement;
      if (serviceSelect) {
        for (let i = 0; i < serviceSelect.options.length; i++) {
          if (serviceSelect.options[i].text.toLowerCase().includes(serviceParam.toLowerCase()) || serviceParam.toLowerCase().includes(serviceSelect.options[i].value.toLowerCase())) {
            serviceSelect.selectedIndex = i;
            break;
          }
        }
      }
    }

    if (ageParam) {
      const ageSelect = document.getElementById('book-child-age') as HTMLSelectElement;
      if (ageSelect) {
        for (let i = 0; i < ageSelect.options.length; i++) {
          if (ageSelect.options[i].value.includes(ageParam.split(' ')[0])) {
            ageSelect.selectedIndex = i;
            break;
          }
        }
      }
    }

    if (locationParam) {
      const locSelect = document.getElementById('book-location') as HTMLSelectElement;
      if (locSelect) {
        for (let i = 0; i < locSelect.options.length; i++) {
          if (locSelect.options[i].value.toLowerCase().includes(locationParam.toLowerCase()) || locationParam.toLowerCase().includes(locSelect.options[i].value.toLowerCase())) {
            locSelect.selectedIndex = i;
            break;
          }
        }
      }
    }

    // 2. WhatsApp Submission Trigger
    const btnWhatsApp = document.getElementById('btn-send-whatsapp-booking');
    btnWhatsApp?.addEventListener('click', () => {
      const parentName = (document.getElementById('book-parent-name') as HTMLInputElement)?.value.trim() || 'Parent';
      const email = (document.getElementById('book-email') as HTMLInputElement)?.value.trim() || 'Not specified';
      const phone = (document.getElementById('book-whatsapp') as HTMLInputElement)?.value.trim() || '';
      const country = (document.getElementById('book-location') as HTMLSelectElement)?.value || 'International';
      const childAge = (document.getElementById('book-child-age') as HTMLSelectElement)?.value || 'Not specified';
      const service = (document.getElementById('book-service') as HTMLSelectElement)?.value || 'General Parent Guidance';
      const timeSlot = (document.getElementById('book-time-slot') as HTMLSelectElement)?.value || 'Earliest Available';
      const notes = (document.getElementById('book-notes') as HTMLTextAreaElement)?.value.trim() || 'None provided';

      const message = `Hi Rabbia, I would like to book an online consultation.\n\n• Parent Name: ${parentName}\n• Country: ${country}\n• Child Age: ${childAge}\n• Focus: ${service}\n• Preferred Time: ${timeSlot}\n• Contact Email: ${email}\n• Phone: ${phone}\n• Notes: ${notes}\n\nPlease share your next available slots.`;

      window.open(`https://wa.me/923364114002?text=${encodeURIComponent(message)}`, '_blank');
    });

    // 3. Online Web3Forms Submission Trigger
    const form = document.getElementById('booking-request-form') as HTMLFormElement;
    const statusDiv = document.getElementById('booking-form-status');

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!statusDiv) return;

      const submitBtn = document.getElementById('btn-submit-online-booking') as HTMLButtonElement;
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.innerText = 'Submitting Request...';
      }

      statusDiv.className = 'p-4 rounded-xl text-xs font-bold text-center mt-3 bg-blue-50 text-brand-navy block';
      statusDiv.innerText = 'Submitting your consultation request...';

      const formData = new FormData(form);

      try {
        const response = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          body: formData
        });
        const result = await response.json();

        if (result.success) {
          statusDiv.className = 'p-4 rounded-xl text-xs font-bold text-center mt-3 bg-green-50 text-green-800 border border-green-200 block';
          statusDiv.innerHTML = '✓ Booking request received! Rabbia will contact you via WhatsApp and email within 24 hours with confirmed time slots.';
          form.reset();
        } else {
          // Fallback to WhatsApp
          statusDiv.className = 'p-4 rounded-xl text-xs font-bold text-center mt-3 bg-amber-50 text-amber-800 border border-amber-200 block';
          statusDiv.innerHTML = 'Thank you! For fastest confirmation, please click "Send via WhatsApp" above or message directly at +92 336 4114002.';
        }
      } catch (err) {
        statusDiv.className = 'p-4 rounded-xl text-xs font-bold text-center mt-3 bg-amber-50 text-amber-800 border border-amber-200 block';
        statusDiv.innerHTML = 'Form submitted. Please also confirm on WhatsApp (+92 336 4114002) for immediate scheduling.';
      } finally {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.innerText = 'Submit Request Online';
        }
      }
    });
  });
</script>
