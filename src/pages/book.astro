---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import InternationalTrustFramework from '../components/global/InternationalTrustFramework.astro';
import { regionalPricing } from '../data/pricing';

const breadcrumbs = [
  { name: 'Home', href: '/' },
  { name: 'Book Consultation', href: '/book/' }
];

const intlPrice = regionalPricing.parentGuidance.international.price;
const pkPrice = regionalPricing.parentGuidance.pakistan.price;
---

<Layout 
  title="Book an Online Consultation | Clinical Psychologist Rabbia Ashraf"
  description="Schedule an online consultation for ADHD support, autism guidance, behaviour planning, and psychological report reviews. Serving families in the UK, USA, UAE, Canada, Australia, and Pakistan."
  canonicalURL="https://www.rabbiapsychologist.com/book/"
>
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 py-8 pb-28 sm:pb-16 max-w-5xl">
    <Breadcrumbs paths={breadcrumbs} />

    <!-- Hero Header -->
    <div class="mt-6 mb-12 text-center max-w-3xl mx-auto">
      <div class="inline-flex items-center gap-2 bg-blue-50 border border-blue-200 text-brand-navy text-xs font-bold px-3.5 py-1.5 rounded-full uppercase tracking-wider mb-4">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        Global Telehealth Consultations Available
      </div>
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-brand-navy mb-4 leading-tight">
        Book Your Consultation with Clinical Psychologist Rabbia Ashraf
      </h1>
      <p class="text-base sm:text-lg text-gray-700 leading-relaxed mb-6">
        Practical, evidence-based parent guidance and child development strategies tailored for families worldwide. Choose the booking pathway that works best for your schedule and time zone.
      </p>

      <!-- Global Country Flags & Trust Badges -->
      <div class="flex flex-wrap items-center justify-center gap-2.5 text-xs text-gray-600 font-medium mb-6">
        <span class="bg-gray-100 px-3 py-1.5 rounded-full border border-gray-200">🇬🇧 United Kingdom</span>
        <span class="bg-gray-100 px-3 py-1.5 rounded-full border border-gray-200">🇺🇸 United States</span>
        <span class="bg-gray-100 px-3 py-1.5 rounded-full border border-gray-200">🇦🇪 UAE &amp; Gulf</span>
        <span class="bg-gray-100 px-3 py-1.5 rounded-full border border-gray-200">🇨🇦 Canada</span>
        <span class="bg-gray-100 px-3 py-1.5 rounded-full border border-gray-200">🇦🇺 Australia</span>
        <span class="bg-gray-100 px-3 py-1.5 rounded-full border border-gray-200">🇵🇰 Pakistan</span>
      </div>

      <!-- Quick Interactive Region & Currency Toggle -->
      <div class="inline-flex items-center gap-2 p-1.5 bg-gray-100/90 rounded-2xl border border-gray-200/80 shadow-2xs">
        <span class="text-xs font-bold text-gray-500 pl-2">Display Fee:</span>
        <button
          type="button"
          id="btn-region-international"
          class="px-3.5 py-1.5 rounded-xl text-xs font-bold transition-all duration-200 cursor-pointer text-brand-navy hover:bg-white"
        >
          🌎 International ($85 USD)
        </button>
        <button
          type="button"
          id="btn-region-pakistan"
          class="px-3.5 py-1.5 rounded-xl text-xs font-bold transition-all duration-200 cursor-pointer text-gray-600 hover:bg-white"
        >
          🇵🇰 Pakistan (PKR 5,000)
        </button>
      </div>
    </div>

    <!-- Live Time Zone Availability Banner -->
    <div class="bg-gradient-to-r from-brand-navy via-[#18395e] to-brand-navy text-white rounded-2xl p-6 shadow-md mb-12">
      <div class="flex flex-col md:flex-row items-center justify-between gap-6">
        <div>
          <div class="flex items-center gap-2 text-xs font-bold text-brand-gold uppercase tracking-wider mb-1">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            Worldwide Time Zone Compatibility
          </div>
          <h2 class="text-xl font-bold text-white mb-1">Flexible Evening &amp; Weekend Online Slots</h2>
          <p class="text-xs text-blue-100/90 max-w-xl">
            Sessions are held securely over Google Meet or Zoom. Our schedule accommodates UK evenings, Gulf time zones, and US/Canada mornings.
          </p>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5 text-center shrink-0 w-full md:w-auto">
          <div class="bg-white/10 px-3 py-2 rounded-xl border border-white/15">
            <div class="text-[10px] text-gray-300 font-bold uppercase">London (BST)</div>
            <div class="text-sm font-extrabold text-white">9am – 6pm</div>
          </div>
          <div class="bg-white/10 px-3 py-2 rounded-xl border border-white/15">
            <div class="text-[10px] text-gray-300 font-bold uppercase">Dubai (GST)</div>
            <div class="text-sm font-extrabold text-white">12pm – 9pm</div>
          </div>
          <div class="bg-white/10 px-3 py-2 rounded-xl border border-white/15">
            <div class="text-[10px] text-gray-300 font-bold uppercase">New York (EST)</div>
            <div class="text-sm font-extrabold text-white">8am – 1pm</div>
          </div>
          <div class="bg-white/10 px-3 py-2 rounded-xl border border-white/15">
            <div class="text-[10px] text-gray-300 font-bold uppercase">Islamabad (PKT)</div>
            <div class="text-sm font-extrabold text-white">1pm – 10pm</div>
          </div>
        </div>
      </div>
    </div>

    <!-- Language & Clinical Policy Transparency Banner -->
    <div class="mb-10 p-5 bg-gradient-to-r from-blue-900/10 via-[#FAF7F2] to-amber-500/10 border-2 border-brand-navy/15 rounded-2xl flex flex-col md:flex-row items-start md:items-center justify-between gap-4 text-xs text-brand-navy shadow-xs">
      <div class="flex items-start sm:items-center gap-3">
        <span class="p-2 bg-brand-navy text-white rounded-xl text-base shrink-0">🌐</span>
        <div>
          <div class="font-bold text-sm text-[#0A233F] mb-0.5">Primary Language: Professional English</div>
          <p class="text-gray-700 leading-relaxed">
            All clinical intakes, 1-on-1 consultations, and written action roadmaps are delivered in <strong>English</strong> (bilingual Urdu support available upon request).
          </p>
        </div>
      </div>
      <div class="flex items-center gap-2 shrink-0 bg-white px-3.5 py-2 rounded-xl border border-gray-200 font-bold text-emerald-800">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        Upfront Transparent Fee Required Prior to Booking
      </div>
    </div>

    <!-- 3 Core Clinical Package Pathways -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-14">
      
      <!-- Package 1: Single 50-Minute Clinical Strategy Consultation -->
      <div class="bg-white rounded-3xl p-6 border border-gray-200 shadow-xs relative flex flex-col justify-between hover:shadow-md transition-shadow">
        <div>
          <div class="flex items-center justify-between mb-3">
            <span class="inline-flex items-center gap-1 bg-blue-50 text-brand-navy text-[10px] font-bold px-2.5 py-1 rounded-full uppercase tracking-wider border border-blue-200">
              Single Session
            </span>
            <span class="text-xs font-bold text-[#0A233F] bg-gray-100 px-2.5 py-0.5 rounded-md">
              <span class="price-international">$85 USD / £65</span>
              <span class="price-pakistan">PKR 5,000</span>
            </span>
          </div>

          <h3 class="text-lg font-serif font-bold text-[#0A233F] mb-2">
            50-Min Clinical Strategy Call
          </h3>
          <p class="text-xs text-[#18222C]/75 leading-relaxed mb-4">
            A comprehensive, 1-on-1 private strategy session with Clinical Psychologist Rabbia Ashraf. Covers ADHD, ASD, or behavior planning.
          </p>

          <ul class="space-y-2 text-xs text-[#18222C]/80 mb-6">
            <li class="flex items-start gap-2">
              <svg class="w-3.5 h-3.5 text-emerald-600 shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
              <span>Intake questionnaire clinical review</span>
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-3.5 h-3.5 text-emerald-600 shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
              <span>3-Step tailored roadmap in 24 hours</span>
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-3.5 h-3.5 text-emerald-600 shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
              <span>Off-screen child protocol (parent only)</span>
            </li>
          </ul>
        </div>

        <a
          href="#booking-request-form"
          class="w-full inline-flex items-center justify-center gap-1.5 bg-[#0A233F] hover:bg-[#12365B] text-white text-xs font-bold py-3 px-4 rounded-xl transition-colors text-center"
        >
          <span>Select 50-Min Session</span>
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
        </a>
      </div>

      <!-- Package 2: Four-Session Pre-Assessment Waitlist Bridge (Most Popular) -->
      <div class="bg-gradient-to-b from-blue-50/70 via-white to-white rounded-3xl p-6 border-2 border-brand-navy shadow-sm relative flex flex-col justify-between hover:shadow-md transition-shadow">
        <div class="absolute -top-3 left-1/2 transform -translate-x-1/2 bg-brand-navy text-white text-[10px] font-bold px-3 py-1 rounded-full uppercase tracking-wider">
          Most Comprehensive
        </div>
        <div>
          <div class="flex items-center justify-between mb-3 mt-1">
            <span class="inline-flex items-center gap-1 bg-brand-gold/20 text-brand-navy text-[10px] font-bold px-2.5 py-1 rounded-full uppercase tracking-wider">
              4-Session Program
            </span>
            <span class="text-xs font-bold text-[#0A233F] bg-white px-2.5 py-0.5 rounded-md border border-gray-200">
              <span class="price-international">$320 USD / £245</span>
              <span class="price-pakistan">PKR 20,000</span>
            </span>
          </div>

          <h3 class="text-lg font-serif font-bold text-[#0A233F] mb-2">
            Waitlist Bridge Program
          </h3>
          <p class="text-xs text-[#18222C]/75 leading-relaxed mb-4">
            For UK, Canada &amp; US families on NHS/public diagnostic waitlists needing immediate home and school behavioral routines.
          </p>

          <ul class="space-y-2 text-xs text-[#18222C]/80 mb-6">
            <li class="flex items-start gap-2">
              <svg class="w-3.5 h-3.5 text-emerald-600 shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
              <span>4 x 50-minute structured clinical sessions</span>
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-3.5 h-3.5 text-emerald-600 shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
              <span>Complete sensory matrix &amp; visual routine plan</span>
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-3.5 h-3.5 text-emerald-600 shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
              <span>Priority WhatsApp check-ins between sessions</span>
            </li>
          </ul>
        </div>

        <a
          href="#booking-request-form"
          class="w-full inline-flex items-center justify-center gap-1.5 bg-brand-navy hover:bg-blue-900 text-white text-xs font-bold py-3 px-4 rounded-xl transition-colors text-center shadow-xs"
        >
          <span>Select 4-Session Program</span>
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
        </a>
      </div>

      <!-- Package 3: Report Review & School IEP Advocacy -->
      <div class="bg-white rounded-3xl p-6 border border-gray-200 shadow-xs relative flex flex-col justify-between hover:shadow-md transition-shadow">
        <div>
          <div class="flex items-center justify-between mb-3">
            <span class="inline-flex items-center gap-1 bg-amber-50 text-amber-900 text-[10px] font-bold px-2.5 py-1 rounded-full uppercase tracking-wider border border-amber-200">
              Specialized Evaluation
            </span>
            <span class="text-xs font-bold text-[#0A233F] bg-gray-100 px-2.5 py-0.5 rounded-md">
              <span class="price-international">$125 USD / £95</span>
              <span class="price-pakistan">PKR 8,500</span>
            </span>
          </div>

          <h3 class="text-lg font-serif font-bold text-[#0A233F] mb-2">
            Report Review &amp; School IEP
          </h3>
          <p class="text-xs text-[#18222C]/75 leading-relaxed mb-4">
            Translation of complex medical/clinical diagnosis reports into plain English with practical school accommodation letters.
          </p>

          <ul class="space-y-2 text-xs text-[#18222C]/80 mb-6">
            <li class="flex items-start gap-2">
              <svg class="w-3.5 h-3.5 text-emerald-600 shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
              <span>Multi-page clinical document deconstruction</span>
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-3.5 h-3.5 text-emerald-600 shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
              <span>50-min strategy session to unpack findings</span>
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-3.5 h-3.5 text-emerald-600 shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
              <span>Draft school/IEP teacher accommodation notes</span>
            </li>
          </ul>
        </div>

        <a
          href="#booking-request-form"
          class="w-full inline-flex items-center justify-center gap-1.5 bg-[#0A233F] hover:bg-[#12365B] text-white text-xs font-bold py-3 px-4 rounded-xl transition-colors text-center"
        >
          <span>Select Report Review</span>
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
        </a>
      </div>

    </div>

    <!-- 3 Simple Booking Options Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mb-16">
      
      <!-- Option 1: On-Page Consultation Request Form (7 cols) -->
      <div class="lg:col-span-7 bg-white rounded-3xl p-6 sm:p-8 pb-12 shadow-sm border border-gray-200">
        <div class="flex items-center justify-between mb-4">
          <span class="bg-brand-cream text-brand-navy text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider">
            Option 1: Direct Request
          </span>
          <span class="text-xs text-emerald-700 font-bold flex items-center gap-1">
            <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
            Fast Response (Under 24 hrs)
          </span>
        </div>

        <h2 class="text-2xl font-bold text-brand-navy mb-2">Request an Appointment Slot</h2>
        <p class="text-xs sm:text-sm text-gray-600 mb-6">
          Fill in your details below. You can submit directly online or send instantly via WhatsApp.
        </p>

        <form id="booking-request-form" action="https://formsubmit.co/psychologistrabbia@gmail.com" method="POST" class="space-y-4">
          <input type="hidden" name="_subject" value="New Consultation Booking Request — Rabbia Psychologist" />
          <input type="hidden" name="_template" value="table" />
          <input type="hidden" name="_captcha" value="false" />

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="book-parent-name" class="block text-xs font-bold text-gray-700 uppercase mb-1">Parent Full Name *</label>
              <input
                type="text"
                id="book-parent-name"
                name="parent_name"
                required
                placeholder="e.g. Sarah Ahmed"
                class="w-full px-3.5 py-2.5 text-sm border border-gray-300 rounded-xl focus:ring-2 focus:ring-brand-navy focus:outline-none"
              />
            </div>

            <div>
              <label for="book-email" class="block text-xs font-bold text-gray-700 uppercase mb-1">Email Address *</label>
              <input
                type="email"
                id="book-email"
                name="email"
                required
                placeholder="name@example.com"
                class="w-full px-3.5 py-2.5 text-sm border border-gray-300 rounded-xl focus:ring-2 focus:ring-brand-navy focus:outline-none"
              />
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="book-whatsapp" class="block text-xs font-bold text-gray-700 uppercase mb-1">WhatsApp / Phone *</label>
              <input
                type="tel"
                id="book-whatsapp"
                name="phone"
                required
                placeholder="+44 7123 456789"
                class="w-full px-3.5 py-2.5 text-sm border border-gray-300 rounded-xl focus:ring-2 focus:ring-brand-navy focus:outline-none"
              />
            </div>

            <div>
              <label for="book-location" class="block text-xs font-bold text-gray-700 uppercase mb-1">Country of Residence *</label>
              <select
                id="book-location"
                name="country"
                required
                class="w-full px-3.5 py-2.5 text-sm border border-gray-300 rounded-xl focus:ring-2 focus:ring-brand-navy focus:outline-none bg-white"
              >
                <option value="">Select your country...</option>
                <option value="United Kingdom">United Kingdom (UK)</option>
                <option value="United States">United States (USA)</option>
                <option value="United Arab Emirates">United Arab Emirates (UAE)</option>
                <option value="Saudi Arabia">Saudi Arabia (KSA)</option>
                <option value="Canada">Canada</option>
                <option value="Australia">Australia</option>
                <option value="Pakistan">Pakistan</option>
                <option value="Qatar">Qatar</option>
                <option value="Other International">Other International</option>
              </select>
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="book-child-age" class="block text-xs font-bold text-gray-700 uppercase mb-1">Child's Age *</label>
              <select
                id="book-child-age"
                name="child_age"
                required
                class="w-full px-3.5 py-2.5 text-sm border border-gray-300 rounded-xl focus:ring-2 focus:ring-brand-navy focus:outline-none bg-white"
              >
                <option value="">Select age bracket...</option>
                <option value="2-4 years (Toddler / Preschool)">2–4 years (Toddler / Preschool)</option>
                <option value="5-7 years (Early Primary)">5–7 years (Early Primary)</option>
                <option value="8-11 years (Middle Childhood)">8–11 years (Middle Childhood)</option>
                <option value="12-16 years (Adolescent / Teen)">12–16 years (Adolescent / Teen)</option>
              </select>
            </div>

            <div>
              <label for="book-service" class="block text-xs font-bold text-gray-700 uppercase mb-1">Consultation Focus *</label>
              <select
                id="book-service"
                name="service"
                required
                class="w-full px-3.5 py-2.5 text-sm border border-gray-300 rounded-xl focus:ring-2 focus:ring-brand-navy focus:outline-none bg-white"
              >
                <option value="50-Minute Clinical Strategy Consultation ($85 / £65 / PKR 5,000)">50-Min Clinical Strategy Consultation ($85 / £65 / PKR 5,000)</option>
                <option value="Four-Session Pre-Assessment Waitlist Bridge ($320 / £245 / PKR 20,000)">Four-Session Waitlist Bridge Program ($320 / £245 / PKR 20,000)</option>
                <option value="ADHD & Executive Function Support (50 Min)">ADHD &amp; Executive Function Guidance (50 Min)</option>
                <option value="Autism Spectrum & Social Communication (50 Min)">Autism Spectrum &amp; Social Communication (50 Min)</option>
                <option value="Behaviour ABC & Meltdown Intervention (50 Min)">Behaviour ABC &amp; Meltdown Support (50 Min)</option>
                <option value="Psychological Report Review & Debrief ($125 / £95 / PKR 8,500)">Psychological Report Review &amp; Debrief ($125 / £95 / PKR 8,500)</option>
                <option value="School Meeting & IEP Accommodation Prep">School IEP &amp; Classroom Advocacy ($140 / £110)</option>
                <option value="General Child Development Guidance (50 Min)">General Child Development Guidance (50 Min)</option>
              </select>
            </div>
          </div>

          <div>
            <label for="book-time-slot" class="block text-xs font-bold text-gray-700 uppercase mb-1">Preferred Time Preference</label>
            <select
              id="book-time-slot"
              name="preferred_time"
              class="w-full px-3.5 py-2.5 text-sm border border-gray-300 rounded-xl focus:ring-2 focus:ring-brand-navy focus:outline-none bg-white"
            >
              <option value="Weekday Evening (After School / Work)">Weekday Evening (After School / Work)</option>
              <option value="Weekday Morning / Midday">Weekday Morning / Midday</option>
              <option value="Weekend (Saturday / Sunday)">Weekend (Saturday / Sunday)</option>
              <option value="Earliest Available Slot">Earliest Available Slot</option>
            </select>
          </div>

          <div>
            <label for="book-notes" class="block text-xs font-bold text-gray-700 uppercase mb-1">Brief Context / Key Questions (Optional)</label>
            <textarea
              id="book-notes"
              name="message"
