---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/global/Breadcrumbs.astro';
import { vaultResources, vaultCategories } from '../data/vaultResources';

const breadcrumbs = [
  { name: 'Home', href: '/' },
  { name: 'Resources', href: '/resources' },
  { name: 'Resource Vault', href: '/resource-vault' }
];

const title = "Clinical Resource Vault: Worksheets, Books & Screening Kits | Rabbia Psychologist";
const description = "Comprehensive clinical resource vault featuring printable worksheets, ADHD routine planners, ABA behavior trackers, clinical book summaries, and pediatric screening toolkits available via WhatsApp.";
const canonicalURL = "https://www.rabbiapsychologist.com/resource-vault/";

const vaultSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Clinical Resource Vault: Pediatric Psychology, Worksheets, Book Summaries & Screening Kits",
  "description": description,
  "url": canonicalURL,
  "publisher": {
    "@type": "Organization",
    "name": "Rabbia Psychologist Child Development Services"
  }
};
---

<BaseLayout title={title} description={description} canonicalURL={canonicalURL} schema={vaultSchema}>
  <!-- Hero Section -->
  <section class="bg-gradient-to-b from-blue-50/70 to-white pt-8 pb-12 border-b border-gray-100">
    <div class="container mx-auto px-4 max-w-6xl">
      <Breadcrumbs paths={breadcrumbs} />

      <div class="mt-6 text-center max-w-3xl mx-auto">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-blue-100/80 text-brand-navy text-xs font-bold tracking-wide uppercase mb-4">
          <svg class="w-4 h-4 text-brand-navy" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" /></svg>
          Direct Access Clinical Library
        </div>

        <h1 class="text-3xl md:text-5xl font-extrabold text-brand-navy tracking-tight mb-4">
          Clinical Resource Vault
        </h1>

        <p class="text-base md:text-lg text-gray-700 leading-relaxed">
          Evidence-based psychological tools curated by Clinical Psychologist Rabbia Ashraf. Open and print worksheets immediately, or request full clinical manuals, book summaries, and screening toolkits directly through WhatsApp.
        </p>

        <!-- Stats Bar -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mt-8 pt-6 border-t border-gray-200/60 text-left">
          <div class="bg-white p-3.5 rounded-xl border border-gray-100 shadow-xs">
            <div class="text-2xl font-extrabold text-brand-navy">9+</div>
            <div class="text-xs text-gray-600 font-medium">Printable Worksheets</div>
          </div>
          <div class="bg-white p-3.5 rounded-xl border border-gray-100 shadow-xs">
            <div class="text-2xl font-extrabold text-amber-700">6+</div>
            <div class="text-xs text-gray-600 font-medium">Clinical Book Guides</div>
          </div>
          <div class="bg-white p-3.5 rounded-xl border border-gray-100 shadow-xs">
            <div class="text-2xl font-extrabold text-purple-700">5+</div>
            <div class="text-xs text-gray-600 font-medium">Pediatric AI Toolkits</div>
          </div>
          <div class="bg-white p-3.5 rounded-xl border border-gray-100 shadow-xs">
            <div class="text-2xl font-extrabold text-emerald-700">Instant</div>
            <div class="text-xs text-gray-600 font-medium">WhatsApp Delivery</div>
          </div>
        </div>

        <!-- Download Complete Pack Banner -->
        <div class="mt-8 bg-gradient-to-r from-brand-navy to-blue-900 text-white p-5 rounded-2xl shadow-md flex flex-col sm:flex-row items-center justify-between gap-4 text-left">
          <div class="flex items-center gap-3.5">
            <div class="w-12 h-12 rounded-xl bg-white/10 flex items-center justify-center shrink-0 border border-white/20">
              <svg class="w-6 h-6 text-brand-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
            </div>
            <div>
              <div class="font-bold text-base text-white">Complete Clinical Resource Pack (All 23 PDFs)</div>
              <p class="text-xs text-blue-100/80">Includes all worksheets, book summaries, AI observation kits, and parent guides in a single convenient ZIP bundle (1.5 MB).</p>
            </div>
          </div>
          <div class="flex items-center gap-2.5 shrink-0 w-full sm:w-auto">
            <a
              href="/downloads/Rabbia_Psychologist_Complete_Clinical_Resource_Pack.zip"
              download
              class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-brand-gold text-brand-navy font-extrabold text-xs md:text-sm px-5 py-3 rounded-xl hover:bg-yellow-400 transition-colors shadow-sm"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
              <span>Download Complete Pack (.ZIP)</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Filter & Search Controls -->
  <section class="py-6 bg-white border-b border-gray-200 sticky top-[80px] z-30 shadow-2xs">
    <div class="container mx-auto px-4 max-w-6xl">
      <div class="flex flex-col md:flex-row gap-4 items-center justify-between">
        
        <!-- Live Search Input -->
        <div class="relative w-full md:w-80 shrink-0">
          <input
            type="text"
            id="vault-search-input"
            placeholder="Search worksheets, book summaries, kits..."
            class="w-full pl-10 pr-4 py-2 text-sm border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-brand-navy focus:border-brand-navy shadow-inner"
            aria-label="Search resources"
          />
          <svg class="w-4 h-4 text-gray-400 absolute left-3 top-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>

        <!-- Format Category Tabs -->
        <div class="flex items-center gap-1.5 overflow-x-auto w-full pb-2 md:pb-0 scrollbar-thin" id="category-tabs">
          {vaultCategories.map((cat, idx) => (
            <button
              type="button"
              class={`vault-category-tab px-3.5 py-1.5 rounded-full text-xs font-semibold whitespace-nowrap transition-all duration-150 cursor-pointer ${
                idx === 0
                  ? 'bg-brand-navy text-white shadow-xs'
                  : 'bg-gray-100 text-gray-700 hover:bg-gray-200 border border-gray-200'
              }`}
              data-category={cat.id}
            >
              {cat.label}
            </button>
          ))}
        </div>
      </div>

      <!-- Tag Filters -->
      <div class="flex items-center gap-1.5 overflow-x-auto w-full pt-3 mt-2 border-t border-gray-100 text-xs text-gray-600">
        <span class="font-bold text-gray-500 uppercase tracking-wider mr-1 text-[11px]">Topic:</span>
        {['All', 'ADHD', 'Autism', 'Behaviour', 'Sensory', 'School', 'Parenting', 'AI & Tech'].map((tag, idx) => (
          <button
            type="button"
            class={`vault-tag-pill px-2.5 py-1 rounded-md text-xs font-medium cursor-pointer transition-colors ${
              idx === 0
                ? 'bg-brand-gold/30 text-brand-navy font-bold'
                : 'bg-gray-50 text-gray-600 hover:bg-gray-200/80 border border-gray-200'
            }`}
            data-tag={tag === 'All' ? 'all' : tag}
          >
            {tag}
          </button>
        ))}
      </div>
    </div>
  </section>

  <!-- Main Resource Grid -->
  <main class="py-12 bg-[#FAF8F3]/60 min-h-[60vh]">
    <div class="container mx-auto px-4 max-w-6xl">
      
      <!-- Counter & Active Filter Badge -->
      <div class="flex items-center justify-between mb-8 pb-3 border-b border-gray-200">
        <span class="text-sm font-semibold text-gray-600" id="results-count">
          Showing all {vaultResources.length} clinical resources
        </span>
        <a href="https://wa.me/923364114002?text=Hi%20Rabbia,%20I%20would%20like%20to%20request%20the%20full%20clinical%20resource%20vault%20toolkit." target="_blank" rel="noopener noreferrer" class="text-xs font-bold text-[#25D366] hover:underline flex items-center gap-1">
          <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg>
          <span>Request Complete Bundle on WhatsApp</span>
        </a>
      </div>

      <!-- Cards Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="vault-grid">
        {vaultResources.map((item) => (
          <div
            class="vault-card bg-white rounded-2xl p-6 shadow-xs hover:shadow-md border border-gray-200 flex flex-col justify-between transition-all duration-200"
            data-category={item.category}
            data-tag={item.tag}
            data-search={`${item.title} ${item.subtitle || ''} ${item.authorOrCreator} ${item.description} ${item.tag}`.toLowerCase()}
          >
            <div>
              <!-- Top Badges -->
              <div class="flex items-center justify-between mb-3">
                <span class="bg-brand-cream text-brand-navy text-[11px] font-bold px-2.5 py-1 rounded-full uppercase tracking-wider border border-brand-sky/20">
                  {item.categoryLabel}
                </span>
                <span class="bg-gray-100 text-gray-700 text-xs font-medium px-2 py-0.5 rounded-md">
                  {item.tag}
                </span>
              </div>

              <!-- Title & Subtitle -->
              <h2 class="text-lg font-bold text-brand-navy mb-1 leading-snug">
                {item.title}
              </h2>
              {item.subtitle && (
                <p class="text-xs text-brand-trust font-medium mb-3">
                  {item.subtitle}
                </p>
              )}

              <!-- Creator/Author -->
              <p class="text-xs text-gray-500 mb-3 font-medium">
                Framework: <span class="text-gray-700 font-semibold">{item.authorOrCreator}</span>
              </p>

              <!-- Description -->
              <p class="text-xs md:text-sm text-gray-600 mb-5 leading-relaxed">
                {item.description}
              </p>
            </div>

            <!-- Card Action Footer -->
            <div class="pt-4 border-t border-gray-100 mt-auto space-y-2">
              <div class="text-[11px] text-gray-500 font-medium">
                Format: <span class="text-gray-700 font-semibold">{item.formatOrType}</span>
              </div>

              {item.actionType === 'print' ? (
                <div class="space-y-2 pt-1">
                  <a
                    href={item.actionUrl}
                    class="w-full inline-flex items-center justify-center gap-2 bg-brand-navy text-white text-xs md:text-sm font-bold py-2.5 px-4 rounded-xl hover:bg-blue-900 transition-colors shadow-2xs text-center"
                  >
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"/></svg>
                    <span>{item.actionText}</span>
                  </a>
                  <div class="grid grid-cols-2 gap-2">
                    <a
                      href={item.pdfUrl}
                      download
                      class="inline-flex items-center justify-center gap-1.5 bg-blue-50 text-brand-navy hover:bg-blue-100 border border-blue-200 text-xs font-bold py-2 px-2.5 rounded-xl transition-colors text-center"
                    >
                      <svg class="w-3.5 h-3.5 text-brand-navy" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
                      <span>Download PDF</span>
                    </a>
                    <a
                      href={`https://wa.me/923364114002?text=${encodeURIComponent(`Hi Rabbia, I would like to request the PDF copy of the ${item.title} from the Resource Vault.`)}`}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center justify-center gap-1.5 bg-[#25D366]/10 text-emerald-800 hover:bg-[#25D366] hover:text-white border border-[#25D366]/30 text-xs font-bold py-2 px-2.5 rounded-xl transition-colors text-center"
                    >
                      <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg>
                      <span>WhatsApp</span>
                    </a>
                  </div>
                </div>
              ) : (
                <div class="space-y-2 pt-1">
                  <a
                    href={item.pdfUrl}
                    download
                    class="w-full inline-flex items-center justify-center gap-2 bg-brand-navy text-white text-xs md:text-sm font-bold py-2.5 px-4 rounded-xl hover:bg-blue-900 transition-colors shadow-2xs text-center"
                  >
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
                    <span>Download Clinical PDF</span>
                  </a>
                  <a
                    href={item.actionUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="w-full inline-flex items-center justify-center gap-2 bg-[#25D366]/10 text-emerald-800 hover:bg-[#25D366] hover:text-white border border-[#25D366]/30 text-xs font-bold py-2 px-3 rounded-xl transition-colors text-center"
                  >
                    <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg>
                    <span>Request on WhatsApp</span>
                  </a>
                </div>
              )}
            </div>
          </div>
        ))}
      </div>

      <!-- No Results State -->
      <div id="no-results" class="hidden text-center py-16 bg-white rounded-2xl border border-gray-200 mt-6 p-8">
        <svg class="w-12 h-12 text-gray-400 mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
        <h3 class="text-lg font-bold text-brand-navy mb-1">No matching resources found</h3>
        <p class="text-sm text-gray-500 mb-4">Try clearing your search query or selecting a different category.</p>
        <button id="reset-filters" class="bg-brand-navy text-white text-xs font-bold px-4 py-2 rounded-lg cursor-pointer hover:bg-blue-900 transition-colors">
          Reset All Filters
        </button>
      </div>

    </div>
  </main>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const searchInput = document.getElementById('vault-search-input') as HTMLInputElement;
      const categoryTabs = document.querySelectorAll('.vault-category-tab');
      const tagPills = document.querySelectorAll('.vault-tag-pill');
      const cards = document.querySelectorAll('.vault-card') as NodeListOf<HTMLElement>;
      const resultsCount = document.getElementById('results-count');
      const noResults = document.getElementById('no-results');
      const resetBtn = document.getElementById('reset-filters');

      let currentCategory = 'all';
      let currentTag = 'all';
      let currentQuery = '';

      function filterCards() {
        let visibleCount = 0;

        cards.forEach((card) => {
          const cardCategory = card.getAttribute('data-category') || '';
          const cardTag = card.getAttribute('data-tag') || '';
          const cardSearch = card.getAttribute('data-search') || '';

          const matchesCategory = currentCategory === 'all' || cardCategory === currentCategory;
          const matchesTag = currentTag === 'all' || cardTag.toLowerCase() === currentTag.toLowerCase();
          const matchesQuery = !currentQuery || cardSearch.includes(currentQuery.toLowerCase());

          if (matchesCategory && matchesTag && matchesQuery) {
            card.style.display = 'flex';
            visibleCount++;
          } else {
            card.style.display = 'none';
          }
        });

        if (resultsCount) {
          resultsCount.textContent = `Showing ${visibleCount} of ${cards.length} clinical resources`;
        }

        if (noResults) {
          if (visibleCount === 0) {
            noResults.classList.remove('hidden');
          } else {
            noResults.classList.add('hidden');
          }
        }
      }

      // Search Handler
      if (searchInput) {
        searchInput.addEventListener('input', (e) => {
          currentQuery = (e.target as HTMLInputElement).value.trim();
          filterCards();
        });
      }

      // Category Tabs Handler
      categoryTabs.forEach((tab) => {
        tab.addEventListener('click', () => {
          categoryTabs.forEach((t) => {
            t.classList.remove('bg-brand-navy', 'text-white', 'shadow-xs');
            t.classList.add('bg-gray-100', 'text-gray-700', 'border', 'border-gray-200');
          });
          tab.classList.remove('bg-gray-100', 'text-gray-700', 'border', 'border-gray-200');
          tab.classList.add('bg-brand-navy', 'text-white', 'shadow-xs');

          currentCategory = tab.getAttribute('data-category') || 'all';
          filterCards();
        });
      });

      // Tag Pills Handler
      tagPills.forEach((pill) => {
        pill.addEventListener('click', () => {
          tagPills.forEach((p) => {
            p.classList.remove('bg-brand-gold/30', 'text-brand-navy', 'font-bold');
            p.classList.add('bg-gray-50', 'text-gray-600', 'border', 'border-gray-200');
          });
          pill.classList.remove('bg-gray-50', 'text-gray-600', 'border', 'border-gray-200');
          pill.classList.add('bg-brand-gold/30', 'text-brand-navy', 'font-bold');

          currentTag = pill.getAttribute('data-tag') || 'all';
          filterCards();
        });
      });

      // Reset Button
      if (resetBtn) {
        resetBtn.addEventListener('click', () => {
          if (searchInput) searchInput.value = '';
          currentQuery = '';
          currentCategory = 'all';
          currentTag = 'all';

          categoryTabs.forEach((t, i) => {
            if (i === 0) {
              t.classList.add('bg-brand-navy', 'text-white');
              t.classList.remove('bg-gray-100', 'text-gray-700');
            } else {
              t.classList.remove('bg-brand-navy', 'text-white');
              t.classList.add('bg-gray-100', 'text-gray-700');
            }
          });

          tagPills.forEach((p, i) => {
            if (i === 0) {
              p.classList.add('bg-brand-gold/30', 'text-brand-navy', 'font-bold');
            } else {
              p.classList.remove('bg-brand-gold/30', 'text-brand-navy', 'font-bold');
            }
          });

          filterCards();
        });
      }
    });
  </script>
</BaseLayout>
