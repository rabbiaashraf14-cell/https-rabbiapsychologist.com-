---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/global/Breadcrumbs.astro';
import { articles, getFeaturedArticles } from '../data/blogArticles';
import { getArticleImage, getCategoryFallbackSvg } from '../utils/imageMatching';
import BlogImageSlideshow from '../components/blog/BlogImageSlideshow.astro';

// Dynamically import all blog images for proper image priority system
const localImages = import.meta.glob<{ default: ImageMetadata }>('/src/assets/blog/*.{jpeg,jpg,png,webp,gif}', { eager: true });

const title = "Child Psychology, ADHD, Autism & Parent Guidance Blog | Rabbia Psychologist";
const description = "Practical, evidence-based articles by Clinical Psychologist Rabbia Ashraf on child development, ADHD, autism, PDA, selective mutism, behaviour, emotional regulation, and psychological reports.";
const canonicalURL = "https://www.rabbiapsychologist.com/blog/";

const breadcrumbs = [
  { name: 'Blog', href: '/blog/' }
];

const collectionSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Child Psychology and Parent Guidance Blog",
  "description": description,
  "url": canonicalURL,
  "author": {
    "@type": "Person",
    "name": "Rabbia Ashraf",
    "jobTitle": "Clinical Psychologist",
    "url": "https://www.rabbiapsychologist.com/about/"
  }
};

const itemListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "Clinical Psychology & Parent Guidance Articles by Rabbia Ashraf",
  "numberOfItems": articles.length,
  "itemListElement": articles.map((article, index) => ({
    "@type": "ListItem",
    "position": index + 1,
    "name": article.title,
    "url": `https://www.rabbiapsychologist.com${article.href}`,
    "description": article.excerpt
  }))
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://www.rabbiapsychologist.com/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Blog",
      "item": "https://www.rabbiapsychologist.com/blog/"
    }
  ]
};

const categories = [
  "ADHD",
  "Autism",
  "Behaviour",
  "Emotional Regulation",
  "Learning Difficulties",
  "School Support",
  "Reports & Assessments",
  "Parent Guidance",
  "Sensory Processing",
  "Speech & Communication"
];

// Curated high-relevance clinical starting guides for parents
const startingArticles = [
  { title: "PDA Autism vs. Defiance", href: "/blog/pda-autism-demand-avoidance-vs-defiance/" },
  { title: "RSD in ADHD Children", href: "/blog/rejection-sensitive-dysphoria-adhd-children/" },
  { title: "Selective Mutism vs. Shyness", href: "/blog/selective-mutism-vs-shyness-when-child-freezes/" },
  { title: "Public Meltdowns vs. Defiance", href: "/blog/public-meltdowns-and-defiance-how-to-deescalate/" },
  { title: "The ADHD Morning Wall", href: "/blog/adhd-morning-routine-and-executive-dysfunction/" },
  { title: "Stuck on an Assessment Waitlist", href: "/blog/child-assessment-waitlist-home-strategies/" },
  { title: "How to Read Psychological Reports", href: "/blog/how-to-read-child-psychological-assessment-report/" },
  { title: "Tantrum vs Meltdown", href: "/blog/tantrum-vs-meltdown/" },
  { title: "Autism Early Signs", href: "/blog/autism-early-signs/" },
  { title: "Speech Delay vs Autism", href: "/blog/speech-delay-vs-autism/" }
];

// Sort articles by date descending
const sortedArticles = [...articles].sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());
---

<BaseLayout canonicalURL={canonicalURL} title={title} description={description}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(collectionSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>

  <div class="container mx-auto px-4 sm:px-6 lg:px-8 py-8 max-w-5xl">
    <Breadcrumbs paths={breadcrumbs} />

    <!-- 1. Blog hero -->
    <div class="mt-8 mb-12 text-center">
      <span class="inline-block text-xs font-bold uppercase tracking-wider text-brand-gold bg-brand-cream border border-brand-gold/30 px-3 py-1 rounded-full mb-3">
        Clinical Child Psychology & Parent Guidance
      </span>
      <h1 class="text-4xl md:text-5xl font-bold text-brand-navy mb-6">Child Psychology, ADHD, Autism & Parent Guidance Blog</h1>

      <!-- 2. Intro -->
      <p class="text-xl text-gray-700 max-w-3xl mx-auto mb-8 leading-relaxed">
        Evidence-based, compassionate clinical insights by Clinical Psychologist Rabbia Ashraf. Navigating autism, ADHD, PDA, emotional dysregulation, school advocacy, and psychological assessment reports.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">

      <!-- Sidebar / Filters -->
      <div class="lg:col-span-1 space-y-8">
        <!-- 3. Featured categories -->
        <div class="bg-gray-50 p-6 rounded-xl border border-gray-100">
          <h2 class="text-xl font-bold text-brand-navy mb-4 border-b pb-2">Browse by Concern</h2>
          <ul class="space-y-2">
            {categories.map((category) => (
              <li><a href="/resources/" class="text-brand-trust hover:underline font-medium">{category}</a></li>
            ))}
          </ul>
        </div>

        <!-- 5. Most helpful for parents starting today -->
        <div class="bg-brand-cream p-6 rounded-xl border border-brand-sky">
          <h2 class="text-xl font-bold text-brand-navy mb-4 border-b pb-2 border-brand-navy/20">Most Helpful for Parents Starting Today</h2>
          <ul class="space-y-3">
            {startingArticles.map((article) => (
              <li><a href={article.href} class="text-brand-trust hover:underline font-medium block">{article.title}</a></li>
            ))}
          </ul>
        </div>

        <!-- Clinical Consultation Callout -->
        <div class="bg-brand-navy text-white p-6 rounded-xl shadow-sm">
          <h3 class="font-bold text-lg mb-2 text-white">Need Clinical Guidance?</h3>
          <p class="text-xs text-brand-cream leading-relaxed mb-4">
            Direct online parent coaching & child developmental consultations with Clinical Psychologist Rabbia Ashraf.
          </p>
          <a href="/book/" class="block text-center bg-brand-gold text-brand-navy font-bold text-xs py-2.5 px-4 rounded-lg hover:bg-white transition-colors">
            Book Consultation
          </a>
        </div>
      </div>

      <!-- Main Blog List -->
      <div class="lg:col-span-3">
        <!-- 4. Featured articles section -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {sortedArticles.map((article) => {
            const imageData = getArticleImage(article, localImages);
            return (
            <article class="bg-white rounded-2xl shadow-sm border border-gray-100 hover-lift flex flex-col group h-full overflow-hidden">

              {imageData.type === 'local' || imageData.type === 'remote' ? (
                <a href={article.href} class="block relative aspect-video w-full bg-brand-cream border-b border-gray-100 overflow-hidden shrink-0">
                  {imageData.type === 'local' ? (
                    <Image
                      src={imageData.src as ImageMetadata}
                      alt={article.title}
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                      width={600}
                      height={338}
                      loading="lazy"
                    />
                  ) : (
                    <img
                      src={imageData.src as string}
                      alt={article.title}
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                      loading="lazy"
                      onerror={`this.onerror=null; this.src='${getCategoryFallbackSvg(article.categories)}';`}
                    />
                  )}
                </a>
              ) : (
                <div class="block relative aspect-video w-full bg-brand-cream border-b border-gray-100 overflow-hidden shrink-0">
                  <BlogImageSlideshow
                    articleUrl={article.href}
                    articleTitle={article.title}
                    fallbackSvg={imageData.src as string}
                    categories={article.categories}
                    readTime={article.readTime}
                  />
                </div>
              )}
              <div class="p-6 flex flex-col flex-grow">
                <div class="flex gap-2 mb-3 flex-wrap items-center">
                  {article.featured && (
                    <span class="text-[11px] font-bold uppercase tracking-wider text-amber-900 bg-amber-100 border border-amber-200 px-2 py-0.5 rounded-full flex items-center gap-1">
                      <span>★</span> Clinical Pillar
                    </span>
                  )}
                  {article.categories.map((cat) => (
                    <span class="text-xs font-bold uppercase tracking-wider text-brand-trust bg-brand-cream px-2 py-1 rounded">{cat}</span>
                  ))}
                  {article.readTime && (
                    <span class="text-xs text-gray-500 font-medium ml-auto">⏱️ {article.readTime}</span>
                  )}
                </div>
                <h3 class="text-xl font-bold text-brand-navy mb-2 leading-tight">
                  <a href={article.href} class="hover:text-brand-trust transition-colors">{article.title}</a>
                </h3>
                <p class="text-gray-600 mb-4 flex-grow text-sm leading-relaxed">{article.excerpt}</p>
                <div class="text-sm text-gray-500 mt-auto border-t pt-4 flex justify-between items-center">
                  <span class="text-xs">{article.author}</span>
                  <span class="text-brand-gold font-bold text-sm group-hover:translate-x-1 transition-transform">Read article &rarr;</span>
                </div>
              </div>
            </article>
            );
          })}
        </div>

        <!-- 7. Blog CTA -->
        <div class="mt-12 bg-brand-navy text-white p-8 rounded-xl text-center shadow-md flex flex-col md:flex-row items-center justify-between gap-6">
          <div class="text-left md:w-2/3">
            <h2 class="text-2xl font-bold mb-4">Need help applying this to your child?</h2>
            <p class="text-brand-cream">Turn reading into action. Get a personalized plan for your family's unique situation.</p>
          </div>
          <div>
            <a href="/start-here/" class="inline-block bg-white text-brand-navy px-8 py-3 rounded-lg font-bold hover:bg-gray-100 transition-colors whitespace-nowrap">Find Your Support Pathway</a>
          </div>
        </div>

        <!-- Internal Links for discovery -->
        <div class="mt-8 flex flex-wrap justify-center gap-4 text-sm font-medium">
           <a href="/services/" class="text-brand-trust hover:underline">Services</a>
           <span class="text-gray-300">|</span>
           <a href="/pricing/" class="text-brand-trust hover:underline">Pricing</a>
           <span class="text-gray-300">|</span>
           <a href="/faqs/" class="text-brand-trust hover:underline">FAQs</a>
           <span class="text-gray-300">|</span>
           <a href="/report-review/" class="text-brand-trust hover:underline">Report Review</a>
           <span class="text-gray-300">|</span>
           <a href="/screener/" class="text-brand-trust hover:underline">Child Screener</a>
        </div>
      </div>

    </div>
  </div>
</BaseLayout>
