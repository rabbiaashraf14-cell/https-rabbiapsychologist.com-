---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/global/Breadcrumbs.astro';
import { alternatives } from '../../data/alternatives';

export function getStaticPaths() {
  return alternatives.map(item => ({
    params: { slug: item.slug },
    props: { item }
  }));
}

interface Props {
  item: typeof alternatives[0];
}

const { item } = Astro.props;

const canonicalURL = `https://www.rabbiapsychologist.com/alternatives/${item.slug}/`;

const breadcrumbs = [
  { name: 'Home', href: '/' },
  { name: 'Clinical Alternatives', href: '/alternatives/' },
  { name: item.title, href: `/alternatives/${item.slug}/` }
];

// Rich schema markup (MedicalWebPage + FAQPage)
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "MedicalWebPage",
      "@id": canonicalURL,
      "url": canonicalURL,
      "name": item.title,
      "description": item.metaDescription,
      "inLanguage": "en",
      "author": {
        "@type": "Person",
        "name": "Rabbia Ashraf",
        "jobTitle": "Clinical Psychologist & Certified ADOS-2 Practitioner",
        "url": "https://www.rabbiapsychologist.com/about/"
      },
      "reviewedBy": {
        "@type": "Person",
        "name": "Rabbia Ashraf",
        "jobTitle": "Clinical Psychologist"
      },
      "medicalAudience": {
        "@type": "MedicalAudience",
        "audienceType": ["Parents", "Teachers", "School Counselors"]
      }
    },
    {
      "@type": "FAQPage",
      "@id": `${canonicalURL}#faq`,
      "mainEntity": item.faqList.map(faq => ({
        "@type": "Question",
        "name": faq.question,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": faq.answer
        }
      }))
    }
  ]
};
---

<BaseLayout 
  canonicalURL={canonicalURL} 
  title={`${item.title} | Rabbia Psychologist`} 
  description={item.metaDescription}
  schema={schema}
>
  <article class="container mx-auto px-4 py-8 max-w-5xl">
    <Breadcrumbs paths={breadcrumbs} />

    <!-- Article Header -->
    <header class="mt-6 mb-10">
      <div class="flex flex-wrap items-center gap-2 mb-4">
        <span class="px-3 py-1 rounded-full bg-emerald-100 text-emerald-900 text-xs font-bold uppercase tracking-wider">
          {item.category}
        </span>
        <span class="px-3 py-1 rounded-full bg-blue-50 text-blue-900 border border-blue-200 text-xs font-semibold">
          {item.evidenceGrade}
        </span>
        <span class="text-xs text-gray-500 font-medium ml-auto">
          {item.readTime}
        </span>
      </div>

      <h1 class="text-3xl sm:text-4xl md:text-5xl font-black text-brand-navy tracking-tight leading-tight mb-6">
        {item.title}
      </h1>

      <p class="text-lg sm:text-xl text-gray-700 leading-relaxed max-w-3xl mb-6">
        {item.metaDescription}
      </p>

      <!-- Clinician Byline -->
      <div class="flex items-center gap-4 py-4 border-y border-gray-200 text-xs sm:text-sm text-gray-600">
        <div class="w-10 h-10 rounded-full bg-emerald-900 text-white flex items-center justify-center font-bold text-base shrink-0 shadow-xs">
          RA
        </div>
        <div>
          <div class="font-bold text-brand-navy">Rabbia Ashraf, MSc, M.Phil</div>
          <div class="text-gray-500">Clinical Psychologist &bull; Certified ADOS-2 &bull; Neurodiversity-Affirming Practice</div>
        </div>
      </div>
    </header>

    <!-- The Problem / Target Dilemma Box -->
    <section class="bg-rose-50/70 rounded-3xl p-6 sm:p-8 border border-rose-200/80 mb-12" aria-label="Clinical Dilemma">
      <div class="flex items-center gap-2 text-rose-800 text-xs font-bold uppercase tracking-wider mb-2">
        <span class="w-2 h-2 rounded-full bg-rose-600"></span>
        The Real-World Dilemma
      </div>
      <h2 class="text-xl sm:text-2xl font-extrabold text-brand-navy mb-3">Why Traditional Routes Fail Families</h2>
      <p class="text-gray-700 text-sm sm:text-base leading-relaxed mb-6">
        {item.targetDilemma}
      </p>

      <div>
        <h3 class="text-xs font-bold text-brand-navy uppercase tracking-wider mb-3">Core Pain Points Driving Parents to Seek Alternatives:</h3>
        <ul class="grid grid-cols-1 md:grid-cols-2 gap-3 text-xs sm:text-sm text-gray-700">
          {item.whyFamiliesSeekAlternatives.map(reason => (
            <li class="bg-white/80 p-3.5 rounded-xl border border-rose-100 flex items-start gap-2 shadow-2xs">
              <span class="text-rose-600 font-bold">&#9888;</span>
              <span>{reason}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Detailed Alternatives Analysis Cards -->
    <section class="my-14" aria-label="Comparative Alternatives Matrix">
      <div class="text-center mb-10">
        <h2 class="text-2xl sm:text-3xl font-extrabold text-brand-navy tracking-tight mb-2">
          Evidence-Based Alternatives Analyzed
        </h2>
        <p class="text-gray-600 text-sm max-w-2xl mx-auto">
          Comprehensive comparison of cost, implementation speed, clinical evidence, strengths, and limitations.
        </p>
      </div>

      <div class="space-y-8">
        {item.alternativesMatrix.map((alt, idx) => (
          <div class="bg-white rounded-3xl p-6 sm:p-8 border border-gray-200 shadow-xs hover:shadow-md transition-shadow">
            <div class="flex flex-wrap items-center justify-between gap-3 pb-4 mb-5 border-b border-gray-100">
              <div class="flex items-center gap-3">
                <span class="w-8 h-8 rounded-full bg-emerald-100 text-emerald-900 font-bold flex items-center justify-center text-sm">
                  {idx + 1}
                </span>
                <div>
                  <h3 class="text-xl sm:text-2xl font-black text-brand-navy">{alt.name}</h3>
                  <span class="text-xs text-emerald-800 font-semibold">{alt.categoryType}</span>
                </div>
              </div>
              <div class="flex items-center gap-2 text-xs">
                <span class="px-2.5 py-1 rounded-md bg-gray-100 text-gray-800 font-bold">
                  Cost: {alt.costLevel}
                </span>
                <span class="px-2.5 py-1 rounded-md bg-blue-50 text-blue-800 font-semibold">
                  Speed: {alt.timeframe}
                </span>
              </div>
            </div>

            <!-- Best Suited For & Evidence Strip -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6 text-xs sm:text-sm">
              <div class="bg-gray-50 p-4 rounded-2xl border border-gray-100">
                <strong class="text-brand-navy block mb-1 font-bold">Best Suited For:</strong>
                <p class="text-gray-600 leading-relaxed">{alt.bestSuitedFor}</p>
              </div>
              <div class="bg-emerald-50/50 p-4 rounded-2xl border border-emerald-100/60">
                <strong class="text-emerald-900 block mb-1 font-bold">Clinical Evidence Base:</strong>
                <p class="text-gray-700 leading-relaxed">{alt.clinicalEvidence}</p>
              </div>
            </div>

            <!-- Strengths and Limitations -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6 text-xs sm:text-sm">
              <div class="bg-emerald-50/60 p-4 rounded-2xl border border-emerald-100 text-emerald-950">
                <strong class="block mb-2 font-bold text-emerald-900">&#10003; Key Clinical Strengths:</strong>
                <ul class="space-y-1.5">
                  {alt.keyStrengths.map(s => (
                    <li class="flex items-start gap-2">
                      <span class="text-emerald-600 font-bold mt-0.5">&bull;</span>
                      <span>{s}</span>
                    </li>
                  ))}
                </ul>
              </div>
              <div class="bg-amber-50/60 p-4 rounded-2xl border border-amber-100 text-amber-950">
                <strong class="block mb-2 font-bold text-amber-900">&#9888; Important Limitations:</strong>
                <ul class="space-y-1.5">
                  {alt.limitations.map(l => (
                    <li class="flex items-start gap-2">
                      <span class="text-amber-600 font-bold mt-0.5">&bull;</span>
                      <span>{l}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>

            <!-- Immediate Action Step -->
            <div class="bg-blue-50/70 p-4 rounded-2xl border border-blue-100 text-xs sm:text-sm text-blue-950 flex items-start gap-3">
              <span class="text-blue-700 font-black text-base shrink-0">&#10140;</span>
              <div>
                <strong class="font-bold text-blue-900">Recommended First Step:</strong>
                <p class="text-gray-700 mt-0.5 leading-relaxed">{alt.recommendedFirstStep}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Clinical Decision Pathway Flowchart -->
    <section class="bg-slate-900 text-white rounded-3xl p-6 sm:p-10 my-12 shadow-lg" aria-label="Decision Flowchart">
      <div class="max-w-3xl mb-8">
        <div class="text-brand-gold text-xs font-bold uppercase tracking-widest mb-2">
          Decision Pathway Framework
        </div>
        <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight mb-3">
          How to Choose the Right Pathway
        </h2>
        <p class="text-gray-300 text-sm leading-relaxed">
          Match your child's immediate needs to the most clinically effective course of action:
        </p>
      </div>

      <div class="space-y-4">
        {item.decisionPathwayFlowchart.map((path, idx) => (
          <div class="bg-white/5 rounded-2xl p-5 border border-white/10 flex flex-col md:flex-row md:items-center justify-between gap-4">
            <div class="flex items-start gap-3 md:w-1/2">
              <span class="w-7 h-7 rounded-full bg-brand-gold text-brand-navy font-bold flex items-center justify-center text-xs shrink-0 mt-0.5">
                {idx + 1}
              </span>
              <div>
                <div class="text-xs text-gray-400 uppercase font-semibold">If Your Situation Is:</div>
                <div class="text-sm font-bold text-white mt-0.5">{path.condition}</div>
              </div>
            </div>
            <div class="border-t md:border-t-0 md:border-l border-white/10 pt-3 md:pt-0 md:pl-5 md:w-1/2">
              <div class="text-xs text-emerald-400 uppercase font-semibold">Recommended Pathway:</div>
              <div class="text-xs sm:text-sm text-gray-200 mt-0.5 leading-relaxed font-medium">{path.action}</div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Specialist Perspective -->
    <section class="bg-white rounded-3xl p-8 sm:p-10 border border-gray-200 shadow-xs my-12" aria-label="Clinical Verdict">
      <div class="flex items-center gap-2 text-emerald-700 text-xs font-bold uppercase tracking-wider mb-3">
        <span>&#9733;</span> Clinician's Perspective &bull; Rabbia Ashraf
      </div>
      <h2 class="text-2xl sm:text-3xl font-black text-brand-navy mb-4 tracking-tight">The Ethical Child-First Principle</h2>
      <p class="text-gray-700 text-base sm:text-lg leading-relaxed mb-6 italic border-l-4 border-emerald-600 pl-4">
        "{item.specialistPerspective}"
      </p>

      <div class="pt-6 border-t border-gray-100">
        <h3 class="text-xs font-bold text-brand-navy uppercase tracking-wider mb-3">When Urgent Professional Triage is Advised:</h3>
        <ul class="grid grid-cols-1 md:grid-cols-3 gap-3 text-xs sm:text-sm text-gray-700">
          {item.whenToSeekSpecialist.map(w => (
            <li class="bg-gray-50 p-3 rounded-xl border border-gray-200 flex items-start gap-2">
              <span class="text-emerald-600 font-bold">&#10003;</span>
              <span>{w}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Frequently Asked Questions -->
    <section class="my-14" aria-label="Frequently Asked Questions">
      <h2 class="text-2xl sm:text-3xl font-extrabold text-brand-navy text-center mb-8 tracking-tight">
        Frequently Asked Questions
      </h2>

      <div class="max-w-3xl mx-auto space-y-4">
        {item.faqList.map(faq => (
          <div class="bg-white rounded-2xl p-6 border border-gray-200 shadow-xs">
            <h3 class="text-base sm:text-lg font-bold text-brand-navy mb-2">{faq.question}</h3>
            <p class="text-gray-700 text-xs sm:text-sm leading-relaxed">{faq.answer}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Academic References & Clinical Guidelines (E-E-A-T) -->
    <section class="bg-gray-50 rounded-2xl p-6 sm:p-8 border border-gray-200 my-12" aria-label="Peer-Reviewed References">
      <h3 class="text-sm font-bold text-brand-navy uppercase tracking-wider mb-3 flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-emerald-700"></span>
        Peer-Reviewed Clinical Citations &amp; Practice Frameworks
      </h3>
      <ul class="space-y-2 text-xs text-gray-600 leading-relaxed">
        {item.peerReviewedCitations.map(cite => (
          <li class="pl-3 border-l-2 border-gray-300">
            {cite.citation}
          </li>
        ))}
      </ul>
      <div class="mt-4 pt-4 border-t border-gray-200 text-[11px] text-gray-500">
        Clinical alternative analyses synthesized in concordance with NICE CG128, American Psychological Association (APA), and AOTA clinical practice guidelines.
      </div>
    </section>

    <!-- Consultation Action Banner -->
    <footer class="bg-linear-to-r from-emerald-950 via-slate-900 to-blue-950 rounded-3xl p-8 sm:p-10 text-white text-center shadow-lg my-12">
      <h2 class="text-2xl sm:text-3xl font-extrabold mb-3">Need Independent Guidance for Your Child?</h2>
      <p class="text-emerald-100 text-sm sm:text-base max-w-2xl mx-auto mb-6 leading-relaxed">
        Schedule an independent clinical triage session or report review with Rabbia Ashraf to establish a personalized, respectful action plan.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a 
          href="/book/"
          class="px-6 py-3 rounded-xl bg-brand-gold text-brand-navy font-bold hover:bg-yellow-400 transition-all shadow-md text-sm"
        >
          Book Clinical Consultation &rarr;
        </a>
        <a 
          href="https://wa.me/923364114002"
          class="px-6 py-3 rounded-xl bg-white/10 hover:bg-white/20 text-white font-semibold transition-all border border-white/20 text-sm flex items-center gap-2"
        >
          WhatsApp Inquiry
        </a>
      </div>
    </footer>
  </article>
</BaseLayout>
