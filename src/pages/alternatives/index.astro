---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/global/Breadcrumbs.astro';
import { alternatives } from '../../data/alternatives';

const title = "Evidence-Based Alternatives & Clinical Decision Frameworks | Rabbia Psychologist";
const description = "Clinical alternative analyses for parents and schools. Explore proven alternatives to NHS waitlists, traditional ABA compliance, and overseas assessment travel.";
const canonicalURL = "https://www.rabbiapsychologist.com/alternatives/";

const breadcrumbs = [
  { name: 'Home', href: '/' },
  { name: 'Clinical Alternatives', href: '/alternatives/' }
];
---

<BaseLayout canonicalURL={canonicalURL} title={title} description={description}>
  <div class="container mx-auto px-4 py-8 max-w-6xl">
    <Breadcrumbs paths={breadcrumbs} />

    <!-- Hero Header -->
    <header class="text-center mt-6 mb-12">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-emerald-50 border border-emerald-200 text-emerald-900 text-xs font-bold uppercase tracking-wider mb-4">
        <span class="w-2 h-2 rounded-full bg-emerald-600 animate-pulse"></span>
        Clinical Alternative Analysis Engine &bull; Respectful, Evidence-Based Pathways
      </div>
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-brand-navy tracking-tight mb-4 max-w-4xl mx-auto">
        Evidence-Based Alternatives for Neurodivergent Families
      </h1>
      <p class="text-base sm:text-lg text-gray-700 max-w-3xl mx-auto leading-relaxed">
        When standard public queues take years, compliance-based therapy feels wrong, or geographical barriers prevent in-person testing, discover validated clinical pathways that protect your child's well-being.
      </p>
    </header>

    <!-- Core Reassurance Pillars -->
    <section class="bg-white rounded-2xl border border-gray-200 p-6 shadow-xs mb-12 grid grid-cols-1 md:grid-cols-3 gap-6 text-center">
      <div class="border-b md:border-b-0 md:border-r border-gray-100 pb-4 md:pb-0">
        <div class="text-2xl font-black text-brand-navy">Zero Wait-Time</div>
        <p class="text-xs text-gray-600 mt-1">NICE-aligned interim home and school strategies you can implement without waiting for a diagnostic letter.</p>
      </div>
      <div class="border-b md:border-b-0 md:border-r border-gray-100 pb-4 md:pb-0">
        <div class="text-2xl font-black text-brand-navy">Neuro-Affirming</div>
        <p class="text-xs text-gray-600 mt-1">Respectful developmental interventions (Floortime, Sensory OT, AAC) that build connection over obedience.</p>
      </div>
      <div>
        <div class="text-2xl font-black text-brand-navy">Global Expat Access</div>
        <p class="text-xs text-gray-600 mt-1">Multi-informant remote assessment methodologies compliant with APA and BPS telepsychology standards.</p>
      </div>
    </section>

    <!-- Alternative Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mb-16">
      {alternatives.map(item => (
        <article class="bg-white rounded-3xl border border-gray-200/90 shadow-xs hover:shadow-xl transition-all duration-300 flex flex-col overflow-hidden group">
          <div class="relative aspect-video overflow-hidden bg-gray-100">
            <img 
              src={item.heroImage} 
              alt={item.title}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              loading="lazy"
              decoding="async"
            />
            <span class="absolute top-3 left-3 bg-emerald-900/90 backdrop-blur-xs text-white text-[11px] font-bold px-2.5 py-1 rounded-full border border-white/20">
              {item.category}
            </span>
          </div>

          <div class="p-6 flex-1 flex flex-col">
            <div class="text-xs font-semibold text-emerald-800 uppercase tracking-wide mb-2 flex items-center justify-between">
              <span>{item.badgeText}</span>
              <span class="text-gray-600 font-normal">{item.readTime}</span>
            </div>

            <h2 class="text-xl font-bold text-brand-navy mb-3 group-hover:text-emerald-700 transition-colors line-clamp-2">
              <a href={`/alternatives/${item.slug}/`} class="focus:outline-hidden">
                {item.title}
              </a>
            </h2>

            <p class="text-gray-600 text-xs sm:text-sm line-clamp-3 mb-6 leading-relaxed flex-1">
              {item.metaDescription}
            </p>

            <div class="pt-4 border-t border-gray-100 flex items-center justify-between text-xs">
              <span class="text-gray-600 font-medium truncate max-w-[180px]">
                {item.evidenceGrade.split('/')[0]}
              </span>
              <a 
                href={`/alternatives/${item.slug}/`}
                class="inline-flex items-center gap-1 font-bold text-emerald-800 hover:text-brand-navy transition-colors"
                aria-label={`Read clinical alternative analysis: ${item.title}`}
              >
                Explore Alternatives &rarr;
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>

    <!-- Free Download CTA -->
    <div class="bg-slate-900 rounded-3xl p-8 sm:p-10 text-white text-center shadow-lg my-12">
      <h2 class="text-2xl sm:text-3xl font-extrabold mb-3">Facing a Crisis or Immediate School Deadline?</h2>
      <p class="text-gray-300 text-sm sm:text-base max-w-2xl mx-auto mb-6 leading-relaxed">
        Download the Waitlist Crisis Action Pack from our Resource Vault or connect directly for specialized clinical guidance.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a 
          href="/resource-vault/"
          class="px-6 py-3 rounded-xl bg-white text-brand-navy font-bold hover:bg-gray-100 transition-all shadow-md text-sm"
        >
          Access Free Resource Vault
        </a>
        <a 
          href="/book/"
          class="px-6 py-3 rounded-xl bg-brand-gold text-brand-navy font-bold hover:bg-yellow-400 transition-all shadow-md text-sm"
        >
          Book Clinical Consultation
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
