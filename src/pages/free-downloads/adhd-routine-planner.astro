---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/global/Breadcrumbs.astro';

const breadcrumbs = [
  { name: 'Resources', href: '/resources' },
  { name: 'Free Downloads', href: '/free-downloads' },
  { name: 'ADHD Routine Planner', href: '/free-downloads/adhd-routine-planner' }
];

const title = "ADHD Home Routine Planner & Visual Schedule | Free Printable Worksheet";
const description = "Printable ADHD daily routine planner based on Dr. Russell Barkley's executive function scaffolding. Includes morning launchpad, visual checklists, and bedtime transition tools.";
const canonicalURL = "https://www.rabbiapsychologist.com/free-downloads/adhd-routine-planner/";
---

<BaseLayout title={title} description={description} canonicalURL={canonicalURL}>
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 py-8 max-w-4xl">
    
    <!-- Action Bar (Hidden when printing) -->
    <div class="no-print mb-8">
      <Breadcrumbs paths={breadcrumbs} />
      
      <div class="mt-6 bg-blue-50 border border-blue-200 rounded-xl p-6 flex flex-col md:flex-row items-center justify-between gap-4 shadow-sm">
        <div>
          <span class="inline-block bg-brand-navy text-white text-xs font-bold px-2.5 py-1 rounded-full uppercase tracking-wider mb-2">Evidence-Based Clinical Tool</span>
          <h1 class="text-2xl md:text-3xl font-bold text-brand-navy">ADHD Home Routine Planner & Visual Schedule</h1>
          <p class="text-gray-700 text-sm mt-1">Ready to print directly or save as PDF to use on your fridge or study desk.</p>
        </div>
        <div class="flex items-center gap-3 w-full md:w-auto shrink-0">
          <button onclick="window.print()" class="flex-1 md:flex-none inline-flex items-center justify-center gap-2 bg-brand-navy text-white px-5 py-3 rounded-lg font-bold hover:bg-blue-900 transition-colors shadow-sm cursor-pointer">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"/></svg>
            <span>Print / Save as PDF</span>
          </button>
          <a href="https://wa.me/923364114002?text=Hi%20Rabbia,%20I%20am%20using%20the%20ADHD%20Routine%20Planner%20and%20would%20like%20to%20learn%20more%20about%20parent%20guidance." target="_blank" rel="noopener noreferrer" class="flex-1 md:flex-none inline-flex items-center justify-center gap-2 bg-[#25D366] text-white px-5 py-3 rounded-lg font-bold hover:bg-[#1EBE5D] transition-colors shadow-sm">
            <span>WhatsApp Rabbia</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Printable Sheet Document Container -->
    <div class="printable-sheet bg-white rounded-xl shadow-lg border border-gray-200 p-8 md:p-12 text-gray-900">
      
      <!-- Clinical Header -->
      <div class="border-b-2 border-brand-navy pb-4 mb-6 flex flex-col md:flex-row justify-between items-start md:items-end gap-4">
        <div>
          <span class="text-xs uppercase tracking-widest text-brand-gold font-bold">Rabbia Psychologist Child Development Services</span>
          <h2 class="text-3xl font-extrabold text-brand-navy mt-1">ADHD Home Routine & Executive Scaffolding Sheet</h2>
          <p class="text-xs text-gray-600">Framework: Barkley's Externalized Executive Functioning Model (Point-of-Performance Scaffolding)</p>
        </div>
        <div class="text-right text-xs text-gray-500 hidden md:block">
          <p>www.rabbiapsychologist.com</p>
          <p>Clinical Parent Resource</p>
        </div>
      </div>

      <!-- Child Profile Header Info -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 bg-gray-50 p-4 rounded-lg border border-gray-200 mb-8 text-sm">
        <div>
          <span class="font-bold text-gray-600 block text-xs">Child's Name:</span>
          <div class="border-b border-gray-400 h-6 mt-1"></div>
        </div>
        <div>
          <span class="font-bold text-gray-600 block text-xs">Age / Grade:</span>
          <div class="border-b border-gray-400 h-6 mt-1"></div>
        </div>
        <div>
          <span class="font-bold text-gray-600 block text-xs">Week Of:</span>
          <div class="border-b border-gray-400 h-6 mt-1"></div>
        </div>
        <div>
          <span class="font-bold text-gray-600 block text-xs">Primary Focus:</span>
          <div class="border-b border-gray-400 h-6 mt-1"></div>
        </div>
      </div>

      <!-- Section 1: Morning Routine -->
      <div class="mb-8">
        <div class="bg-brand-navy text-white px-4 py-2 rounded-t-lg font-bold flex items-center justify-between text-sm md:text-base">
          <span>PART 1: Morning Launchpad (Low Working-Memory Sequence)</span>
          <span class="text-xs text-brand-gold font-normal">Target Departure Time: [ &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; ]</span>
        </div>
        <div class="border border-t-0 border-gray-300 rounded-b-lg overflow-x-auto">
          <table class="w-full text-left text-sm">
            <thead class="bg-gray-100 border-b border-gray-300 text-xs font-semibold uppercase text-gray-700">
              <tr>
                <th class="p-3 w-16 text-center">Done</th>
                <th class="p-3 w-48">Routine Step</th>
                <th class="p-3">Parent Scaffolding Cue (Visual / Environmental)</th>
                <th class="p-3 w-32 text-center">Target Time</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-200">
              <tr>
                <td class="p-3 text-center"><input type="checkbox" class="w-5 h-5 rounded border-gray-400 text-brand-navy" /></td>
                <td class="p-3 font-semibold text-brand-navy">1. Gentle Sensory Awakening</td>
                <td class="p-3 text-gray-700">Open curtains for natural light; play quiet rhythmic music (avoid sudden shouting).</td>
                <td class="p-3 text-center text-gray-500">7:00 AM</td>
              </tr>
              <tr>
                <td class="p-3 text-center"><input type="checkbox" class="w-5 h-5 rounded border-gray-400 text-brand-navy" /></td>
                <td class="p-3 font-semibold text-brand-navy">2. Pre-Set Clothing</td>
                <td class="p-3 text-gray-700">Clothes laid out in order the night before on a dedicated chair (eliminates decision fatigue).</td>
                <td class="p-3 text-center text-gray-500">7:15 AM</td>
              </tr>
              <tr>
                <td class="p-3 text-center"><input type="checkbox" class="w-5 h-5 rounded border-gray-400 text-brand-navy" /></td>
                <td class="p-3 font-semibold text-brand-navy">3. High-Protein Breakfast</td>
                <td class="p-3 text-gray-700">Provide protein-rich food (eggs, peanut butter, yogurt) to support neurotransmitter function.</td>
                <td class="p-3 text-center text-gray-500">7:30 AM</td>
              </tr>
              <tr>
                <td class="p-3 text-center"><input type="checkbox" class="w-5 h-5 rounded border-gray-400 text-brand-navy" /></td>
                <td class="p-3 font-semibold text-brand-navy">4. Bathroom & Grooming</td>
                <td class="p-3 text-gray-700">Visual 3-step mirror card: Teeth (2 min timer) &rarr; Face wash &rarr; Hair.</td>
                <td class="p-3 text-center text-gray-500">7:45 AM</td>
              </tr>
              <tr>
                <td class="p-3 text-center"><input type="checkbox" class="w-5 h-5 rounded border-gray-400 text-brand-navy" /></td>
                <td class="p-3 font-semibold text-brand-navy">5. Launchpad Bag & Shoes</td>
                <td class="p-3 text-gray-700">Backpack, water bottle, and shoes kept in entry launchpad box. Zero search time.</td>
                <td class="p-3 text-center text-gray-500">7:55 AM</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Section 2: Evening Wind-Down -->
      <div class="mb-8">
        <div class="bg-brand-navy text-white px-4 py-2 rounded-t-lg font-bold flex items-center justify-between text-sm md:text-base">
          <span>PART 2: Evening Wind-Down & Dopamine Transition</span>
          <span class="text-xs text-brand-gold font-normal">Target Lights-Out: [ &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; ]</span>
        </div>
        <div class="border border-t-0 border-gray-300 rounded-b-lg overflow-x-auto">
          <table class="w-full text-left text-sm">
            <thead class="bg-gray-100 border-b border-gray-300 text-xs font-semibold uppercase text-gray-700">
              <tr>
                <th class="p-3 w-16 text-center">Done</th>
                <th class="p-3 w-48">Routine Step</th>
                <th class="p-3">Parent Scaffolding Cue (Visual / Environmental)</th>
                <th class="p-3 w-32 text-center">Target Time</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-200">
              <tr>
                <td class="p-3 text-center"><input type="checkbox" class="w-5 h-5 rounded border-gray-400 text-brand-navy" /></td>
                <td class="p-3 font-semibold text-brand-navy">1. Screen Sunset (-60 Min)</td>
                <td class="p-3 text-gray-700">All screens powered down and docked in living room charging station (blue light cutoff).</td>
                <td class="p-3 text-center text-gray-500">8:00 PM</td>
              </tr>
              <tr>
                <td class="p-3 text-center"><input type="checkbox" class="w-5 h-5 rounded border-gray-400 text-brand-navy" /></td>
                <td class="p-3 font-semibold text-brand-navy">2. Tomorrow's Launchpad</td>
                <td class="p-3 text-gray-700">Pack school bag, verify homework in folder, choose tomorrow's clothes together.</td>
                <td class="p-3 text-center text-gray-500">8:15 PM</td>
              </tr>
              <tr>
                <td class="p-3 text-center"><input type="checkbox" class="w-5 h-5 rounded border-gray-400 text-brand-navy" /></td>
                <td class="p-3 font-semibold text-brand-navy">3. Warm Bath or Heavy Work</td>
                <td class="p-3 text-gray-700">Warm water or deep proprioceptive pressure (weighted blanket / big bear hug) to stimulate melatonin.</td>
                <td class="p-3 text-center text-gray-500">8:30 PM</td>
              </tr>
              <tr>
                <td class="p-3 text-center"><input type="checkbox" class="w-5 h-5 rounded border-gray-400 text-brand-navy" /></td>
                <td class="p-3 font-semibold text-brand-navy">4. Co-Regulation Reading</td>
                <td class="p-3 text-gray-700">Read aloud together or listen to an audiobook under dim, warm lamp lighting.</td>
                <td class="p-3 text-center text-gray-500">8:45 PM</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Clinical Golden Rules for ADHD Routines -->
      <div class="bg-gray-50 p-6 rounded-xl border border-gray-300 mb-8 text-xs leading-relaxed">
        <h4 class="font-bold text-brand-navy text-sm uppercase tracking-wider mb-2">Psychologist's Implementation Rules:</h4>
        <ul class="list-disc pl-5 space-y-1 text-gray-700">
          <li><strong>Externalize Time:</strong> Children with ADHD suffer from "time blindness". Use an analog clock or visual countdown timer (Time Timer) rather than digital clocks.</li>
          <li><strong>The Dopamine Bridge:</strong> Transitions from high stimulation (video games/tablets) to low stimulation (homework/sleep) cause distress. Always build a 5-minute sensory bridge (e.g. snack, jumping on trampoline, listening to 1 favorite song).</li>
          <li><strong>Consistency Over Perfection:</strong> Follow the sequence rather than rigid minutes. The order of activities forms the neurological muscle memory.</li>
        </ul>
      </div>

      <!-- Clinical Disclaimer & Footer -->
      <div class="border-t border-gray-300 pt-4 text-[11px] text-gray-500 flex flex-col md:flex-row justify-between items-center gap-2">
        <p><strong>Clinical Notice:</strong> This worksheet is for educational parent guidance. It does not substitute for an individual medical, neuropsychological, or psychological assessment.</p>
        <p class="shrink-0 font-medium">© 2026 Rabbia Psychologist Child Development Services</p>
      </div>

    </div>

    <!-- Back to Hub (no-print) -->
    <div class="no-print mt-8 text-center">
      <a href="/free-downloads" class="inline-flex items-center gap-2 text-brand-navy hover:text-blue-800 font-bold">
        <span>&larr; Return to Free Downloads Hub</span>
      </a>
    </div>

  </div>
</BaseLayout>
