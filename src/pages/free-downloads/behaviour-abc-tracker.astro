---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/global/Breadcrumbs.astro';

const breadcrumbs = [
  { name: 'Resources', href: '/resources' },
  { name: 'Free Downloads', href: '/free-downloads' },
  { name: 'Behaviour ABC Tracker', href: '/free-downloads/behaviour-abc-tracker' }
];

const title = "Behaviour ABC Incident Tracker & Functional Assessment Sheet | Free Printable";
const description = "Printable ABC behavior tracker (Antecedent-Behaviour-Consequence) for parents to identify hidden triggers, meltdown patterns, and functional needs.";
const canonicalURL = "https://www.rabbiapsychologist.com/free-downloads/behaviour-abc-tracker/";
---

<BaseLayout title={title} description={description} canonicalURL={canonicalURL}>
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 py-8 max-w-5xl">
    
    <!-- Action Bar (Hidden when printing) -->
    <div class="no-print mb-8">
      <Breadcrumbs paths={breadcrumbs} />
      
      <div class="mt-6 bg-blue-50 border border-blue-200 rounded-xl p-6 flex flex-col md:flex-row items-center justify-between gap-4 shadow-sm">
        <div>
          <span class="inline-block bg-brand-navy text-white text-xs font-bold px-2.5 py-1 rounded-full uppercase tracking-wider mb-2">Clinical Assessment Tool</span>
          <h1 class="text-2xl md:text-3xl font-bold text-brand-navy">Behaviour ABC Incident Tracker</h1>
          <p class="text-gray-700 text-sm mt-1">Isolate what triggers challenging behaviours and understand what need your child is communicating.</p>
        </div>
        <div class="flex items-center gap-3 w-full md:w-auto shrink-0">
          <button onclick="window.print()" class="flex-1 md:flex-none inline-flex items-center justify-center gap-2 bg-brand-navy text-white px-5 py-3 rounded-lg font-bold hover:bg-blue-900 transition-colors shadow-sm cursor-pointer">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"/></svg>
            <span>Print / Save as PDF</span>
          </button>
          <a href="https://wa.me/923364114002?text=Hi%20Rabbia,%20I%20have%20completed%20the%20Behaviour%20ABC%20Tracker%20and%20would%20like%20guidance%20on%20interpreting%20the%20patterns." target="_blank" rel="noopener noreferrer" class="flex-1 md:flex-none inline-flex items-center justify-center gap-2 bg-[#25D366] text-white px-5 py-3 rounded-lg font-bold hover:bg-[#1EBE5D] transition-colors shadow-sm">
            <span>WhatsApp Rabbia</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Printable Sheet Document Container -->
    <div class="printable-sheet bg-white rounded-xl shadow-lg border border-gray-200 p-8 md:p-12 text-gray-900">
      
      <!-- Clinical Header -->
      <div class="border-b-2 border-brand-navy pb-4 mb-6 flex flex-col md:flex-row justify-between items-start md:items-end gap-4">
        <div>
          <span class="text-xs uppercase tracking-widest text-brand-gold font-bold">Rabbia Psychologist Child Development Services</span>
          <h2 class="text-3xl font-extrabold text-brand-navy mt-1">Functional Behaviour ABC Observation Sheet</h2>
          <p class="text-xs text-gray-600">Framework: Functional Behaviour Assessment (FBA) & Applied Behaviour Analysis Methodology</p>
        </div>
        <div class="text-right text-xs text-gray-500 hidden md:block">
          <p>www.rabbiapsychologist.com</p>
          <p>Clinical Parent Resource</p>
        </div>
      </div>

      <!-- Child Profile Header Info -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 bg-gray-50 p-4 rounded-lg border border-gray-200 mb-8 text-sm">
        <div>
          <span class="font-bold text-gray-600 block text-xs">Child's Name:</span>
          <div class="border-b border-gray-400 h-6 mt-1"></div>
        </div>
        <div>
          <span class="font-bold text-gray-600 block text-xs">Target Behaviour:</span>
          <div class="border-b border-gray-400 h-6 mt-1"></div>
        </div>
        <div>
          <span class="font-bold text-gray-600 block text-xs">Observation Period:</span>
          <div class="border-b border-gray-400 h-6 mt-1"></div>
        </div>
        <div>
          <span class="font-bold text-gray-600 block text-xs">Recorded By:</span>
          <div class="border-b border-gray-400 h-6 mt-1"></div>
        </div>
      </div>

      <!-- Clinical Matrix Table -->
      <div class="border border-gray-300 rounded-lg overflow-x-auto mb-8">
        <table class="w-full text-left text-xs md:text-sm">
          <thead class="bg-brand-navy text-white text-xs uppercase font-semibold">
            <tr>
              <th class="p-3 w-28 border-r border-navy-700">Date & Time</th>
              <th class="p-3 w-1/3 border-r border-navy-700">
                <span class="block font-bold">A: Antecedent (Trigger)</span>
                <span class="text-[10px] text-gray-300 font-normal">What happened immediately before? (Demand, transition, loud noise, hunger)</span>
              </th>
              <th class="p-3 w-1/3 border-r border-navy-700">
                <span class="block font-bold">B: Behaviour (Observable)</span>
                <span class="text-[10px] text-gray-300 font-normal">What did child do? (Screaming, hitting, running, refusal). Intensity 1-5.</span>
              </th>
              <th class="p-3 w-1/3">
                <span class="block font-bold">C: Consequence (Response)</span>
                <span class="text-[10px] text-gray-300 font-normal">What happened immediately after? (Task postponed, attention given, comfort)</span>
              </th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-200">
            {/* Row 1 - Example */}
            <tr class="bg-gray-50/70">
              <td class="p-3 border-r border-gray-200 font-medium text-gray-600 italic">Example:<br />Mon 4:30 PM</td>
              <td class="p-3 border-r border-gray-200 text-gray-600 italic">Asked to turn off iPad and start maths homework after school.</td>
              <td class="p-3 border-r border-gray-200 text-gray-600 italic">Threw tablet on sofa, screamed "I hate maths!", ran to bedroom. (Intensity: 4/5, Duration: 15 min).</td>
              <td class="p-3 text-gray-600 italic">Parent followed into room, argued for 10 min, then delayed maths until after snack. (Outcome: Task delayed).</td>
            </tr>

            {/* Blank Fillable Incident Rows */}
            {[1, 2, 3, 4, 5].map((rowNum) => (
              <tr class="h-20">
                <td class="p-3 border-r border-gray-200 align-top font-medium text-gray-400">Incident #{rowNum}</td>
                <td class="p-3 border-r border-gray-200 align-top"></td>
                <td class="p-3 border-r border-gray-200 align-top"></td>
                <td class="p-3 align-top"></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <!-- Functional Analysis Guide -->
      <div class="grid grid-cols-1 md:grid-cols-4 gap-4 bg-blue-50/60 p-6 rounded-xl border border-blue-200 mb-8 text-xs text-gray-800">
        <div class="md:col-span-4 font-bold text-brand-navy text-sm uppercase tracking-wider mb-1">
          How to Uncover the Function (The 4 Needs Behind Every Behaviour):
        </div>
        <div class="bg-white p-3 rounded-lg border border-blue-100 shadow-xs">
          <strong class="text-brand-navy block text-sm mb-1">1. Escape / Avoidance</strong>
          <p>Does the behaviour reliably delay a hard task, difficult conversation, or sensory discomfort?</p>
        </div>
        <div class="bg-white p-3 rounded-lg border border-blue-100 shadow-xs">
          <strong class="text-brand-navy block text-sm mb-1">2. Attention Seeking</strong>
          <p>Does the behaviour produce immediate verbal reaction, eye contact, or co-regulation from adults?</p>
        </div>
        <div class="bg-white p-3 rounded-lg border border-blue-100 shadow-xs">
          <strong class="text-brand-navy block text-sm mb-1">3. Access to Tangible</strong>
          <p>Does the behaviour happen when denied a specific toy, snack, activity, or device privilege?</p>
        </div>
        <div class="bg-white p-3 rounded-lg border border-blue-100 shadow-xs">
          <strong class="text-brand-navy block text-sm mb-1">4. Sensory Regulation</strong>
          <p>Does the child seem physically overwhelmed, seeking deep pressure, or covering ears/eyes?</p>
        </div>
      </div>

      <!-- Clinical Disclaimer & Footer -->
      <div class="border-t border-gray-300 pt-4 text-[11px] text-gray-500 flex flex-col md:flex-row justify-between items-center gap-2">
        <p><strong>Clinical Notice:</strong> Behaviour tracking logs are clinical observation aids. They do not replace diagnostic consultation or comprehensive functional behavior assessments.</p>
        <p class="shrink-0 font-medium">© 2026 Rabbia Psychologist Child Development Services</p>
      </div>

    </div>

    <!-- Back to Hub (no-print) -->
    <div class="no-print mt-8 text-center">
      <a href="/free-downloads/" class="inline-flex items-center gap-2 text-brand-navy hover:text-blue-800 font-bold">
        <span>&larr; Return to Free Downloads Hub</span>
      </a>
    </div>

  </div>
</BaseLayout>
