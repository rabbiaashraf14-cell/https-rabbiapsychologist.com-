---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/global/Breadcrumbs.astro';

const breadcrumbs = [
  { name: 'Resources', href: '/resources' },
  { name: 'Free Downloads', href: '/free-downloads' },
  { name: 'School IEP Checklist', href: '/free-downloads/school-iep-checklist' }
];

const title = "School IEP & Teacher Conference Advocacy Checklist | Free Printable Guide";
const description = "Printable IEP and school meeting checklist for parents. Prepare documentation, propose classroom accommodations, and secure special education support.";
const canonicalURL = "https://www.rabbiapsychologist.com/free-downloads/school-iep-checklist/";
---

<BaseLayout title={title} description={description} canonicalURL={canonicalURL}>
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 py-8 max-w-5xl">
    
    <!-- Action Bar (Hidden when printing) -->
    <div class="no-print mb-8">
      <Breadcrumbs paths={breadcrumbs} />
      
      <div class="mt-6 bg-blue-50 border border-blue-200 rounded-xl p-6 flex flex-col md:flex-row items-center justify-between gap-4 shadow-sm">
        <div>
          <span class="inline-block bg-brand-navy text-white text-xs font-bold px-2.5 py-1 rounded-full uppercase tracking-wider mb-2">School Collaboration Tool</span>
          <h1 class="text-2xl md:text-3xl font-bold text-brand-navy">IEP & School Meeting Advocacy Checklist</h1>
          <p class="text-gray-700 text-sm mt-1">Walk into your parent-teacher conference or IEP review fully prepared, organized, and confident.</p>
        </div>
        <div class="flex items-center gap-3 w-full md:w-auto shrink-0">
          <button onclick="window.print()" class="flex-1 md:flex-none inline-flex items-center justify-center gap-2 bg-brand-navy text-white px-5 py-3 rounded-lg font-bold hover:bg-blue-900 transition-colors shadow-sm cursor-pointer">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"/></svg>
            <span>Print / Save as PDF</span>
          </button>
          <a href="https://wa.me/923364114002?text=Hi%20Rabbia,%20I%20have%20an%20upcoming%20IEP%20meeting%20and%20would%20like%20guidance%20on%20advocating%20for%20my%20child." target="_blank" rel="noopener noreferrer" class="flex-1 md:flex-none inline-flex items-center justify-center gap-2 bg-[#25D366] text-white px-5 py-3 rounded-lg font-bold hover:bg-[#1EBE5D] transition-colors shadow-sm">
            <span>WhatsApp Rabbia</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Printable Sheet Document Container -->
    <div class="printable-sheet bg-white rounded-xl shadow-lg border border-gray-200 p-8 md:p-12 text-gray-900">
      
      <!-- Clinical Header -->
      <div class="border-b-2 border-brand-navy pb-4 mb-6 flex flex-col md:flex-row justify-between items-start md:items-end gap-4">
        <div>
          <span class="text-xs uppercase tracking-widest text-brand-gold font-bold">Rabbia Psychologist Child Development Services</span>
          <h2 class="text-3xl font-extrabold text-brand-navy mt-1">IEP & School Conference Advocacy Checklist</h2>
          <p class="text-xs text-gray-600">Framework: Special Education Collaborative Planning & Inclusion Standards (IDEA / SEN)</p>
        </div>
        <div class="text-right text-xs text-gray-500 hidden md:block">
          <p>www.rabbiapsychologist.com</p>
          <p>Clinical Parent Resource</p>
        </div>
      </div>

      <!-- Child Profile Header Info -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 bg-gray-50 p-4 rounded-lg border border-gray-200 mb-8 text-sm">
        <div>
          <span class="font-bold text-gray-600 block text-xs">Student's Name:</span>
          <div class="border-b border-gray-400 h-6 mt-1"></div>
        </div>
        <div>
          <span class="font-bold text-gray-600 block text-xs">School / Grade:</span>
          <div class="border-b border-gray-400 h-6 mt-1"></div>
        </div>
        <div>
          <span class="font-bold text-gray-600 block text-xs">Meeting Date:</span>
          <div class="border-b border-gray-400 h-6 mt-1"></div>
        </div>
        <div>
          <span class="font-bold text-gray-600 block text-xs">Attending Staff:</span>
          <div class="border-b border-gray-400 h-6 mt-1"></div>
        </div>
      </div>

      <!-- Stage 1: Pre-Meeting Documentation Prep -->
      <div class="mb-8">
        <h3 class="bg-brand-navy text-white px-4 py-2 rounded-t-lg font-bold text-sm md:text-base">
          STAGE 1: Pre-Meeting Evidence & Records Preparation (Bring in Binder)
        </h3>
        <div class="border border-t-0 border-gray-300 rounded-b-lg p-5 space-y-3 text-sm">
          <label class="flex items-start gap-3 cursor-pointer">
            <input type="checkbox" class="w-5 h-5 rounded border-gray-400 text-brand-navy mt-0.5 shrink-0" />
            <span><strong>Psychological & Clinical Reports:</strong> Copy of latest diagnostic, psychoeducational, speech, or occupational therapy evaluations.</span>
          </label>
          <label class="flex items-start gap-3 cursor-pointer">
            <input type="checkbox" class="w-5 h-5 rounded border-gray-400 text-brand-navy mt-0.5 shrink-0" />
            <span><strong>Work Sample Comparison:</strong> 2 samples of best work (when regulated/supported) vs. 2 samples when overwhelmed or rushed.</span>
          </label>
          <label class="flex items-start gap-3 cursor-pointer">
            <input type="checkbox" class="w-5 h-5 rounded border-gray-400 text-brand-navy mt-0.5 shrink-0" />
            <span><strong>Home Strategy Dossier:</strong> 1-page summary of what strategies reliably soothe and focus your child at home.</span>
          </label>
          <label class="flex items-start gap-3 cursor-pointer">
            <input type="checkbox" class="w-5 h-5 rounded border-gray-400 text-brand-navy mt-0.5 shrink-0" />
            <span><strong>Top 3 Priorities:</strong> Identify your 3 non-negotiable goals for this term (e.g., emotional safety, assignment chunking, peer socialization).</span>
          </label>
        </div>
      </div>

      <!-- Stage 2: Accommodation Request Matrix -->
      <div class="mb-8">
        <h3 class="bg-brand-navy text-white px-4 py-2 rounded-t-lg font-bold text-sm md:text-base">
          STAGE 2: Classroom Accommodations Request Matrix
        </h3>
        <div class="border border-t-0 border-gray-300 rounded-b-lg overflow-x-auto">
          <table class="w-full text-left text-xs md:text-sm">
            <thead class="bg-gray-100 border-b border-gray-300 font-semibold uppercase text-gray-700">
              <tr>
                <th class="p-3 w-16 text-center">Req.</th>
                <th class="p-3 w-40">Support Domain</th>
                <th class="p-3">Specific Requested Accommodation</th>
                <th class="p-3 w-32 text-center">Agreed (Y/N)</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-200">
              <tr>
                <td class="p-3 text-center"><input type="checkbox" class="w-5 h-5 rounded border-gray-400 text-brand-navy" /></td>
                <td class="p-3 font-semibold text-brand-navy">Sensory Needs</td>
                <td class="p-3">Permission to wear noise-dampening headphones during independent work; access to quiet calming corner when overstimulated.</td>
                <td class="p-3 text-center border-b border-gray-300"></td>
              </tr>
              <tr>
                <td class="p-3 text-center"><input type="checkbox" class="w-5 h-5 rounded border-gray-400 text-brand-navy" /></td>
                <td class="p-3 font-semibold text-brand-navy">Attention & Focus</td>
                <td class="p-3">Preferential seating near teacher away from windows/doors; check for understanding before starting solo tasks.</td>
                <td class="p-3 text-center border-b border-gray-300"></td>
              </tr>
              <tr>
                <td class="p-3 text-center"><input type="checkbox" class="w-5 h-5 rounded border-gray-400 text-brand-navy" /></td>
                <td class="p-3 font-semibold text-brand-navy">Testing & Exams</td>
                <td class="p-3">25% to 50% extra time; separate quiet test room; chunking tests into 20-minute sections with brain breaks.</td>
                <td class="p-3 text-center border-b border-gray-300"></td>
              </tr>
              <tr>
                <td class="p-3 text-center"><input type="checkbox" class="w-5 h-5 rounded border-gray-400 text-brand-navy" /></td>
                <td class="p-3 font-semibold text-brand-navy">Executive Function</td>
                <td class="p-3">Written or printed visual assignment rubric; peer homework buddy; end-of-day backpack check before leaving.</td>
                <td class="p-3 text-center border-b border-gray-300"></td>
              </tr>
              <tr>
                <td class="p-3 text-center"><input type="checkbox" class="w-5 h-5 rounded border-gray-400 text-brand-navy" /></td>
                <td class="p-3 font-semibold text-brand-navy">Emotional Safety</td>
                <td class="p-3">Discreet "break card" the student can place on desk without public calling out; designated safe support staff member.</td>
                <td class="p-3 text-center border-b border-gray-300"></td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Stage 3: Meeting Accountability & Follow-Up -->
      <div class="mb-8">
        <h3 class="bg-brand-navy text-white px-4 py-2 rounded-t-lg font-bold text-sm md:text-base">
          STAGE 3: Post-Meeting Accountability & Agreed Next Steps
        </h3>
        <div class="border border-t-0 border-gray-300 rounded-b-lg p-5 text-sm space-y-4">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <span class="font-bold text-gray-700 block text-xs mb-1">Assigned Case Manager / Contact Person:</span>
              <div class="border-b border-gray-400 h-6"></div>
            </div>
            <div>
              <span class="font-bold text-gray-700 block text-xs mb-1">Follow-Up Review Date (6-8 Weeks):</span>
              <div class="border-b border-gray-400 h-6"></div>
            </div>
          </div>
          <div>
            <span class="font-bold text-gray-700 block text-xs mb-1">Key Action Items Agreed:</span>
            <div class="border-b border-gray-300 h-6 mb-2"></div>
            <div class="border-b border-gray-300 h-6 mb-2"></div>
            <div class="border-b border-gray-300 h-6"></div>
          </div>
        </div>
      </div>

      <!-- Clinical Disclaimer & Footer -->
      <div class="border-t border-gray-300 pt-4 text-[11px] text-gray-500 flex flex-col md:flex-row justify-between items-center gap-2">
        <p><strong>Clinical Notice:</strong> This checklist provides educational advocacy structure. School accommodations vary by country, state education guidelines, and institutional policies.</p>
        <p class="shrink-0 font-medium">© 2026 Rabbia Psychologist Child Development Services</p>
      </div>

    </div>

    <!-- Back to Hub (no-print) -->
    <div class="no-print mt-8 text-center">
      <a href="/free-downloads" class="inline-flex items-center gap-2 text-brand-navy hover:text-blue-800 font-bold">
        <span>&larr; Return to Free Downloads Hub</span>
      </a>
    </div>

  </div>
</BaseLayout>
