---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/global/Breadcrumbs.astro';
import PriceDisplay from '../../components/global/PriceDisplay.astro';

const title = "ADHD Parent Guidance & Executive Function Support | Rabbia Psychologist";
const description = "Online parent guidance for ADHD routines, executive function, school support, and emotional regulation. Get practical help for your child's development.";
const canonicalURL = "https://www.rabbiapsychologist.com/services/adhd-support/";

const breadcrumbs = [
  { name: 'Services', href: '/services' },
  { name: 'ADHD Support', href: '/services/adhd-support' }
];

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "ADHD Parent Guidance and Executive Function Support",
  "provider": {
    "@type": "Organization",
    "name": "Rabbia Psychologist Child Development Services"
  },
  "description": "Online parent guidance for ADHD routines, executive function, school support, and emotional regulation.",
  "areaServed": "International",
  "serviceType": "Parent Guidance",
  "offers": {
    "@type": "Offer",
    "priceCurrency": "USD",
    "price": "95"
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How do I know if my child has ADHD?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Children with ADHD often show persistent patterns of inattention, hyperactivity, or impulsivity that interfere with daily life. Common signs include difficulty sustaining focus, seeming not to listen, struggling with organization, fidgeting, and acting without thinking."
      }
    },
    {
      "@type": "Question",
      "name": "Can ADHD look like laziness?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, to an observer, executive function struggles—such as difficulty starting tasks, low working memory, and mental fatigue—can look like laziness or lack of motivation. In reality, the child is often struggling with the cognitive load of organizing and completing the task."
      }
    },
    {
      "@type": "Question",
      "name": "Why are mornings so hard for children with ADHD?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Mornings require a high sequence of steps, time management, task switching, and working memory—all of which fall under executive functioning. Children with ADHD often become overwhelmed by these demands."
      }
    },
    {
      "@type": "Question",
      "name": "Can parent guidance help before a formal diagnosis?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Absolutely. You do not need a formal diagnosis to start implementing structural supports at home. Creating visual routines, breaking tasks into smaller steps, and understanding your child's triggers can help immediately."
      }
    },
    {
      "@type": "Question",
      "name": "Do you prescribe ADHD medication?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. We provide parent guidance, behavioral strategies, and developmental consultation. Medication advice, formal diagnosis, and medical treatment decisions should be discussed with a qualified medical professional in your local area."
      }
    }
  ]
};
---

<BaseLayout canonicalURL={canonicalURL} title={title} description={description}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <div class="container mx-auto px-4 sm:px-6 lg:px-8 py-8 max-w-4xl">
    <Breadcrumbs paths={breadcrumbs} />

    <!-- 1. Hero section -->
    <div class="mt-8 mb-12 text-center">
      <h1 class="text-4xl md:text-5xl font-bold text-brand-navy mb-4">ADHD Parent Guidance and Executive Function Support</h1>
      <p class="text-xl text-gray-700 mb-4">Practical strategies for attention, hyperactivity, impulsivity, and executive function struggles at home and school.</p>
      <div class="flex justify-center mb-6">
        <PriceDisplay serviceKey="adhdSupport" />
      </div>
      <a href="/book" class="inline-block bg-brand-navy text-white px-8 py-4 rounded-lg font-bold hover:bg-blue-900 transition-colors shadow-md">Book Consultation</a>
    </div>

    <div class="prose prose-lg max-w-none text-gray-700 space-y-12">

      <!-- Parent problem statement -->
      <section>
        <p class="lead text-xl">ADHD can affect attention, impulse control, emotional regulation, routines, homework, transitions, sleep, school performance, and family stress. Parents often notice the behaviour first, but the real difficulty may be attention regulation, working memory, planning, task initiation, or emotional overload.</p>
      </section>

      <!-- 2. This is right for you if -->
      <section>
        <h2 class="text-2xl font-bold text-brand-navy border-b pb-2">This service is right for you if:</h2>
        <ul>
          <li>Your child has a recent ADHD diagnosis and you need a home plan.</li>
          <li>You are waiting for an assessment but need strategies right now.</li>
          <li>You feel exhausted managing your child's daily routines.</li>
          <li>You need help communicating your child's needs to their school.</li>
        </ul>
      </section>

      <!-- 3. Common signs parents ask about -->
      <section>
        <h2 class="text-2xl font-bold text-brand-navy border-b pb-2">Common signs parents ask about:</h2>
        <ul>
          <li>Child does not listen even after repeated reminders</li>
          <li>Child starts homework but cannot finish</li>
          <li>Morning routines feel impossible</li>
          <li>Child forgets instructions quickly</li>
          <li>Emotional reactions feel bigger than expected</li>
          <li>Child interrupts, rushes, or acts before thinking</li>
          <li>Teacher reports incomplete work or careless mistakes</li>
          <li>Parent feels exhausted from constant reminding</li>
        </ul>
      </section>

      <!-- 4. How this service helps (What we do) -->
      <section>
        <h2 class="text-2xl font-bold text-brand-navy border-b pb-2">How this service helps (What happens in the session):</h2>
        <ul>
          <li>Parent interview and concern mapping</li>
          <li>Routine review</li>
          <li>Behaviour and attention pattern review</li>
          <li>Executive function support strategies</li>
          <li>Home structure and visual routine planning</li>
          <li>School communication guidance</li>
          <li>Next-step planning for assessment if needed</li>
          <li>Referral direction where medical or diagnostic evaluation is needed</li>
        </ul>
      </section>

      <!-- 5. What you leave with -->
      <section>
        <h2 class="text-2xl font-bold text-brand-navy border-b pb-2">What you leave with:</h2>
        <p>You will leave with a clear, step-by-step action plan. This might include a custom morning routine structure, a script for how to respond during an outburst, or a list of specific accommodations to ask the school for.</p>
      </section>

      <!-- 6. What this service does not include / Safety Boundary -->
      <section class="bg-brand-cream p-6 rounded-xl border border-brand-sky">
        <h2 class="text-2xl font-bold text-brand-navy border-b pb-2 mb-4">What this service does not include</h2>
        <p><strong>Safety Boundary:</strong> This service provides parent guidance and support planning. Medication advice, formal diagnosis, and medical treatment decisions should be discussed with a qualified medical professional in the family’s local area.</p>
        <p>It also does not include direct therapy with the child or emergency crisis intervention.</p>
      </section>

      <!-- Parents Also Ask Block -->
      <section class="bg-gray-50 p-6 rounded-xl border border-gray-200">
        <h3 class="text-xl font-bold text-brand-navy mb-4">Parents Also Ask</h3>
        <div class="space-y-4">
          <div>
            <h4 class="font-bold text-brand-navy">Is this normal behaviour or something more?</h4>
            <p class="text-sm">Many children struggle with attention occasionally, but if it frequently affects routines and learning, it may need support. We explore <a href="/blog/when-to-seek-developmental-assessment" class="text-brand-trust hover:underline">when to seek an assessment</a>.</p>
          </div>
          <div>
            <h4 class="font-bold text-brand-navy">When should I seek help?</h4>
            <p class="text-sm">Seek help when daily routines cause constant stress, or school performance is affected. Early guidance can make a significant difference.</p>
          </div>
          <div>
            <h4 class="font-bold text-brand-navy">Can this improve with home strategies?</h4>
            <p class="text-sm">Yes, creating visual routines and modifying the environment can greatly help children better manage their attention and tasks.</p>
          </div>
          <div>
            <h4 class="font-bold text-brand-navy">Should I speak to the school first?</h4>
            <p class="text-sm">It's often helpful to connect home and school strategies. We can help you with <a href="/services/school-consultation" class="text-brand-trust hover:underline">school support planning</a>.</p>
          </div>
        </div>
      </section>

      <!-- 7. Related resources & internal links -->
      <section>
        <h3 class="text-xl font-bold text-brand-navy mb-4">Related Services & Resources</h3>
        <ul class="grid grid-cols-1 md:grid-cols-2 gap-2">
          <li><a href="/services/behaviour-planning" class="text-brand-trust font-bold hover:underline">Behaviour Planning</a></li>
          <li><a href="/services/school-consultation" class="text-brand-trust font-bold hover:underline">School Consultation</a></li>
          <li><a href="/report-review" class="text-brand-trust font-bold hover:underline">Report Review</a></li>
          <li><a href="/resources" class="text-brand-trust font-bold hover:underline">Resource Center</a></li>
          <li><a href="/faqs" class="text-brand-trust font-bold hover:underline">Frequently Asked Questions</a></li>
        </ul>
      </section>

      <!-- Evidence-Based Foundation -->
      <section class="bg-blue-50/60 border border-blue-100 rounded-xl p-6 my-8">
        <div class="flex items-center gap-2 mb-3">
          <span class="text-xs font-bold text-brand-navy uppercase tracking-wider bg-white px-2.5 py-1 rounded border border-blue-200">Clinical Research & Evidence</span>
        </div>
        <h3 class="text-xl font-bold text-brand-navy mb-2">Evidence-Based ADHD Treatment Sequencing</h3>
        <p class="text-sm text-gray-700 leading-relaxed mb-4">
          Clinical trials consistently demonstrate the critical power of combining behavioral modifications with structured home supports:
        </p>
        <ul class="space-y-2 text-xs md:text-sm text-gray-700 mb-4 list-disc pl-5">
          <li><strong>Behavioral Interventions First:</strong> The landmark Pelham et al. (2016) clinical trial proved that beginning with behavioral parent training and classroom support prior to medication yields fewer disciplinary problems, superior family functioning, and lower medication dosages.</li>
          <li><strong>Preschool AAP Guidelines:</strong> The American Academy of Pediatrics explicitly recommends Parent Training in Behavior Management (PTBM) as the primary first-line intervention for young children before medication.</li>
          <li><strong>Multimodal Success:</strong> The gold-standard MTA Study showed that combining behavioral parent guidance with medical supervision delivers the highest overall family satisfaction and social outcomes.</li>
        </ul>
        <a href="/knowledge-hub" class="inline-flex items-center gap-1.5 text-xs font-bold text-brand-navy hover:text-blue-700 underline">
          <span>Read the full ADHD clinical trials & meta-analyses in our Knowledge Hub</span>
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
        </a>
      </section>

      <!-- Related blog articles -->
      <section>
        <h3 class="text-xl font-bold text-brand-navy mb-4">Related Articles & Research</h3>
        <ul class="list-disc pl-5">
          <li><a href="/knowledge-hub" class="text-brand-trust font-bold hover:underline">ADHD Scientific Literature & Clinical Guidelines (Knowledge Hub)</a></li>
          <li><a href="/blog/morning-routine-problems-in-adhd" class="text-brand-trust hover:underline">Morning Routine Problems in ADHD</a></li>
          <li><a href="/blog/how-to-support-executive-function-at-home" class="text-brand-trust hover:underline">How to Support Executive Function at Home</a></li>
          <li><a href="/blog/screen-time-and-emotional-regulation" class="text-brand-trust hover:underline">Screen Time and Emotional Regulation</a></li>
        </ul>
      </section>

      <!-- 8. FAQ section -->
      <section>
        <h2 class="text-2xl font-bold text-brand-navy border-b pb-4 mb-6">Frequently Asked Questions</h2>
        <div class="space-y-4">
          <div class="border border-gray-200 rounded-lg p-4">
            <h4 class="font-bold text-brand-navy mb-2">How do I know if my child has ADHD?</h4>
            <p class="text-sm">Children with ADHD often show persistent patterns of inattention, hyperactivity, or impulsivity that interfere with daily life. Common signs include difficulty sustaining focus, seeming not to listen, struggling with organization, fidgeting, and acting without thinking.</p>
          </div>
          <div class="border border-gray-200 rounded-lg p-4">
            <h4 class="font-bold text-brand-navy mb-2">Can ADHD look like laziness?</h4>
            <p class="text-sm">Yes, to an observer, executive function struggles—such as difficulty starting tasks, low working memory, and mental fatigue—can look like laziness or lack of motivation. In reality, the child is often struggling with the cognitive load of organizing and completing the task.</p>
          </div>
          <div class="border border-gray-200 rounded-lg p-4">
            <h4 class="font-bold text-brand-navy mb-2">Why are mornings so hard for children with ADHD?</h4>
            <p class="text-sm">Mornings require a high sequence of steps, time management, task switching, and working memory—all of which fall under executive functioning. Children with ADHD often become overwhelmed by these demands.</p>
          </div>
          <div class="border border-gray-200 rounded-lg p-4">
            <h4 class="font-bold text-brand-navy mb-2">Can parent guidance help before a formal diagnosis?</h4>
            <p class="text-sm">Absolutely. You do not need a formal diagnosis to start implementing structural supports at home. Creating visual routines, breaking tasks into smaller steps, and understanding your child's triggers can help immediately.</p>
          </div>
          <div class="border border-gray-200 rounded-lg p-4">
            <h4 class="font-bold text-brand-navy mb-2">Do you prescribe ADHD medication?</h4>
            <p class="text-sm">No. We provide parent guidance, behavioral strategies, and developmental consultation. Medication advice, formal diagnosis, and medical treatment decisions should be discussed with a qualified medical professional in your local area.</p>
          </div>
        </div>
      </section>

      <!-- 9. CTA block -->
      <div class="bg-gradient-to-br from-brand-cream to-white p-8 md:p-10 rounded-2xl border border-brand-gold mt-12 text-center shadow-sm">
        <span class="inline-block bg-blue-100 text-brand-navy text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider mb-3">
          Available Worldwide via Secure Online Telehealth
        </span>
        <h3 class="text-2xl md:text-3xl font-extrabold text-brand-navy mb-3">Ready for Clarity and a Practical ADHD Action Plan?</h3>
        <p class="text-sm md:text-base text-gray-700 max-w-xl mx-auto mb-6">
          Schedule your 50-minute parent guidance consultation or download our free clinical tools to start implementing positive executive function routines today.
        </p>
        <div class="flex flex-col sm:flex-row justify-center items-center gap-3.5 max-w-2xl mx-auto">
          <a href="/book?service=ADHD%20Support" class="w-full sm:w-auto bg-brand-navy text-white px-7 py-3.5 rounded-xl font-bold hover:bg-blue-900 transition-colors shadow-sm text-center">
            Book ADHD Consultation
          </a>
          <a href="https://wa.me/923364114002?text=Hi%20Rabbia,%20I%20would%20like%20to%20enquire%20about%20an%20online%20ADHD%20parent%20consultation." target="_blank" rel="noopener noreferrer" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-[#25D366] text-white px-6 py-3.5 rounded-xl font-bold hover:bg-[#1EBE5D] transition-colors shadow-2xs text-center">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg>
            <span>Ask on WhatsApp</span>
          </a>
          <a href="/downloads/adhd-home-routine-planner.pdf" download class="w-full sm:w-auto inline-flex items-center justify-center gap-1.5 bg-white text-brand-navy border border-gray-300 px-5 py-3.5 rounded-xl font-bold hover:bg-gray-50 transition-colors shadow-2xs text-center text-xs">
            <svg class="w-4 h-4 text-brand-navy" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
            <span>Free ADHD Planner (PDF)</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
