---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/global/Breadcrumbs.astro';

const breadcrumbs = [
  { name: 'Services', href: '/services' },
  { name: 'School Partnership Services', href: '/services/school-partnership' }
];

const title = "School Partnership & Student Support Services | Rabbia Psychologist";
const description = "Support every child with greater confidence. Practical guidance for schools, teachers, and support teams to manage developmental, behavioural, and learning needs.";

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "School Partnership Services",
  "description": description,
  "provider": {
    "@type": "Organization",
    "name": "Rabbia Psychologist Child Development Services"
  },
  "areaServed": "International"
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Can you work with individual students referred by our school?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. The appropriate service will depend on the student’s concern, location, available records, parental consent, and whether consultation, observation, screening, assessment, or referral is required."
      }
    },
    {
      "@type": "Question",
      "name": "Can you train our entire teaching team?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Workshops can be customized for teachers, coordinators, counsellors, learning-support staff, school leadership, or parents."
      }
    },
    {
      "@type": "Question",
      "name": "Do you provide online school consultation?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Online consultation, staff training, report discussion, support planning, and case conferences can be arranged for schools in different cities and countries."
      }
    },
    {
      "@type": "Question",
      "name": "Can you help us develop Individualized Education Plans?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Guidance can be provided for developing practical goals, accommodations, support strategies, and progress-monitoring procedures."
      }
    }
  ]
};
---

<BaseLayout title={title} description={description}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <div class="container mx-auto px-4 sm:px-6 lg:px-8 py-8 max-w-7xl">
    <Breadcrumbs paths={breadcrumbs} />

    <!-- Hero section -->
    <div class="mt-12 mb-20 grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <div class="max-w-2xl">
        <p class="text-sm font-bold text-brand-navy tracking-wider uppercase mb-3">SCHOOL PARTNERSHIPS</p>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-brand-navy mb-6 leading-tight">School Partnership & Student Support Services</h1>
        <p class="text-xl md:text-2xl text-brand-navy font-medium mb-4">Support Every Child with Greater Confidence</p>
        <p class="text-lg text-gray-700 mb-8 leading-relaxed">
          Schools do not always need another general recommendation. They need practical guidance that teachers can apply in the classroom, parents can continue at home, and support teams can monitor over time. Rabbia Psychologist Child Development Services partners with schools, preschools, and special education centres to support students experiencing developmental, behavioural, and learning difficulties.
        </p>
        <div class="flex flex-col sm:flex-row gap-4">
          <a href="#enquiry-form" class="inline-block text-center bg-brand-navy text-white px-8 py-4 rounded-[12px] font-bold hover-lift shadow-md transition-colors">Request a School Partnership Consultation</a>
          <a href="/contact" class="inline-block text-center bg-transparent border-2 border-brand-navy text-brand-navy px-8 py-4 rounded-[12px] font-bold hover-lift transition-colors">Contact Us</a>
        </div>
      </div>

      <!-- Sophisticated Visual Composition -->
      <div class="relative w-full aspect-square md:aspect-[4/3] lg:aspect-square max-w-lg mx-auto lg:mx-0 lg:ml-auto">
        <div class="absolute inset-0 bg-brand-mist rounded-[28px] transform rotate-3 scale-105 opacity-50"></div>
        <div class="absolute inset-0 bg-white rounded-[24px] shadow-sm border border-brand-border flex items-center justify-center p-8">

           <div class="w-full h-full relative flex flex-col justify-between">

              <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
                 <div class="w-32 h-32 rounded-full border border-dashed border-brand-gold opacity-30 animate-pulse"></div>
              </div>

              <div class="flex justify-between items-start w-full relative z-10">
                 <div class="bg-brand-cream border border-brand-border px-6 py-4 rounded-[16px] shadow-sm flex flex-col items-center">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-brand-navy mb-2" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" /></svg>
                    <span class="text-sm font-bold text-brand-navy tracking-wider uppercase">School</span>
                 </div>

                 <div class="bg-brand-cream border border-brand-border px-6 py-4 rounded-[16px] shadow-sm flex flex-col items-center mt-8">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-brand-navy mb-2" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" /></svg>
                    <span class="text-sm font-bold text-brand-navy tracking-wider uppercase">Family</span>
                 </div>
              </div>

              <div class="flex justify-center w-full relative z-10 my-4">
                 <div class="bg-brand-navy text-white px-8 py-5 rounded-[18px] shadow-md flex flex-col items-center transform scale-110">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-white mb-2" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" /></svg>
                    <span class="text-base font-bold tracking-wider uppercase">Student</span>
                 </div>
              </div>

              <div class="flex justify-center w-full relative z-10">
                 <div class="bg-brand-cream border border-brand-border px-6 py-4 rounded-[16px] shadow-sm flex flex-col items-center">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-brand-navy mb-2" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" /></svg>
                    <span class="text-sm font-bold text-brand-navy tracking-wider uppercase">Psychology</span>
                 </div>
              </div>

              <!-- Connecting lines (svg) -->
              <svg class="absolute inset-0 w-full h-full pointer-events-none text-brand-gold opacity-40" style="z-index: 1;">
                 <path d="M25% 30% L50% 50%" stroke="currentColor" stroke-width="2" stroke-dasharray="4 4" fill="none" />
                 <path d="M75% 40% L50% 50%" stroke="currentColor" stroke-width="2" stroke-dasharray="4 4" fill="none" />
                 <path d="M50% 80% L50% 50%" stroke="currentColor" stroke-width="2" stroke-dasharray="4 4" fill="none" />
              </svg>
           </div>
        </div>
      </div>
    </div>

    <div class="mx-auto space-y-24">

      <section class="scroll-mt-12">
        <h2 class="text-3xl font-bold text-brand-navy mb-10 text-center">How I Can Support Your School</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">

          <div class="bg-white p-8 rounded-[20px] shadow-sm border border-brand-border hover-lift flex flex-col h-full">
            <div class="w-12 h-12 bg-brand-cream rounded-full flex items-center justify-center mb-6 text-brand-gold">
               <span class="font-bold text-lg">01</span>
            </div>
            <h3 class="text-xl font-bold text-brand-navy mb-3">STUDENT DEVELOPMENT & BEHAVIOUR</h3>
            <p class="text-sm text-gray-600 mb-6 flex-grow">Professional consultation for students experiencing developmental, behavioural, or learning concerns.</p>
            <ul class="space-y-2 text-sm text-gray-700">
              <li class="flex items-start"><svg class="w-4 h-4 text-brand-green mr-2 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg> Attention and concentration</li>
              <li class="flex items-start"><svg class="w-4 h-4 text-brand-green mr-2 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg> Hyperactivity and impulsivity</li>
              <li class="flex items-start"><svg class="w-4 h-4 text-brand-green mr-2 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg> Challenging behaviour</li>
              <li class="flex items-start"><svg class="w-4 h-4 text-brand-green mr-2 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg> Emotional regulation</li>
              <li class="flex items-start"><svg class="w-4 h-4 text-brand-green mr-2 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg> Learning and developmental concerns</li>
            </ul>
          </div>

          <div class="bg-white p-8 rounded-[20px] shadow-sm border border-brand-border hover-lift flex flex-col h-full">
            <div class="w-12 h-12 bg-brand-cream rounded-full flex items-center justify-center mb-6 text-brand-gold">
               <span class="font-bold text-lg">02</span>
            </div>
            <h3 class="text-xl font-bold text-brand-navy mb-3">CLASSROOM OBSERVATION & SUPPORT</h3>
            <p class="text-sm text-gray-600 mb-6 flex-grow">Identifying triggers and developing strategies based on the child's functioning in the actual classroom environment.</p>
            <ul class="space-y-2 text-sm text-gray-700">
              <li class="flex items-start"><svg class="w-4 h-4 text-brand-green mr-2 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg> Behaviour observation</li>
              <li class="flex items-start"><svg class="w-4 h-4 text-brand-green mr-2 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg> Environmental and sensory factors</li>
              <li class="flex items-start"><svg class="w-4 h-4 text-brand-green mr-2 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg> Classroom participation</li>
              <li class="flex items-start"><svg class="w-4 h-4 text-brand-green mr-2 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg> Attention and executive-function needs</li>
              <li class="flex items-start"><svg class="w-4 h-4 text-brand-green mr-2 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg> Practical classroom strategies</li>
            </ul>
          </div>

          <div class="bg-white p-8 rounded-[20px] shadow-sm border border-brand-border hover-lift flex flex-col h-full">
            <div class="w-12 h-12 bg-brand-cream rounded-full flex items-center justify-center mb-6 text-brand-gold">
               <span class="font-bold text-lg">03</span>
            </div>
            <h3 class="text-xl font-bold text-brand-navy mb-3">INDIVIDUALIZED EDUCATION & SUPPORT PLANNING</h3>
            <p class="text-sm text-gray-600 mb-6 flex-grow">Guidance in developing actionable accommodations, goals, and support plans for students with diverse needs.</p>
            <ul class="space-y-2 text-sm text-gray-700">
              <li class="flex items-start"><svg class="w-4 h-4 text-brand-green mr-2 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg> Individualized Education Plans</li>
              <li class="flex items-start"><svg class="w-4 h-4 text-brand-green mr-2 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg> Individual Support Plans</li>
              <li class="flex items-start"><svg class="w-4 h-4 text-brand-green mr-2 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg> Behaviour Support Plans</li>
              <li class="flex items-start"><svg class="w-4 h-4 text-brand-green mr-2 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg> Classroom accommodations</li>
              <li class="flex items-start"><svg class="w-4 h-4 text-brand-green mr-2 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg> Learning and participation goals</li>
            </ul>
          </div>

          <div class="bg-white p-8 rounded-[20px] shadow-sm border border-brand-border hover-lift flex flex-col h-full">
            <div class="w-12 h-12 bg-brand-cream rounded-full flex items-center justify-center mb-6 text-brand-gold">
               <span class="font-bold text-lg">04</span>
            </div>
            <h3 class="text-xl font-bold text-brand-navy mb-3">TEACHER CONSULTATION & GUIDANCE</h3>
            <p class="text-sm text-gray-600 mb-6 flex-grow">Direct consultation for teachers to help understand behaviour and apply effective responses.</p>
            <ul class="space-y-2 text-sm text-gray-700">
              <li class="flex items-start"><svg class="w-4 h-4 text-brand-green mr-2 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg> Behaviour-management strategies</li>
              <li class="flex items-start"><svg class="w-4 h-4 text-brand-green mr-2 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg> Classroom routines</li>
              <li class="flex items-start"><svg class="w-4 h-4 text-brand-green mr-2 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg> Reinforcement strategies</li>
              <li class="flex items-start"><svg class="w-4 h-4 text-brand-green mr-2 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg> Communication approaches</li>
              <li class="flex items-start"><svg class="w-4 h-4 text-brand-green mr-2 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg> Student-specific guidance</li>
            </ul>
          </div>

          <div class="bg-white p-8 rounded-[20px] shadow-sm border border-brand-border hover-lift flex flex-col h-full">
            <div class="w-12 h-12 bg-brand-cream rounded-full flex items-center justify-center mb-6 text-brand-gold">
               <span class="font-bold text-lg">05</span>
            </div>
            <h3 class="text-xl font-bold text-brand-navy mb-3">PARENT–SCHOOL COLLABORATION</h3>
            <p class="text-sm text-gray-600 mb-6 flex-grow">Structuring communication between the school and parents to ensure consistent support strategies across settings.</p>
            <ul class="space-y-2 text-sm text-gray-700">
              <li class="flex items-start"><svg class="w-4 h-4 text-brand-green mr-2 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg> Parent consultation</li>
              <li class="flex items-start"><svg class="w-4 h-4 text-brand-green mr-2 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg> Home–school consistency</li>
              <li class="flex items-start"><svg class="w-4 h-4 text-brand-green mr-2 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg> Behaviour support across settings</li>
              <li class="flex items-start"><svg class="w-4 h-4 text-brand-green mr-2 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg> Shared intervention goals</li>
              <li class="flex items-start"><svg class="w-4 h-4 text-brand-green mr-2 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg> Progress communication</li>
            </ul>
          </div>

          <div class="bg-white p-8 rounded-[20px] shadow-sm border border-brand-border hover-lift flex flex-col h-full">
            <div class="w-12 h-12 bg-brand-cream rounded-full flex items-center justify-center mb-6 text-brand-gold">
               <span class="font-bold text-lg">06</span>
            </div>
            <h3 class="text-xl font-bold text-brand-navy mb-3">STAFF TRAINING & WORKSHOPS</h3>
            <p class="text-sm text-gray-600 mb-6 flex-grow">Customized workshops designed for teachers, coordinators, and inclusion support teams.</p>
            <ul class="space-y-2 text-sm text-gray-700">
              <li class="flex items-start"><svg class="w-4 h-4 text-brand-green mr-2 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg> Child development</li>
