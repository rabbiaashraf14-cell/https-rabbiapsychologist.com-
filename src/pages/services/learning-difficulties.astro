---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/global/Breadcrumbs.astro';

const title = "Learning Difficulties & Academic Support Guidance | Rabbia Psychologist";
const description = "Evidence-based parent guidance for children struggling academically, reading and writing challenges, executive dysfunction, and IEP support.";
const canonicalURL = "https://www.rabbiapsychologist.com/services/learning-difficulties/";

const breadcrumbs = [
  { name: 'Services', href: '/services/' },
  { name: 'Learning Difficulties', href: '/services/learning-difficulties/' }
];

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Learning Difficulties and Academic Support Guidance",
  "provider": {
    "@type": "Organization",
    "name": "Rabbia Psychologist Child Development Services"
  },
  "description": "Evidence-based guidance for parents of children struggling with reading, writing, working memory, attention, and classroom learning.",
  "areaServed": "International",
  "serviceType": "Parent Guidance"
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is the difference between ADHD and a learning difficulty?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "ADHD primarily affects executive function skills such as sustained attention, impulse inhibition, and working memory across settings. Specific learning difficulties (like dyslexia or dyscalculia) specifically affect the processing of language, reading fluency, or mathematical reasoning."
      }
    },
    {
      "@type": "Question",
      "name": "How can parent guidance help my child who is falling behind in school?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "We analyze your child's learning profile, unpack homework resistance, identify cognitive fatigue and dopamine depletion, and build customized visual routines and classroom accommodations to advocate for with teachers."
      }
    },
    {
      "@type": "Question",
      "name": "Can you advise on school accommodations and IEPs?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. We help parents draft concrete, realistic classroom accommodation requests including extra time, chunked assignments, multisensory instructions, and reduced homework volume."
      }
    }
  ]
};
---

<BaseLayout title={title} description={description} canonical={canonicalURL}>
  <div class="bg-gray-50 border-b border-gray-200">
    <div class="container mx-auto px-4 py-4">
      <Breadcrumbs items={breadcrumbs} />
    </div>
  </div>

  <section class="py-16 md:py-24 bg-white">
    <div class="container mx-auto px-4 max-w-4xl">
      <div class="text-center mb-12">
        <span class="inline-block px-3 py-1 bg-brand-cream text-brand-navy rounded-full text-xs font-bold uppercase tracking-wider mb-4 border border-brand-gold/30">
          Academic Support &amp; Executive Function
        </span>
        <h1 class="text-3xl md:text-5xl font-bold text-brand-navy mb-6 leading-tight">
          Learning Difficulties &amp; Academic Guidance
        </h1>
        <p class="text-lg md:text-xl text-gray-700 leading-relaxed max-w-3xl mx-auto">
          Practical strategies and neurodevelopmental insight for children who are bright, capable, and hardworking, but experiencing distressing roadblocks with reading, homework, writing, or classroom attention.
        </p>
      </div>

      <div class="bg-brand-cream/40 border border-brand-gold/40 rounded-2xl p-6 md:p-8 mb-12">
        <h2 class="text-2xl font-bold text-brand-navy mb-4">Common Learning Roadblocks We Address</h2>
        <ul class="space-y-3 text-gray-700">
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 text-brand-trust shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
            <span><strong>Nightly Homework Battles:</strong> Hours spent in frustration over tasks that should take 15 minutes due to executive fatigue or cognitive bottlenecks.</span>
          </li>
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 text-brand-trust shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
            <span><strong>Discrepancy in Ability vs Output:</strong> High verbal intelligence and quick comprehension orally, but slow, labored writing or spelling regression.</span>
          </li>
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 text-brand-trust shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
            <span><strong>Working Memory Overload:</strong> Forgetting multi-step instructions halfway through, missing assignments, or losing test points on careless oversight.</span>
          </li>
        </ul>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-16">
        <div class="border border-gray-200 rounded-2xl p-6 shadow-xs">
          <h3 class="text-xl font-bold text-brand-navy mb-4">What Our Sessions Provide</h3>
          <ul class="space-y-2.5 text-sm text-gray-700">
            <li>✓ Detailed review of report cards, teacher feedback, and past testing</li>
            <li>✓ Identification of underlying cognitive or attentional bottlenecks</li>
            <li>✓ Tailored homework de-escalation routines and dopamine scaffolds</li>
            <li>✓ concrete multisensory learning methods for home study</li>
            <li>✓ Teacher collaboration strategies and IEP accommodation blueprints</li>
          </ul>
        </div>

        <div class="border border-gray-200 rounded-2xl p-6 shadow-xs bg-gray-50">
          <h3 class="text-xl font-bold text-brand-navy mb-4">Related Support Services</h3>
          <p class="text-sm text-gray-600 mb-4 leading-relaxed">
            Many learning struggles intersect with attention or neurodevelopmental profiles:
          </p>
          <ul class="space-y-2 text-sm font-semibold text-brand-navy">
            <li><a href="/services/school-consultation/" class="hover:underline text-brand-trust">→ School Consultation &amp; IEP Guidance</a></li>
            <li><a href="/services/adhd-support/" class="hover:underline text-brand-trust">→ ADHD Executive Function Support</a></li>
            <li><a href="/report-review/" class="hover:underline text-brand-trust">→ Psychological Report &amp; Assessment Review</a></li>
          </ul>
        </div>
      </div>

      <!-- FAQ Accordion -->
      <div class="mb-16">
        <h2 class="text-2xl font-bold text-brand-navy mb-6 text-center">Frequently Asked Questions</h2>
        <div class="space-y-4">
          {faqSchema.mainEntity.map(faq => (
            <div class="border border-gray-200 rounded-xl p-5 bg-white">
              <h3 class="font-bold text-brand-navy text-lg mb-2">{faq.name}</h3>
              <p class="text-gray-600 text-sm leading-relaxed">{faq.acceptedAnswer.text}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- Booking CTA -->
      <div class="bg-brand-navy text-white rounded-3xl p-8 md:p-12 text-center">
        <h2 class="text-2xl md:text-3xl font-bold mb-4">Ready to End the Homework Tears?</h2>
        <p class="text-gray-200 max-w-xl mx-auto mb-8 text-sm md:text-base leading-relaxed">
          Book an online parent consultation to understand your child's unique cognitive profile and establish strategies that bring peace back to your home.
        </p>
        <div class="flex flex-col sm:flex-row justify-center items-center gap-4">
          <a href="/book/" class="w-full sm:w-auto px-8 py-3.5 bg-brand-gold text-brand-navy rounded-xl font-bold hover:bg-yellow-400 transition-all shadow-md">
            Schedule Parent Consultation
          </a>
          <a href="https://wa.me/923364114002?text=Hello%20Rabbia,%20I%20would%20like%20to%20discuss%20learning%20support%20for%20my%20child." target="_blank" rel="noopener noreferrer" class="w-full sm:w-auto px-8 py-3.5 bg-white/10 text-white border border-white/20 rounded-xl font-bold hover:bg-white/20 transition-all">
            Inquire on WhatsApp
          </a>
        </div>
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</BaseLayout>
