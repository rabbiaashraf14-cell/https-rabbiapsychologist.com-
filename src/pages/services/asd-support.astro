---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/global/Breadcrumbs.astro';
import PriceDisplay from '../../components/global/PriceDisplay.astro';

const title = "Autism Parent Guidance & Developmental Support Planning | Rabbia Psychologist";
const description = "Online parent guidance for autism, communication strategies, and behavioral support planning. Help your child's development at home and school.";
const canonicalURL = "https://www.rabbiapsychologist.com/services/asd-support/";

const breadcrumbs = [
  { name: 'Services', href: '/services' },
  { name: 'Autism Support', href: '/services/asd-support' }
];

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Autism Parent Guidance and Developmental Support Planning",
  "provider": {
    "@type": "Organization",
    "name": "Rabbia Psychologist Child Development Services"
  },
  "description": "Online parent guidance for autism, communication strategies, and behavioral support planning.",
  "areaServed": "International",
  "serviceType": "Parent Guidance",
  "offers": {
    "@type": "Offer",
    "priceCurrency": "USD",
    "price": "95"
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Can autism be diagnosed online?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Our services provide parent guidance and developmental consultation, not formal online medical diagnosis. A formal medical or diagnostic evaluation for autism should be done locally where legally permitted, which we can guide you towards."
      }
    },
    {
      "@type": "Question",
      "name": "Is speech delay the same as autism?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. Speech delay is common but can happen for many reasons. In autism, delays are often in social communication—such as eye contact, joint attention, or using gestures—not just spoken words."
      }
    },
    {
      "@type": "Question",
      "name": "What should parents do after an autism diagnosis?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "After a diagnosis, the focus shifts to understanding your child's unique profile. This includes adapting the environment to support their sensory needs, building communication through play, establishing predictable routines, and planning school supports."
      }
    },
    {
      "@type": "Question",
      "name": "Can autism look different in girls?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Girls often 'mask' or camouflage their traits, mimicking peers in social settings. Their special interests might also be more socially acceptable (like animals or books), making their autism less obvious to teachers and even parents."
      }
    },
    {
      "@type": "Question",
      "name": "Can parent guidance help while waiting for assessment?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Parent guidance is highly effective while waiting for an assessment. You can begin implementing visual supports, sensory breaks, and communication strategies immediately to ease daily routines."
      }
    }
  ]
};
---

<BaseLayout canonicalURL={canonicalURL} title={title} description={description}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <div class="container mx-auto px-4 sm:px-6 lg:px-8 py-8 max-w-4xl">
    <Breadcrumbs paths={breadcrumbs} />

    <!-- 1. Hero section -->
    <div class="mt-8 mb-12 text-center">
      <h1 class="text-4xl md:text-5xl font-bold text-brand-navy mb-4">Autism Parent Guidance and Developmental Support Planning</h1>
      <p class="text-xl text-gray-700 mb-4">Parent guidance, communication strategies, and behavioral support planning for families navigating ASD.</p>
      <div class="flex justify-center mb-6">
        <PriceDisplay serviceKey="asdParentGuidance" />
      </div>
      <a href="/book/" class="inline-block bg-brand-navy text-white px-8 py-4 rounded-lg font-bold hover:bg-blue-900 transition-colors shadow-md">Book Consultation</a>
    </div>

    <div class="prose prose-lg max-w-none text-gray-700 space-y-12">

      <!-- Parent problem statement -->
      <section>
        <p class="lead text-xl">Autism may affect social communication, play, flexibility, sensory processing, emotional regulation, routines, and behaviour. Some children show early signs clearly, while others may be missed because they speak well, perform academically, or mask difficulties in structured settings.</p>
      </section>

      <!-- 2. This is right for you if -->
      <section>
        <h2 class="text-2xl font-bold text-brand-navy border-b pb-2">This service is right for you if:</h2>
        <ul>
          <li>You recently received an autism diagnosis for your child and feel overwhelmed.</li>
          <li>You are seeing signs of developmental delay and want to know how to support them now.</li>
          <li>You need help understanding your child's sensory needs or behavior.</li>
          <li>You are waiting for an assessment and need practical guidance for home and school.</li>
        </ul>
      </section>

      <!-- 3. Common signs parents ask about -->
      <section>
        <h2 class="text-2xl font-bold text-brand-navy border-b pb-2">Parents often ask:</h2>
        <ul>
          <li>Is speech delay always autism?</li>
          <li>Why does my child avoid eye contact?</li>
          <li>Why does my child repeat words or phrases?</li>
          <li>Why does my child line up toys or play the same way?</li>
          <li>Why does my child panic when routines change?</li>
          <li>Why does my child cover ears or avoid textures?</li>
          <li>Can autism signs look different in girls?</li>
          <li>What should we do after an autism diagnosis?</li>
        </ul>
      </section>

      <!-- 4. How this service helps (What we do) -->
      <section>
        <h2 class="text-2xl font-bold text-brand-navy border-b pb-2">How this service helps (What happens in the session):</h2>
        <ul>
          <li>Parent concern mapping</li>
          <li>Developmental history review</li>
          <li>Communication and play pattern discussion</li>
          <li>Sensory and routine concerns</li>
          <li>Behaviour triggers</li>
          <li>Home support strategies</li>
          <li>School support planning</li>
          <li>Report review if family already has assessment documents</li>
          <li>Referral guidance for formal assessment where needed</li>
        </ul>
      </section>

      <!-- 5. What you leave with -->
      <section>
        <h2 class="text-2xl font-bold text-brand-navy border-b pb-2">What you leave with:</h2>
        <p>You will leave with a clear, step-by-step action plan tailored to your child's profile. This includes practical strategies for building communication, supporting sensory needs, managing transitions, and advocating for your child at school.</p>
      </section>

      <!-- 6. What this service does not include / Safety Boundary -->
      <section class="bg-brand-cream p-6 rounded-xl border border-brand-sky">
        <h2 class="text-2xl font-bold text-brand-navy border-b pb-2 mb-4">What this service does not include</h2>
        <p><strong>Safety Boundary:</strong> Online sessions can support parents with understanding concerns and planning next steps, but they do not replace formal local diagnostic assessment where required. We do not provide online medical diagnosis or prescribe medication.</p>
      </section>

      <!-- Parents Also Ask Block -->
      <section class="bg-gray-50 p-6 rounded-xl border border-gray-200">
        <h3 class="text-xl font-bold text-brand-navy mb-4">Parents Also Ask</h3>
        <div class="space-y-4">
          <div>
            <h4 class="font-bold text-brand-navy">Is this normal behaviour or something more?</h4>
            <p class="text-sm">If you notice differences in your child's communication, social interaction, or play, it's worth exploring. Read more about <a href="/blog/autism-early-signs/" class="text-brand-trust hover:underline">early autism signs</a>.</p>
          </div>
          <div>
            <h4 class="font-bold text-brand-navy">When should I seek help?</h4>
            <p class="text-sm">Early support is always beneficial. If you have concerns about your child's development, seeking parent guidance can provide you with practical tools to help them thrive.</p>
          </div>
          <div>
            <h4 class="font-bold text-brand-navy">Do I need an assessment?</h4>
            <p class="text-sm">A formal assessment can provide clarity and open doors to targeted support. However, parent guidance can start immediately to support your child at home.</p>
          </div>
          <div>
            <h4 class="font-bold text-brand-navy">Can online guidance help?</h4>
            <p class="text-sm">Yes, equipping you, the parent, with strategies to use in your child's daily environment is one of the most effective ways to support their development.</p>
          </div>
        </div>
      </section>

      <!-- 7. Related resources & internal links -->
      <section>
        <h3 class="text-xl font-bold text-brand-navy mb-4">Related Services & Resources</h3>
        <ul class="grid grid-cols-1 md:grid-cols-2 gap-2">
          <li><a href="/services/behaviour-planning/" class="text-brand-trust font-bold hover:underline">Behaviour Planning</a></li>
          <li><a href="/services/school-consultation/" class="text-brand-trust font-bold hover:underline">School Consultation</a></li>
          <li><a href="/report-review/" class="text-brand-trust font-bold hover:underline">Report Review</a></li>
          <li><a href="/resources/" class="text-brand-trust font-bold hover:underline">Resource Center</a></li>
          <li><a href="/faqs/" class="text-brand-trust font-bold hover:underline">Frequently Asked Questions</a></li>
        </ul>
      </section>

      <!-- Evidence-Based Foundation -->
      <section class="bg-blue-50/60 border border-blue-100 rounded-xl p-6 my-8">
        <div class="flex items-center gap-2 mb-3">
          <span class="text-xs font-bold text-brand-navy uppercase tracking-wider bg-white px-2.5 py-1 rounded border border-blue-200">Clinical Research & Evidence</span>
        </div>
        <h3 class="text-xl font-bold text-brand-navy mb-2">Our Clinical Approach is Grounded in Scientific Literature</h3>
        <p class="text-sm text-gray-700 leading-relaxed mb-4">
          Families frequently hear about various treatments online. Our guidance is strictly anchored in gold-standard peer-reviewed research:
        </p>
        <ul class="space-y-2 text-xs md:text-sm text-gray-700 mb-4 list-disc pl-5">
          <li><strong>Medication in Autism:</strong> FDA-approved medications (Risperidone, Aripiprazole) target severe co-occurring irritability and aggression, not the core communication traits of autism.</li>
          <li><strong>Stem Cell Therapy Realities:</strong> The Duke University double-blind Phase II RCT (Dawson et al., 2020) and international meta-analyses confirm that cord blood stem cells have not demonstrated significant efficacy over placebo.</li>
          <li><strong>Modern NDBIs & ABA:</strong> We advocate for naturalistic, assent-based developmental interventions (such as ESDM) that prioritize communication, emotional regulation, and joyful connection over rigid compliance.</li>
        </ul>
        <a href="/knowledge-hub/" class="inline-flex items-center gap-1.5 text-xs font-bold text-brand-navy hover:text-blue-700 underline">
          <span>Read the full research papers & clinical trials in our Knowledge Hub</span>
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
        </a>
      </section>

      <!-- Related blog articles -->
      <section>
        <h3 class="text-xl font-bold text-brand-navy mb-4">Related Articles & Research</h3>
        <ul class="list-disc pl-5">
          <li><a href="/knowledge-hub/" class="text-brand-trust font-bold hover:underline">Autism Scientific Research & Clinical Trials (Knowledge Hub)</a></li>
          <li><a href="/blog/autism-early-signs/" class="text-brand-trust hover:underline">Autism Early Signs</a></li>
          <li><a href="/blog/speech-delay-vs-autism/" class="text-brand-trust hover:underline">Speech Delay vs Autism</a></li>
          <li><a href="/blog/parent-guidance-after-an-autism-diagnosis/" class="text-brand-trust hover:underline">Parent Guidance After an Autism Diagnosis</a></li>
          <li><a href="/blog/sensory-processing-difficulties/" class="text-brand-trust hover:underline">Sensory Processing Difficulties</a></li>
        </ul>
      </section>

      <!-- 8. FAQ section -->
      <section>
        <h2 class="text-2xl font-bold text-brand-navy border-b pb-4 mb-6">Frequently Asked Questions</h2>
        <div class="space-y-4">
          <div class="border border-gray-200 rounded-lg p-4">
            <h4 class="font-bold text-brand-navy mb-2">Can autism be diagnosed online?</h4>
            <p class="text-sm">Our services provide parent guidance and developmental consultation, not formal online medical diagnosis. A formal medical or diagnostic evaluation for autism should be done locally where legally permitted, which we can guide you towards.</p>
          </div>
          <div class="border border-gray-200 rounded-lg p-4">
            <h4 class="font-bold text-brand-navy mb-2">Is speech delay the same as autism?</h4>
            <p class="text-sm">No. Speech delay is common but can happen for many reasons. In autism, delays are often in social communication—such as eye contact, joint attention, or using gestures—not just spoken words.</p>
          </div>
          <div class="border border-gray-200 rounded-lg p-4">
            <h4 class="font-bold text-brand-navy mb-2">What should parents do after an autism diagnosis?</h4>
            <p class="text-sm">After a diagnosis, the focus shifts to understanding your child's unique profile. This includes adapting the environment to support their sensory needs, building communication through play, establishing predictable routines, and planning school supports.</p>
          </div>
          <div class="border border-gray-200 rounded-lg p-4">
            <h4 class="font-bold text-brand-navy mb-2">Can autism look different in girls?</h4>
            <p class="text-sm">Yes. Girls often 'mask' or camouflage their traits, mimicking peers in social settings. Their special interests might also be more socially acceptable (like animals or books), making their autism less obvious to teachers and even parents.</p>
          </div>
          <div class="border border-gray-200 rounded-lg p-4">
            <h4 class="font-bold text-brand-navy mb-2">Can parent guidance help while waiting for assessment?</h4>
            <p class="text-sm">Yes. Parent guidance is highly effective while waiting for an assessment. You can begin implementing visual supports, sensory breaks, and communication strategies immediately to ease daily routines.</p>
          </div>
        </div>
      </section>

      <!-- 9. CTA block -->
      <div class="bg-gradient-to-br from-brand-cream to-white p-8 md:p-10 rounded-2xl border border-brand-gold mt-12 text-center shadow-sm">
        <span class="inline-block bg-purple-100 text-purple-900 text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider mb-3">
          Available Worldwide via Secure Online Telehealth
        </span>
        <h3 class="text-2xl md:text-3xl font-extrabold text-brand-navy mb-3">Ready for Clarity and a Supportive Autism Plan?</h3>
        <p class="text-sm md:text-base text-gray-700 max-w-xl mx-auto mb-6">
          Schedule your 50-minute parent guidance consultation or download our clinical observation guide to understand your child's social-emotional and sensory needs.
        </p>
        <div class="flex flex-col sm:flex-row justify-center items-center gap-3.5 max-w-2xl mx-auto">
          <a href="/book/?service=Autism%20Support" class="w-full sm:w-auto bg-brand-navy text-white px-7 py-3.5 rounded-xl font-bold hover:bg-blue-900 transition-colors shadow-sm text-center">
            Book Autism Consultation
          </a>
          <a href="https://wa.me/923364114002?text=Hi%20Rabbia,%20I%20would%20like%20to%20enquire%20about%20an%20online%20Autism%20parent%20consultation." target="_blank" rel="noopener noreferrer" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-[#25D366] text-white px-6 py-3.5 rounded-xl font-bold hover:bg-[#1EBE5D] transition-colors shadow-2xs text-center">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg>
            <span>Ask on WhatsApp</span>
          </a>
          <a href="/downloads/autism-observation-guide.pdf" download class="w-full sm:w-auto inline-flex items-center justify-center gap-1.5 bg-white text-brand-navy border border-gray-300 px-5 py-3.5 rounded-xl font-bold hover:bg-gray-50 transition-colors shadow-2xs text-center text-xs">
            <svg class="w-4 h-4 text-brand-navy" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
            <span>Free Autism Guide (PDF)</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
