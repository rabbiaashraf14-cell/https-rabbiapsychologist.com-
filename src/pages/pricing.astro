---
import BaseLayout from '../layouts/BaseLayout.astro';
import StickyMobileBookingCTA from '../components/global/StickyMobileBookingCTA.astro';
import PriceDisplay from '../components/global/PriceDisplay.astro';
import CountdownSection from '../components/global/CountdownSection.astro';
import { isPromotionActive } from '../utils/pricing';

const title = "Pricing & Fees | Rabbia Psychologist";
const description = "Transparent pricing for online parent consultation, ADHD/ASD support, behavior planning, and report reviews.";
---

<BaseLayout title={title} description={description}>
  <div class="container mx-auto px-4 py-16 max-w-5xl">
    <div class="text-center mb-16">
      <h1 class="text-4xl md:text-5xl font-bold text-brand-navy mb-6 flex flex-col items-center">
        <span>Pricing</span>
        <span class="text-sm font-medium text-gray-500 mt-4 tracking-widest uppercase flex flex-col items-center gap-2 price-pakistan">
          Pakistan Resident Pricing
          <span class="text-xs font-normal normal-case text-gray-500 mt-1">Local rates are available for clients currently residing in Pakistan.</span>
        </span>
        <span class="text-sm font-medium text-gray-500 mt-4 tracking-widest uppercase flex flex-col items-center gap-2 price-international">
          International Client Pricing &middot; USD
          <span class="text-xs font-normal normal-case text-gray-500 mt-1">Rates apply to clients currently residing outside Pakistan.</span>
        </span>
      </h1>
      <p class="text-xl text-gray-700 max-w-3xl mx-auto mt-4">
        Clear and transparent fees for parent guidance and child development support.
      </p>
      <p class="text-sm text-gray-500 mt-2">
        Currently residing in a different country? Let us know when booking.
      </p>
    </div>

    <CountdownSection />

    <!-- Core Services Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mb-16">

      <!-- Card A -->
      <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-8 flex flex-col h-full hover:shadow-md transition-shadow">
        <h3 class="text-2xl font-bold text-brand-navy mb-2">Online Parent Guidance Consultation</h3>
        <PriceDisplay serviceKey="parentGuidance" />
        <p class="text-sm text-gray-500 mb-4">Flexible session lengths</p>
        <p class="text-sm text-gray-700 mb-4 h-20 overflow-hidden"><strong>Best for:</strong> general developmental concerns, parenting stress, and initial guidance without a formal diagnosis.</p>
        <ul class="list-disc pl-5 text-gray-600 text-sm mb-8 space-y-1 flex-grow">
          <li>developmental review</li>
          <li>initial strategies</li>
        </ul>
        <a href="/book?service=General%20Child%20Development%20Guidance" class="w-full text-center bg-brand-navy text-white px-4 py-2.5 rounded-xl font-bold hover:bg-blue-900 transition-colors mt-auto">{isPromotionActive() ? 'Book Now – Save 35%' : 'Book Consultation'}</a>
      </div>

      <!-- Card B -->
      <div class="bg-white rounded-xl shadow-sm border border-brand-navy p-8 flex flex-col h-full hover:shadow-md transition-shadow relative">
        <div class="absolute top-0 right-1/2 transform translate-x-1/2 -translate-y-1/2 bg-brand-navy text-white px-3 py-1 rounded-full text-xs font-bold tracking-wider uppercase whitespace-nowrap">Most Popular</div>
        <h3 class="text-2xl font-bold text-brand-navy mb-2">ADHD Support Consultation</h3>
        <PriceDisplay serviceKey="adhdSupport" />
        <p class="text-sm text-gray-500 mb-4">Flexible session lengths</p>
        <p class="text-sm text-gray-700 mb-4 h-20 overflow-hidden"><strong>Best for:</strong> home routines, executive function, and managing attention/hyperactivity.</p>
        <ul class="list-disc pl-5 text-gray-600 text-sm mb-8 space-y-1 flex-grow">
          <li>routine planning</li>
          <li>executive function support</li>
        </ul>
        <a href="/book?service=ADHD%20Support" class="w-full text-center bg-brand-navy text-white px-4 py-2.5 rounded-xl font-bold hover:bg-blue-900 transition-colors mt-auto">{isPromotionActive() ? 'Book Now – Save 35%' : 'Book Consultation'}</a>
      </div>

      <!-- Card C -->
      <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-8 flex flex-col h-full hover:shadow-md transition-shadow">
        <h3 class="text-2xl font-bold text-brand-navy mb-2">ASD Parent Guidance Consultation</h3>
        <PriceDisplay serviceKey="asdParentGuidance" />
        <p class="text-sm text-gray-500 mb-4">Flexible session lengths</p>
        <p class="text-sm text-gray-700 mb-4 h-20 overflow-hidden"><strong>Best for:</strong> communication strategies, sensory needs, and autism parent training.</p>
        <ul class="list-disc pl-5 text-gray-600 text-sm mb-8 space-y-1 flex-grow">
          <li>sensory accommodation</li>
          <li>behavior support</li>
        </ul>
        <a href="/book?service=Autism%20Support" class="w-full text-center bg-brand-navy text-white px-4 py-2.5 rounded-xl font-bold hover:bg-blue-900 transition-colors mt-auto">{isPromotionActive() ? 'Book Now – Save 35%' : 'Book Consultation'}</a>
      </div>

      <!-- Card D -->
      <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-8 flex flex-col h-full hover:shadow-md transition-shadow">
        <h3 class="text-2xl font-bold text-brand-navy mb-2">Behaviour Planning Session</h3>
        <PriceDisplay serviceKey="behaviourPlanning" />
        <p class="text-sm text-gray-500 mb-4">Flexible session lengths</p>
        <p class="text-sm text-gray-700 mb-4 h-20 overflow-hidden"><strong>Best for:</strong> meltdowns, tantrums, aggression, and difficult transitions.</p>
        <ul class="list-disc pl-5 text-gray-600 text-sm mb-8 space-y-1 flex-grow">
          <li>de-escalation strategies</li>
          <li>proactive routine building</li>
        </ul>
        <a href="/book?service=Behaviour%20Planning" class="w-full text-center bg-brand-navy text-white px-4 py-2.5 rounded-xl font-bold hover:bg-blue-900 transition-colors mt-auto">{isPromotionActive() ? 'Book Now – Save 35%' : 'Book Consultation'}</a>
      </div>

      <!-- Card E -->
      <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-8 flex flex-col h-full hover:shadow-md transition-shadow">
        <h3 class="text-2xl font-bold text-brand-navy mb-2">Report Review & Parent Explanation</h3>
        <PriceDisplay serviceKey="reportReview" />
        <p class="text-sm text-gray-500 mb-4">Flexible session lengths</p>
        <p class="text-sm text-gray-700 mb-4 h-20 overflow-hidden"><strong>Best for:</strong> parents who have a clinical/psychological report and need help translating it into action.</p>
        <ul class="list-disc pl-5 text-gray-600 text-sm mb-8 space-y-1 flex-grow">
          <li>plain English explanation</li>
          <li>next steps mapped out</li>
        </ul>
        <a href="/book?service=Psychological%20Report%20Review" class="w-full text-center bg-brand-navy text-white px-4 py-2.5 rounded-xl font-bold hover:bg-blue-900 transition-colors mt-auto">{isPromotionActive() ? 'Book Now – Save 35%' : 'Book Consultation'}</a>
      </div>

      <!-- Card F -->
      <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-8 flex flex-col h-full hover:shadow-md transition-shadow">
        <h3 class="text-2xl font-bold text-brand-navy mb-2">School / IEP Consultation</h3>
        <PriceDisplay serviceKey="schoolIEP" />
        <p class="text-sm text-gray-500 mb-4">Flexible session lengths</p>
        <p class="text-sm text-gray-700 mb-4 h-20 overflow-hidden"><strong>Best for:</strong> parent-teacher meetings, accommodation planning, and school communication.</p>
        <ul class="list-disc pl-5 text-gray-600 text-sm mb-8 space-y-1 flex-grow">
          <li>meeting preparation</li>
          <li>suggested accommodations</li>
        </ul>
        <a href="/book?service=School%20Consultation" class="w-full text-center bg-brand-navy text-white px-4 py-2.5 rounded-xl font-bold hover:bg-blue-900 transition-colors mt-auto">{isPromotionActive() ? 'Book Now – Save 35%' : 'Book Consultation'}</a>
      </div>

      <!-- Card G -->
      <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-8 flex flex-col h-full hover:shadow-md transition-shadow">
        <h3 class="text-2xl font-bold text-brand-navy mb-2">Four-Session Parent Guidance Package</h3>
        <PriceDisplay serviceKey="fourSessionPackage" />
        <p class="text-sm text-gray-500 mb-4">Includes: four 50–60 minute online sessions</p>
        <p class="text-sm text-gray-700 mb-4 h-20 overflow-hidden"><strong>Best for:</strong> families who need ongoing support for ADHD, ASD, or behaviour planning.</p>
        <ul class="list-disc pl-5 text-gray-600 text-sm mb-8 space-y-1 flex-grow">
          <li>structured progress review</li>
          <li>practical home plan adjustments</li>
        </ul>
        <a href="/book?service=Four-Session%20Package" class="w-full text-center bg-brand-navy text-white px-4 py-2.5 rounded-xl font-bold hover:bg-blue-900 transition-colors mt-auto">{isPromotionActive() ? 'Book Now – Save 35%' : 'Book Consultation'}</a>
      </div>

      <!-- Card H -->
      <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-8 flex flex-col h-full hover:shadow-md transition-shadow">
        <h3 class="text-2xl font-bold text-brand-navy mb-2">Workshop / Parent Training</h3>
        <PriceDisplay serviceKey="workshopTraining" />
        <p class="text-sm text-gray-500 mb-4">Format: group or custom workshop</p>
        <p class="text-sm text-gray-700 mb-4 h-20 overflow-hidden"><strong>Best for:</strong> schools, parent groups, or organizations.</p>
        <ul class="list-disc pl-5 text-gray-600 text-sm mb-8 space-y-1 flex-grow">
          <li>custom topics</li>
          <li>practical strategies</li>
        </ul>
        <a href="/book?service=Workshop%20Training" class="w-full text-center bg-brand-navy text-white px-4 py-2.5 rounded-xl font-bold hover:bg-blue-900 transition-colors mt-auto">{isPromotionActive() ? 'Book Now – Save 35%' : 'Book Consultation'}</a>
      </div>

      <!-- Card I -->
      <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-8 flex flex-col h-full hover:shadow-md transition-shadow">
        <h3 class="text-2xl font-bold text-brand-navy mb-2">Digital Resources &amp; Downloads</h3>
        <PriceDisplay serviceKey="digitalResources" />
        <p class="text-sm text-gray-500 mb-4">23 Downloadable Clinical PDF tools</p>
        <p class="text-sm text-gray-700 mb-4 h-20 overflow-hidden"><strong>Includes:</strong> checklists, visual planners, school meeting templates, behaviour trackers.</p>
        <ul class="list-disc pl-5 text-gray-600 text-sm mb-8 space-y-1 flex-grow">
          <li>Instant PDF access</li>
          <li>Print-ready A4 formats</li>
        </ul>
        <a href="/free-downloads" class="w-full text-center bg-white text-brand-navy border-2 border-brand-navy px-4 py-2.5 rounded-xl font-bold hover:bg-gray-50 transition-colors mt-auto">Browse Free Clinical Tools</a>
      </div>
    </div>

    <!-- International Payment Methods & Worldwide Telehealth Clarity -->
    <div class="bg-gradient-to-br from-blue-50/70 to-white rounded-3xl p-8 border border-blue-200/80 mb-16 text-left shadow-sm">
      <div class="max-w-4xl mx-auto">
        <div class="flex items-center gap-2 text-xs font-bold text-brand-trust uppercase tracking-wider mb-2">
          <svg class="w-4 h-4 text-emerald-600" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
          Global Payment Methods &amp; Currency Support
        </div>
        <h3 class="text-2xl font-bold text-brand-navy mb-3">How International Clients Pay</h3>
        <p class="text-sm text-gray-700 leading-relaxed mb-6">
          We welcome families across the United Kingdom, United States, Canada, UAE, Saudi Arabia, Qatar, Europe, Australia, and Pakistan. Advance payments are simple, secure, and available in multiple currencies:
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4 mb-6">
          <div class="bg-white p-4 rounded-xl border border-gray-200">
            <div class="font-bold text-brand-navy text-sm mb-1">💳 Wise &amp; International Cards</div>
            <p class="text-xs text-gray-600 leading-relaxed">Pay easily in USD, GBP, EUR, AED, CAD, or AUD with zero hidden conversion fees.</p>
          </div>
          <div class="bg-white p-4 rounded-xl border border-gray-200">
            <div class="font-bold text-brand-navy text-sm mb-1">🏦 Direct Bank Wire / IBAN</div>
            <p class="text-xs text-gray-600 leading-relaxed">International electronic transfer details provided upon booking confirmation.</p>
          </div>
          <div class="bg-white p-4 rounded-xl border border-gray-200 price-pakistan">
            <div class="font-bold text-brand-navy text-sm mb-1">🇵🇰 Pakistan Domestic Transfer</div>
            <p class="text-xs text-gray-600 leading-relaxed">Raast Instant ID, JazzCash, EasyPaisa, or direct online bank transfer.</p>
          </div>
          <div class="bg-white p-4 rounded-xl border border-gray-200 price-international">
            <div class="font-bold text-brand-navy text-sm mb-1">🌍 Worldwide Currency Billing</div>
            <p class="text-xs text-gray-600 leading-relaxed">Seamless electronic settlement in USD, GBP, EUR, AED, CAD, or AUD.</p>
          </div>
        </div>

        <div class="flex flex-col sm:flex-row items-center justify-between gap-4 pt-4 border-t border-blue-200/60">
          <div class="text-xs text-gray-600">
            Questions about international billing or insurance receipts? Chat directly with us.
          </div>
          <a
            href="https://wa.me/923364114002?text=Hi%20Rabbia,%20I%20have%20a%20question%20regarding%20international%20consultation%20fees%20and%20payment%20methods."
            target="_blank"
            rel="noopener noreferrer"
            class="shrink-0 inline-flex items-center gap-2 bg-[#25D366] text-white text-xs font-bold py-2.5 px-4 rounded-xl hover:bg-[#1EBE5D] transition-colors"
          >
            <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg>
            <span>Billing Assistance on WhatsApp</span>
          </a>
        </div>
      </div>
    </div>

    <div class="text-center mb-16">
      <p class="text-lg text-gray-600 italic">Assessment, screening, and payment details are confirmed at the time of booking.</p>
    </div>

    <!-- Which option should I choose? -->
    <div class="max-w-4xl mx-auto mb-16">
      <h2 class="text-3xl font-bold text-brand-navy mb-6 text-center">Which option should I choose?</h2>
      <div class="space-y-4">
        <div class="bg-white border border-gray-200 rounded-lg p-6">
          <h4 class="font-bold text-lg text-brand-navy mb-2">I am worried about my child's behaviour or development, but I don't have a diagnosis.</h4>
          <p class="text-gray-700">The <strong>Online Parent Guidance Consultation</strong> is the best starting point. We will discuss your concerns, map out a plan, and figure out if further assessment is needed.</p>
        </div>
        <div class="bg-white border border-gray-200 rounded-lg p-6">
          <h4 class="font-bold text-lg text-brand-navy mb-2">My child was recently diagnosed with ADHD or Autism and I feel overwhelmed.</h4>
          <p class="text-gray-700">Choose the <strong>ADHD Support Consultation</strong> or <strong>ASD Parent Guidance Consultation</strong> for focused, practical strategies to support your child at home.</p>
        </div>
        <div class="bg-white border border-gray-200 rounded-lg p-6">
          <h4 class="font-bold text-lg text-brand-navy mb-2">I have a 10-page report from a specialist and I don't know what it means for school.</h4>
          <p class="text-gray-700">Book the <strong>Report Review and Parent Explanation Session</strong>. We will translate the clinical jargon into actionable home and school steps.</p>
        </div>
      </div>
    </div>

    <!-- What pricing does not include -->
    <div class="max-w-4xl mx-auto mb-16">
      <h2 class="text-3xl font-bold text-brand-navy mb-6 text-center">What pricing does not include</h2>
      <div class="bg-brand-cream border border-brand-gold/30 rounded-lg p-8 text-center">
        <p class="text-gray-700 text-lg">Fees do not include emergency care, medication prescription or management, guarantee of school placement, or formal cross-border clinical diagnosis.</p>
      </div>
    </div>

    <!-- Pricing Policy FAQ -->
    <div class="max-w-4xl mx-auto mb-16">
      <details class="bg-white border border-gray-200 rounded-lg p-6 group">
        <summary class="font-bold text-lg text-brand-navy cursor-pointer list-none flex justify-between items-center">
          How is my rate determined?
          <span class="transition-transform group-open:rotate-180">
            <svg class="w-5 h-5 text-brand-navy" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
          </span>
        </summary>
        <div class="mt-4 text-gray-700 text-base">
          Rates are based on your current country of residence rather than nationality. Pakistan Resident Pricing is available to clients currently residing in Pakistan, while International Client Pricing applies to clients residing outside Pakistan.
        </div>
      </details>
    </div>

  </div>

  <StickyMobileBookingCTA />
</BaseLayout>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "OfferCatalog",
  "name": "Rabbia Psychologist Child Development Services Pricing",
  "itemListElement": [
    {
      "@type": "Offer",
      "itemOffered": {
        "@type": "Service",
        "name": "Online Parent Guidance Consultation"
      },
      "priceSpecification": {
        "@type": "PriceSpecification",
        "price": "85",
        "priceCurrency": "USD"
      }
    },
    {
      "@type": "Offer",
      "itemOffered": {
        "@type": "Service",
        "name": "ADHD Support Consultation"
      },
      "priceSpecification": {
        "@type": "PriceSpecification",
        "price": "95",
        "priceCurrency": "USD"
      }
    },
    {
      "@type": "Offer",
      "itemOffered": {
        "@type": "Service",
        "name": "ASD Parent Guidance Consultation"
      },
      "priceSpecification": {
        "@type": "PriceSpecification",
        "price": "95",
        "priceCurrency": "USD"
      }
    },
    {
      "@type": "Offer",
      "itemOffered": {
        "@type": "Service",
        "name": "Behaviour Planning Session"
      },
      "priceSpecification": {
        "@type": "PriceSpecification",
        "price": "95",
        "priceCurrency": "USD"
      }
    },
    {
      "@type": "Offer",
      "itemOffered": {
        "@type": "Service",
        "name": "Report Review and Parent Explanation Session"
      },
      "priceSpecification": {
        "@type": "PriceSpecification",
        "price": "125",
        "priceCurrency": "USD"
      }
    },
    {
      "@type": "Offer",
      "itemOffered": {
        "@type": "Service",
        "name": "School / IEP Consultation"
      },
      "priceSpecification": {
        "@type": "PriceSpecification",
        "minPrice": "140",
        "priceCurrency": "USD"
      }
    }
  ]
}
</script>

<script>
  import { getDiscountedPrice, isPromotionActive } from '../utils/pricing';

  if (isPromotionActive()) {
    try {
      const schemaScript = document.querySelector('script[type="application/ld+json"]');

      // Inject new SEO script for Limited Time Offer
      const promoScript = document.createElement('script');
      promoScript.type = 'application/ld+json';
      promoScript.textContent = JSON.stringify({
        "@context": "https://schema.org",
        "@type": "WebPage",
        "name": "July Promotion - Limited Time Offer",
        "description": "Parent Consultation Discount - 35% OFF mid-July promotion."
      });
      document.head.appendChild(promoScript);

      if (schemaScript && schemaScript.textContent) {
        const schema = JSON.parse(schemaScript.textContent);
        if (schema.itemListElement) {
          schema.itemListElement.forEach((item: any) => {
            if (item.priceSpecification) {
              if (item.priceSpecification.price) {
                item.priceSpecification.price = getDiscountedPrice(Number(item.priceSpecification.price)).toString();
              } else if (item.priceSpecification.minPrice) {
                item.priceSpecification.minPrice = getDiscountedPrice(Number(item.priceSpecification.minPrice)).toString();
              }
            }
          });
          schemaScript.textContent = JSON.stringify(schema);
        }
      }
    } catch (e) {
      console.error('Error updating pricing schema dynamically', e);
    }
  }
</script>
