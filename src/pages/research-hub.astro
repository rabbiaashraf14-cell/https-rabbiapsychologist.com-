---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/global/Breadcrumbs.astro';
import ResearchCard from '../components/ResearchCard.astro';
import { researchPapers } from '../data/researchPapers';

const title = "Research & Publications | Rabbia Psychologist Child Development Services";
const description = "Peer-reviewed scientific research, clinical trials, and evidence-based publications in child psychology, autism, ADHD, and pediatric development.";
const canonicalURL = "https://www.rabbiapsychologist.com/research-hub/";

const breadcrumbs = [
  { name: 'About', href: '/about' },
  { name: 'Research Hub', href: '/research-hub' }
];
---

<BaseLayout title={title} description={description} canonicalURL={canonicalURL}>
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 py-8 max-w-6xl">
    <Breadcrumbs paths={breadcrumbs} />
    
    <div class="mt-8 mb-10 text-center max-w-3xl mx-auto">
      <span class="text-xs font-bold text-brand-gold uppercase tracking-wider">Clinical Evidence Base</span>
      <h1 class="text-3xl md:text-5xl font-extrabold text-brand-navy mt-1 mb-4">Publications & Scientific Evidence</h1>
      <p class="text-base md:text-lg text-gray-700 leading-relaxed">
        My clinical practice is grounded in active engagement with scientific literature, gold-standard randomized clinical trials, and evidence-based interventions.
      </p>

      <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
        <a href="/knowledge-hub/" class="inline-flex items-center gap-2 bg-brand-navy text-white text-xs md:text-sm font-bold px-5 py-2.5 rounded-lg hover:bg-blue-900 transition-colors shadow-sm">
          <span>Explore Interactive Knowledge Hub (Filter & Search)</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
        </a>
      </div>
    </div>

    <!-- Curated Peer-Reviewed Highlights -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {researchPapers.map(paper => (
        <ResearchCard item={paper} />
      ))}
    </div>

    <!-- Bottom CTA -->
    <div class="mt-14 bg-blue-50/70 border border-blue-100 rounded-2xl p-8 text-center max-w-3xl mx-auto">
      <h2 class="text-xl md:text-2xl font-bold text-brand-navy mb-2">Evidence-Based Guidance for Your Family</h2>
      <p class="text-sm text-gray-700 mb-6">
        Need personalized help understanding evaluations, reports, or intervention strategies for your child?
      </p>
      <div class="flex flex-wrap items-center justify-center gap-3">
        <a href="/book/" class="bg-brand-navy text-white text-sm font-bold px-6 py-3 rounded-lg hover:bg-blue-900 transition-colors">
          Book Consultation
        </a>
        <a href="/knowledge-hub/" class="bg-white border border-gray-300 text-brand-navy text-sm font-semibold px-6 py-3 rounded-lg hover:bg-gray-50 transition-colors">
          View All Topics & FAQs
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
