---
import { Image } from 'astro:assets';
import profileImage from '../assets/rabbia-ashraf-professional-profile.webp';

import Layout from '../layouts/Layout.astro';
import Schema from '../components/Schema.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const breadcrumbs = [
  { name: 'About', href: '/about/' },
  { name: 'Credentials & Qualifications', href: '/credentials/' }
];

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Rabbia Ashraf",
  "jobTitle": "Clinical Psychologist",
  "hasCredential": [
    {
      "@type": "EducationalOccupationalCredential",
      "name": "MS in Clinical Psychology"
    },
    {
      "@type": "EducationalOccupationalCredential",
      "name": "BS (Hons) in Applied Psychology"
    },
    {
      "@type": "EducationalOccupationalCredential",
      "name": "ADOS-2 Certified Administrator (Autism Diagnostic Observation Schedule)"
    }
  ],
  "knowsAbout": [
    "Autism Spectrum Disorder",
    "Attention Deficit Hyperactivity Disorder (ADHD)",
    "Pathological Demand Avoidance (PDA)",
    "Executive Functioning",
    "Childhood Emotional Regulation",
    "Psychological Assessment Report Translation",
    "School IEP & SEN Accommodation"
  ],
  "url": "https://www.rabbiapsychologist.com/credentials/"
};
---

<Layout 
  title="Clinical Credentials & Qualifications | Rabbia Ashraf Clinical Psychologist"
  description="Examine the professional credentials, degrees, ADOS-2 certification, diagnostic test competencies, and ethical telehealth governance of Clinical Psychologist Rabbia Ashraf."
  canonicalURL="https://www.rabbiapsychologist.com/credentials/"
>
  <Schema slot="head" schema={[personSchema]} />

  <div class="container mx-auto px-4 sm:px-6 lg:px-8 py-8 max-w-5xl">
    <Breadcrumbs paths={breadcrumbs} />

    <!-- Hero Header Profile Card -->
    <div class="mt-8 mb-12 bg-white rounded-3xl p-6 sm:p-10 shadow-sm border border-gray-200">
      <div class="flex flex-col md:flex-row gap-8 items-center md:items-start">
        
        <div class="w-40 sm:w-48 shrink-0 relative">
          <div class="absolute inset-0 bg-blue-100/50 rounded-2xl blur-xl"></div>
          <Image
            src={profileImage}
            alt="Rabbia Ashraf Clinical Psychologist credentials"
            class="relative z-10 w-full rounded-2xl object-cover object-top aspect-[4/5] shadow-md border border-gray-100"
            width={240}
            height={300}
            loading="eager"
          />
        </div>

        <div class="flex-1 text-center md:text-left">
          <div class="inline-flex items-center gap-2 bg-blue-50 border border-blue-200 text-brand-navy text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider mb-3">
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
            Verified Clinical Practitioner
          </div>
          <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-brand-navy mb-3">
            Credentials &amp; Clinical Governance
          </h1>
          <p class="text-base sm:text-lg text-gray-700 leading-relaxed mb-6 font-normal">
            <strong>Rabbia Ashraf</strong> is a Consultant Clinical Psychologist specializing in child and adolescent neurodevelopment, parent guidance, and psychological assessment interpretation. Her clinical philosophy pairs rigorous diagnostic training with empathetic, practical parent collaboration.
          </p>

          <!-- Core Credential Badges -->
          <div class="flex flex-wrap gap-2 justify-center md:justify-start text-xs font-semibold">
            <span class="bg-gray-100 text-brand-navy px-3 py-1.5 rounded-xl border border-gray-200">
              🎓 MS Clinical Psychology
            </span>
            <span class="bg-gray-100 text-brand-navy px-3 py-1.5 rounded-xl border border-gray-200">
              🧬 Certified ADOS-2 Administrator
            </span>
            <span class="bg-gray-100 text-brand-navy px-3 py-1.5 rounded-xl border border-gray-200">
              🧠 7+ Years Clinical Experience
            </span>
            <span class="bg-gray-100 text-brand-navy px-3 py-1.5 rounded-xl border border-gray-200">
              🌎 International Telehealth Practice
            </span>
          </div>
        </div>

      </div>
    </div>

    <!-- 1. Formal Academic Degrees -->
    <section class="mb-12">
      <h2 class="text-2xl font-bold text-brand-navy mb-6 flex items-center gap-2.5">
        <span class="w-8 h-8 rounded-xl bg-blue-100 text-brand-navy flex items-center justify-center text-sm font-extrabold">1</span>
        Formal Academic Degrees &amp; Clinical Education
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="bg-white rounded-2xl p-6 border border-gray-200 shadow-2xs">
          <div class="text-xs font-bold text-brand-gold uppercase tracking-wider mb-1">Postgraduate Clinical Degree</div>
          <h3 class="text-xl font-bold text-brand-navy mb-2">Master of Science (MS) in Clinical Psychology</h3>
          <p class="text-xs sm:text-sm text-gray-600 leading-relaxed mb-4">
            Rigorous advanced clinical training encompassing child psychopathology, psychological testing, psychometric assessment administration, psychotherapeutic interventions, and supervised hospital internships in child psychiatry and developmental units.
          </p>
          <div class="text-[11px] text-gray-500 font-medium">
            Focus: Childhood Neurodevelopmental Disorders, Assessment Diagnostics &amp; Cognitive-Behavioral Interventions.
          </div>
        </div>

        <div class="bg-white rounded-2xl p-6 border border-gray-200 shadow-2xs">
          <div class="text-xs font-bold text-brand-gold uppercase tracking-wider mb-1">Undergraduate Degree</div>
          <h3 class="text-xl font-bold text-brand-navy mb-2">Bachelor of Science (BS Hons) in Applied Psychology</h3>
          <p class="text-xs sm:text-sm text-gray-600 leading-relaxed mb-4">
            Four-year foundational degree covering neuroanatomy, developmental milestones, learning theory, cognitive neuroscience, psychometrics, and quantitative research methodology.
          </p>
          <div class="text-[11px] text-gray-500 font-medium">
            Focus: Early Childhood Developmental Stages, Behavioral Psychology &amp; Family Systems.
          </div>
        </div>
      </div>
    </section>

    <!-- 2. Specialized Diagnostic Instruments & Test Battery Competencies -->
    <section class="mb-12">
      <h2 class="text-2xl font-bold text-brand-navy mb-4 flex items-center gap-2.5">
        <span class="w-8 h-8 rounded-xl bg-emerald-100 text-emerald-800 flex items-center justify-center text-sm font-extrabold">2</span>
        Assessment Instruments &amp; Test Battery Competencies
      </h2>
      <p class="text-sm text-gray-600 mb-6 leading-relaxed">
        Rabbia Ashraf is clinically trained in administering and interpreting the gold-standard diagnostic instruments utilized by public hospitals (NHS, Australian state health) and private pediatric practices worldwide.
      </p>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        
        <div class="bg-gray-50 rounded-2xl p-5 border border-gray-200">
          <div class="font-bold text-brand-navy text-sm mb-1">ADOS-2</div>
          <div class="text-[11px] font-semibold text-emerald-700 mb-2">Autism Diagnostic Observation Schedule</div>
          <p class="text-xs text-gray-600 leading-relaxed">
            Certified practitioner across Toddler Module and Modules 1–4. Gold standard clinical observation of social communication and repetitive behaviors.
          </p>
        </div>

        <div class="bg-gray-50 rounded-2xl p-5 border border-gray-200">
          <div class="font-bold text-brand-navy text-sm mb-1">ADI-R Informed</div>
          <div class="text-[11px] font-semibold text-emerald-700 mb-2">Autism Diagnostic Interview-Revised</div>
          <p class="text-xs text-gray-600 leading-relaxed">
            Comprehensive developmental anamnesis mapping social milestones, communication history, and sensory development from infancy.
          </p>
        </div>

        <div class="bg-gray-50 rounded-2xl p-5 border border-gray-200">
          <div class="font-bold text-brand-navy text-sm mb-1">Conners 4th Edition &amp; Vanderbilt</div>
          <div class="text-[11px] font-semibold text-emerald-700 mb-2">ADHD &amp; Executive Function Scales</div>
          <p class="text-xs text-gray-600 leading-relaxed">
            Standardized parent and teacher cross-informant rating scale analysis for inattention, hyperactivity, impulsivity, and executive dysfunction.
          </p>
        </div>

        <div class="bg-gray-50 rounded-2xl p-5 border border-gray-200">
          <div class="font-bold text-brand-navy text-sm mb-1">WISC-V &amp; WPPSI-IV</div>
          <div class="text-[11px] font-semibold text-emerald-700 mb-2">Wechsler Intelligence Scales for Children</div>
          <p class="text-xs text-gray-600 leading-relaxed">
            Cognitive profile interpretation: Discrepancy analysis between Verbal Comprehension, Visual Spatial, Fluid Reasoning, Working Memory, and Processing Speed.
          </p>
        </div>

        <div class="bg-gray-50 rounded-2xl p-5 border border-gray-200">
          <div class="font-bold text-brand-navy text-sm mb-1">VABS-3</div>
          <div class="text-[11px] font-semibold text-emerald-700 mb-2">Vineland Adaptive Behavior Scales</div>
          <p class="text-xs text-gray-600 leading-relaxed">
            Evaluation of practical everyday functioning across Communication, Daily Living Skills, Motor Skills, and Socialization domains.
          </p>
        </div>

        <div class="bg-gray-50 rounded-2xl p-5 border border-gray-200">
          <div class="font-bold text-brand-navy text-sm mb-1">BRIEF-2</div>
          <div class="text-[11px] font-semibold text-emerald-700 mb-2">Behavior Rating Inventory of Executive Function</div>
          <p class="text-xs text-gray-600 leading-relaxed">
            Assessment of real-world executive functioning: Task initiation, emotional control, working memory, cognitive flexibility, and organization.
          </p>
        </div>

      </div>
    </section>

    <!-- 3. Professional Scope & Telehealth Ethics Governance -->
    <section class="mb-12 bg-white rounded-3xl p-6 sm:p-8 border border-gray-200 shadow-2xs">
      <h2 class="text-2xl font-bold text-brand-navy mb-4 flex items-center gap-2.5">
        <span class="w-8 h-8 rounded-xl bg-amber-100 text-amber-800 flex items-center justify-center text-sm font-extrabold">3</span>
        Clinical Scope &amp; International Telehealth Governance
      </h2>
      
      <p class="text-sm text-gray-700 leading-relaxed mb-6">
        To uphold international psychological ethics (aligning with APA, BPS, and cross-border telehealth standards), our remote consultations follow explicit, transparent boundaries:
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-left">
        <div class="bg-gray-50 p-5 rounded-2xl border border-gray-100">
          <div class="font-bold text-brand-navy text-sm mb-2 flex items-center gap-2">
            <svg class="w-4 h-4 text-emerald-600" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
            What International Consultations Provide
          </div>
          <ul class="text-xs text-gray-600 space-y-2">
            <li>• Expert 1-on-1 parent guidance and coaching</li>
            <li>• Line-by-line translation of 20+ page psychological reports</li>
            <li>• Concrete home routines, visual schedules, and sensory scaffolds</li>
            <li>• School accommodation guidance &amp; teacher communication scripts</li>
            <li>• Waitlist bridge support while families await local public assessments</li>
          </ul>
        </div>

        <div class="bg-gray-50 p-5 rounded-2xl border border-gray-100">
          <div class="font-bold text-brand-navy text-sm mb-2 flex items-center gap-2">
            <svg class="w-4 h-4 text-amber-600" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/></svg>
            Ethical Boundaries &amp; Referral Triage
          </div>
          <ul class="text-xs text-gray-600 space-y-2">
            <li>• Not a replacement for local emergency medical or psychiatric crisis care</li>
            <li>• Cross-border telehealth does not provide formal statutory disability legal diagnosis in jurisdictions requiring in-person licensure</li>
            <li>• When clinical therapy or in-person evaluation is needed, we provide structured referral guidance for local Developmental Pediatricians, OTs, or SLTs</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- 4. Why the Parent-Led Model Works -->
    <section class="mb-12 bg-gradient-to-br from-blue-50/50 to-white rounded-3xl p-6 sm:p-8 border border-blue-100 text-left">
      <h2 class="text-2xl font-bold text-brand-navy mb-3">
        Why Parent-Centered Telehealth Is Most Effective
      </h2>
      <p class="text-xs sm:text-sm text-gray-700 leading-relaxed mb-4">
        Many parents ask: <em>"Why doesn't my child need to be on the call?"</em> Decades of developmental psychology research confirm that for neurodivergent children (ADHD, ASD, PDA, sensory sensitivities), forcing them to interact with a stranger on a screen produces artificial anxiety and masking.
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-2">
        <div class="bg-white p-4 rounded-xl border border-gray-100 text-xs text-gray-600">
          <strong class="text-brand-navy block mb-1">1. Parents Are the Anchors</strong>
          You spend hundreds of hours each month with your child. Empowering you with clinical tools transforms every morning and bedtime.
        </div>
        <div class="bg-white p-4 rounded-xl border border-gray-100 text-xs text-gray-600">
          <strong class="text-brand-navy block mb-1">2. Zero Child Stress</strong>
          No webcam resistance, no performance pressure, and no dysregulation before or after the appointment.
        </div>
        <div class="bg-white p-4 rounded-xl border border-gray-100 text-xs text-gray-600">
          <strong class="text-brand-navy block mb-1">3. Honest, Unfiltered Conversation</strong>
          Parents can speak candidly about marital strain, exhaustion, and behavioral challenges without fear of distressing the child.
        </div>
      </div>
    </section>

    <!-- 5. Verification & Consultation CTA -->
    <div class="bg-brand-navy text-white rounded-3xl p-8 text-center sm:text-left flex flex-col sm:flex-row items-center justify-between gap-6">
      <div>
        <h3 class="text-xl sm:text-2xl font-bold text-white mb-2">
          Verify Qualifications or Discuss Your Child's Needs
        </h3>
        <p class="text-xs sm:text-sm text-blue-100/90 max-w-xl">
          For full employment history, institutional affiliations, and clinical research, connect with Rabbia on LinkedIn or schedule an introductory parent consultation.
        </p>
      </div>

      <div class="flex flex-col sm:flex-row gap-3 shrink-0 w-full sm:w-auto">
        <a
          href="https://www.linkedin.com/in/rabbiapsychologist"
          target="_blank"
          rel="noopener noreferrer"
          class="apple-btn bg-white/10 hover:bg-white/20 text-white font-bold px-5 py-3 text-sm rounded-xl text-center border border-white/20"
        >
          View LinkedIn Profile
        </a>
        <a
          href="/book/"
          class="apple-btn bg-white text-brand-navy hover:bg-gray-100 font-bold px-6 py-3 text-sm rounded-xl text-center shadow-md"
        >
          Book Consultation
        </a>
      </div>
    </div>

  </div>
</Layout>
