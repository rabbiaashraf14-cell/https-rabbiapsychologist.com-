---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/global/Breadcrumbs.astro';
import ResearchCard from '../components/ResearchCard.astro';
import DisclaimerBanner from '../components/global/DisclaimerBanner.astro';
import { researchPapers, researchCategories } from '../data/researchPapers';

const title = "Knowledge Hub: Scientific Research Papers & Clinical Evidence | Rabbia Psychologist";
const description = "Explore the latest peer-reviewed scientific research, clinical trials, meta-analyses, and open-source AI tools covering Autism, ADHD, Stem Cell Therapy, ABA, Sensory Processing, and Speech Delays.";
const canonicalURL = "https://www.rabbiapsychologist.com/knowledge-hub/";

const breadcrumbs = [
  { name: 'Home', href: '/' },
  { name: 'Resources', href: '/resources' },
  { name: 'Knowledge Hub', href: '/knowledge-hub' }
];

const knowledgeHubSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Knowledge Hub: Scientific Research & Evidence in Pediatric Psychology",
  "description": description,
  "url": canonicalURL,
  "publisher": {
    "@type": "Organization",
    "name": "Rabbia Psychologist Child Development Services"
  }
};
---

<BaseLayout title={title} description={description} canonicalURL={canonicalURL} schema={knowledgeHubSchema}>
  <!-- Hero Section -->
  <section class="bg-gradient-to-b from-blue-50/60 to-white pt-8 pb-12 border-b border-gray-100">
    <div class="container mx-auto px-4 max-w-6xl">
      <Breadcrumbs paths={breadcrumbs} />

      <div class="mt-6 text-center max-w-3xl mx-auto">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-100/80 text-brand-navy text-xs font-bold tracking-wide uppercase mb-4">
          <svg class="w-4 h-4 text-brand-navy" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
          </svg>
          Evidence-Based Psychology & Open Science
        </div>
        <h1 class="text-3xl md:text-5xl font-extrabold text-brand-navy tracking-tight mb-4">
          Scientific Knowledge Hub & Research Library
        </h1>
        <p class="text-base md:text-lg text-gray-700 leading-relaxed">
          Navigating pediatric neurodevelopment requires evidence over speculation. Explore peer-reviewed clinical trials, meta-analyses, and open-source computational tools across Autism, ADHD, Stem Cell Therapy, Sensory Processing, and Speech Delays.
        </p>

        <!-- Stats Bar -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mt-8 pt-6 border-t border-gray-200/60 text-left">
          <div class="bg-white p-3.5 rounded-lg border border-gray-100 shadow-sm">
            <div class="text-2xl font-extrabold text-brand-navy">10+</div>
            <div class="text-xs text-gray-600">Core Clinical Fields</div>
          </div>
          <div class="bg-white p-3.5 rounded-lg border border-gray-100 shadow-sm">
            <div class="text-2xl font-extrabold text-emerald-700">RCT & Reviews</div>
            <div class="text-xs text-gray-600">Gold-Standard Trials</div>
          </div>
          <div class="bg-white p-3.5 rounded-lg border border-gray-100 shadow-sm">
            <div class="text-2xl font-extrabold text-purple-700">Open Science</div>
            <div class="text-xs text-gray-600">GitHub & Hugging Face</div>
          </div>
          <div class="bg-white p-3.5 rounded-lg border border-gray-100 shadow-sm">
            <div class="text-2xl font-extrabold text-amber-700">Parent Guides</div>
            <div class="text-xs text-gray-600">Plain-English Translations</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Filter & Search Controls -->
  <section class="py-8 bg-white border-b border-gray-100 sticky top-[80px] z-30 shadow-xs">
    <div class="container mx-auto px-4 max-w-6xl">
      <div class="flex flex-col md:flex-row gap-4 items-center justify-between">
        
        <!-- Live Search Input -->
        <div class="relative w-full md:w-80 shrink-0">
          <input
            type="text"
            id="search-input"
            placeholder="Search papers, authors, medications..."
            class="w-full pl-10 pr-4 py-2 text-sm border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-brand-navy focus:border-brand-navy shadow-inner"
            aria-label="Search research papers"
          />
          <svg class="w-4 h-4 text-gray-400 absolute left-3 top-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>

        <!-- Category Scrollable Pills -->
        <div class="flex items-center gap-1.5 overflow-x-auto w-full pb-2 md:pb-0 scrollbar-thin">
          {researchCategories.map((cat, idx) => (
            <button
              type="button"
              class={`category-tab px-3.5 py-1.5 rounded-full text-xs font-semibold whitespace-nowrap transition-all duration-150 cursor-pointer ${
                idx === 0
                  ? 'bg-brand-navy text-white shadow-xs'
                  : 'bg-gray-100 text-gray-700 hover:bg-gray-200'
              }`}
              data-category-id={cat.id}
            >
              {cat.label}
            </button>
          ))}
        </div>
      </div>

      <!-- Active Counter -->
      <div class="mt-3 flex items-center justify-between text-xs text-gray-500 font-medium">
        <span>Showing <strong id="item-count" class="text-brand-navy">{researchPapers.length}</strong> scientific resources</span>
        <button id="reset-filters" class="hidden text-brand-navy hover:underline font-semibold cursor-pointer">Reset Filters</button>
      </div>
    </div>
  </section>

  <!-- Research Cards Grid -->
  <section class="py-10 bg-gray-50/50 min-h-[600px]">
    <div class="container mx-auto px-4 max-w-6xl">
      <div id="papers-grid" class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {researchPapers.map(paper => (
          <div class="paper-card-wrapper" data-category={paper.category} data-tags={paper.tags.join(' ').toLowerCase()} data-text={`${paper.title} ${paper.authors} ${paper.journalOrPlatform} ${paper.parentTakeaway} ${paper.clinicalTakeaway}`.toLowerCase()}>
            <ResearchCard item={paper} />
          </div>
        ))}
      </div>

      <!-- No Results State -->
      <div id="no-results" class="hidden text-center py-16 bg-white rounded-xl border border-gray-200 p-8 mt-6">
        <svg class="w-12 h-12 text-gray-400 mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <h3 class="text-lg font-bold text-gray-800 mb-1">No research matches your filter</h3>
        <p class="text-sm text-gray-600 mb-4">Try clearing your search terms or selecting "All Resources" to view all available studies.</p>
        <button id="clear-search-btn" class="bg-brand-navy text-white text-xs font-bold px-4 py-2 rounded-lg hover:bg-blue-900 transition-colors">
          View All Studies
        </button>
      </div>
    </div>
  </section>

  <!-- Parent FAQ: Deciphering the Science -->
  <section class="py-16 bg-white border-t border-gray-200">
    <div class="container mx-auto px-4 max-w-4xl">
      <div class="text-center mb-12">
        <span class="text-xs font-bold text-brand-gold uppercase tracking-wider">Clinical Guidance for Families</span>
        <h2 class="text-2xl md:text-3xl font-extrabold text-brand-navy mt-1">Frequently Asked Research & Evidence Questions</h2>
        <p class="text-sm md:text-base text-gray-600 mt-2">Common scientific questions parents ask when evaluating therapies, medications, and online claims.</p>
      </div>

      <div class="space-y-4">
        <!-- FAQ 1 -->
        <details class="group bg-gray-50 p-5 rounded-xl border border-gray-200 transition-all open:bg-blue-50/40 open:border-blue-200">
          <summary class="font-bold text-brand-navy cursor-pointer list-none flex justify-between items-center text-base md:text-lg">
            <span>Are stem cell therapies or cord blood infusions proven to treat or cure autism?</span>
            <svg class="w-5 h-5 text-gray-500 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </summary>
          <div class="mt-4 text-sm text-gray-700 leading-relaxed border-t border-gray-200/60 pt-3 space-y-2">
            <p><strong>The Scientific Consensus:</strong> No. In the largest, most rigorous double-blind, placebo-controlled Phase II trial conducted by Duke University (Dawson et al., <em>Journal of Pediatrics</em>, 2020, n=180), cord blood infusions did <strong>not</strong> produce statistically significant improvements in socialization or core autism symptoms over a placebo.</p>
            <p>Major international bodies, including the International Society for Stem Cell Research (ISSCR) and the U.S. FDA, explicitly warn against unproven commercial stem cell clinics charging thousands of dollars without verified clinical trial evidence or long-term safety data.</p>
          </div>
        </details>

        <!-- FAQ 2 -->
        <details class="group bg-gray-50 p-5 rounded-xl border border-gray-200 transition-all open:bg-blue-50/40 open:border-blue-200">
          <summary class="font-bold text-brand-navy cursor-pointer list-none flex justify-between items-center text-base md:text-lg">
            <span>For ADHD, should we start with medication or behavioral therapy first?</span>
            <svg class="w-5 h-5 text-gray-500 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </summary>
          <div class="mt-4 text-sm text-gray-700 leading-relaxed border-t border-gray-200/60 pt-3 space-y-2">
            <p><strong>The Evidence:</strong> The landmark sequencing trial led by Dr. William Pelham (2016) demonstrated that starting with <strong>behavioral intervention and parent training first</strong>, followed by adding low doses of medication only if needed, resulted in superior long-term child behavior, fewer classroom rule violations, and required significantly lower medication dosages than beginning with medication first.</p>
            <p>The American Academy of Pediatrics (AAP) guidelines firmly mandate Parent Training in Behavior Management (PTBM) as the primary first-line intervention for preschool-aged children.</p>
          </div>
        </details>

        <!-- FAQ 3 -->
        <details class="group bg-gray-50 p-5 rounded-xl border border-gray-200 transition-all open:bg-blue-50/40 open:border-blue-200">
          <summary class="font-bold text-brand-navy cursor-pointer list-none flex justify-between items-center text-base md:text-lg">
            <span>What does medication actually do for autism?</span>
            <svg class="w-5 h-5 text-gray-500 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </summary>
          <div class="mt-4 text-sm text-gray-700 leading-relaxed border-t border-gray-200/60 pt-3 space-y-2">
            <p>There are no medications approved to treat the core social-communicative differences of autism. The two medications approved by the FDA (Risperidone and Aripiprazole) are indicated specifically for co-occurring <strong>severe irritability, aggressive outbursts, and self-injurious behaviors</strong>.</p>
            <p>International clinical guidelines (e.g., British Association for Psychopharmacology) advise that behavioral supports, communication tools, and environmental modifications should always be prioritized before pharmacotherapy.</p>
          </div>
        </details>

        <!-- FAQ 4 -->
        <details class="group bg-gray-50 p-5 rounded-xl border border-gray-200 transition-all open:bg-blue-50/40 open:border-blue-200">
          <summary class="font-bold text-brand-navy cursor-pointer list-none flex justify-between items-center text-base md:text-lg">
            <span>Is every speech delay in a young child a sign of autism?</span>
            <svg class="w-5 h-5 text-gray-500 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </summary>
          <div class="mt-4 text-sm text-gray-700 leading-relaxed border-t border-gray-200/60 pt-3 space-y-2">
            <p><strong>Clinical Distinction:</strong> No. Speech delay is common and can stem from Developmental Language Disorder (DLD), childhood apraxia of speech, hearing issues, or environmental factors. In pure speech delays, children typically retain strong non-verbal communication—pointing to show you things, waving, making shared eye contact, and showing joyful back-and-forth engagement.</p>
            <p>In autism, delays are characteristically in <strong>social communication</strong> (joint attention, declarative gestures, responding to name, shared enjoyment) rather than solely the mechanics of spoken words.</p>
          </div>
        </details>

        <!-- FAQ 5 -->
        <details class="group bg-gray-50 p-5 rounded-xl border border-gray-200 transition-all open:bg-blue-50/40 open:border-blue-200">
          <summary class="font-bold text-brand-navy cursor-pointer list-none flex justify-between items-center text-base md:text-lg">
            <span>Can typically developing children have sensory processing sensitivities?</span>
            <svg class="w-5 h-5 text-gray-500 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </summary>
          <div class="mt-4 text-sm text-gray-700 leading-relaxed border-t border-gray-200/60 pt-3 space-y-2">
            <p>Yes. As established in Winnie Dunn's Sensory Processing framework, sensory sensitivity exists along a continuous normal spectrum. Around 5–15% of typically developing children have noticeable sensory preferences (such as hating tags on clothing, fearing loud hand dryers, or being selective about food textures).</p>
            <p>The American Academy of Pediatrics advises that sensory differences should be managed with supportive daily accommodations rather than medicalized as an isolated disorder unless they cause severe impairment across settings.</p>
          </div>
        </details>
      </div>
    </div>
  </section>

  <!-- Consultation Banner -->
  <section class="py-14 bg-brand-navy text-white text-center">
    <div class="container mx-auto px-4 max-w-3xl">
      <h2 class="text-2xl md:text-3xl font-bold mb-4">Need Help Applying Scientific Research to Your Child's Care?</h2>
      <p class="text-gray-300 text-sm md:text-base mb-8 leading-relaxed">
        Research gives us the map, but every child is unique. Book a clinical consultation or professional report review to interpret your child's profile, cut through online noise, and design an evidence-based developmental plan.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-4">
        <a href="/book" class="bg-brand-gold text-brand-navy font-bold px-8 py-3.5 rounded-lg hover:bg-yellow-400 transition-colors shadow-md text-sm md:text-base">
          Book a Clinical Consultation
        </a>
        <a href="/report-review" class="bg-white/10 hover:bg-white/20 border border-white/30 text-white font-semibold px-6 py-3.5 rounded-lg transition-colors text-sm md:text-base">
          Request a Report Review
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const tabs = document.querySelectorAll<HTMLButtonElement>('.category-tab');
    const searchInput = document.getElementById('search-input') as HTMLInputElement | null;
    const cards = document.querySelectorAll<HTMLElement>('.paper-card-wrapper');
    const countEl = document.getElementById('item-count');
    const noResults = document.getElementById('no-results');
    const resetBtn = document.getElementById('reset-filters');
    const clearSearchBtn = document.getElementById('clear-search-btn');

    let currentCategory = 'all';
    let searchQuery = '';

    const filterCards = () => {
      let visibleCount = 0;

      cards.forEach(card => {
        const cardCat = card.getAttribute('data-category') || '';
        const cardText = card.getAttribute('data-text') || '';

        const matchesCat = currentCategory === 'all' || cardCat === currentCategory;
        const matchesSearch = !searchQuery || cardText.includes(searchQuery);

        if (matchesCat && matchesSearch) {
          card.classList.remove('hidden');
          visibleCount++;
        } else {
          card.classList.add('hidden');
        }
      });

      if (countEl) countEl.textContent = visibleCount.toString();

      if (noResults) {
        if (visibleCount === 0) {
          noResults.classList.remove('hidden');
        } else {
          noResults.classList.add('hidden');
        }
      }

      if (resetBtn) {
        if (currentCategory !== 'all' || searchQuery.length > 0) {
          resetBtn.classList.remove('hidden');
        } else {
          resetBtn.classList.add('hidden');
        }
      }
    };

    // Category Tabs Click
    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        tabs.forEach(t => {
          t.classList.remove('bg-brand-navy', 'text-white', 'shadow-xs');
          t.classList.add('bg-gray-100', 'text-gray-700');
        });

        tab.classList.remove('bg-gray-100', 'text-gray-700');
        tab.classList.add('bg-brand-navy', 'text-white', 'shadow-xs');

        currentCategory = tab.getAttribute('data-category-id') || 'all';
        filterCards();
      });
    });

    // Search Input
    searchInput?.addEventListener('input', (e) => {
      searchQuery = (e.target as HTMLInputElement).value.trim().toLowerCase();
      filterCards();
    });

    // Reset Filters
    const reset = () => {
      if (searchInput) searchInput.value = '';
      searchQuery = '';
      currentCategory = 'all';

      tabs.forEach((t, i) => {
        if (i === 0) {
          t.classList.add('bg-brand-navy', 'text-white', 'shadow-xs');
          t.classList.remove('bg-gray-100', 'text-gray-700');
        } else {
          t.classList.remove('bg-brand-navy', 'text-white', 'shadow-xs');
          t.classList.add('bg-gray-100', 'text-gray-700');
        }
      });

      filterCards();
    };

    resetBtn?.addEventListener('click', reset);
    clearSearchBtn?.addEventListener('click', reset);
  });
</script>
