        </div>

        <!-- Related Articles -->
        <div class="bg-white p-6 rounded-xl border border-gray-200 my-8 not-prose">
          <h3 class="text-xl font-bold text-brand-navy mb-4">Related Articles</h3>
          <ul class="space-y-2">
            <li><a href="/blog/how-to-support-executive-function-at-home/" class="text-brand-trust hover:underline">How to Support Executive Function at Home</a></li>
            <li><a href="/blog/understanding-adhd-and-hyperactivity-in-children/" class="text-brand-trust hover:underline">Understanding ADHD and Hyperactivity in Children</a></li>
            <li><a href="/blog/sleep-routine-and-child-behaviour/" class="text-brand-trust hover:underline">Sleep Routine and Child Behaviour</a></li>
          </ul>
        </div>


        <ArticleAuthor
          author="Rabbia Ashraf"
