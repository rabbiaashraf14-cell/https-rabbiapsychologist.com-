---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/global/Breadcrumbs.astro';
import { redditDilemmas, type RedditDilemma } from '../../data/redditDilemmas';

export function getStaticPaths() {
  return redditDilemmas.map(item => ({
    params: { slug: item.slug },
    props: { item }
  }));
}

interface Props {
  item: RedditDilemma;
}

const { item } = Astro.props;

const canonicalURL = `https://www.rabbiapsychologist.com/parent-dilemmas/${item.slug}/`;

const breadcrumbs = [
  { name: 'Home', href: '/' },
  { name: 'Parent Dilemmas', href: '/parent-dilemmas/' },
  { name: item.title, href: `/parent-dilemmas/${item.slug}/` }
];

// Rich Google QAPage Schema for capturing Discussion / Question Snippets
const qaSchema = {
  "@context": "https://schema.org",
  "@type": "QAPage",
  "mainEntity": {
    "@type": "Question",
    "name": item.title,
    "text": item.rawParentQuote,
    "answerCount": 1,
    "upvoteCount": 1400,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": `${item.theNeuroscience} Protocol for tonight: ${item.actionableProtocolTonight.map(s => `${s.step}. ${s.title}: ${s.description}`).join(' ')}`,
      "url": canonicalURL,
      "author": {
        "@type": "Person",
        "name": "Rabbia Ashraf",
        "jobTitle": "Clinical Psychologist & Certified ADOS-2 Practitioner",
        "url": "https://www.rabbiapsychologist.com/about/"
      }
    }
  }
};
---

<BaseLayout 
  canonicalURL={canonicalURL} 
  title={`${item.title} | Real Parent Dilemmas Decoded`} 
  description={`${item.title} Clinical neuroscience explanation and word-for-word scripts by Clinical Psychologist Rabbia Ashraf.`}
  schema={qaSchema}
>
  <article class="container mx-auto px-4 py-8 max-w-4xl">
    <Breadcrumbs paths={breadcrumbs} />

    <!-- Article Header -->
    <header class="mt-6 mb-10">
      <div class="flex flex-wrap items-center gap-2 mb-4">
        <span class="px-3 py-1 rounded-full bg-orange-100 text-orange-950 text-xs font-bold uppercase tracking-wider">
          {item.icpProfile}
        </span>
        <span class="px-3 py-1 rounded-full bg-blue-50 text-blue-900 border border-blue-200 text-xs font-semibold">
          {item.clinicalTheme}
        </span>
        <span class="text-xs text-gray-500 font-medium ml-auto">
          {item.readTime}
        </span>
      </div>

      <div class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-3 flex items-center gap-2">
        <span class="w-2.5 h-2.5 rounded-full bg-orange-500"></span>
        <span>Community Context: {item.redditCommunity}</span>
      </div>

      <h1 class="text-3xl sm:text-4xl md:text-5xl font-black text-brand-navy tracking-tight leading-tight mb-6">
        {item.title}
      </h1>

      <!-- Clinician Byline -->
      <div class="flex items-center gap-4 py-4 border-y border-gray-200 text-xs sm:text-sm text-gray-600">
        <div class="w-10 h-10 rounded-full bg-slate-900 text-white flex items-center justify-center font-bold text-base shrink-0 shadow-xs">
          RA
        </div>
        <div>
          <div class="font-bold text-brand-navy">Rabbia Ashraf, MSc, M.Phil</div>
          <div class="text-gray-500">Clinical Psychologist &bull; Certified ADOS-2 Practitioner &bull; Pediatric Neurodevelopment</div>
        </div>
      </div>
    </header>

    <!-- The Raw Dilemma Quote -->
    <section class="bg-amber-50/60 rounded-3xl p-6 sm:p-8 border border-amber-200/80 mb-12" aria-label="The Real Parent Dilemma">
      <div class="flex items-center gap-2 text-amber-900 text-xs font-bold uppercase tracking-wider mb-3">
        <span class="text-orange-600 font-black text-sm">&#10077;</span>
        The Real Parent Question (Unfiltered)
      </div>
      <blockquote class="text-gray-800 text-base sm:text-lg leading-relaxed italic border-l-4 border-amber-500 pl-4 mb-4">
        {item.rawParentQuote}
      </blockquote>
      <div class="text-[11px] text-gray-600">
        &bull; {item.upvotesContext}
      </div>
    </section>

    <!-- The Neuroscience Breakdown -->
    <section class="bg-white rounded-3xl p-6 sm:p-8 border border-gray-200 shadow-xs mb-12" aria-label="The Clinical Neuroscience">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-50 text-blue-900 text-xs font-bold uppercase tracking-wider mb-3">
        Brain Architecture &bull; What Is Actually Happening
      </div>
      <h2 class="text-2xl sm:text-3xl font-extrabold text-brand-navy mb-4 tracking-tight">
        The Neuroscience Behind the Battle
      </h2>
      <p class="text-gray-700 text-base sm:text-lg leading-relaxed mb-6">
        {item.theNeuroscience}
      </p>

      <div class="bg-rose-50/70 p-5 rounded-2xl border border-rose-100">
        <strong class="text-rose-900 block mb-1 font-bold text-sm">Why Traditional Parenting Advice Backfires:</strong>
        <p class="text-rose-950 text-xs sm:text-sm leading-relaxed">
          {item.whyConventionalAdviceFails}
        </p>
      </div>
    </section>

    <!-- The Actionable Protocol for Tonight -->
    <section class="bg-blue-50/60 rounded-3xl p-6 sm:p-10 border border-blue-200/80 my-12" aria-label="Action Protocol Tonight">
      <div class="max-w-3xl mb-8">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-100 text-blue-900 text-xs font-bold uppercase tracking-wider mb-3">
          Clinical Action Plan
        </div>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-brand-navy mb-3 tracking-tight">
          What to Say &amp; Do Tonight: The 3-Step Protocol
        </h2>
        <p class="text-gray-700 text-sm sm:text-base leading-relaxed">
          Forget generic lectures. Test this neurological de-escalation protocol in your home this evening:
        </p>
      </div>

      <div class="space-y-6">
        {item.actionableProtocolTonight.map(step => (
          <div class="bg-white rounded-2xl p-6 border border-blue-100 shadow-xs">
            <div class="flex items-center gap-3 mb-3">
              <span class="w-8 h-8 rounded-full bg-brand-navy text-white font-bold flex items-center justify-center text-sm shrink-0">
                {step.step}
              </span>
              <h3 class="text-lg font-bold text-brand-navy">{step.title}</h3>
            </div>
            <p class="text-xs sm:text-sm text-gray-700 mb-4 leading-relaxed">
              {step.description}
            </p>
            {step.wordForWordScript && (
              <div class="bg-emerald-50/70 p-4 rounded-xl border border-emerald-200/70 text-xs sm:text-sm text-emerald-950">
                <strong class="font-bold text-emerald-900 block mb-1">Exact Script to Use:</strong>
                <p class="italic">{step.wordForWordScript}</p>
              </div>
            )}
          </div>
        ))}
      </div>
    </section>

    <!-- What NEVER to Do Box -->
    <section class="bg-white rounded-3xl p-6 sm:p-8 border border-gray-200 shadow-xs my-12" aria-label="Mistakes to Avoid">
      <h2 class="text-xl sm:text-2xl font-bold text-brand-navy mb-4 tracking-tight flex items-center gap-2 text-rose-700">
        <span>&#9888;</span> What NEVER to Do (Why It Escalates Distress)
      </h2>
      <ul class="space-y-3 text-xs sm:text-sm text-gray-700">
        {item.whatNeverToDo.map(err => (
          <li class="flex items-start gap-2.5 bg-rose-50/40 p-3.5 rounded-xl border border-rose-100">
            <span class="text-rose-600 font-bold mt-0.5">&#10007;</span>
            <span>{err}</span>
          </li>
        ))}
      </ul>
    </section>

    <!-- Clinical Takeaway by Rabbia Ashraf -->
    <section class="bg-slate-900 text-white rounded-3xl p-8 sm:p-10 my-12 shadow-lg" aria-label="Clinician Perspective">
      <div class="flex items-center gap-2 text-brand-gold text-xs font-bold uppercase tracking-widest mb-3">
        <span>&#9733;</span> Clinician's Perspective &bull; Rabbia Ashraf
      </div>
      <h2 class="text-2xl sm:text-3xl font-black mb-4 tracking-tight">The Clinical Bottom Line</h2>
      <p class="text-gray-200 text-base sm:text-lg leading-relaxed italic border-l-4 border-brand-gold pl-4">
        "{item.clinicalTakeaway}"
      </p>
    </section>

    <!-- Related Clinical Resources -->
    <section class="bg-gray-50 rounded-2xl p-6 sm:p-8 border border-gray-200 my-12" aria-label="Related Deep Dives">
      <h3 class="text-sm font-bold text-brand-navy uppercase tracking-wider mb-4 flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-blue-700"></span>
        Related Evidence-Based Guides
      </h3>
      <div class="flex flex-wrap gap-3 text-xs">
        <a 
          href={`/blog/${item.relatedBlogSlug}/`}
          class="px-4 py-2 rounded-xl bg-white text-blue-700 font-semibold border border-gray-200 hover:border-blue-300 shadow-2xs hover:shadow-xs transition-all"
        >
          Read Clinical Blog Guide &rarr;
        </a>
        {item.relatedCompareSlug && (
          <a 
            href={`/compare/${item.relatedCompareSlug}/`}
            class="px-4 py-2 rounded-xl bg-white text-brand-navy font-semibold border border-gray-200 hover:border-blue-300 shadow-2xs hover:shadow-xs transition-all"
          >
            View Diagnostic Comparison Matrix &rarr;
          </a>
        )}
        {item.relatedAlternativeSlug && (
          <a 
            href={`/alternatives/${item.relatedAlternativeSlug}/`}
            class="px-4 py-2 rounded-xl bg-white text-emerald-800 font-semibold border border-gray-200 hover:border-emerald-300 shadow-2xs hover:shadow-xs transition-all"
          >
            Explore Clinical Alternatives &rarr;
          </a>
        )}
      </div>
    </section>

    <!-- Consultation Action Banner -->
    <footer class="bg-linear-to-r from-brand-navy via-slate-900 to-blue-900 rounded-3xl p-8 sm:p-10 text-white text-center shadow-lg my-12">
      <h2 class="text-2xl sm:text-3xl font-extrabold mb-3">Tired of Struggling Alone Late at Night?</h2>
      <p class="text-blue-100 text-sm sm:text-base max-w-2xl mx-auto mb-6 leading-relaxed">
        Turn online forum searches into an actionable clinical strategy. Schedule a 1-on-1 parent consultation with Rabbia Ashraf to unpack your child's exact profile.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a 
          href="/book/"
          class="px-6 py-3 rounded-xl bg-brand-gold text-brand-navy font-bold hover:bg-yellow-400 transition-all shadow-md text-sm"
        >
          Book 1-on-1 Clinical Session &rarr;
        </a>
        <a 
          href="https://wa.me/923364114002"
          class="px-6 py-3 rounded-xl bg-white/10 hover:bg-white/20 text-white font-semibold transition-all border border-white/20 text-sm flex items-center gap-2"
        >
          WhatsApp Direct Inquiry
        </a>
      </div>
    </footer>
  </article>
</BaseLayout>
