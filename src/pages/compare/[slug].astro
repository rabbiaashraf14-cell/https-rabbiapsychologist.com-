---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/global/Breadcrumbs.astro';
import { comparisons, type ComparisonItem } from '../../data/comparisons';

export function getStaticPaths() {
  return comparisons.map(item => ({
    params: { slug: item.slug },
    props: { item }
  }));
}

interface Props {
  item: ComparisonItem;
}

const { item } = Astro.props;

const canonicalURL = `https://www.rabbiapsychologist.com/compare/${item.slug}/`;

const breadcrumbs = [
  { name: 'Home', href: '/' },
  { name: 'Clinical Comparisons', href: '/compare/' },
  { name: item.title, href: `/compare/${item.slug}/` }
];

// Rich schema markup (MedicalWebPage + FAQPage)
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "MedicalWebPage",
      "@id": canonicalURL,
      "url": canonicalURL,
      "name": item.title,
      "description": item.metaDescription,
      "inLanguage": "en",
      "author": {
        "@type": "Person",
        "name": "Rabbia Ashraf",
        "jobTitle": "Clinical Psychologist & Certified ADOS-2 Practitioner",
        "url": "https://www.rabbiapsychologist.com/about/"
      },
      "reviewedBy": {
        "@type": "Person",
        "name": "Rabbia Ashraf",
        "jobTitle": "Clinical Psychologist"
      },
      "medicalAudience": {
        "@type": "MedicalAudience",
        "audienceType": ["Parents", "Teachers", "Pediatricians"]
      }
    },
    {
      "@type": "FAQPage",
      "@id": `${canonicalURL}#faq`,
      "mainEntity": item.faqList.map(faq => ({
        "@type": "Question",
        "name": faq.question,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": faq.answer
        }
      }))
    }
  ]
};
---

<BaseLayout 
  canonicalURL={canonicalURL} 
  title={`${item.title} | Rabbia Psychologist`} 
  description={item.metaDescription}
  schema={schema}
>
  <article class="container mx-auto px-4 py-8 max-w-5xl">
    <Breadcrumbs paths={breadcrumbs} />

    <!-- Article Header -->
    <header class="mt-6 mb-10">
      <div class="flex flex-wrap items-center gap-2 mb-4">
        <span class="px-3 py-1 rounded-full bg-blue-100/80 text-blue-800 text-xs font-bold uppercase tracking-wider">
          {item.category}
        </span>
        <span class="px-3 py-1 rounded-full bg-emerald-50 text-emerald-800 border border-emerald-200 text-xs font-semibold">
          {item.evidenceGrade}
        </span>
        <span class="text-xs text-gray-500 font-medium ml-auto">
          {item.readTime}
        </span>
      </div>

      <h1 class="text-3xl sm:text-4xl md:text-5xl font-black text-brand-navy tracking-tight leading-tight mb-6">
        {item.title}
      </h1>

      <p class="text-lg sm:text-xl text-gray-700 leading-relaxed max-w-3xl mb-6">
        {item.metaDescription}
      </p>

      <!-- Clinician Byline & Date -->
      <div class="flex items-center gap-4 py-4 border-y border-gray-200 text-xs sm:text-sm text-gray-600">
        <div class="w-10 h-10 rounded-full bg-blue-900 text-white flex items-center justify-center font-bold text-base shrink-0 shadow-xs">
          RA
        </div>
        <div>
          <div class="font-bold text-brand-navy">Rabbia Ashraf, MSc, M.Phil</div>
          <div class="text-gray-500">Clinical Psychologist &bull; Certified ADOS-2 &bull; Evidence-Based Practice</div>
        </div>
      </div>
    </header>

    <!-- Side-by-Side Subject Overview Cards -->
    <section class="grid grid-cols-1 md:grid-cols-2 gap-6 my-10" aria-label="Core Profiles Summary">
      <!-- Subject A -->
      <div class="bg-white rounded-3xl p-6 sm:p-8 border border-blue-100 shadow-xs flex flex-col">
        <div class="inline-block px-3 py-1 rounded-full bg-blue-50 text-blue-700 text-xs font-bold uppercase tracking-wide mb-3 w-fit">
          Profile A
        </div>
        <h2 class="text-2xl font-black text-brand-navy mb-1">{item.subjectA.name}</h2>
        <p class="text-xs font-bold text-blue-800 uppercase tracking-wider mb-4">{item.subjectA.subheading}</p>
        
        <div class="mb-5 bg-blue-50/50 p-4 rounded-2xl border border-blue-100/60 text-xs sm:text-sm text-gray-700 leading-relaxed">
          <strong class="text-brand-navy block mb-1">Underlying Neurology:</strong>
          {item.subjectA.underlyingNeurology}
        </div>

        <div class="mb-5">
          <h3 class="font-bold text-brand-navy text-xs uppercase tracking-wider mb-2">Core Observable Signs:</h3>
          <ul class="space-y-2 text-xs sm:text-sm text-gray-700">
            {item.subjectA.primarySymptoms.map(sign => (
              <li class="flex items-start gap-2">
                <span class="text-blue-600 font-bold mt-0.5">&bull;</span>
                <span>{sign}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="mt-auto pt-4 border-t border-gray-100 grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs">
          <div class="bg-emerald-50/70 p-3 rounded-xl border border-emerald-100 text-emerald-900">
            <strong class="block mb-1 font-bold text-emerald-800">&#10003; What Helps:</strong>
            <ul class="space-y-1 list-disc list-inside">
              {item.subjectA.whatHelps.slice(0, 2).map(h => <li>{h}</li>)}
            </ul>
          </div>
          <div class="bg-rose-50/70 p-3 rounded-xl border border-rose-100 text-rose-900">
            <strong class="block mb-1 font-bold text-rose-800">&#10007; What Harms:</strong>
            <ul class="space-y-1 list-disc list-inside">
              {item.subjectA.whatHarms.slice(0, 2).map(w => <li>{w}</li>)}
            </ul>
          </div>
        </div>
      </div>

      <!-- Subject B -->
      <div class="bg-white rounded-3xl p-6 sm:p-8 border border-amber-100 shadow-xs flex flex-col">
        <div class="inline-block px-3 py-1 rounded-full bg-amber-50 text-amber-800 text-xs font-bold uppercase tracking-wide mb-3 w-fit">
          Profile B
        </div>
        <h2 class="text-2xl font-black text-brand-navy mb-1">{item.subjectB.name}</h2>
        <p class="text-xs font-bold text-amber-800 uppercase tracking-wider mb-4">{item.subjectB.subheading}</p>
        
        <div class="mb-5 bg-amber-50/50 p-4 rounded-2xl border border-amber-100/60 text-xs sm:text-sm text-gray-700 leading-relaxed">
          <strong class="text-brand-navy block mb-1">Underlying Neurology:</strong>
          {item.subjectB.underlyingNeurology}
        </div>

        <div class="mb-5">
          <h3 class="font-bold text-brand-navy text-xs uppercase tracking-wider mb-2">Core Observable Signs:</h3>
          <ul class="space-y-2 text-xs sm:text-sm text-gray-700">
            {item.subjectB.primarySymptoms.map(sign => (
              <li class="flex items-start gap-2">
                <span class="text-amber-600 font-bold mt-0.5">&bull;</span>
                <span>{sign}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="mt-auto pt-4 border-t border-gray-100 grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs">
          <div class="bg-emerald-50/70 p-3 rounded-xl border border-emerald-100 text-emerald-900">
            <strong class="block mb-1 font-bold text-emerald-800">&#10003; What Helps:</strong>
            <ul class="space-y-1 list-disc list-inside">
              {item.subjectB.whatHelps.slice(0, 2).map(h => <li>{h}</li>)}
            </ul>
          </div>
          <div class="bg-rose-50/70 p-3 rounded-xl border border-rose-100 text-rose-900">
            <strong class="block mb-1 font-bold text-rose-800">&#10007; What Harms:</strong>
            <ul class="space-y-1 list-disc list-inside">
              {item.subjectB.whatHarms.slice(0, 2).map(w => <li>{w}</li>)}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- Side-by-Side Clinical Differences Table -->
    <section class="my-14" aria-label="Detailed Comparison Matrix">
      <div class="text-center mb-8">
        <h2 class="text-2xl sm:text-3xl font-extrabold text-brand-navy tracking-tight mb-2">
          Clinical Comparison Matrix
        </h2>
        <p class="text-gray-600 text-sm max-w-2xl mx-auto">
          Detailed observation breakdown across environmental response, triggers, and diagnostic significance.
        </p>
      </div>

      <div class="overflow-x-auto rounded-3xl border border-gray-200 shadow-sm bg-white">
        <table class="w-full text-left border-collapse text-xs sm:text-sm">
          <thead>
            <tr class="bg-slate-900 text-white">
              <th class="p-4 sm:p-5 font-bold w-1/4">Assessment Domain</th>
              <th class="p-4 sm:p-5 font-bold w-1/3 border-l border-white/10">{item.subjectA.name.split('(')[0]}</th>
              <th class="p-4 sm:p-5 font-bold w-1/3 border-l border-white/10">{item.subjectB.name.split('(')[0]}</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-200">
            {item.keyDifferencesTable.map((row, idx) => (
              <tr class={idx % 2 === 0 ? "bg-white hover:bg-blue-50/30 transition-colors" : "bg-gray-50/50 hover:bg-blue-50/30 transition-colors"}>
                <td class="p-4 sm:p-5 font-bold text-brand-navy align-top">
                  <div>{row.domain}</div>
                  <div class="text-[11px] text-gray-600 font-normal mt-1 italic">{row.clinicalSignificance}</div>
                </td>
                <td class="p-4 sm:p-5 text-gray-700 border-l border-gray-100 align-top leading-relaxed">
                  {row.subjectAObservation}
                </td>
                <td class="p-4 sm:p-5 text-gray-700 border-l border-gray-100 align-top leading-relaxed">
                  {row.subjectBObservation}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- At-Home Differentiator Protocol -->
    <section class="bg-blue-50/60 rounded-3xl p-6 sm:p-10 border border-blue-200/80 my-12" aria-label="At-Home Differentiator Steps">
      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-100 text-blue-900 text-xs font-bold uppercase tracking-wider mb-3">
          Practical Parent Action
        </div>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-brand-navy mb-4 tracking-tight">
          The At-Home Differential Observation Protocol
        </h2>
        <p class="text-gray-700 text-sm sm:text-base leading-relaxed mb-8">
          You do not need a lab to gather critical diagnostic data. Conduct these low-stress at-home observations to share with your assessing psychologist or pediatrician:
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {item.atHomeDifferentiatorProtocol.map(step => (
          <div class="bg-white rounded-2xl p-6 border border-blue-100 shadow-xs flex flex-col">
            <div class="flex items-center gap-3 mb-3">
              <span class="w-8 h-8 rounded-full bg-brand-navy text-white font-bold flex items-center justify-center text-sm shrink-0">
                {step.stepNumber}
              </span>
              <h3 class="text-base sm:text-lg font-bold text-brand-navy">{step.title}</h3>
            </div>
            <p class="text-xs sm:text-sm text-gray-700 mb-4 leading-relaxed flex-1">
              <strong>Instructions:</strong> {step.action}
            </p>
            <div class="bg-amber-50/80 p-3 rounded-xl border border-amber-200/60 text-xs text-amber-900">
              <strong class="font-bold text-amber-950 block mb-1">What to Observe:</strong>
              {step.observationTip}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Clinical Verdict Box -->
    <section class="bg-slate-900 text-white rounded-3xl p-8 sm:p-10 my-12 shadow-lg" aria-label="Clinical Verdict">
      <div class="flex items-center gap-2 text-brand-gold text-xs font-bold uppercase tracking-widest mb-3">
        <span>&#9733;</span> Clinician's Perspective &bull; Rabbia Ashraf
      </div>
      <h2 class="text-2xl sm:text-3xl font-black mb-4 tracking-tight">The Clinical Bottom Line</h2>
      <p class="text-gray-200 text-base sm:text-lg leading-relaxed mb-6">
        {item.clinicalVerdict}
      </p>

      <div class="pt-6 border-t border-white/10">
        <h3 class="text-sm font-bold text-white uppercase tracking-wider mb-3">When to Seek Formal Evaluation:</h3>
        <ul class="grid grid-cols-1 md:grid-cols-3 gap-3 text-xs sm:text-sm text-gray-300">
          {item.whenToSeekSpecialist.map(w => (
            <li class="bg-white/5 p-3 rounded-xl border border-white/10 flex items-start gap-2">
              <span class="text-emerald-400 font-bold">&#10003;</span>
              <span>{w}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Frequently Asked Questions -->
    <section class="my-14" aria-label="Frequently Asked Questions">
      <h2 class="text-2xl sm:text-3xl font-extrabold text-brand-navy text-center mb-8 tracking-tight">
        Frequently Asked Questions
      </h2>

      <div class="max-w-3xl mx-auto space-y-4">
        {item.faqList.map(faq => (
          <div class="bg-white rounded-2xl p-6 border border-gray-200 shadow-xs">
            <h3 class="text-base sm:text-lg font-bold text-brand-navy mb-2">{faq.question}</h3>
            <p class="text-gray-700 text-xs sm:text-sm leading-relaxed">{faq.answer}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Academic References & Clinical Guidelines (E-E-A-T) -->
    <section class="bg-gray-50 rounded-2xl p-6 sm:p-8 border border-gray-200 my-12" aria-label="Peer-Reviewed References">
      <h3 class="text-sm font-bold text-brand-navy uppercase tracking-wider mb-3 flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-blue-700"></span>
        Peer-Reviewed Clinical Citations &amp; Diagnostic Guidelines
      </h3>
      <ul class="space-y-2 text-xs text-gray-600 leading-relaxed">
        {item.peerReviewedCitations.map(cite => (
          <li class="pl-3 border-l-2 border-gray-300">
            {cite.citation}
          </li>
        ))}
      </ul>
      <div class="mt-4 pt-4 border-t border-gray-200 text-[11px] text-gray-500">
        Diagnostic criteria referenced in accordance with DSM-5-TR, ICD-11, and National Institute for Health and Care Excellence (NICE) guidelines.
      </div>
    </section>

    <!-- Consultation Action Banner -->
    <footer class="bg-linear-to-r from-blue-900 to-indigo-900 rounded-3xl p-8 sm:p-10 text-white text-center shadow-lg my-12">
      <h2 class="text-2xl sm:text-3xl font-extrabold mb-3">Need Clinical Guidance for Your Child?</h2>
      <p class="text-blue-100 text-sm sm:text-base max-w-2xl mx-auto mb-6 leading-relaxed">
        Book an initial consultation or report review session with Rabbia Ashraf (Clinical Psychologist &amp; Certified ADOS-2 Practitioner) for personalized clarity.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a 
          href="/book/"
          class="px-6 py-3 rounded-xl bg-brand-gold text-brand-navy font-bold hover:bg-yellow-400 transition-all shadow-md text-sm"
        >
          Book Consultation &rarr;
        </a>
        <a 
          href="https://wa.me/923364114002"
          class="px-6 py-3 rounded-xl bg-white/10 hover:bg-white/20 text-white font-semibold transition-all border border-white/20 text-sm flex items-center gap-2"
        >
          WhatsApp Inquiry
        </a>
      </div>
    </footer>
  </article>
</BaseLayout>
