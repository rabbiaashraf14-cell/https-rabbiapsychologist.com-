---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/global/Breadcrumbs.astro';
import { comparisons } from '../../data/comparisons';

const title = "Evidence-Based Clinical Comparisons & Diagnostic Matrices | Rabbia Psychologist";
const description = "Comprehensive, peer-reviewed clinical comparisons for parents and educators. Compare ADHD vs SPD, Autism Meltdowns vs Tantrums, ADOS-2 vs CARS-2, and more.";
const canonicalURL = "https://www.rabbiapsychologist.com/compare/";

const breadcrumbs = [
  { name: 'Home', href: '/' },
  { name: 'Clinical Comparisons', href: '/compare/' }
];

const categories = ['All', 'Diagnostic & Symptoms', 'Assessment & Testing', 'Therapies & Interventions'];
---

<BaseLayout canonicalURL={canonicalURL} title={title} description={description}>
  <div class="container mx-auto px-4 py-8 max-w-6xl">
    <Breadcrumbs paths={breadcrumbs} />

    <!-- Hero Header -->
    <header class="text-center mt-6 mb-12">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-blue-50 border border-blue-200 text-brand-navy text-xs font-bold uppercase tracking-wider mb-4">
        <span class="w-2 h-2 rounded-full bg-blue-600 animate-pulse"></span>
        Programmatic Clinical Comparison Engine &bull; DSM-5-TR &amp; NICE Standards
      </div>
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-brand-navy tracking-tight mb-4 max-w-4xl mx-auto">
        Evidence-Based Diagnostic &amp; Therapy Comparisons
      </h1>
      <p class="text-base sm:text-lg text-gray-700 max-w-3xl mx-auto leading-relaxed">
        Objective, peer-reviewed matrices comparing neurodevelopmental conditions, diagnostic assessment tools, and therapy modalities to help parents and schools make informed clinical decisions.
      </p>
    </header>

    <!-- Authority Reassurance Strip -->
    <section class="bg-white rounded-2xl border border-gray-200 p-6 shadow-xs mb-12 grid grid-cols-1 md:grid-cols-3 gap-6 text-center">
      <div class="border-b md:border-b-0 md:border-r border-gray-100 pb-4 md:pb-0">
        <div class="text-2xl font-black text-brand-navy">DSM-5-TR &amp; NICE</div>
        <p class="text-xs text-gray-600 mt-1">Grounding all symptomatic differences in internationally validated clinical frameworks.</p>
      </div>
      <div class="border-b md:border-b-0 md:border-r border-gray-100 pb-4 md:pb-0">
        <div class="text-2xl font-black text-brand-navy">Objective Criteria</div>
        <p class="text-xs text-gray-600 mt-1">Transparent side-by-side matrices contrasting neurology, behaviors, and intervention outcomes.</p>
      </div>
      <div>
        <div class="text-2xl font-black text-brand-navy">At-Home Protocols</div>
        <p class="text-xs text-gray-600 mt-1">Actionable observation tests parents can conduct safely without distress or pressure.</p>
      </div>
    </section>

    <!-- Comparison Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mb-16">
      {comparisons.map(item => (
        <article class="bg-white rounded-3xl border border-gray-200/90 shadow-xs hover:shadow-xl transition-all duration-300 flex flex-col overflow-hidden group">
          <div class="relative aspect-video overflow-hidden bg-gray-100">
            <img 
              src={item.heroImage} 
              alt={item.title}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              loading="lazy"
              decoding="async"
            />
            <span class="absolute top-3 left-3 bg-brand-navy/90 backdrop-blur-xs text-white text-[11px] font-bold px-2.5 py-1 rounded-full border border-white/20">
              {item.category}
            </span>
          </div>

          <div class="p-6 flex-1 flex flex-col">
            <div class="text-xs font-semibold text-blue-700 uppercase tracking-wide mb-2 flex items-center justify-between">
              <span>{item.badgeText}</span>
              <span class="text-gray-600 font-normal">{item.readTime}</span>
            </div>

            <h2 class="text-xl font-bold text-brand-navy mb-3 group-hover:text-blue-700 transition-colors line-clamp-2">
              <a href={`/compare/${item.slug}/`} class="focus:outline-hidden">
                {item.title}
              </a>
            </h2>

            <p class="text-gray-600 text-xs sm:text-sm line-clamp-3 mb-6 leading-relaxed flex-1">
              {item.metaDescription}
            </p>

            <div class="pt-4 border-t border-gray-100 flex items-center justify-between text-xs">
              <span class="text-gray-600 font-medium truncate max-w-[180px]">
                {item.evidenceGrade.split('(')[0]}
              </span>
              <a 
                href={`/compare/${item.slug}/`}
                class="inline-flex items-center gap-1 font-bold text-blue-700 hover:text-brand-navy transition-colors"
                aria-label={`View clinical comparison: ${item.title}`}
              >
                View Comparison &rarr;
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>

    <!-- Quick Consultation Banner -->
    <div class="bg-linear-to-r from-brand-navy to-slate-800 rounded-3xl p-8 sm:p-10 text-white text-center shadow-lg my-12">
      <h2 class="text-2xl sm:text-3xl font-extrabold mb-3">Still Unsure Which Profile Matches Your Child?</h2>
      <p class="text-gray-300 text-sm sm:text-base max-w-2xl mx-auto mb-6 leading-relaxed">
        Neurodevelopmental profiles frequently overlap. Schedule a clinical consultation to review developmental history, school observations, and symptom questionnaires.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a 
          href="/book/"
          class="px-6 py-3 rounded-xl bg-brand-gold text-brand-navy font-bold hover:bg-yellow-400 transition-all shadow-md text-sm"
        >
          Book Clinical Consultation
        </a>
        <a 
          href="https://wa.me/923364114002"
          class="px-6 py-3 rounded-xl bg-white/10 hover:bg-white/20 text-white font-semibold transition-all border border-white/20 text-sm flex items-center gap-2"
        >
          Message on WhatsApp
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
