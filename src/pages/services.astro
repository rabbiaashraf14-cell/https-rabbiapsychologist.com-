---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/global/Breadcrumbs.astro';
import WaitlistCrisisBanner from '../components/global/WaitlistCrisisBanner.astro';
import { services } from '../data/services';

const title = "Clinical Child Development Services | Rabbia Psychologist";
const description = "Explore our child development services including parent guidance, ASD support, ADHD strategies, school IEP help, and behavior support planning.";
const canonicalURL = "https://www.rabbiapsychologist.com/services/";

const breadcrumbs = [
  { name: 'Home', href: '/' },
  { name: 'Services', href: '/services/' }
];
---

<BaseLayout canonicalURL={canonicalURL} title={title} description={description}>
  <div class="container mx-auto px-4 py-8 max-w-5xl">
    <Breadcrumbs paths={breadcrumbs} />

    <div class="text-center mt-6 mb-8">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-50 border border-blue-200 text-brand-navy text-xs font-bold uppercase tracking-wider mb-3">
        Clinical Child Psychology &bull; Evidence-Informed Practice
      </div>
      <h1 class="text-4xl md:text-5xl font-extrabold text-brand-navy mb-4 tracking-tight">Our Clinical Consultation Pathways</h1>
      <p class="text-lg text-gray-700 max-w-3xl mx-auto leading-relaxed">
        Neurodiversity-affirming, personalized consultation services for families navigating ADHD, autism, school anxiety, meltdowns, and developmental assessment reports worldwide.
      </p>
    </div>

    <!-- Waitlist Interim Support Reassurance Banner -->
    <WaitlistCrisisBanner />

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 my-12">
      {services.map(service => (
        <div id={service.slug} class="group apple-glass-card apple-specular-top rounded-3xl p-7 sm:p-8 shadow-sm hover:shadow-xl transition-all duration-300 scroll-mt-24 flex flex-col relative h-full border border-gray-100">
          <a href={service.ctaUrl} class="group-hover:text-brand-trust transition-colors">
            <h2 class="text-2xl font-bold text-brand-navy mb-3 group-hover:text-brand-trust tracking-tight">{service.title}</h2>
          </a>
          <p class="text-gray-700 mb-5 text-sm leading-relaxed">{service.description}</p>

          <div class="mb-4 bg-gray-50/80 p-3.5 rounded-2xl border border-gray-100">
            <h3 class="font-bold text-brand-navy mb-1 text-xs uppercase tracking-wider">This is right for you if:</h3>
            <p class="text-gray-600 text-xs leading-relaxed">{service.whoItIsFor}</p>
          </div>

          <div class="mb-5">
            <h3 class="font-bold text-brand-navy mb-1 text-xs uppercase tracking-wider">Common Questions Parents Ask:</h3>
            <p class="text-gray-600 text-xs italic bg-blue-50/50 p-3 rounded-xl border border-blue-100/60">"{service.commonConcerns}"</p>
          </div>

          <div class="mb-5">
             <h3 class="font-semibold text-gray-800 mb-2 text-xs uppercase tracking-wider">What your session includes:</h3>
             <ul class="space-y-1.5 text-gray-600 text-xs">
               {service.whatItIncludes.map(item => (
                 <li class="flex items-start gap-1.5">
                   <svg class="w-3.5 h-3.5 text-emerald-600 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                   <span>{item}</span>
                 </li>
               ))}
             </ul>
          </div>

          <div class="mb-6 flex-grow">
             <h3 class="font-semibold text-gray-500 mb-1.5 text-xs uppercase tracking-wider">Scope Boundaries:</h3>
             <ul class="space-y-1 text-gray-400 text-[11px]">
               {service.whatItDoesNotInclude.map(item => (
                 <li class="flex items-start gap-1">
                   <span class="text-gray-300">&bull;</span>
                   <span>{item}</span>
                 </li>
               ))}
             </ul>
          </div>

          <div class="pt-4 border-t border-gray-100 mt-auto flex flex-col gap-2.5">
            <a href={service.ctaUrl} class="block text-center text-brand-navy font-bold text-xs hover:underline">
              Read In-Depth Clinical Guide &rarr;
            </a>
            <a href="/book/" class="apple-btn apple-btn-primary !py-3 !px-6 text-center text-sm font-semibold shadow-sm w-full block">
              Book Consultation Session
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</BaseLayout>
