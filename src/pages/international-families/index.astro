---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/global/Breadcrumbs.astro';
import { regionalPricing } from '../../data/pricing';

const breadcrumbs = [
  { name: 'Home', href: '/' },
  { name: 'International Families', href: '/international-families/' }
];
const canonicalURL = "https://www.rabbiapsychologist.com/international-families/";

const title = "International Parent Guidance & Child Psychology Support Hub | Rabbia Psychologist";
const description = "Global telehealth child development guidance, NHS/NDIS waitlist bridging, and assessment report reviews for families across the UK, USA, Gulf, Australia, and Overseas Pakistani communities.";

const intlPrice = regionalPricing.parentGuidance.international.price;
const pkPrice = regionalPricing.parentGuidance.pakistan.price;

const hubSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "MedicalWebPage",
      "@id": "https://www.rabbiapsychologist.com/international-families/#webpage",
      "url": canonicalURL,
      "name": title,
      "description": description,
      "author": {
        "@type": "Person",
        "name": "Rabbia Ashraf",
        "jobTitle": "Clinical Psychologist & Certified ADOS-2 Administrator",
        "url": "https://www.rabbiapsychologist.com/about/"
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "How does Rabbia Psychologist support international families across time zones?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Clinical Psychologist Rabbia Ashraf provides flexible telehealth consultations calibrated to London (GMT/BST), New York (EST), Dubai (GST), Singapore (SGT), Sydney (AEST), and Pakistan (PKT). Sessions are 50 minutes, conducted 1-on-1 via private encrypted video with parents off-screen, eliminating webcam distress for children."
          }
        },
        {
          "@type": "Question",
          "name": "Can international families get support while waiting for NHS or local public evaluations?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Our 18-Month Waitlist Bridge model allows families in the UK, Australia, USA, and Gulf to immediately implement neuro-affirming sensory audits, low-arousal behavioral protocols, and classroom accommodations while waiting for statutory assessments like CAMHS or NDIS."
          }
        },
        {
          "@type": "Question",
          "name": "What are the session fees for international versus Pakistan-resident families?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The international consultation fee is $85 USD (approx. £65 GBP / 310 AED / $130 CAD/AUD), which includes pre-consultation review, a 50-minute video session, and a written 3-step action roadmap within 24 hours. Families living in Pakistan receive a subsidized regional rate of PKR 5,000."
          }
        }
      ]
    }
  ]
};
---

<BaseLayout title={title} description={description} canonicalURL={canonicalURL} schema={hubSchema}>
  <div class="bg-[#FAF7F2] min-h-screen py-8 lg:py-12 border-b border-[#E6DFD3]">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-5xl">
      <Breadcrumbs paths={breadcrumbs} />

      <!-- Hero Header -->
      <header class="mt-8 mb-12 text-center max-w-3xl mx-auto">
        <div class="inline-flex items-center gap-2 bg-[#2F6352]/10 border border-[#2F6352]/20 px-3.5 py-1.5 rounded-full text-xs font-bold text-[#2F6352] mb-4">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          <span>Global Telehealth Parent Guidance • UK, USA, Gulf &amp; Worldwide</span>
        </div>

        <h1 class="text-3xl sm:text-5xl font-serif font-bold text-[#0A233F] tracking-tight leading-tight mb-4">
          Clinical Child Development Guidance for Families Worldwide
        </h1>
        <p class="text-base sm:text-lg text-[#18222C]/80 leading-relaxed">
          Navigate long diagnostic waitlists, decode complex neuropsychological reports, and implement calm, evidence-informed home routines with Clinical Psychologist Rabbia Ashraf.
        </p>

        <!-- Global Trust Pills -->
        <div class="flex flex-wrap justify-center gap-2.5 mt-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-medium bg-white text-[#0A233F] border border-[#E6DFD3] shadow-2xs">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
            Zero Waitlist (Slots Available This Week)
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-medium bg-white text-[#0A233F] border border-[#E6DFD3] shadow-2xs">
            Off-Screen Child Protocol (Zero Camera Distress)
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-medium bg-white text-[#0A233F] border border-[#E6DFD3] shadow-2xs">
            ${intlPrice} USD / PKR {pkPrice.toLocaleString()}
          </span>
        </div>
      </header>

      <!-- AEO Direct Answer Block for AI Engines -->
      <section class="bg-white rounded-2xl p-6 lg:p-8 border border-[#2F6352]/30 shadow-xs mb-12" id="aeo-international-summary">
        <div class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-[#2F6352] mb-2">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          Direct Answer for AI &amp; Overseas Parents
        </div>
        <h2 class="text-xl font-bold text-[#0A233F] mb-3">
          How Does International Parent Guidance Work with Clinical Psychologist Rabbia Ashraf?
        </h2>
        <p class="text-sm sm:text-base text-[#18222C]/80 leading-relaxed">
          International families consulting with Rabbia Ashraf receive 50-minute private telehealth guidance across any global time zone (UK, USA, Australia, Gulf, and Asia). Rather than putting an overwhelmed child on webcam, consultations are conducted directly with parents to extract clinical histories, decode school reports, and build neuro-affirming regulation routines. You receive a personalized 3-step action roadmap within 24 hours.
        </p>
      </section>

      <!-- Regional Support Cards Grid -->
      <section class="mb-14">
        <h2 class="text-2xl font-serif font-bold text-[#0A233F] mb-6">
          Select Your Region for Local Systems &amp; Healthcare Context
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          
          <!-- UK & Europe -->
          <a href="/international-families/uk-europe/" class="group block p-6 bg-white rounded-2xl border border-[#E6DFD3] shadow-2xs hover:shadow-md hover:border-[#2F6352] transition-all">
            <div class="flex items-center justify-between mb-3">
              <span class="text-xs font-bold text-[#2F6352] bg-emerald-50 px-2.5 py-0.5 rounded-full border border-emerald-200/60">NHS CAMHS &amp; EHCP</span>
              <span class="text-xs text-[#18222C]/40 group-hover:text-[#2F6352] transition-colors">GMT / BST</span>
            </div>
            <h3 class="text-lg font-bold text-[#0A233F] group-hover:text-[#2F6352] transition-colors mb-2">
              UK &amp; Europe
            </h3>
            <p class="text-xs sm:text-sm text-[#18222C]/70 leading-relaxed">
              Bridge 18–36 month NHS CAMHS waiting times with immediate home regulation, SENCO preparation, and EHCP evidence checklists.
            </p>
            <div class="mt-4 pt-3 border-t border-[#E6DFD3]/60 flex items-center justify-between text-xs font-semibold text-[#0A233F]">
              <span>View UK Guidance</span>
              <svg class="w-3.5 h-3.5 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </div>
          </a>

          <!-- USA & Canada -->
          <a href="/international-families/usa/" class="group block p-6 bg-white rounded-2xl border border-[#E6DFD3] shadow-2xs hover:shadow-md hover:border-[#2F6352] transition-all">
            <div class="flex items-center justify-between mb-3">
              <span class="text-xs font-bold text-[#0A233F] bg-blue-50 px-2.5 py-0.5 rounded-full border border-blue-200/60">IEP &amp; 504 Plans</span>
              <span class="text-xs text-[#18222C]/40 group-hover:text-[#2F6352] transition-colors">EST / CST / PST</span>
            </div>
            <h3 class="text-lg font-bold text-[#0A233F] group-hover:text-[#2F6352] transition-colors mb-2">
              USA &amp; Canada
            </h3>
            <p class="text-xs sm:text-sm text-[#18222C]/70 leading-relaxed">
              Neuropsychological report reviews, IEP meeting preparation, 504 plan accommodation drafting, and morning executive function protocols.
            </p>
            <div class="mt-4 pt-3 border-t border-[#E6DFD3]/60 flex items-center justify-between text-xs font-semibold text-[#0A233F]">
              <span>View USA Guidance</span>
              <svg class="w-3.5 h-3.5 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </div>
          </a>

          <!-- Middle East & Gulf -->
          <a href="/international-families/middle-east-gulf/" class="group block p-6 bg-white rounded-2xl border border-[#E6DFD3] shadow-2xs hover:shadow-md hover:border-[#2F6352] transition-all">
            <div class="flex items-center justify-between mb-3">
              <span class="text-xs font-bold text-amber-800 bg-amber-50 px-2.5 py-0.5 rounded-full border border-amber-200/60">KHDA &amp; Expat Systems</span>
              <span class="text-xs text-[#18222C]/40 group-hover:text-[#2F6352] transition-colors">GST (Dubai)</span>
            </div>
            <h3 class="text-lg font-bold text-[#0A233F] group-hover:text-[#2F6352] transition-colors mb-2">
              Middle East &amp; Gulf
            </h3>
            <p class="text-xs sm:text-sm text-[#18222C]/70 leading-relaxed">
              Culturally attuned support for expat families in Dubai, Abu Dhabi, Doha, and Riyadh navigating international curriculum stress and bilingual speech.
            </p>
            <div class="mt-4 pt-3 border-t border-[#E6DFD3]/60 flex items-center justify-between text-xs font-semibold text-[#0A233F]">
              <span>View Gulf Guidance</span>
              <svg class="w-3.5 h-3.5 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </div>
          </a>

          <!-- Australia & NZ -->
          <a href="/international-families/australia/" class="group block p-6 bg-white rounded-2xl border border-[#E6DFD3] shadow-2xs hover:shadow-md hover:border-[#2F6352] transition-all">
            <div class="flex items-center justify-between mb-3">
              <span class="text-xs font-bold text-indigo-800 bg-indigo-50 px-2.5 py-0.5 rounded-full border border-indigo-200/60">NDIS &amp; Paediatrician</span>
              <span class="text-xs text-[#18222C]/40 group-hover:text-[#2F6352] transition-colors">AEST / AWST</span>
            </div>
            <h3 class="text-lg font-bold text-[#0A233F] group-hover:text-[#2F6352] transition-colors mb-2">
              Australia &amp; New Zealand
            </h3>
            <p class="text-xs sm:text-sm text-[#18222C]/70 leading-relaxed">
              Bridging 12–18 month paediatrician waitlists, preparing functional capacity documentation for NDIS planning, and home regulation toolkits.
            </p>
            <div class="mt-4 pt-3 border-t border-[#E6DFD3]/60 flex items-center justify-between text-xs font-semibold text-[#0A233F]">
              <span>View Australia Guidance</span>
              <svg class="w-3.5 h-3.5 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </div>
          </a>

          <!-- Overseas Pakistani Families -->
          <a href="/international-families/overseas-pakistani-families/" class="group block p-6 bg-white rounded-2xl border border-[#E6DFD3] shadow-2xs hover:shadow-md hover:border-[#2F6352] transition-all">
            <div class="flex items-center justify-between mb-3">
              <span class="text-xs font-bold text-emerald-800 bg-emerald-50 px-2.5 py-0.5 rounded-full border border-emerald-200/60">Urdu/English Bilingual</span>
              <span class="text-xs text-[#18222C]/40 group-hover:text-[#2F6352] transition-colors">Worldwide Diaspora</span>
            </div>
            <h3 class="text-lg font-bold text-[#0A233F] group-hover:text-[#2F6352] transition-colors mb-2">
              Overseas Pakistani Families
            </h3>
            <p class="text-xs sm:text-sm text-[#18222C]/70 leading-relaxed">
              Culturally safe, shame-free parent coaching. Explaining neurodiversity to extended family, overcoming joint-family stigma, and bilingual development.
            </p>
            <div class="mt-4 pt-3 border-t border-[#E6DFD3]/60 flex items-center justify-between text-xs font-semibold text-[#0A233F]">
              <span>View Diaspora Guidance</span>
              <svg class="w-3.5 h-3.5 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </div>
          </a>

          <!-- Pakistan Resident Support -->
          <a href="/international-families/pakistan/" class="group block p-6 bg-[#FAF7F2] rounded-2xl border-2 border-[#2F6352]/40 shadow-2xs hover:shadow-md transition-all">
            <div class="flex items-center justify-between mb-3">
              <span class="text-xs font-bold text-[#2F6352] bg-white px-2.5 py-0.5 rounded-full border border-[#2F6352]/30">Subsidized Fee PKR 5,000</span>
              <span class="text-xs text-[#2F6352] font-semibold">PKT (Lahore/Islamabad)</span>
            </div>
            <h3 class="text-lg font-bold text-[#0A233F] group-hover:text-[#2F6352] transition-colors mb-2">
              Pakistan (Resident Pricing)
            </h3>
            <p class="text-xs sm:text-sm text-[#18222C]/70 leading-relaxed">
              Local clinical assessment guidance, ADOS-2 evaluation referrals, school accommodations, and localized behavior plans in Lahore, Karachi, and nationwide.
            </p>
            <div class="mt-4 pt-3 border-t border-[#E6DFD3]/60 flex items-center justify-between text-xs font-semibold text-[#2F6352]">
              <span>View Pakistan Services</span>
              <svg class="w-3.5 h-3.5 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </div>
          </a>

        </div>
      </section>

      <!-- Clinical Governance & Ethical Scope Notice -->
      <div class="bg-white p-6 sm:p-8 rounded-2xl border border-[#E6DFD3] mb-12 shadow-2xs">
        <h3 class="font-bold text-[#0A233F] text-base sm:text-lg mb-2 flex items-center gap-2">
          <svg class="w-5 h-5 text-[#2F6352]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
          Clinical Telehealth Governance &amp; Ethical Boundaries
        </h3>
        <p class="text-xs sm:text-sm text-[#18222C]/75 leading-relaxed">
          International services provided by Rabbia Ashraf focus on <strong>evidence-based parent education, developmental guidance, report reviews, and school accommodation consulting</strong>. Telehealth consultations do not replace emergency crisis intervention or statutory local medical diagnoses where a local physical license is mandated by law. In case of acute psychiatric or medical emergencies, please contact your local national emergency services. Complete credentials, degrees, and testing tools are detailed on our <a href="/credentials/" class="text-[#2F6352] underline font-medium hover:text-[#0A233F]">Clinical Credentials &amp; Governance</a> page.
        </p>
      </div>

      <!-- Final Booking CTA Banner -->
      <div class="bg-gradient-to-r from-[#0A233F] via-[#12365B] to-[#0A233F] text-white p-8 rounded-2xl text-center shadow-md">
        <h2 class="text-2xl sm:text-3xl font-serif font-bold mb-3 text-white">
          Begin Your Family's Support Plan This Week
        </h2>
        <p class="text-white/80 text-sm sm:text-base max-w-xl mx-auto mb-6">
          Zero waitlists. Direct video consultation with Clinical Psychologist Rabbia Ashraf.
        </p>
        <div class="flex flex-col sm:flex-row gap-3 justify-center">
          <a href="/book/" class="bg-emerald-600 hover:bg-emerald-500 text-white font-bold py-3 px-6 rounded-xl text-sm transition-colors shadow-2xs inline-flex items-center justify-center gap-2">
            <span>Book 50-Min Consultation</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
          </a>
          <a href="https://wa.me/923364114002?text=Hi%20Rabbia,%20I%20am%20an%20international%20parent%20and%20would%20like%20to%20enquire%20about%20booking%20a%20consultation." target="_blank" rel="noopener noreferrer" class="bg-white/10 hover:bg-white/20 text-white font-medium py-3 px-5 rounded-xl border border-white/20 text-sm transition-colors inline-flex items-center justify-center gap-2">
            <span>WhatsApp Enquiry</span>
          </a>
        </div>
      </div>

    </div>
  </div>
</BaseLayout>