---
// Interactive Telehealth Scheduler inspired by Cal.com & modern design systems
// Provides instant timezone detection, support pathway switching, and interactive slot selection.
---

<section class="py-16 lg:py-24 bg-gradient-to-b from-white via-brand-cream/30 to-white relative overflow-hidden" id="interactive-scheduler">
  <!-- Subtle ambient glow spheres -->
  <div class="absolute top-1/2 left-1/4 -translate-y-1/2 w-96 h-96 bg-emerald-500/5 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute top-1/2 right-1/4 -translate-y-1/2 w-96 h-96 bg-brand-navy/5 rounded-full blur-3xl pointer-events-none"></div>

  <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-5xl relative z-10">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-10">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white border border-brand-navy/10 text-xs font-semibold text-brand-navy uppercase tracking-wider mb-4 shadow-2xs">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        Cal.com-Powered Telehealth Booking Preview
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-brand-navy tracking-tight mb-4">
        Reserve Your Discovery Call or Consultation
      </h2>
      <p class="text-base sm:text-lg text-gray-600 leading-relaxed">
        Select your support pathway and preferred time slot. Sessions automatically sync with your local time zone.
      </p>

      <!-- Dynamic Timezone Detection Banner -->
      <div class="inline-flex items-center gap-2 mt-4 px-4 py-2 rounded-2xl bg-brand-cream border border-brand-navy/10 text-xs font-medium text-brand-navy shadow-xs">
        <svg class="w-4 h-4 text-emerald-600 animate-spin-slow shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <circle cx="12" cy="12" r="10" stroke-width="1.5" stroke-dasharray="4 4" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6l4 2" />
        </svg>
        <span>Detected Local Timezone: <strong id="user-detected-tz" class="text-brand-navy font-bold">Detecting...</strong></span>
        <span class="hidden sm:inline text-gray-400">•</span>
        <span id="user-local-clock" class="text-emerald-700 font-semibold hidden sm:inline"></span>
      </div>
    </div>

    <!-- Main Scheduler Card Frame -->
    <div class="apple-glass-card apple-specular-top p-6 sm:p-8 lg:p-10 shadow-[0_20px_60px_-15px_rgba(10,35,63,0.08)] bg-white/95">
      
      <!-- Step 1: Select Consultation Pathway -->
      <div class="mb-8">
        <div class="flex items-center justify-between mb-3">
          <label class="text-xs font-bold uppercase tracking-wider text-gray-500">
            Step 1: Choose Your Consultation Pathway
          </label>
          <span class="text-[11px] font-semibold text-emerald-700 bg-emerald-50 px-2.5 py-0.5 rounded-full border border-emerald-200">
            100% Confidential
          </span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-3.5" id="pathway-selector">
          
          <!-- Pathway 1: Free 15-Min Discovery Call -->
          <button 
            type="button" 
            data-pathway="discovery"
            data-duration="15 Mins"
            data-price="Free"
            class="pathway-btn active text-left p-4 sm:p-5 rounded-2xl border-2 border-emerald-500 bg-emerald-50/40 hover:bg-emerald-50/70 transition-all duration-200 relative group cursor-pointer focus:outline-none"
          >
            <div class="flex items-center justify-between mb-2">
              <span class="text-[11px] font-extrabold uppercase tracking-wider text-emerald-800 bg-emerald-100 px-2 py-0.5 rounded-md">
                Zero Risk
              </span>
              <span class="text-xs font-bold text-emerald-700">100% Free</span>
            </div>
            <div class="font-bold text-brand-navy text-base mb-1">Free 15-Min Discovery</div>
            <p class="text-xs text-gray-600 leading-relaxed mb-2">
              Discuss your child's situation, confirm fit, and get immediate triage guidance.
            </p>
            <div class="text-[11px] font-semibold text-emerald-700 flex items-center gap-1">
              <span>Google Meet / WhatsApp Voice</span>
            </div>
          </button>

          <!-- Pathway 2: Full 50-Min Session -->
          <button 
            type="button" 
            data-pathway="full"
            data-duration="50 Mins"
            data-price="$85 USD / £65"
            class="pathway-btn text-left p-4 sm:p-5 rounded-2xl border border-gray-200 bg-white hover:border-brand-navy/30 transition-all duration-200 relative group cursor-pointer focus:outline-none"
          >
            <div class="flex items-center justify-between mb-2">
              <span class="text-[11px] font-extrabold uppercase tracking-wider text-brand-navy bg-brand-cream px-2 py-0.5 rounded-md border border-brand-navy/5">
                Clinical Strategy
              </span>
              <span class="text-xs font-bold text-brand-navy">$85 / £65</span>
            </div>
            <div class="font-bold text-brand-navy text-base mb-1">50-Min Comprehensive</div>
            <p class="text-xs text-gray-600 leading-relaxed mb-2">
              Full diagnostic history, tailored coping strategies &amp; 1-page written action roadmap.
            </p>
            <div class="text-[11px] font-semibold text-brand-navy flex items-center gap-1">
              <span>Deep parent coaching &amp; routine audit</span>
            </div>
          </button>

          <!-- Pathway 3: ADOS-2 & Report Review -->
          <button 
            type="button" 
            data-pathway="report"
            data-duration="60 Mins"
            data-price="$110 USD / £85"
            class="pathway-btn text-left p-4 sm:p-5 rounded-2xl border border-gray-200 bg-white hover:border-brand-navy/30 transition-all duration-200 relative group cursor-pointer focus:outline-none"
          >
            <div class="flex items-center justify-between mb-2">
              <span class="text-[11px] font-extrabold uppercase tracking-wider text-purple-800 bg-purple-50 px-2 py-0.5 rounded-md border border-purple-200">
                School / IEP Prep
              </span>
              <span class="text-xs font-bold text-purple-900">$110 / £85</span>
            </div>
            <div class="font-bold text-brand-navy text-base mb-1">Report &amp; IEP Debrief</div>
            <p class="text-xs text-gray-600 leading-relaxed mb-2">
              Translate 30-page neuropsych or ADOS reports into clear school accommodations.
            </p>
            <div class="text-[11px] font-semibold text-purple-800 flex items-center gap-1">
              <span>Line-by-line clinical translation</span>
            </div>
          </button>

        </div>
      </div>

      <!-- Step 2: Interactive Day & Time Slot Preview -->
      <div class="mb-8 pt-6 border-t border-gray-100">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-4">
          <label class="text-xs font-bold uppercase tracking-wider text-gray-500">
            Step 2: Select a Day &amp; Time Window (Your Local Time)
          </label>
          <span class="text-xs font-medium text-gray-500">
            🟢 48-Hour Waitlist Bridge Guarantee
          </span>
        </div>

        <!-- Day Selector Tabs -->
        <div class="flex items-center gap-2 overflow-x-auto pb-2 scrollbar-none mb-4" id="day-selector">
          <!-- Dynamically populated or rendered -->
          <button type="button" data-day="Tomorrow" class="day-tab active px-4 py-2.5 rounded-xl border-2 border-emerald-500 bg-emerald-50 font-bold text-xs text-emerald-900 whitespace-nowrap cursor-pointer transition-all">
            Tomorrow (Thu)
          </button>
          <button type="button" data-day="Friday" class="day-tab px-4 py-2.5 rounded-xl border border-gray-200 bg-white font-medium text-xs text-gray-700 hover:border-gray-400 whitespace-nowrap cursor-pointer transition-all">
            Friday
          </button>
          <button type="button" data-day="Saturday" class="day-tab px-4 py-2.5 rounded-xl border border-gray-200 bg-white font-medium text-xs text-gray-700 hover:border-gray-400 whitespace-nowrap cursor-pointer transition-all">
            Saturday (Weekend)
          </button>
          <button type="button" data-day="Monday" class="day-tab px-4 py-2.5 rounded-xl border border-gray-200 bg-white font-medium text-xs text-gray-700 hover:border-gray-400 whitespace-nowrap cursor-pointer transition-all">
            Next Monday
          </button>
          <button type="button" data-day="Tuesday" class="day-tab px-4 py-2.5 rounded-xl border border-gray-200 bg-white font-medium text-xs text-gray-700 hover:border-gray-400 whitespace-nowrap cursor-pointer transition-all">
            Next Tuesday
          </button>
        </div>

        <!-- Available Slots Grid -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5" id="slot-selector">
          <button type="button" data-time="10:00 AM" class="slot-btn p-3 rounded-xl border border-gray-200 bg-white hover:border-emerald-500 hover:bg-emerald-50/30 text-xs font-bold text-gray-800 transition-all text-center cursor-pointer">
            10:00 AM
            <span class="block text-[10px] font-normal text-gray-500">Morning Slot</span>
          </button>
          <button type="button" data-time="11:30 AM" class="slot-btn active p-3 rounded-xl border-2 border-emerald-500 bg-emerald-50 text-xs font-bold text-emerald-900 transition-all text-center cursor-pointer">
            11:30 AM
            <span class="block text-[10px] font-bold text-emerald-700">Recommended</span>
          </button>
          <button type="button" data-time="2:30 PM" class="slot-btn p-3 rounded-xl border border-gray-200 bg-white hover:border-emerald-500 hover:bg-emerald-50/30 text-xs font-bold text-gray-800 transition-all text-center cursor-pointer">
            2:30 PM
            <span class="block text-[10px] font-normal text-gray-500">Afternoon Slot</span>
          </button>
          <button type="button" data-time="4:30 PM" class="slot-btn p-3 rounded-xl border border-gray-200 bg-white hover:border-emerald-500 hover:bg-emerald-50/30 text-xs font-bold text-gray-800 transition-all text-center cursor-pointer">
            4:30 PM
            <span class="block text-[10px] font-normal text-gray-500">UK / Gulf Evening</span>
          </button>
        </div>
      </div>

      <!-- Step 3: Instant 1-Click Confirmation Action Card -->
      <div class="bg-brand-cream/80 rounded-2xl p-5 sm:p-6 border border-brand-navy/10 flex flex-col md:flex-row items-center justify-between gap-5">
        <div class="text-center md:text-left">
          <div class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-1">
            Selected Booking Summary
          </div>
          <div class="text-base sm:text-lg font-extrabold text-brand-navy" id="booking-summary-text">
            Free 15-Min Discovery Call • Tomorrow at 11:30 AM
          </div>
          <div class="text-xs text-gray-600 mt-1 flex flex-wrap items-center justify-center md:justify-start gap-2">
            <span>🔒 Confidential</span>
            <span>•</span>
            <span>Zero Payment Required</span>
            <span>•</span>
            <span>Voice Notes Welcome</span>
          </div>
        </div>

        <div class="flex flex-col sm:flex-row items-center gap-3 w-full md:w-auto shrink-0">
          <!-- Direct WhatsApp Instant Action -->
          <a
            id="scheduler-whatsapp-btn"
            href="https://wa.me/923364114002?text=Hi%20Rabbia,%20I%20would%20like%20to%20reserve%20a%20Free%2015-Minute%20Discovery%20Call%20for%20Tomorrow%20at%2011:30%20AM.%20My%20child's%20approximate%20age%20is%20___."
            target="_blank"
            rel="noopener noreferrer"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-[#25D366] hover:bg-[#1EBE5D] text-white text-xs sm:text-sm font-bold py-3.5 px-6 rounded-xl transition-all shadow-sm hover:shadow-md cursor-pointer text-center"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg>
            <span>Confirm on WhatsApp</span>
          </a>

          <!-- Google Calendar Alternative -->
          <a
            href="https://calendar.app.google/zMKejpnpCjh91WRG7"
            target="_blank"
            rel="noopener noreferrer"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-brand-navy hover:bg-[#13385E] text-white text-xs sm:text-sm font-bold py-3.5 px-6 rounded-xl transition-all shadow-sm text-center"
          >
            <span>Google Calendar</span>
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
          </a>
        </div>
      </div>

    </div>

  </div>
</section>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    // 1. Detect User's Local Timezone and display formatted clock
    try {
      const tz = Intl.DateTimeFormat().resolvedOptions().timeZone || 'UTC';
      const tzEl = document.getElementById('user-detected-tz');
      const clockEl = document.getElementById('user-local-clock');
      if (tzEl) {
        tzEl.textContent = tz.replace(/_/g, ' ');
      }
      if (clockEl) {
        const updateClock = () => {
          const now = new Date();
          clockEl.textContent = 'Local Time: ' + now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
        };
        updateClock();
        setInterval(updateClock, 30000);
      }
    } catch (e) {
      console.warn('Timezone detection error:', e);
    }

    // 2. Interactive Pathway and Slot Selector Logic
    let currentPathway = 'Free 15-Min Discovery Call';
    let currentDay = 'Tomorrow';
    let currentTime = '11:30 AM';

    const pathwayBtns = document.querySelectorAll('.pathway-btn');
    const dayTabs = document.querySelectorAll('.day-tab');
    const slotBtns = document.querySelectorAll('.slot-btn');
    const summaryText = document.getElementById('booking-summary-text');
    const whatsappBtn = document.getElementById('scheduler-whatsapp-btn');

    function updateSummary() {
      if (summaryText) {
        summaryText.textContent = `${currentPathway} • ${currentDay} at ${currentTime}`;
      }
      if (whatsappBtn) {
        const msg = encodeURIComponent(`Hi Rabbia, I visited your website and would like to reserve a ${currentPathway} for ${currentDay} at ${currentTime} (My local time). My child's approximate age is ___.`);
        whatsappBtn.href = `https://wa.me/923364114002?text=${msg}`;
      }
    }

    // Pathway Button Click
    pathwayBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        pathwayBtns.forEach(b => {
          b.classList.remove('active', 'border-2', 'border-emerald-500', 'bg-emerald-50/40');
          b.classList.add('border-gray-200', 'bg-white');
        });
        btn.classList.add('active', 'border-2', 'border-emerald-500', 'bg-emerald-50/40');
        btn.classList.remove('border-gray-200', 'bg-white');

        const pw = btn.getAttribute('data-pathway');
        if (pw === 'discovery') currentPathway = 'Free 15-Min Discovery Call';
        else if (pw === 'full') currentPathway = '50-Minute Comprehensive Consultation';
        else if (pw === 'report') currentPathway = 'ADOS-2 & Report Review';
        updateSummary();
      });
    });

    // Day Tab Click
    dayTabs.forEach(tab => {
      tab.addEventListener('click', () => {
        dayTabs.forEach(t => {
          t.classList.remove('active', 'border-2', 'border-emerald-500', 'bg-emerald-50', 'text-emerald-900', 'font-bold');
          t.classList.add('border-gray-200', 'bg-white', 'text-gray-700', 'font-medium');
        });
        tab.classList.add('active', 'border-2', 'border-emerald-500', 'bg-emerald-50', 'text-emerald-900', 'font-bold');
        tab.classList.remove('border-gray-200', 'bg-white', 'text-gray-700', 'font-medium');
        currentDay = tab.getAttribute('data-day') || 'Tomorrow';
        updateSummary();
      });
    });

    // Slot Button Click
    slotBtns.forEach(slot => {
      slot.addEventListener('click', () => {
        slotBtns.forEach(s => {
          s.classList.remove('active', 'border-2', 'border-emerald-500', 'bg-emerald-50', 'text-emerald-900');
          s.classList.add('border-gray-200', 'bg-white', 'text-gray-800');
        });
        slot.classList.add('active', 'border-2', 'border-emerald-500', 'bg-emerald-50', 'text-emerald-900');
        slot.classList.remove('border-gray-200', 'bg-white', 'text-gray-800');
        currentTime = slot.getAttribute('data-time') || '11:30 AM';
        updateSummary();
      });
    });
  });
</script>
