---
---
<section class="py-20 lg:py-24 bg-gradient-to-b from-brand-cream/30 via-white to-brand-cream/20 border-t border-brand-navy/5" id="services">
  <div class="container mx-auto px-4 max-w-6xl">
    <div class="text-center mb-14">
      <div class="apple-pill mb-4">
        <span class="w-2 h-2 rounded-full bg-brand-trust"></span>
        <span>Specialist Clinical Pathways</span>
      </div>
      <h2 class="text-3xl md:text-5xl font-extrabold text-brand-navy tracking-tight mb-4">Choose Your Starting Point</h2>
      <p class="text-base md:text-lg text-gray-600 max-w-2xl mx-auto leading-relaxed">Evidence-informed child and parent consultations customized to your family's daily challenges and developmental goals.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">

      <!-- Parent Consultation -->
      <div class="apple-glass-card apple-specular-top p-7 flex flex-col h-full group relative overflow-hidden">
        <div class="w-13 h-13 bg-blue-50/80 text-brand-trust rounded-2xl flex items-center justify-center mb-6 group-hover:scale-105 transition-transform duration-300 shadow-xs border border-blue-100/50">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
        </div>
        <h3 class="text-xl font-bold text-brand-navy mb-3 group-hover:text-blue-900 transition-colors tracking-tight">Parent Guidance Session</h3>
        <p class="text-gray-600 mb-6 flex-grow leading-relaxed text-sm md:text-base">Discuss your general developmental concerns, understand if an assessment is needed, and get a clear starting point.</p>
        <div class="pt-4 border-t border-gray-100/80 flex items-center justify-between mt-auto">
          <a href="/parent-support/" class="text-xs font-bold text-gray-500 hover:text-brand-navy transition-colors">
            Learn Details →
          </a>
          <a href="/book/?service=parent-guidance" class="apple-btn apple-btn-primary !py-2 !px-4 !text-xs font-semibold shadow-xs">
            Book Session
          </a>
        </div>
      </div>

      <!-- ADHD Guidance -->
      <div class="apple-glass-card apple-specular-top p-7 flex flex-col h-full group relative overflow-hidden">
        <div class="w-13 h-13 bg-amber-50/80 text-amber-700 rounded-2xl flex items-center justify-center mb-6 group-hover:scale-105 transition-transform duration-300 shadow-xs border border-amber-100/50">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path></svg>
        </div>
        <h3 class="text-xl font-bold text-brand-navy mb-3 group-hover:text-blue-900 transition-colors tracking-tight">ADHD Guidance</h3>
        <p class="text-gray-600 mb-6 flex-grow leading-relaxed text-sm md:text-base">Executive function routines, dopamine bridges, and practical strategies for attention, impulsivity, and morning routines.</p>
        <div class="pt-4 border-t border-gray-100/80 flex items-center justify-between mt-auto">
          <a href="/services/adhd-support/" class="text-xs font-bold text-gray-500 hover:text-brand-navy transition-colors">
            Learn Details →
          </a>
          <a href="/book/?service=adhd-support" class="apple-btn apple-btn-primary !py-2 !px-4 !text-xs font-semibold shadow-xs">
            Book Session
          </a>
        </div>
      </div>

      <!-- Autism Parent Guidance -->
      <div class="apple-glass-card apple-specular-top p-7 flex flex-col h-full group relative overflow-hidden">
        <div class="w-13 h-13 bg-sky-50/80 text-sky-700 rounded-2xl flex items-center justify-center mb-6 group-hover:scale-105 transition-transform duration-300 shadow-xs border border-sky-100/50">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
        </div>
        <h3 class="text-xl font-bold text-brand-navy mb-3 group-hover:text-blue-900 transition-colors tracking-tight">Autism Parent Guidance</h3>
        <p class="text-gray-600 mb-6 flex-grow leading-relaxed text-sm md:text-base">Neurodiversity-affirming parent coaching, communication strategies, and sensory-friendly home structure for ASD.</p>
        <div class="pt-4 border-t border-gray-100/80 flex items-center justify-between mt-auto">
          <a href="/services/asd-support/" class="text-xs font-bold text-gray-500 hover:text-brand-navy transition-colors">
            Learn Details →
          </a>
          <a href="/book/?service=autism-support" class="apple-btn apple-btn-primary !py-2 !px-4 !text-xs font-semibold shadow-xs">
            Book Session
          </a>
        </div>
      </div>

      <!-- Behaviour Support -->
      <div class="apple-glass-card apple-specular-top p-7 flex flex-col h-full group relative overflow-hidden">
        <div class="w-13 h-13 bg-rose-50/80 text-rose-700 rounded-2xl flex items-center justify-center mb-6 group-hover:scale-105 transition-transform duration-300 shadow-xs border border-rose-100/50">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path></svg>
        </div>
        <h3 class="text-xl font-bold text-brand-navy mb-3 group-hover:text-blue-900 transition-colors tracking-tight">Behaviour Support</h3>
        <p class="text-gray-600 mb-6 flex-grow leading-relaxed text-sm md:text-base">Structured de-escalation tools, collaborative problem solving, and managing public meltdowns, aggression, and defiance.</p>
        <div class="pt-4 border-t border-gray-100/80 flex items-center justify-between mt-auto">
          <a href="/services/behaviour-planning/" class="text-xs font-bold text-gray-500 hover:text-brand-navy transition-colors">
            Learn Details →
          </a>
          <a href="/book/?service=behaviour-planning" class="apple-btn apple-btn-primary !py-2 !px-4 !text-xs font-semibold shadow-xs">
            Book Session
          </a>
        </div>
      </div>

      <!-- School & Learning Support -->
      <div class="apple-glass-card apple-specular-top p-7 flex flex-col h-full group relative overflow-hidden">
        <div class="w-13 h-13 bg-indigo-50/80 text-indigo-700 rounded-2xl flex items-center justify-center mb-6 group-hover:scale-105 transition-transform duration-300 shadow-xs border border-indigo-100/50">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" d="M12 14l9-5-9-5-9 5 9 5z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" d="M12 14v6"></path></svg>
        </div>
        <h3 class="text-xl font-bold text-brand-navy mb-3 group-hover:text-blue-900 transition-colors tracking-tight">School &amp; Learning Support</h3>
        <p class="text-gray-600 mb-6 flex-grow leading-relaxed text-sm md:text-base">Preparing for parent-teacher meetings, SENCO discussions, and tailoring practical classroom accommodations for your child.</p>
        <div class="pt-4 border-t border-gray-100/80 flex items-center justify-between mt-auto">
          <a href="/services/school-consultation/" class="text-xs font-bold text-gray-500 hover:text-brand-navy transition-colors">
            Learn Details →
          </a>
          <a href="/book/?service=school-consultation" class="apple-btn apple-btn-primary !py-2 !px-4 !text-xs font-semibold shadow-xs">
            Book Session
          </a>
        </div>
      </div>

      <!-- Assessment & Report Guidance -->
      <div class="apple-glass-card apple-specular-top p-7 flex flex-col h-full group relative overflow-hidden">
        <div class="w-13 h-13 bg-emerald-50/80 text-emerald-700 rounded-2xl flex items-center justify-center mb-6 group-hover:scale-105 transition-transform duration-300 shadow-xs border border-emerald-100/50">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
        </div>
        <h3 class="text-xl font-bold text-brand-navy mb-3 group-hover:text-blue-900 transition-colors tracking-tight">Assessment &amp; Report Review</h3>
        <p class="text-gray-600 mb-6 flex-grow leading-relaxed text-sm md:text-base">Translate complex percentile scores and clinical psychological jargon into concrete, parent-friendly home action items.</p>
        <div class="pt-4 border-t border-gray-100/80 flex items-center justify-between mt-auto">
          <a href="/report-review/" class="text-xs font-bold text-gray-500 hover:text-brand-navy transition-colors">
            Learn Details →
          </a>
          <a href="/book/?service=report-review" class="apple-btn apple-btn-primary !py-2 !px-4 !text-xs font-semibold shadow-xs">
            Book Session
          </a>
        </div>
      </div>

    </div>
  </div>
</section>

    </div>
  </div>
</section>
