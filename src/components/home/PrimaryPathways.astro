---
---
<section class="py-16 bg-gray-50 border-b border-gray-100">
  <div class="container mx-auto px-4 max-w-6xl">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8">

      <!-- Development & Assessment -->
      <a href="/parent-support" class="bg-white rounded-[24px] p-8 shadow-sm hover:shadow-md hover-lift transition-all border border-gray-100 flex flex-col group">
        <div class="w-14 h-14 bg-brand-cream text-brand-trust rounded-2xl flex items-center justify-center mb-6 shadow-sm group-hover:bg-brand-trust group-hover:text-white transition-colors">
          <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"></path></svg>
        </div>
        <h3 class="text-2xl font-bold text-brand-navy mb-4">Development & Assessment</h3>
        <p class="text-gray-600 mb-6 flex-grow leading-relaxed">
          Guidance and support for ADHD, autism, developmental concerns, and psychological assessment next steps.
        </p>
        <span class="inline-flex items-center text-brand-trust font-bold group-hover:text-brand-navy transition-colors mt-auto">
          Explore Support <svg class="w-5 h-5 ml-1 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
        </span>
      </a>

      <!-- Emotions & Behaviour -->
      <a href="/services/behaviour-planning" class="bg-white rounded-[24px] p-8 shadow-sm hover:shadow-md hover-lift transition-all border border-gray-100 flex flex-col group">
        <div class="w-14 h-14 bg-brand-cream text-brand-trust rounded-2xl flex items-center justify-center mb-6 shadow-sm group-hover:bg-brand-trust group-hover:text-white transition-colors">
          <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path></svg>
        </div>
        <h3 class="text-2xl font-bold text-brand-navy mb-4">Emotions & Behaviour</h3>
        <p class="text-gray-600 mb-6 flex-grow leading-relaxed">
          Practical strategies for managing meltdowns, anxiety, emotional regulation, and challenging behaviour at home.
        </p>
        <span class="inline-flex items-center text-brand-trust font-bold group-hover:text-brand-navy transition-colors mt-auto">
          Explore Support <svg class="w-5 h-5 ml-1 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
        </span>
      </a>

      <!-- Parent & School Guidance -->
      <a href="/services/school-consultation" class="bg-white rounded-[24px] p-8 shadow-sm hover:shadow-md hover-lift transition-all border border-gray-100 flex flex-col group">
        <div class="w-14 h-14 bg-brand-cream text-brand-trust rounded-2xl flex items-center justify-center mb-6 shadow-sm group-hover:bg-brand-trust group-hover:text-white transition-colors">
          <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 14l9-5-9-5-9 5 9 5z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 14v6"></path></svg>
        </div>
        <h3 class="text-2xl font-bold text-brand-navy mb-4">Parent & School Guidance</h3>
        <p class="text-gray-600 mb-6 flex-grow leading-relaxed">
          Clear actionable plans, clinical report interpretation, and collaborative school meeting support.
        </p>
        <span class="inline-flex items-center text-brand-trust font-bold group-hover:text-brand-navy transition-colors mt-auto">
          Explore Support <svg class="w-5 h-5 ml-1 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
        </span>
      </a>

    </div>
  </div>
</section>
