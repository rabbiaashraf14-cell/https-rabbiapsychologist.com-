---
import { Image } from 'astro:assets';
import profileImage from '../../assets/rabbia-ashraf-professional-profile.webp';

interface Props {
  videoUrl?: string;
}

const { videoUrl = "https://www.youtube-nocookie.com/embed/dQw4w9WgXcQ" } = Astro.props;
---

<section class="py-16 md:py-24 bg-gradient-to-b from-white via-brand-cream/30 to-white relative overflow-hidden" id="video-tour">
  <!-- Subtle ambient decorative glow -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-brand-sky/20 rounded-full blur-3xl pointer-events-none"></div>

  <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-6xl relative z-10">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-12 lg:mb-16">
      <span class="inline-flex items-center gap-2 py-1.5 px-4 rounded-full bg-brand-trust/10 text-brand-navy text-xs font-bold tracking-wider uppercase mb-4 border border-brand-trust/20">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-ping"></span>
        Meet Your Clinical Psychologist
      </span>
      <h2 class="text-3xl md:text-5xl font-extrabold text-brand-navy tracking-tight mb-4">
        Care That Starts with Understanding
      </h2>
      <p class="text-base md:text-lg text-gray-700 leading-relaxed">
        See how our 1-on-1 private video consultations bridge clinical expertise with empathetic, practical support for parents across the UK, USA, Gulf, and worldwide.
      </p>
    </div>

    <!-- Video Showcase Card & Steps Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
      
      <!-- Left: Interactive Video Player Card (7 cols) -->
      <div class="lg:col-span-7">
        <div class="relative group rounded-3xl p-2 bg-gradient-to-tr from-brand-gold/30 via-brand-trust/20 to-brand-sky/40 shadow-2xl transition-all duration-500 hover:shadow-brand-trust/20">
          
          <!-- Outer screen frame -->
          <div class="relative rounded-[22px] overflow-hidden bg-brand-navy aspect-video flex items-center justify-center">
            
            <!-- Poster / Thumbnail Image with soft overlay -->
            <Image
              src={profileImage}
              alt="Clinical Psychologist Rabbia Ashraf welcoming parents to private consultations"
              class="w-full h-full object-cover object-top opacity-85 group-hover:scale-105 transition-transform duration-700"
              width={800}
              height={450}
            />

            <!-- Gradient dark vignette for clinical luxury feel -->
            <div class="absolute inset-0 bg-gradient-to-t from-brand-navy/90 via-brand-navy/40 to-transparent"></div>

            <!-- Top Header Bar inside Video Preview -->
            <div class="absolute top-4 left-4 right-4 flex items-center justify-between pointer-events-none">
              <div class="inline-flex items-center gap-2 bg-black/60 backdrop-blur-md px-3 py-1.5 rounded-full text-xs text-white font-medium border border-white/10">
                <span class="w-2 h-2 rounded-full bg-red-500 animate-pulse"></span>
                <span>Video Introduction (2 Min)</span>
              </div>
              <span class="bg-white/20 backdrop-blur-md text-white text-[11px] font-semibold px-2.5 py-1 rounded-md">
                HD 1080p
              </span>
            </div>

            <!-- Central Animated Play Button -->
            <button
              id="open-video-modal-btn"
              type="button"
              class="absolute z-20 group/btn flex items-center justify-center cursor-pointer focus:outline-none focus:ring-4 focus:ring-brand-gold/60 rounded-full transition-transform duration-300 hover:scale-110 active:scale-95"
              aria-label="Play welcome video by Clinical Psychologist Rabbia Ashraf"
            >
              <div class="relative w-20 h-20 md:w-24 md:h-24 flex items-center justify-center">
                <!-- Glowing pulsing ring -->
                <div class="absolute inset-0 bg-brand-gold rounded-full opacity-40 animate-ping"></div>
                <!-- Main button disk -->
                <div class="relative w-16 h-16 md:w-20 md:h-20 bg-brand-gold hover:bg-yellow-400 text-brand-navy rounded-full shadow-2xl flex items-center justify-center transition-all duration-300">
                  <svg class="w-8 h-8 md:w-9 md:h-9 text-brand-navy translate-x-0.5" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M8 5v14l11-7z"/>
                  </svg>
                </div>
              </div>
            </button>

            <!-- Bottom Video Card Metadata -->
            <div class="absolute bottom-4 left-4 right-4 flex items-end justify-between pointer-events-none">
              <div>
                <p class="text-white font-bold text-sm md:text-base drop-shadow-md">What to Expect in Your Session</p>
                <p class="text-gray-300 text-xs drop-shadow-sm">Rabbia Ashraf • Clinical Psychologist</p>
              </div>
              <div class="bg-brand-navy/80 backdrop-blur-md px-3 py-1 rounded-lg border border-white/10 text-brand-gold text-xs font-semibold">
                Tap to Watch
              </div>
            </div>

          </div>
        </div>

        <!-- Trust Caption below Video -->
        <div class="mt-4 flex items-center justify-between text-xs text-gray-500 px-2">
          <span class="flex items-center gap-1.5">
            <svg class="w-4 h-4 text-emerald-600" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
            100% Confidential Telehealth
          </span>
          <span class="flex items-center gap-1.5">
            <svg class="w-4 h-4 text-brand-trust" fill="currentColor" viewBox="0 0 20 20"><path d="M13 6a3 3 0 11-6 0 3 3 0 016 0zM18 8a2 2 0 11-4 0 2 2 0 014 0zM14 15a4 4 0 00-8 0v3h8v-3zM6 8a2 2 0 11-4 0 2 2 0 014 0zM16 18v-3a5.972 5.972 0 00-.75-2.906A3.005 3.005 0 0119 15v3h-3zM4.75 12.094A5.973 5.973 0 004 15v3H1v-3a3 3 0 013.75-2.906z"/></svg>
            No Waitlist • Immediate Booking
          </span>
          <span class="hidden sm:flex items-center gap-1.5">
            <svg class="w-4 h-4 text-brand-gold" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
            Evidence-Based
          </span>
        </div>
      </div>

      <!-- Right: What Happens in a Video Consultation (5 cols) -->
      <div class="lg:col-span-5 flex flex-col justify-center space-y-6">
        <div>
          <h3 class="text-2xl font-bold text-brand-navy mb-2">How Our Video Consultations Work</h3>
          <p class="text-sm md:text-base text-gray-600 leading-relaxed">
            No clinical jargon or cold checklists. We look past surface behaviors to uncover root causes and build an actionable roadmap for your child.
          </p>
        </div>

        <div class="space-y-4">
          <!-- Item 1 -->
          <div class="flex items-start gap-4 p-4 rounded-2xl bg-white border border-gray-100 shadow-sm hover:shadow-md transition-shadow">
            <div class="w-10 h-10 rounded-xl bg-blue-50 text-brand-trust flex items-center justify-center font-bold text-base shrink-0">
              1
            </div>
            <div>
              <h4 class="font-bold text-brand-navy text-sm md:text-base mb-0.5">Comprehensive Developmental History</h4>
              <p class="text-xs md:text-sm text-gray-600 leading-relaxed">
                We review school feedback, past reports, daily routines, and specific triggers without judgment.
              </p>
            </div>
          </div>

          <!-- Item 2 -->
          <div class="flex items-start gap-4 p-4 rounded-2xl bg-white border border-gray-100 shadow-sm hover:shadow-md transition-shadow">
            <div class="w-10 h-10 rounded-xl bg-amber-50 text-amber-700 flex items-center justify-center font-bold text-base shrink-0">
              2
            </div>
            <div>
              <h4 class="font-bold text-brand-navy text-sm md:text-base mb-0.5">Behavioral & Neurodivergent Profiling</h4>
              <p class="text-xs md:text-sm text-gray-600 leading-relaxed">
                Distinguish sensory overload, ADHD executive dysfunction, or autism traits from normal developmental phases.
              </p>
            </div>
          </div>

          <!-- Item 3 -->
          <div class="flex items-start gap-4 p-4 rounded-2xl bg-white border border-gray-100 shadow-sm hover:shadow-md transition-shadow">
            <div class="w-10 h-10 rounded-xl bg-emerald-50 text-emerald-700 flex items-center justify-center font-bold text-base shrink-0">
              3
            </div>
            <div>
              <h4 class="font-bold text-brand-navy text-sm md:text-base mb-0.5">Concrete Strategy & School Plan</h4>
              <p class="text-xs md:text-sm text-gray-600 leading-relaxed">
                Leave with specific home routines, de-escalation scripts, IEP accommodation wording, and follow-up tools.
              </p>
            </div>
          </div>
        </div>

        <!-- Action Buttons -->
        <div class="flex flex-col sm:flex-row items-center gap-3 pt-2">
          <a
            href="/book"
            class="w-full sm:w-auto px-7 py-3.5 bg-brand-navy text-white rounded-xl font-bold text-sm md:text-base hover:bg-blue-900 transition-all shadow-md hover:shadow-lg hover:-translate-y-0.5 text-center flex items-center justify-center gap-2"
          >
            <span>Book Video Consultation</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
          </a>
          <a
            href="/screener"
            class="w-full sm:w-auto px-6 py-3.5 bg-white text-brand-navy border border-gray-300 rounded-xl font-bold text-sm md:text-base hover:bg-gray-50 transition-all shadow-sm hover:-translate-y-0.5 text-center"
          >
            Take 60s Screener First
          </a>
        </div>

      </div>

    </div>

  </div>

  <!-- Interactive Video Modal -->
  <div
    id="video-modal-backdrop"
    class="fixed inset-0 z-50 bg-brand-navy/90 backdrop-blur-md flex items-center justify-center p-4 sm:p-6 opacity-0 pointer-events-none transition-opacity duration-300"
    role="dialog"
    aria-modal="true"
    aria-labelledby="modal-title"
  >
    <div
      id="video-modal-container"
      class="relative w-full max-w-4xl bg-brand-navy rounded-3xl overflow-hidden shadow-2xl border border-white/20 transform scale-95 transition-transform duration-300"
    >
      <!-- Close Button -->
      <button
        id="close-video-modal-btn"
        type="button"
        class="absolute top-4 right-4 z-30 w-10 h-10 rounded-full bg-black/60 text-white hover:bg-black/80 flex items-center justify-center transition-colors focus:outline-none focus:ring-2 focus:ring-white"
        aria-label="Close video"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>

      <!-- Modal Content: Video & Clinical Context -->
      <div class="aspect-video bg-black relative flex flex-col justify-center items-center">
        <!-- Interactive Simulated Video Player Interface with Playback States -->
        <div id="video-embed-box" class="w-full h-full flex flex-col justify-between p-6 sm:p-8 bg-gradient-to-t from-black via-slate-900 to-black text-white relative">
          
          <div class="flex items-center gap-3">
            <span class="w-3 h-3 rounded-full bg-emerald-500 animate-pulse"></span>
            <span id="modal-title" class="font-bold text-sm sm:text-base text-gray-200">Consultation Introduction • Clinical Psychologist Rabbia Ashraf</span>
          </div>

          <!-- Video Central Message & Highlights -->
          <div class="max-w-xl text-center mx-auto my-auto py-6">
            <div class="w-16 h-16 rounded-full bg-brand-gold/20 text-brand-gold flex items-center justify-center mx-auto mb-4 border border-brand-gold/40">
              <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/>
              </svg>
            </div>
            <h4 class="text-xl sm:text-2xl font-bold mb-2">Welcome to Rabbia Child Development Services</h4>
            <p class="text-xs sm:text-sm text-gray-300 leading-relaxed mb-6">
              "Every child's behaviour communicates an underlying neurological, sensory, or emotional need. In our consultations, you get an evidence-based roadmap tailored for your family's exact reality."
            </p>
            <div class="flex flex-wrap justify-center gap-3">
              <a
                href="/book"
                class="px-6 py-2.5 bg-brand-gold text-brand-navy rounded-xl font-bold text-sm hover:bg-yellow-400 transition-colors shadow-md"
              >
                Schedule Your 50-Min Consultation
              </a>
              <a
                href="https://wa.me/923364114002?text=Hello%20Rabbia,%20I%20watched%20your%20consultation%20overview%20and%20would%20like%20to%20discuss%20my%20child's%20needs."
                target="_blank"
                rel="noopener noreferrer"
                class="px-5 py-2.5 bg-emerald-600 text-white rounded-xl font-bold text-sm hover:bg-emerald-500 transition-colors shadow-md inline-flex items-center gap-1.5"
              >
                Direct WhatsApp Enquiry
              </a>
            </div>
          </div>

          <!-- Bottom Control Bar -->
          <div class="w-full flex items-center justify-between text-xs text-gray-400 border-t border-white/10 pt-3">
            <div class="flex items-center gap-3">
              <span>0:00 / 2:15</span>
              <span class="text-emerald-400">• Online Worldwide (UK, USA, Gulf & Pakistan)</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-[11px] bg-white/10 px-2 py-0.5 rounded">Child & Adolescent Specialist</span>
            </div>
          </div>
        </div>

      </div>

    </div>
  </div>
</section>

<script>
  function setupVideoModal() {
    const openBtn = document.getElementById('open-video-modal-btn');
    const closeBtn = document.getElementById('close-video-modal-btn');
    const backdrop = document.getElementById('video-modal-backdrop');
    const container = document.getElementById('video-modal-container');

    if (!openBtn || !backdrop || !closeBtn || !container) return;

    function openModal() {
      backdrop.classList.remove('opacity-0', 'pointer-events-none');
      backdrop.classList.add('opacity-100', 'pointer-events-auto');
      container.classList.remove('scale-95');
      container.classList.add('scale-100');
      document.body.style.overflow = 'hidden';
    }

    function closeModal() {
      backdrop.classList.add('opacity-0', 'pointer-events-none');
      backdrop.classList.remove('opacity-100', 'pointer-events-auto');
      container.classList.add('scale-95');
      container.classList.remove('scale-100');
      document.body.style.overflow = '';
    }

    openBtn.addEventListener('click', openModal);
    closeBtn.addEventListener('click', closeModal);

    backdrop.addEventListener('click', (e) => {
      if (e.target === backdrop) {
        closeModal();
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !backdrop.classList.contains('pointer-events-none')) {
        closeModal();
      }
    });
  }

  // Support Astro View Transitions and initial load
  setupVideoModal();
  document.addEventListener('astro:page-load', setupVideoModal);
</script>
