---
---
<div class="relative overflow-hidden bg-brand-cream py-10 lg:py-16 flex items-center">
  <div class="absolute inset-0 bg-gradient-to-br from-brand-cream to-blue-50 z-0 pointer-events-none"></div>
  <div class="absolute -top-40 -right-40 w-96 h-96 bg-brand-sky/30 rounded-full blur-3xl opacity-50"></div>
  <div class="absolute top-40 -left-40 w-96 h-96 bg-brand-lavender/30 rounded-full blur-3xl opacity-50"></div>

  <!-- Subtle decorative abstract shapes -->
  <svg class="absolute top-1/4 right-1/4 w-32 h-32 text-brand-gold/10 animate-spin-slow pointer-events-none hidden lg:block" fill="none" viewBox="0 0 24 24" stroke="currentColor">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M12 4v16m8-8H4" />
  </svg>
  <svg class="absolute bottom-1/4 left-1/3 w-24 h-24 text-brand-navy/5 pointer-events-none hidden lg:block" fill="none" viewBox="0 0 24 24" stroke="currentColor">
    <circle cx="12" cy="12" r="10" stroke-width="1" />
  </svg>

  <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-16 items-center">

      <!-- Text Content: Mobile order-1, Desktop: order-1 -->
      <div class="order-1 text-center lg:text-left animate-fade-in-up">
        <span class="inline-block py-1 px-3 rounded-full bg-white text-brand-navy text-xs lg:text-sm font-bold tracking-wide uppercase mb-6 shadow-sm border border-brand-gold/30">
          Guiding Child Development with Care, Clarity, and Expertise
        </span>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-brand-navy mb-6 tracking-tight leading-tight">
          Child Development & Parent Guidance
        </h1>
        <p class="text-lg md:text-xl text-gray-700 max-w-2xl mx-auto lg:mx-0 mb-8 leading-relaxed">
          Support for ADHD, autism, behaviour, school difficulties, emotional regulation, report understanding, and developmental concerns.
        </p>
        <div class="flex flex-col sm:flex-row justify-center lg:justify-start items-center gap-4 mb-8">
          <a href="/book" class="w-full sm:w-auto px-8 py-3 md:py-4 bg-brand-navy text-white rounded-[12px] font-bold text-lg hover:bg-blue-900 transition-all shadow-md hover:shadow-lg hover:-translate-y-1">
            Book Parent Consultation
          </a>
          <a href="/services" class="w-full sm:w-auto px-8 py-3 md:py-4 bg-transparent text-brand-navy border-2 border-brand-navy rounded-[12px] font-bold text-lg hover:bg-white/50 transition-all shadow-sm hover:-translate-y-1">
            View Services
          </a>
        </div>

        <!-- Credibility Row -->
        <div class="flex flex-wrap justify-center lg:justify-start gap-4 text-sm font-semibold text-gray-600">
          <span class="flex items-center gap-1.5">
            <svg class="w-4 h-4 text-brand-trust" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
            Online Worldwide
          </span>
          <span class="flex items-center gap-1.5">
            <svg class="w-4 h-4 text-brand-trust" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
            Lahore Assessments
          </span>
          <span class="flex items-center gap-1.5">
            <svg class="w-4 h-4 text-brand-trust" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
            ADHD & Autism Support
          </span>
          <span class="flex items-center gap-1.5">
            <svg class="w-4 h-4 text-brand-trust" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
            Parent-Friendly Guidance
          </span>
          <span class="flex items-center gap-1.5">
            <svg class="w-4 h-4 text-brand-trust" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
            Clinical Psychologist
          </span>
        </div>
      </div>

      <!-- Visual Trust Panel: Mobile order-2, Desktop: order-2 -->
      <div class="order-2 flex justify-center lg:justify-end animate-fade-in-up" style="animation-delay: 0.2s;">
        <div class="relative w-full max-w-[500px]">
          <!-- Subtle Background Visual -->
          <div class="absolute inset-0 bg-brand-sky/20 blur-2xl rounded-full transform -translate-x-4 translate-y-4"></div>

          <div class="relative z-10 w-full flex flex-col gap-4">

            <!-- Trust Card 1 -->
            <div class="bg-white/95 backdrop-blur-sm border border-gray-100 rounded-[16px] p-5 lg:p-6 shadow-[0_4px_20px_-4px_rgba(0,0,0,0.05)] flex items-start gap-4">
              <div class="w-12 h-12 rounded-full bg-brand-cream flex items-center justify-center shrink-0">
                <svg class="w-6 h-6 text-brand-trust" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
              <div>
                <h3 class="text-base font-bold text-brand-navy mb-1">Evidence-Informed Support</h3>
                <p class="text-sm text-gray-600 leading-relaxed">Practical psychological guidance grounded in child development and family needs.</p>
              </div>
            </div>

            <!-- Trust Card 2 -->
            <div class="bg-white/95 backdrop-blur-sm border border-gray-100 rounded-[16px] p-5 lg:p-6 shadow-[0_4px_20px_-4px_rgba(0,0,0,0.05)] flex items-start gap-4">
              <div class="w-12 h-12 rounded-full bg-brand-cream flex items-center justify-center shrink-0">
                <svg class="w-6 h-6 text-brand-trust" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
                </svg>
              </div>
              <div>
                <h3 class="text-base font-bold text-brand-navy mb-1">For Parents & Families</h3>
                <p class="text-sm text-gray-600 leading-relaxed">Clear recommendations you can understand and use in everyday life.</p>
              </div>
            </div>

            <!-- Trust Card 3 -->
            <div class="bg-white/95 backdrop-blur-sm border border-gray-100 rounded-[16px] p-5 lg:p-6 shadow-[0_4px_20px_-4px_rgba(0,0,0,0.05)] flex items-start gap-4">
              <div class="w-12 h-12 rounded-full bg-brand-cream flex items-center justify-center shrink-0">
                <svg class="w-6 h-6 text-brand-trust" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
              <div>
                <h3 class="text-base font-bold text-brand-navy mb-1">Online & Lahore</h3>
                <p class="text-sm text-gray-600 leading-relaxed">Worldwide online consultations with assessment services available in Lahore.</p>
              </div>
            </div>

          </div>
        </div>
      </div>

    </div>
  </div>
</div>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .animate-fade-in-up {
      animation: fadeInUp 0.8s ease-out forwards;
      opacity: 0;
      transform: translateY(20px);
    }
  }
  @keyframes fadeInUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
