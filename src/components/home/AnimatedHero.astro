---
---
<div class="relative overflow-hidden bg-brand-cream py-8 lg:py-24 flex items-center min-h-[75vh]">
  <div class="absolute inset-0 bg-gradient-to-br from-brand-cream to-blue-50 z-0 pointer-events-none"></div>
  <div class="absolute -top-40 -right-40 w-96 h-96 bg-brand-sky/30 rounded-full blur-3xl opacity-50"></div>
  <div class="absolute top-40 -left-40 w-96 h-96 bg-brand-lavender/30 rounded-full blur-3xl opacity-50"></div>

  <!-- Subtle decorative abstract shapes -->
  <svg class="absolute top-1/4 right-1/4 w-32 h-32 text-brand-gold/10 animate-spin-slow pointer-events-none hidden lg:block" fill="none" viewBox="0 0 24 24" stroke="currentColor">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M12 4v16m8-8H4" />
  </svg>
  <svg class="absolute bottom-1/4 left-1/3 w-24 h-24 text-brand-navy/5 pointer-events-none hidden lg:block" fill="none" viewBox="0 0 24 24" stroke="currentColor">
    <circle cx="12" cy="12" r="10" stroke-width="1" />
  </svg>

  <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-16 items-center">

      <!-- Text Content: Mobile order-1, Desktop: order-1 -->
      <div class="order-1 text-center lg:text-left animate-fade-in-up">
        <span class="inline-block py-1 px-3 rounded-full bg-white text-brand-navy text-xs lg:text-sm font-bold tracking-wide uppercase mb-6 shadow-sm border border-brand-gold/30">
          CHILD & ADOLESCENT CLINICAL PSYCHOLOGY
        </span>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-brand-navy mb-6 tracking-tight leading-tight">
          Understand what’s behind the behaviour.<br/>Help your child move forward.
        </h1>
        <p class="text-lg md:text-xl text-gray-700 max-w-2xl mx-auto lg:mx-0 mb-8 leading-relaxed">
          Evidence-informed assessment, parent guidance and psychological support for ADHD, autism, emotional regulation, behaviour, school difficulties and developmental concerns.
        </p>
        <div class="flex flex-col sm:flex-row justify-center lg:justify-start items-center gap-4 mb-8">
          <a href="/book" class="w-full sm:w-auto px-8 py-3 md:py-4 bg-brand-navy text-white rounded-lg font-bold text-lg hover:bg-blue-900 transition-all shadow-lg hover:shadow-xl hover:-translate-y-1">
            Book Parent Consultation
          </a>
          <a href="/services" class="w-full sm:w-auto px-8 py-3 md:py-4 bg-white text-brand-navy border-2 border-brand-navy rounded-lg font-bold text-lg hover:bg-gray-50 transition-all shadow-sm hover:-translate-y-1">
            View Services
          </a>
        </div>

        <!-- Credibility Row -->
        <div class="flex flex-wrap justify-center lg:justify-start gap-4 text-sm font-semibold text-gray-600">
          <span class="flex items-center gap-1.5">
            <svg class="w-4 h-4 text-brand-trust" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
            Online Worldwide
          </span>
          <span class="flex items-center gap-1.5">
            <svg class="w-4 h-4 text-brand-trust" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
            Lahore Assessments
          </span>
          <span class="flex items-center gap-1.5">
            <svg class="w-4 h-4 text-brand-trust" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
            Parent-Friendly Guidance
          </span>
          <span class="flex items-center gap-1.5">
            <svg class="w-4 h-4 text-brand-trust" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
            Clinical Psychologist
          </span>
        </div>
      </div>

      <!-- Service Navigator: Mobile order-2, Desktop: order-2 -->
      <div class="order-2 w-full max-w-lg mx-auto lg:mx-0 lg:ml-auto animate-fade-in-up" style="animation-delay: 0.2s;">
        <div class="bg-white/80 backdrop-blur-md rounded-[28px] p-6 sm:p-8 shadow-xl border border-white/50 relative overflow-hidden">
          <!-- Subtle glow effect behind cards -->
          <div class="absolute inset-0 bg-gradient-to-br from-brand-sky/10 to-brand-cream/10 z-0 pointer-events-none"></div>

          <div class="relative z-10">
            <h2 class="text-2xl font-bold text-brand-navy mb-6">How can I help your child?</h2>

            <div class="grid grid-cols-2 gap-3 sm:gap-4 mb-6">
              <a href="/services/adhd-support" class="bg-white px-4 py-3 sm:py-4 rounded-2xl shadow-sm border border-gray-100 hover:shadow-md hover:border-brand-sky/30 hover:-translate-y-0.5 transition-all flex flex-col justify-center group">
                <span class="text-sm sm:text-base font-bold text-brand-navy group-hover:text-brand-trust transition-colors">ADHD & Attention</span>
              </a>
              <a href="/services/asd-support" class="bg-white px-4 py-3 sm:py-4 rounded-2xl shadow-sm border border-gray-100 hover:shadow-md hover:border-brand-sky/30 hover:-translate-y-0.5 transition-all flex flex-col justify-center group">
                <span class="text-sm sm:text-base font-bold text-brand-navy group-hover:text-brand-trust transition-colors">Autism & Development</span>
              </a>
              <a href="/services/behaviour-planning" class="bg-white px-4 py-3 sm:py-4 rounded-2xl shadow-sm border border-gray-100 hover:shadow-md hover:border-brand-sky/30 hover:-translate-y-0.5 transition-all flex flex-col justify-center group">
                <span class="text-sm sm:text-base font-bold text-brand-navy group-hover:text-brand-trust transition-colors">Behaviour</span>
              </a>
              <a href="/services/behaviour-planning" class="bg-white px-4 py-3 sm:py-4 rounded-2xl shadow-sm border border-gray-100 hover:shadow-md hover:border-brand-sky/30 hover:-translate-y-0.5 transition-all flex flex-col justify-center group">
                <span class="text-sm sm:text-base font-bold text-brand-navy group-hover:text-brand-trust transition-colors">Emotional Regulation</span>
              </a>
              <a href="/services/school-consultation" class="bg-white px-4 py-3 sm:py-4 rounded-2xl shadow-sm border border-gray-100 hover:shadow-md hover:border-brand-sky/30 hover:-translate-y-0.5 transition-all flex flex-col justify-center group">
                <span class="text-sm sm:text-base font-bold text-brand-navy group-hover:text-brand-trust transition-colors">School Difficulties</span>
              </a>
              <a href="/report-review" class="bg-white px-4 py-3 sm:py-4 rounded-2xl shadow-sm border border-gray-100 hover:shadow-md hover:border-brand-sky/30 hover:-translate-y-0.5 transition-all flex flex-col justify-center group">
                <span class="text-sm sm:text-base font-bold text-brand-navy group-hover:text-brand-trust transition-colors">Psychological Assessment</span>
              </a>
            </div>

            <a href="/services" class="inline-flex items-center text-sm font-semibold text-brand-trust hover:text-brand-navy transition-colors group">
              Not sure where to start? <span class="ml-1 group-hover:translate-x-1 transition-transform">→ Find the right service</span>
            </a>
          </div>
        </div>
      </div>

    </div>
  </div>
</div>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .animate-fade-in-up {
      animation: fadeInUp 0.8s ease-out forwards;
      opacity: 0;
      transform: translateY(20px);
    }
  }
  @keyframes fadeInUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
