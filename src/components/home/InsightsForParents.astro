---
import { Image } from 'astro:assets';
import { articles } from '../../data/blogArticles';
import { getArticleImage, getCategoryFallbackSvg } from '../../utils/imageMatching';
import BlogImageSlideshow from '../blog/BlogImageSlideshow.astro';

// Sort by date, newest first, take top 3
const latestArticles = [...articles]
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime())
  .slice(0, 3);

// Dynamically import all blog images for proper image priority system
const localImages = import.meta.glob<{ default: ImageMetadata }>('/src/assets/blog/*.{jpeg,jpg,png,webp,gif}', { eager: true });
---

<section class="py-16 bg-white border-t border-gray-100">
  <div class="container mx-auto px-4 max-w-6xl">
    <div class="text-center mb-12">
      <span class="inline-block py-1 px-3 rounded-full bg-brand-cream text-brand-navy text-xs font-bold tracking-wide uppercase mb-4 shadow-sm border border-brand-gold/30">
        PARENT RESOURCES
      </span>
      <h2 class="text-3xl md:text-4xl font-bold text-brand-navy mb-4">Insights for Parents</h2>
      <p class="text-lg text-gray-700 max-w-2xl mx-auto">
        Practical, evidence-informed guidance for understanding your child's development, emotions and behaviour.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {latestArticles.map((article) => {
        const image = getArticleImage(article, localImages);
        return (
          <a href={article.href} class="bg-white rounded-[24px] shadow-sm hover:shadow-md hover-lift transition-all border border-gray-100 flex flex-col h-full group overflow-hidden">
            <div class="relative w-full aspect-[4/3] overflow-hidden bg-gray-50">
              {image.type === 'local' || image.type === 'remote' ? (
                <>
                  {image.type === 'local' ? (
                    <Image
                      src={image.src as ImageMetadata}
                      alt={article.title}
                      class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                      loading="lazy"
                      width={400}
                      height={300}
                    />
                  ) : (
                    <img
                      src={image.src as string}
                      alt={article.title}
                      class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                      loading="lazy"
                      onerror={`this.onerror=null; this.src='${getCategoryFallbackSvg(article.categories)}';`}
                    />
                  )}
                </>
              ) : (
                <div class="absolute inset-0 w-full h-full">
                  <BlogImageSlideshow articleTitle={article.title} fallbackSvg={image.src as string} />
                </div>
              )}
            </div>

            <div class="p-6 flex flex-col flex-grow">
              <span class="inline-block px-3 py-1 bg-brand-gold/10 text-brand-navy text-xs font-bold uppercase tracking-wide rounded-full self-start mb-4">
                {article.categories && article.categories.length > 0 ? article.categories[0] : 'Blog'}
              </span>
              <h3 class="text-xl font-bold text-brand-navy mb-3 group-hover:text-brand-trust transition-colors line-clamp-2">
                {article.title}
              </h3>
              <p class="text-gray-600 text-sm mb-6 flex-grow line-clamp-3">
                {article.excerpt}
              </p>
              <div class="mt-auto flex items-center text-sm font-bold text-brand-trust group-hover:text-brand-navy transition-colors">
                Read Article
                <svg class="w-4 h-4 ml-1 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
              </div>
            </div>
          </a>
        );
      })}
    </div>

    <div class="text-center mt-12">
      <a href="/blog" class="inline-flex items-center justify-center px-8 py-3 bg-white text-brand-navy border-2 border-brand-navy rounded-lg font-bold hover:bg-gray-50 transition-colors shadow-sm">
        View All Articles
      </a>
    </div>
  </div>
</section>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
