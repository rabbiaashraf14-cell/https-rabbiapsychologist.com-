---
import { Image } from 'astro:assets';
import { articles } from '../../data/blogArticles';
import { getArticleImage, getCategoryFallbackSvg } from '../../utils/imageMatching';
import BlogImageSlideshow from '../blog/BlogImageSlideshow.astro';

// Sort by date, newest first, take top 3 for the preview section
const latestArticles = [...articles]
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime())
  .slice(0, 3);

// Dynamically import all blog images for proper image priority system
const localImages = import.meta.glob<{ default: ImageMetadata }>('/src/assets/blog/*.{jpeg,jpg,png,webp,gif}', { eager: true });
---

<section class="py-16 bg-white border-t border-gray-100">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-7xl">
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold text-brand-navy mb-4">Parent Resources & Insights</h2>
      <p class="text-xl text-gray-700 max-w-3xl mx-auto">
        Practical psychology guidance for everyday parenting, development, behaviour, and emotional wellbeing.
      </p>
    </div>

    {latestArticles.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {latestArticles.map((article, index) => {
          const image = getArticleImage(article, localImages);

          return (
            <article class="bg-white rounded-[16px] overflow-hidden shadow-sm border border-gray-100 flex flex-col group hover:shadow-md transition-shadow">
              <a href={article.href} class="block relative w-full aspect-[16/10] overflow-hidden bg-gray-50">
                {image.type === 'local' || image.type === 'remote' ? (
                  <>
                    {image.type === 'local' ? (
                      <Image
                        src={image.src as ImageMetadata}
                        alt={article.title}
                        class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                        width={600}
                        height={375}
                      />
                    ) : (
                      <img
                        src={image.src as string}
                        alt={article.title}
                        class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                        loading="lazy"
                        onerror={`this.onerror=null; this.src='${getCategoryFallbackSvg(article.categories)}';`}
                      />
                    )}
                  </>
                ) : (
                  <div class="absolute inset-0 w-full h-full">
                    <BlogImageSlideshow articleTitle={article.title} fallbackSvg={image.src as string} />
                  </div>
                )}
              </a>

              <div class="p-6 flex flex-col flex-grow">
                <span class="inline-block px-3 py-1 bg-brand-cream text-brand-trust text-xs font-bold uppercase tracking-wide rounded-full self-start mb-4">
                  {article.categories && article.categories.length > 0 ? article.categories[0] : 'Insight'}
                </span>

                <h3 class="text-xl font-bold text-brand-navy mb-3 leading-tight group-hover:text-brand-trust transition-colors">
                  <a href={article.href}>{article.title}</a>
                </h3>

                <p class="text-gray-600 text-sm line-clamp-3 mb-6 flex-grow">
                  {article.excerpt}
                </p>

                <a href={article.href} class="inline-flex items-center gap-2 text-brand-trust font-bold text-sm mt-auto group-hover:translate-x-1 transition-transform">
                  Read Article
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
                </a>
              </div>
            </article>
          );
        })}
      </div>
    ) : (
      <div class="text-center py-10 bg-gray-50 rounded-xl border border-gray-100">
        <p class="text-gray-600">Resources and insights coming soon.</p>
      </div>
    )}

    <div class="text-center mt-12">
      <a href="/blog" class="inline-block px-8 py-3 bg-brand-cream text-brand-navy border border-brand-gold/30 rounded-lg font-bold text-sm hover:bg-brand-gold/20 transition-colors">
        View All Resources
      </a>
    </div>
  </div>
</section>

<style>
  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
