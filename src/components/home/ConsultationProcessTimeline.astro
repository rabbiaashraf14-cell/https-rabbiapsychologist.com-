---
import { regionalPricing } from '../../data/pricing';

const intlPrice = regionalPricing.parentGuidance.international.price;
const pkPrice = regionalPricing.parentGuidance.pakistan.price;
---

<section class="py-20 lg:py-24 bg-white relative overflow-hidden border-t border-gray-100" id="consultation-process">
  <!-- Soft background ambient glow -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[650px] h-[350px] bg-gradient-to-tr from-blue-50 via-emerald-50/40 to-amber-50/40 rounded-full blur-3xl pointer-events-none opacity-70"></div>

  <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-6xl relative z-10">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-brand-cream border border-brand-navy/10 text-xs font-semibold text-brand-navy uppercase tracking-wider mb-4">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        Zero Stress • Parent-Centered Care
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-brand-navy tracking-tight mb-4">
        What Actually Happens in a 50-Minute Consultation?
      </h2>
      <p class="text-base sm:text-lg text-gray-600 leading-relaxed">
        No sterile waiting rooms. No forcing a dysregulated child to sit in front of a webcam. A calm, structured clinical consultation focused entirely on equipping parents with actionable answers.
      </p>
    </div>

    <!-- 3-Step Process Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-12">
      
      <!-- Step 1 -->
      <div class="apple-glass-card apple-specular-top p-7 sm:p-8 flex flex-col justify-between relative group hover-lift bg-white">
        <div>
          <div class="flex items-center justify-between mb-6">
            <span class="w-12 h-12 rounded-2xl bg-blue-50 text-brand-navy border border-blue-100 flex items-center justify-center font-extrabold text-lg shadow-2xs">
              01
            </span>
            <span class="text-xs font-bold text-gray-400 uppercase tracking-wider">Before The Call</span>
          </div>
          <h3 class="text-xl font-bold text-brand-navy mb-3">
            Confidential Intake &amp; Report Review
          </h3>
          <p class="text-sm text-gray-600 leading-relaxed mb-4">
            You complete a brief 5-minute pre-session form detailing your child’s challenges, daily triggers, and school situation.
          </p>
          <ul class="text-xs text-gray-600 space-y-2 border-t border-gray-100 pt-3">
            <li class="flex items-start gap-2">
              <svg class="w-4 h-4 text-emerald-600 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <span>Upload prior speech, OT, or medical reports</span>
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-4 h-4 text-emerald-600 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <span>Rabbia prepares in advance so session time is 100% focused</span>
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-4 h-4 text-emerald-600 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <strong class="text-brand-navy">Child stays off-camera and relaxed</strong>
            </li>
          </ul>
        </div>
      </div>

      <!-- Step 2 -->
      <div class="apple-glass-card apple-specular-top p-7 sm:p-8 flex flex-col justify-between relative group hover-lift bg-white">
        <div>
          <div class="flex items-center justify-between mb-6">
            <span class="w-12 h-12 rounded-2xl bg-amber-50 text-amber-800 border border-amber-100 flex items-center justify-center font-extrabold text-lg shadow-2xs">
              02
            </span>
            <span class="text-xs font-bold text-gray-400 uppercase tracking-wider">During The Call</span>
          </div>
          <h3 class="text-xl font-bold text-brand-navy mb-3">
            50-Min 1-on-1 Video Strategy
          </h3>
          <p class="text-sm text-gray-600 leading-relaxed mb-4">
            We meet securely over Google Meet or Zoom to dissect the root causes behind behaviors, sensory triggers, and school friction.
          </p>
          <ul class="text-xs text-gray-600 space-y-2 border-t border-gray-100 pt-3">
            <li class="flex items-start gap-2">
              <svg class="w-4 h-4 text-emerald-600 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <span>Behavior decoded: Understanding the "Why" behind defiance or meltdowns</span>
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-4 h-4 text-emerald-600 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <span>Immediate triage for executive dysfunction &amp; sensory overloads</span>
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-4 h-4 text-emerald-600 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <span>Empathetic, zero-judgment parent guidance</span>
            </li>
          </ul>
        </div>
      </div>

      <!-- Step 3 -->
      <div class="apple-glass-card apple-specular-top p-7 sm:p-8 flex flex-col justify-between relative group hover-lift bg-white">
        <div>
          <div class="flex items-center justify-between mb-6">
            <span class="w-12 h-12 rounded-2xl bg-emerald-50 text-emerald-800 border border-emerald-100 flex items-center justify-center font-extrabold text-lg shadow-2xs">
              03
            </span>
            <span class="text-xs font-bold text-gray-400 uppercase tracking-wider">After The Call</span>
          </div>
          <h3 class="text-xl font-bold text-brand-navy mb-3">
            Written Action Roadmap (24–48 Hrs)
          </h3>
          <p class="text-sm text-gray-600 leading-relaxed mb-4">
            You don't have to scramble to take notes. You receive a structured, printable action plan outlining your child's tailored strategies.
          </p>
          <ul class="text-xs text-gray-600 space-y-2 border-t border-gray-100 pt-3">
            <li class="flex items-start gap-2">
              <svg class="w-4 h-4 text-emerald-600 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <span>Step-by-step home routines and morning/bedtime visual cues</span>
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-4 h-4 text-emerald-600 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <span>Exact scripts and accommodation wording for school &amp; IEP meetings</span>
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-4 h-4 text-emerald-600 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <span>Clear referral pathways if formal in-person assessment is recommended</span>
            </li>
          </ul>
        </div>
      </div>

    </div>

    <!-- Reassurance Banner with Fast Booking Actions -->
    <div class="bg-gradient-to-r from-brand-navy via-[#103358] to-brand-navy rounded-3xl p-6 sm:p-8 text-white flex flex-col md:flex-row items-center justify-between gap-6 shadow-md">
      <div>
        <div class="flex items-center gap-2 text-xs font-bold text-brand-gold uppercase tracking-wider mb-2">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
          Direct Telehealth Access • No Referral Necessary
        </div>
        <h3 class="text-xl sm:text-2xl font-bold text-white mb-1">
          Ready to bring calm and clarity to your home?
        </h3>
        <p class="text-xs sm:text-sm text-blue-100 max-w-xl">
          Consultation fee: 
          <span class="price-international font-bold text-white">${intlPrice} USD / £65 GBP / A$130 AUD</span>
          <span class="price-pakistan font-bold text-white">PKR {pkPrice.toLocaleString()}</span>
          — Booked directly with Clinical Psychologist Rabbia Ashraf.
        </p>
      </div>

      <div class="flex flex-col sm:flex-row items-center gap-3 shrink-0 w-full md:w-auto">
        <a
          href="/book/"
          class="w-full sm:w-auto apple-btn bg-white text-brand-navy hover:bg-gray-100 font-bold px-6 py-3 text-sm rounded-xl text-center shadow-sm"
        >
          Schedule Free 15-Min Call
        </a>
        <a
          href="https://wa.me/923364114002?text=Hi%20Rabbia,%20I%20would%20like%20to%20enquire%20about%20booking%20a%20consultation."
          target="_blank"
          rel="noopener noreferrer"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-[#25D366] text-white hover:bg-[#1EBE5D] font-bold px-5 py-3 text-sm rounded-xl text-center shadow-sm transition-colors"
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg>
          <span>Quick WhatsApp</span>
        </a>
      </div>
    </div>

  </div>
</section>
