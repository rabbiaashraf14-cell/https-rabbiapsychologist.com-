---
const cases = [
  {
    tag: 'Waitlist Bridge • London, UK',
    accentColor: 'blue',
    child: '6-Year-Old Boy (Suspected ADHD & Sensory Sensitivity)',
    struggle: 'Facing an 18-month NHS waiting list. Every morning was a 45-minute battle over sensory socks, task refusal, and arriving late at school. Teachers reported constant chair-rocking and circle-time disruptions.',
    solution: 'Constructed a sensory-safe morning sequence, dopamine-friendly visual transition ladder, and an evidence-backed classroom movement script for the school SENCO.',
    result: 'Morning transition reduced from 45 to 15 calm minutes. School implemented sensory movement breaks without disciplinary reprimands.'
  },
  {
    tag: 'Autism & Masking • Dubai, UAE',
    accentColor: 'emerald',
    child: '8-Year-Old Girl (After-School Restraint Collapse)',
    struggle: 'Praised as an "angelic, quiet student" by teachers, but suffered explosive 90-minute weeping meltdowns the moment she stepped inside the house. Mother was burdened with deep self-blame and exhaustion.',
    solution: 'Identified internalized sensory masking and nervous system exhaustion. Implemented a 45-minute "Zero-Demand Sensory Sanctuary" after school and arranged quiet lunchroom access.',
    result: 'After-school aggression dropped by over 80%. Mother gained clinical validation and school established a neuro-affirming support plan.'
  },
  {
    tag: 'Report Debrief • New Jersey, USA',
    accentColor: 'amber',
    child: '10-Year-Old Boy (Complex Neuropsych Report)',
    struggle: 'Parents received a 32-page psychoeducational report full of percentiles and clinical terminology. They felt completely lost and unprepared for their upcoming school IEP / 504 committee meeting.',
    solution: 'Translated the entire psychometric battery line-by-line. Highlighted the key discrepancy between high verbal reasoning and slow processing speed, boiling down 32 pages into a 4-point school accommodation roadmap.',
    result: 'School district approved all 4 accommodations—including reduced homework volume and extra time—during the initial meeting.'
  }
];
---

<section class="py-20 lg:py-24 bg-brand-cream/50 border-t border-gray-100 relative overflow-hidden" id="case-outcomes">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-6xl relative z-10">
    
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white border border-brand-navy/10 text-xs font-semibold text-brand-navy uppercase tracking-wider mb-4 shadow-2xs">
        <span class="w-2 h-2 rounded-full bg-brand-gold"></span>
        Clinical Transformation Scenarios
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-brand-navy tracking-tight mb-4">
        What Real Relief Looks Like in Practice
      </h2>
      <p class="text-base sm:text-lg text-gray-600 leading-relaxed">
        Every child’s nervous system is unique. Here is how structured 50-minute parent consultations turned everyday household distress into actionable, lasting strategies.
      </p>
    </div>

    <!-- 3 Vignette Cards Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 mb-12">
      {cases.map((item) => (
        <div class="apple-glass-card apple-specular-top p-7 sm:p-8 flex flex-col justify-between bg-white hover-lift">
          <div>
            <div class="inline-block bg-brand-cream text-brand-navy text-[11px] font-bold px-3 py-1 rounded-full uppercase tracking-wider mb-4 border border-brand-navy/5">
              {item.tag}
            </div>

            <h3 class="text-lg font-bold text-brand-navy mb-3">
              {item.child}
            </h3>

            <!-- The Challenge -->
            <div class="mb-4">
              <span class="text-[11px] font-extrabold text-gray-400 uppercase tracking-wider block mb-1">
                The Struggle
              </span>
              <p class="text-xs sm:text-sm text-gray-600 leading-relaxed">
                {item.struggle}
              </p>
            </div>

            <!-- The Clinical Plan -->
            <div class="mb-4 pt-3 border-t border-gray-100">
              <span class="text-[11px] font-extrabold text-brand-navy uppercase tracking-wider block mb-1">
                The Clinical Roadmap
              </span>
              <p class="text-xs sm:text-sm text-gray-600 leading-relaxed">
                {item.solution}
              </p>
            </div>
          </div>

          <!-- The Measurable Outcome -->
          <div class="mt-4 pt-4 border-t border-emerald-100 bg-emerald-50/60 -mx-7 -mb-7 sm:-mx-8 sm:-mb-8 p-5 sm:p-6 rounded-b-3xl">
            <span class="text-[11px] font-extrabold text-emerald-800 uppercase tracking-wider flex items-center gap-1.5 mb-1">
              <svg class="w-4 h-4 text-emerald-600" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
              The Transformation
            </span>
            <p class="text-xs font-medium text-emerald-950 leading-relaxed">
              {item.result}
            </p>
          </div>
        </div>
      ))}
    </div>

    <!-- Ethical Notice -->
    <div class="text-center text-[11px] text-gray-400 max-w-2xl mx-auto">
      *Case vignettes are anonymized clinical composites with identifying details altered to protect family privacy and clinical confidentiality.
    </div>

  </div>
</section>
