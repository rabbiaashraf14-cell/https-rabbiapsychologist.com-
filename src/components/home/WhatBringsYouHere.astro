---
---
<section class="py-16 bg-white">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-6xl">
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold text-brand-navy mb-4">What are you noticing?</h2>
      <p class="text-lg text-gray-700 max-w-2xl mx-auto">Providing practical clarity and guidance when you feel overwhelmed by your child’s developmental or behavioural needs.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">

      <!-- Card 1 -->
      <a href="/services/asd-support" class="bg-gray-50 rounded-2xl p-6 border border-gray-100 shadow-sm hover-lift group">
        <h3 class="text-xl font-bold text-brand-navy mb-3 group-hover:text-brand-trust transition-colors">
          "My child isn't communicating like other children."
        </h3>
        <p class="text-brand-trust font-bold text-sm inline-flex items-center group-hover:underline">
          Explore Autism Support <svg class="w-4 h-4 ml-1 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
        </p>
      </a>

      <!-- Card 2 -->
      <a href="/services/adhd-support" class="bg-gray-50 rounded-2xl p-6 border border-gray-100 shadow-sm hover-lift group">
        <h3 class="text-xl font-bold text-brand-navy mb-3 group-hover:text-brand-trust transition-colors">
          "School says my child struggles to focus."
        </h3>
        <p class="text-brand-trust font-bold text-sm inline-flex items-center group-hover:underline">
          Explore ADHD Support <svg class="w-4 h-4 ml-1 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
        </p>
      </a>

      <!-- Card 3 -->
      <a href="/services/learning-difficulties" class="bg-gray-50 rounded-2xl p-6 border border-gray-100 shadow-sm hover-lift group">
        <h3 class="text-xl font-bold text-brand-navy mb-3 group-hover:text-brand-trust transition-colors">
          "My child is bright but struggling academically."
        </h3>
        <p class="text-brand-trust font-bold text-sm inline-flex items-center group-hover:underline">
          Explore Learning Support <svg class="w-4 h-4 ml-1 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
        </p>
      </a>

      <!-- Card 4 -->
      <a href="/services/behaviour-planning" class="bg-gray-50 rounded-2xl p-6 border border-gray-100 shadow-sm hover-lift group">
        <h3 class="text-xl font-bold text-brand-navy mb-3 group-hover:text-brand-trust transition-colors">
          "Meltdowns or behaviour are becoming difficult to manage."
        </h3>
        <p class="text-brand-trust font-bold text-sm inline-flex items-center group-hover:underline">
          Explore Behaviour Planning <svg class="w-4 h-4 ml-1 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
        </p>
      </a>

      <!-- Card 5 -->
      <a href="/services/asd-support" class="bg-gray-50 rounded-2xl p-6 border border-gray-100 shadow-sm hover-lift group">
        <h3 class="text-xl font-bold text-brand-navy mb-3 group-hover:text-brand-trust transition-colors">
          "My child struggles socially or with other children."
        </h3>
        <p class="text-brand-trust font-bold text-sm inline-flex items-center group-hover:underline">
          Explore Support Options <svg class="w-4 h-4 ml-1 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
        </p>
      </a>

      <!-- Card 6 -->
      <a href="/services/parent-support" class="bg-gray-50 rounded-2xl p-6 border border-gray-100 shadow-sm hover-lift group">
        <h3 class="text-xl font-bold text-brand-navy mb-3 group-hover:text-brand-trust transition-colors">
          "I'm unsure whether this is autism, ADHD, a learning difficulty, or something else."
        </h3>
        <p class="text-brand-trust font-bold text-sm inline-flex items-center group-hover:underline">
          Book Parent Consultation <svg class="w-4 h-4 ml-1 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
        </p>
      </a>

    </div>
  </div>
</section>
