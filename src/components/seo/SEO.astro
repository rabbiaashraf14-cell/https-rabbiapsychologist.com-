      "credentialCategory": "clinical certification",
      "recognizedBy": {
        "@type": "Organization",
        "name": "Autism Diagnostic Observation Schedule Clinical Training"
      }
    }
  ],
  "availableService": [
    {
      "@type": "MedicalTherapy",
      "name": "Parent-Led Neurodevelopmental Guidance Consultation",
