---
interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  noindex?: boolean;
  schema?: any;
  keywords?: string;
  type?: string;
  image?: string;
}

const {
  title,
  description,
  canonical,
  ogTitle = title,
  ogDescription = description,
  ogImage = "/og-brand-card.png",
  noindex = false,
  schema,
  keywords,
  type = "website",
  image = "/og-brand-card.png"
} = Astro.props;

const siteName = "Rabbia Psychologist Child Development Services";
const shortSiteName = "Rabbia Psychologist";
const fullTitle = title.includes("Rabbia")
  ? title
  : `${title} | ${shortSiteName}`;

let canonicalNormalized = canonical;
if (!canonicalNormalized) {
  let pathname = Astro.url.pathname;
  if (!pathname.endsWith('/')) {
    pathname = `${pathname}/`;
  }
  canonicalNormalized = new URL(pathname, Astro.site || 'https://www.rabbiapsychologist.com').href;
} else if (!canonicalNormalized.endsWith('/') && !canonicalNormalized.split('/').pop()?.includes('.')) {
  canonicalNormalized = `${canonicalNormalized}/`;
}

const defaultEntitySchema = {
  "@context": "https://schema.org",
  "@type": "MedicalBusiness",
  "@id": "https://www.rabbiapsychologist.com/#organization",
  "name": "Rabbia Psychologist Child Development Services",
  "alternateName": "Rabbia Ashraf Clinical Psychology Practice",
  "url": "https://www.rabbiapsychologist.com",
  "logo": "https://www.rabbiapsychologist.com/favicon.png",
  "image": "https://www.rabbiapsychologist.com/og-brand-card.png",
  "description": "Global parent guidance and evidence-based child development consultation platform led by Clinical Psychologist Rabbia Ashraf (ADOS-2 Certified). Specializing in Autism, ADHD, executive function, sensory accommodations, and neuropsychological report reviews for families worldwide.",
  "medicalSpecialty": [
    "ClinicalPsychology",
    "PediatricPsychology",
    "NeurodevelopmentalAssessment"
  ],
  "priceRange": "$$",
  "currenciesAccepted": ["USD", "GBP", "AED", "AUD", "CAD", "PKR"],
  "telephone": "+923364114002",
  "email": "psychologistrabbia@gmail.com",
  "hasCredential": [
    {
      "@type": "EducationalOccupationalCredential",
      "name": "MS in Clinical Psychology",
      "credentialCategory": "degree"
    },
    {
      "@type": "EducationalOccupationalCredential",
