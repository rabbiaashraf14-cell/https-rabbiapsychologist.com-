    ],
    "hasCredential": [
      {
        "@type": "EducationalOccupationalCredential",
        "name": "MS in Clinical Psychology"
      },
      {
        "@type": "EducationalOccupationalCredential",
        "name": "ADOS-2 Certified Administrator"
      }
    ],
