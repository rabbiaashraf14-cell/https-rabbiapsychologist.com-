    },
    {
      "@type": "MedicalTherapy",
      "name": "18-Month Waitlist Bridge Support",
      "description": "Immediate clinical support and home intervention roadmaps for families on 12-24 month NHS or public healthcare assessment waitlists."
    },
    {
      "@type": "MedicalTherapy",
      "name": "Pediatric Neurodevelopmental Report Translation & IEP Review",
      "description": "Expert second-opinion decoding of ADOS-2, ADI-R, Conners 4, and WISC-V diagnostic reports into parent-friendly school and home strategies."
    }
  ],
  "founder": {
    "@type": "Person",
    "@id": "https://www.rabbiapsychologist.com/#rabbia-ashraf",
    "name": "Rabbia Ashraf",
    "jobTitle": "Clinical Psychologist & Child Development Specialist",
    "url": "https://www.rabbiapsychologist.com/about",
    "sameAs": [
      "https://www.linkedin.com/in/rabbiapsychologist",
