---
import { formatRegionalPrice } from '../../utils/pricing';
import type { ServiceKey } from '../../data/pricing';
import SaleBadge from './SaleBadge.astro';

interface Props {
  serviceKey: ServiceKey;
  size?: 'lg' | 'xl';
}

const { serviceKey, size = 'xl' } = Astro.props;
const textSize = size === 'xl' ? 'text-xl' : 'text-lg';

const intlPrice = formatRegionalPrice(serviceKey, 'international', true);
const pkPrice = formatRegionalPrice(serviceKey, 'pakistan', true);
---
<div class="mb-4">
  <!-- International Pricing Block -->
  <div class="price-international">
    {intlPrice.hasDiscount ? (
      <div class="flex flex-col">
        <div class="flex items-center gap-2 mb-1">
          <SaleBadge />
        </div>
        <p class={`text-sm text-gray-500 line-through mb-1`}>{intlPrice.original}</p>
        <p class={`${textSize} font-bold text-brand-navy mb-1`}>{intlPrice.discounted}</p>
      </div>
    ) : (
      <p class={`${textSize} font-bold text-brand-gold mb-1`}>{intlPrice.original}</p>
    )}
  </div>

  <!-- Pakistan Pricing Block -->
  <div class="price-pakistan">
    {pkPrice.hasDiscount ? (
      <div class="flex flex-col">
        <div class="flex items-center gap-2 mb-1">
          <SaleBadge />
        </div>
        <p class={`text-sm text-gray-500 line-through mb-1`}>{pkPrice.original}</p>
        <p class={`${textSize} font-bold text-brand-navy mb-1`}>{pkPrice.discounted}</p>
      </div>
    ) : (
      <p class={`${textSize} font-bold text-brand-gold mb-1`}>{pkPrice.original}</p>
    )}
  </div>
</div>
