<script is:inline>
  (function() {
    try {
      var setRegion = function(region) {
        document.documentElement.setAttribute('data-pricing-region', region);
      };

      // 1. Check for explicit saved preference first
      var saved = localStorage.getItem('rabbia_pricing_region') || sessionStorage.getItem('rabbia_pricing_region_session');
      if (saved === 'pakistan' || saved === 'international') {
        setRegion(saved);
        return;
      }

      // 2. Instant Zero-Latency Timezone Detection (Runs synchronously before DOM renders)
      var tz = '';
      try {
        tz = (window.Intl && Intl.DateTimeFormat) ? Intl.DateTimeFormat().resolvedOptions().timeZone : '';
      } catch (e) {}

      // Asia/Karachi indicates Pakistan resident
      var isPakistanTz = (tz === 'Asia/Karachi');
      setRegion(isPakistanTz ? 'pakistan' : 'international');

      // 3. Confirm / Refine via IP Geolocation in the background
      fetch('https://1.1.1.1/cdn-cgi/trace')
        .then(function(res) { return res.text(); })
        .then(function(data) {
          var match = data.match(/loc=([A-Z]{2})/);
          if (match && match[1]) {
            var detected = (match[1] === 'PK') ? 'pakistan' : 'international';
            setRegion(detected);
            sessionStorage.setItem('rabbia_pricing_region_session', detected);
          }
        })
        .catch(function() {
          fetch('https://get.geojs.io/v1/ip/country')
            .then(function(res) { return res.text(); })
            .then(function(country) {
              var detected = (country.trim() === 'PK') ? 'pakistan' : 'international';
              setRegion(detected);
              sessionStorage.setItem('rabbia_pricing_region_session', detected);
            })
            .catch(function() {});
        });
    } catch (e) {
      document.documentElement.setAttribute('data-pricing-region', 'international');
    }
  })();
</script>
