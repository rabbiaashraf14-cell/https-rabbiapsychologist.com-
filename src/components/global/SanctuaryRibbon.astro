---
import { regionalPricing } from '../../data/pricing';

const intlPrice = regionalPricing.parentGuidance.international.price;
const pkPrice = regionalPricing.parentGuidance.pakistan.price;
---

<div 
  id="sanctuary-top-ribbon" 
  class="relative z-50 bg-gradient-to-r from-[#0A233F] via-[#12365B] to-[#0A233F] text-white border-b border-white/10 transition-all duration-300"
  role="banner"
  aria-label="Clinical Telehealth Intake Availability"
>
  <div class="container mx-auto px-4 py-2 sm:py-2.5 flex items-center justify-between gap-3 text-xs">
    
    <!-- Left: Status Pulse & Mode Message -->
    <div class="flex items-center gap-2.5 overflow-hidden">
      <span class="inline-flex items-center gap-1.5 shrink-0 bg-emerald-500/20 text-emerald-300 border border-emerald-400/30 px-2 py-0.5 rounded-full text-[10px] sm:text-xs font-bold uppercase tracking-wider">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        <span id="ribbon-status-label">Live Intake Open</span>
      </span>
      
      <!-- B2C Message -->
      <p id="ribbon-message-parents" class="truncate text-white/95 font-medium text-[11px] sm:text-xs m-0">
        <span class="hidden md:inline">UK, USA, Gulf &amp; Pakistan Telehealth • </span>
        <span class="text-white font-bold">15 Minute Discovery Calls &amp; Sessions Available This Week</span>
        <span class="hidden lg:inline text-white/70"> — No GP Referral Needed</span>
      </p>

      <!-- B2B Message -->
      <p id="ribbon-message-schools" class="truncate text-white/95 font-medium text-[11px] sm:text-xs m-0 hidden">
        <span class="hidden md:inline">Institutional Inclusion Support • </span>
        <span class="text-white font-bold">KHDA, UK SEND Code &amp; PPA Aligned School Retainers</span>
        <span class="hidden lg:inline text-white/70"> — Booking Term Workshops &amp; Audits</span>
      </p>
    </div>

    <!-- Right: Regional Fee & Quick Actions -->
    <div class="flex items-center gap-3 shrink-0">
      
      <!-- Regional Fee Badge (Shown in Parents Mode) -->
      <span id="ribbon-fee-badge" class="hidden sm:inline-flex items-center gap-1 bg-white/10 px-2.5 py-0.5 rounded-lg border border-white/15 text-[11px] font-semibold text-white/90">
        <span class="price-international">${intlPrice} USD / £65</span>
        <span class="price-pakistan">PKR {pkPrice.toLocaleString()}</span>
      </span>

      <!-- Action Button: Book Slot (Parents) -->
      <a 
        id="ribbon-cta-parents"
        href="/book/" 
        class="inline-flex items-center gap-1 bg-emerald-600 hover:bg-emerald-500 text-white font-bold px-3 py-1 rounded-lg text-[11px] sm:text-xs transition-colors shadow-2xs whitespace-nowrap"
      >
        <span>Book Slot</span>
        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
      </a>

      <!-- Action Button: Institutional RFP (Schools) -->
      <a 
        id="ribbon-cta-schools"
        href="/school-partnerships/" 
        class="hidden items-center gap-1 bg-brand-gold hover:bg-amber-600 text-white font-bold px-3 py-1 rounded-lg text-[11px] sm:text-xs transition-colors shadow-2xs whitespace-nowrap"
      >
        <span>School RFP</span>
        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
      </a>

      <!-- Action Button 2: Quick WhatsApp (Hidden on small mobile) -->
      <a 
        href="https://wa.me/923364114002?text=Hi%20Rabbia,%20I%20would%20like%20to%20enquire%20about%20booking%20a%20consultation." 
        target="_blank"
        rel="noopener noreferrer"
        class="hidden lg:inline-flex items-center gap-1 text-white/80 hover:text-white text-[11px] font-medium transition-colors"
        aria-label="Direct WhatsApp Enquiry"
      >
        <span>WhatsApp</span>
        <svg class="w-3.5 h-3.5 text-[#25D366]" fill="currentColor" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg>
      </a>

    </div>

  </div>
</div>
