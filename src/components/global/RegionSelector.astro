---
---
<div class="flex items-center justify-center gap-4 text-sm mt-2 mb-6">
  <button
    id="btn-region-pakistan"
    class="text-gray-500 hover:text-brand-navy transition-colors font-medium border-b-2 border-transparent pb-1"
  >
    Pakistan 🇵🇰
  </button>
  <span class="text-gray-300">|</span>
  <button
    id="btn-region-international"
    class="text-gray-500 hover:text-brand-navy transition-colors font-medium border-b-2 border-transparent pb-1"
  >
    International 🌎
  </button>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const btnPk = document.getElementById('btn-region-pakistan');
    const btnIntl = document.getElementById('btn-region-international');

    function updateActiveState() {
      const currentRegion = document.documentElement.getAttribute('data-pricing-region') || 'international';

      if (currentRegion === 'pakistan') {
        btnPk?.classList.add('text-brand-navy', 'border-brand-navy');
        btnPk?.classList.remove('text-gray-500', 'border-transparent');

        btnIntl?.classList.remove('text-brand-navy', 'border-brand-navy');
        btnIntl?.classList.add('text-gray-500', 'border-transparent');
      } else {
        btnIntl?.classList.add('text-brand-navy', 'border-brand-navy');
        btnIntl?.classList.remove('text-gray-500', 'border-transparent');

        btnPk?.classList.remove('text-brand-navy', 'border-brand-navy');
        btnPk?.classList.add('text-gray-500', 'border-transparent');
      }
    }

    // Initialize state
    updateActiveState();

    // Listeners for manual override
    btnPk?.addEventListener('click', () => {
      document.documentElement.setAttribute('data-pricing-region', 'pakistan');
      localStorage.setItem('rabbia_pricing_region', 'pakistan');
      updateActiveState();
    });

    btnIntl?.addEventListener('click', () => {
      document.documentElement.setAttribute('data-pricing-region', 'international');
      localStorage.setItem('rabbia_pricing_region', 'international');
      updateActiveState();
    });

    // Handle case where detection completes slightly after DOM load
    const observer = new MutationObserver((mutations) => {
      mutations.forEach((mutation) => {
        if (mutation.attributeName === 'data-pricing-region') {
          updateActiveState();
        }
      });
    });

    observer.observe(document.documentElement, { attributes: true });
  });
</script>
