---
interface Props {
  paths?: Array<{ name: string; href: string }>;
}

const { paths } = Astro.props;
const pathname = new URL(Astro.request.url).pathname;

// Use explicit paths if passed, or auto-derive from URL segments
const derivedItems = paths || [
  { name: 'Home', href: '/' },
  ...pathname.split('/').filter(Boolean).map((segment, index, arr) => ({
    name: segment.charAt(0).toUpperCase() + segment.slice(1).replace(/-/g, ' '),
    href: '/' + arr.slice(0, index + 1).join('/') + '/'
  }))
];

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": derivedItems.map((item, index) => ({
    "@type": "ListItem",
    "position": index + 1,
    "name": item.name,
    "item": item.href.startsWith('http') ? item.href : `https://www.rabbiapsychologist.com${item.href.endsWith('/') ? item.href : item.href + '/'}`
  }))
};
---

<!-- JSON-LD Structured Breadcrumb Schema for SEO & AEO -->
<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

<nav aria-label="Breadcrumb" class="mb-6">
  <ol class="flex flex-wrap items-center text-xs sm:text-sm text-gray-500 gap-1">
    {derivedItems.map((item, index) => {
      const isLast = index === derivedItems.length - 1;
      return (
        <li class="flex items-center">
          {index > 0 && <span class="mx-1.5 text-gray-300">/</span>}
          {isLast ? (
            <span class="text-brand-navy font-semibold" aria-current="page">{item.name}</span>
          ) : (
            <a href={item.href.endsWith('/') ? item.href : item.href + '/'} class="hover:text-brand-navy transition-colors">{item.name}</a>
          )}
        </li>
      );
    })}
  </ol>
</nav>
