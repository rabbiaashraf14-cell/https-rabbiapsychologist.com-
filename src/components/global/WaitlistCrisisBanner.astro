---
interface Props {
  condition?: string;
}

const { condition = "developmental assessments" } = Astro.props;
---

<div class="apple-glass-card apple-specular-top p-6 sm:p-7 rounded-3xl my-8 border border-brand-gold/30 bg-gradient-to-br from-white/95 via-amber-50/20 to-blue-50/20 shadow-lg text-left relative overflow-hidden">
  <!-- Subtle ambient glow -->
  <div class="absolute -top-12 -right-12 w-36 h-36 bg-amber-400/10 rounded-full blur-2xl pointer-events-none"></div>

  <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-6 relative z-10">
    <div class="space-y-2 max-w-2xl">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-100/80 border border-amber-300 text-amber-900 text-[11px] font-bold uppercase tracking-wider">
        <span class="w-2 h-2 rounded-full bg-amber-500 animate-pulse"></span>
        Waitlist Support Initiative &bull; UK &bull; Australia &bull; USA &bull; Global
      </div>
      
      <h3 class="text-xl sm:text-2xl font-bold text-brand-navy tracking-tight">
        Stuck on a 6 to 18-Month Public Assessment Waitlist?
      </h3>
      
      <p class="text-sm text-gray-700 leading-relaxed">
        You don't have to watch your child struggle while waiting for NHS CAMHS, Australian NDIS public clinics, or US developmental pediatricians. While formal diagnostic queues crawl, you can implement evidence-based home routines, meldown de-escalation, and school accommodation plans <strong>this week</strong>.
      </p>

      <div class="flex flex-wrap items-center gap-3 pt-1 text-xs text-gray-600 font-medium">
        <span class="inline-flex items-center gap-1 text-emerald-700 font-semibold">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
          Direct 1:1 Video Consultations
        </span>
        <span class="text-gray-300">&bull;</span>
        <span class="inline-flex items-center gap-1 text-emerald-700 font-semibold">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
          No GP Referral Needed
        </span>
        <span class="text-gray-300">&bull;</span>
        <span class="inline-flex items-center gap-1 text-emerald-700 font-semibold">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
          UK, US &amp; Aus Timezones
        </span>
      </div>
    </div>

    <div class="shrink-0 flex flex-col sm:flex-row md:flex-col gap-2.5 w-full md:w-auto">
      <a href="/book/" class="apple-btn apple-btn-primary !py-3 !px-6 text-center text-sm font-bold shadow-md whitespace-nowrap">
        Skip The Queue &bull; Book Session
      </a>
      <a href="/screener/" class="text-center text-xs font-semibold text-brand-navy hover:text-blue-700 underline py-1">
        Take 60-Second Readiness Screener &rarr;
      </a>
    </div>
  </div>
</div>
