---
import { Image } from 'astro:assets';
import authorPhoto from '../../assets/rabbia-ashraf-professional-profile.webp';

interface Props {
  datePublished?: string;
  dateModified?: string;
  readTime?: string;
}

const { datePublished, dateModified, readTime } = Astro.props;
---
<div class="bg-[#FAF7F2] rounded-2xl shadow-xs border border-[#E6DFD3] overflow-hidden my-12" itemscope itemtype="https://schema.org/Person">
  <div class="p-6 md:p-8 flex flex-col md:flex-row items-center md:items-start gap-6">
    <div class="w-28 h-28 md:w-32 md:h-32 rounded-full overflow-hidden bg-white flex-shrink-0 border-4 border-white shadow-md relative">
      <Image
        src={authorPhoto}
        alt="Rabbia Ashraf, Clinical Psychologist & Certified ADOS-2 Administrator"
        class="w-full h-full object-cover object-top"
        width={160}
        height={160}
        loading="lazy"
        itemprop="image"
      />
    </div>

    <div class="flex-grow text-center md:text-left">
      <h3 class="font-serif font-bold text-[#0A233F] m-0 text-2xl mb-1" itemprop="name">Rabbia Ashraf</h3>
      <p class="text-[#2F6352] font-semibold text-sm mb-3" itemprop="jobTitle">Clinical Psychologist &amp; Certified ADOS-2 Practitioner</p>

      <p class="text-sm text-[#18222C]/80 mb-4 leading-relaxed max-w-2xl mx-auto md:mx-0" itemprop="description">
        Rabbia Ashraf holds an MS in Clinical Psychology and specialized certification in the ADOS-2 (Autism Diagnostic Observation Schedule). She specializes in neurodevelopmental parent guidance, ADHD executive dysfunction, low-arousal strategies, and decoding complex assessment reports for families worldwide.
      </p>

      <div class="flex flex-wrap items-center justify-center md:justify-start gap-2 mb-6">
        <span class="inline-flex items-center px-3 py-1 rounded-full bg-white text-[#0A233F] text-xs font-semibold border border-[#E6DFD3]">
          <svg class="w-3.5 h-3.5 mr-1.5 text-[#2F6352]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          MS Clinical Psychology (CCP)
        </span>
        <span class="inline-flex items-center px-3 py-1 rounded-full bg-white text-[#0A233F] text-xs font-semibold border border-[#E6DFD3]">
          <svg class="w-3.5 h-3.5 mr-1.5 text-[#2F6352]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          ADOS-2 Certified Administrator
        </span>
        <span class="inline-flex items-center px-3 py-1 rounded-full bg-white text-[#0A233F] text-xs font-semibold border border-[#E6DFD3]">
          Zero Waitlist Bridge Model
        </span>
      </div>

      <div class="flex flex-col sm:flex-row gap-3 justify-center md:justify-start">
        <a href="/book/" class="bg-[#0A233F] hover:bg-[#12365B] text-white !py-2.5 !px-5 !text-sm font-bold rounded-xl shadow-xs transition-colors inline-flex items-center justify-center gap-1.5">
          <span>Book Consultation</span>
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
        </a>
        <a href="/credentials/" class="bg-white hover:bg-[#FAF7F2] text-[#0A233F] !py-2.5 !px-5 !text-sm font-semibold rounded-xl border border-[#E6DFD3] transition-colors inline-flex items-center justify-center gap-1.5">
          <span>View Clinical Governance &amp; Degrees</span>
        </a>
      </div>
    </div>
  </div>

  <!-- Standard Clinical Educational Disclaimer (E-E-A-T & YMYL Compliance) -->
  <div class="px-6 md:px-8 py-3.5 bg-amber-50/70 border-t border-amber-200/50 text-[11px] text-[#18222C]/75 flex items-start gap-2 leading-relaxed">
    <svg class="w-4 h-4 text-amber-700 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
    </svg>
    <span><strong class="text-[#0A233F]">Clinical Educational Scope:</strong> Articles authored by Clinical Psychologist Rabbia Ashraf are formulated for psychoeducational and parent guidance purposes. They do not constitute emergency psychiatric care or replace physical in-person developmental evaluations where legally mandated.</span>
  </div>

  {(datePublished || dateModified || readTime) && (
    <div class="bg-white border-t border-[#E6DFD3] px-6 py-2.5 flex flex-wrap gap-4 text-xs text-[#18222C]/60 items-center justify-center md:justify-start">
      {datePublished && <span>Published: {datePublished}</span>}
      {dateModified && <span>Clinically Reviewed: {dateModified}</span>}
      {readTime && <span>Estimated: {readTime}</span>}
    </div>
  )}
</div>