---
interface Props {
  headings?: { text: string; slug: string; level: number }[];
}

const { headings = [] } = Astro.props;
---

<div id="smart-toc-container" class="apple-glass-card apple-specular-top p-5 lg:p-6 mb-8 max-w-full">
  <details class="group" open>
    <summary class="flex justify-between items-center font-bold text-brand-navy cursor-pointer list-none text-base md:text-lg select-none">
      <div class="flex items-center gap-2.5">
        <span class="w-2 h-2 rounded-full bg-brand-gold"></span>
        <span>Table of Contents</span>
        <span class="text-xs font-normal text-gray-500 hidden sm:inline">(Quick Jump)</span>
      </div>
      <span class="transition-transform duration-300 group-open:rotate-180 text-gray-400">
        <svg fill="none" height="20" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24" width="20"><path d="M6 9l6 6 6-6"></path></svg>
      </span>
    </summary>

    <div class="mt-4 border-t border-gray-100/80 pt-4">
      <ul id="smart-toc-list" class="space-y-2 text-xs md:text-sm list-none p-0 m-0">
        {headings.length > 0 ? (
          headings.map(heading => {
            const isH2 = heading.level === 2 || (heading as any).depth === 2;
            return (
              <li class={`transition-colors duration-200 m-0 p-0 ${isH2 ? 'font-medium text-brand-navy' : 'pl-4 text-gray-500'}`}>
                <a href={`#${heading.slug}`} class="toc-link hover:text-brand-trust py-1 flex items-center gap-1.5" data-target={heading.slug}>
                  <span class="w-1 h-1 rounded-full bg-gray-300"></span>
                  <span>{heading.text}</span>
                </a>
              </li>
            );
          })
        ) : (
          <li class="toc-placeholder text-gray-400 italic text-xs py-1">Scanning article sections...</li>
        )}
      </ul>
    </div>
  </details>
</div>

<script>
  function initSmartTOC() {
    const tocList = document.getElementById('smart-toc-list');
    const container = document.getElementById('smart-toc-container');
    if (!tocList || !container) return;

    const article = document.querySelector('article') || document.querySelector('main');
    if (!article) return;

    // If static headings weren't provided, auto-discover all H2 and H3 elements in the article
    const placeholder = tocList.querySelector('.toc-placeholder');
    if (placeholder) {
      const headingElements = article.querySelectorAll('h2, h3');
      if (headingElements.length === 0) {
        container.style.display = 'none';
        return;
      }

      tocList.innerHTML = '';
      headingElements.forEach((h, index) => {
        // Skip headings that are inside sidebars or CTAs
        if (h.closest('.no-toc') || h.closest('footer')) return;

        let id = h.getAttribute('id');
        if (!id) {
          id = h.textContent
            ?.toLowerCase()
            .trim()
            .replace(/[^\w\s-]/g, '')
            .replace(/\s+/g, '-') || `section-${index}`;
          h.setAttribute('id', id);
        }

        const isH2 = h.tagName.toLowerCase() === 'h2';
        const li = document.createElement('li');
        li.className = `transition-colors duration-200 m-0 p-0 ${isH2 ? 'font-medium text-brand-navy' : 'pl-4 text-gray-500'}`;

        const a = document.createElement('a');
        a.href = `#${id}`;
        a.className = 'toc-link hover:text-brand-trust py-1 flex items-center gap-1.5';
        a.setAttribute('data-target', id);
        a.innerHTML = `<span class="w-1 h-1 rounded-full ${isH2 ? 'bg-brand-gold' : 'bg-gray-300'}"></span><span>${h.textContent}</span>`;

        li.appendChild(a);
        tocList.appendChild(li);
      });
    }

    // Smooth scroll offset handling (taking fixed Apple header into account)
    tocList.querySelectorAll<HTMLAnchorElement>('.toc-link').forEach(anchor => {
      anchor.addEventListener('click', (e) => {
        e.preventDefault();
        const targetId = anchor.getAttribute('href')?.substring(1);
        if (targetId) {
          const el = document.getElementById(targetId);
          if (el) {
            const yOffset = -100;
            const y = el.getBoundingClientRect().top + window.pageYOffset + yOffset;
            window.scrollTo({ top: y, behavior: 'smooth' });
          }
        }
      });
    });

    // Active reading scroll observer
    const links = tocList.querySelectorAll<HTMLAnchorElement>('.toc-link');
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        const id = entry.target.getAttribute('id');
        if (entry.isIntersecting && id) {
          links.forEach(l => {
            l.classList.remove('text-brand-trust', 'font-bold');
          });
          const active = tocList.querySelector(`.toc-link[data-target="${id}"]`);
          if (active) {
            active.classList.add('text-brand-trust', 'font-bold');
          }
        }
      });
    }, { rootMargin: '0px 0px -70% 0px' });

    article.querySelectorAll('h2, h3').forEach(heading => {
      if (heading.id) observer.observe(heading);
    });
  }

  // Initialize on page load and client page-loads
  initSmartTOC();
  document.addEventListener('astro:page-load', initSmartTOC);
</script>
