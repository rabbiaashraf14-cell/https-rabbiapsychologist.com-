---
interface Props {
  headings?: { text: string; slug: string; level: number }[];
  className?: string;
}

const { headings = [], className = '' } = Astro.props;
---

<div id="smart-toc-container" class={`apple-glass-card p-4 sm:p-5 mb-8 max-w-full text-left select-none ${className}`}>
  <!-- Header with live progress pill -->
  <div class="flex items-center justify-between pb-2.5 border-b border-brand-border/60">
    <div class="flex items-center gap-2">
      <span class="flex h-2 w-2 relative">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-brand-sage opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2 w-2 bg-brand-sage"></span>
      </span>
      <span class="text-xs font-bold uppercase tracking-wider text-brand-navy">Table of Contents</span>
    </div>
    <span id="toc-reading-progress" class="text-[11px] font-semibold text-brand-sage bg-brand-sage-light px-2 py-0.5 rounded-full transition-all duration-200">
      0% Read
    </span>
  </div>

  <!-- Micro reading progress track -->
  <div class="w-full bg-brand-border/40 h-1 rounded-full overflow-hidden mt-2 mb-3">
    <div id="toc-progress-bar" class="h-full bg-brand-sage transition-all duration-150 rounded-full w-0"></div>
  </div>

  <!-- TOC Navigation List -->
  <nav class="relative my-1 max-h-[calc(100vh-16rem)] overflow-y-auto pr-1 text-left no-scrollbar" aria-label="Table of contents">
    <!-- Sliding active indicator line -->
    <div id="toc-active-indicator" class="absolute left-0 w-0.5 bg-brand-sage rounded-full transition-all duration-300 ease-out opacity-0 pointer-events-none"></div>

    <ul id="smart-toc-list" class="space-y-1 text-xs border-l border-brand-border/60 pl-3 m-0 list-none">
      {headings.length > 0 ? (
        headings.map((heading, index) => {
          const isH2 = heading.level === 2 || (heading as any).depth === 2;
          return (
            <li class={`m-0 p-0 transition-colors duration-150 ${isH2 ? 'mt-1.5' : 'pl-3'}`}>
              <a
                href={`#${heading.slug}`}
                class="toc-link group flex items-start gap-2 py-1.5 px-2 rounded-lg text-gray-600 hover:text-brand-navy hover:bg-brand-sage-light/50 transition-all duration-200"
                data-target={heading.slug}
              >
                <span class={`w-1.5 h-1.5 rounded-full mt-1.5 shrink-0 transition-colors duration-200 ${isH2 ? 'bg-brand-sage/60 group-hover:bg-brand-sage' : 'bg-gray-300'}`}></span>
                <span class={`leading-snug ${isH2 ? 'font-semibold text-brand-navy text-[13px]' : 'text-gray-500 text-[12px]'}`}>
                  {heading.text}
                </span>
              </a>
            </li>
          );
        })
      ) : (
        <li class="toc-placeholder text-gray-400 italic text-xs py-2">Discovering article topics...</li>
      )}
    </ul>
  </nav>

  <!-- Footer Actions: Back to Top & Clinical Assistance -->
  <div class="pt-3 mt-3 border-t border-brand-border/60 flex items-center justify-between text-[11px] text-gray-500">
    <button
      id="toc-back-to-top"
      type="button"
      class="hover:text-brand-navy flex items-center gap-1.5 font-medium transition-colors cursor-pointer group"
      title="Scroll back to top of article"
    >
      <svg class="w-3.5 h-3.5 text-gray-400 group-hover:text-brand-navy transition-colors transform group-hover:-translate-y-0.5 duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 10l7-7m0 0l7 7m-7-7v18" />
      </svg>
      <span>Top</span>
    </button>

    <a
      href="/book/"
      class="text-brand-sage font-semibold hover:text-brand-green flex items-center gap-1 transition-colors"
      title="Book a parent consultation"
    >
      <span>Ask Rabbia</span>
      <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
      </svg>
    </a>
  </div>
</div>

<script>
  function initSmartTOC() {
    const tocList = document.getElementById('smart-toc-list');
    const container = document.getElementById('smart-toc-container');
    const progressBar = document.getElementById('toc-progress-bar');
    const progressText = document.getElementById('toc-reading-progress');
    const backToTopBtn = document.getElementById('toc-back-to-top');
    const activeIndicator = document.getElementById('toc-active-indicator');

    if (!tocList || !container) return;

    const article = document.querySelector('article') || document.querySelector('main');
    if (!article) return;

    // Auto-discover headings if pre-rendered headings were empty
    const placeholder = tocList.querySelector('.toc-placeholder');
    if (placeholder) {
      const headingElements = article.querySelectorAll('h2, h3');
      if (headingElements.length === 0) {
        container.style.display = 'none';
        return;
      }

      tocList.innerHTML = '';
      headingElements.forEach((h, index) => {
        // Skip headings that are inside sidebars, CTAs, authors, or disclaimers
        if (h.closest('.no-toc') || h.closest('footer') || h.closest('#smart-toc-container') || h.closest('.border-t')) return;

        let id = h.getAttribute('id');
        if (!id) {
          id = h.textContent
            ?.toLowerCase()
            .trim()
            .replace(/[^\w\s-]/g, '')
            .replace(/\s+/g, '-') || `section-${index}`;
          h.setAttribute('id', id);
        }

        const isH2 = h.tagName.toLowerCase() === 'h2';
        const li = document.createElement('li');
        li.className = `m-0 p-0 transition-colors duration-150 ${isH2 ? 'mt-1.5' : 'pl-3'}`;

        const a = document.createElement('a');
        a.href = `#${id}`;
        a.className = 'toc-link group flex items-start gap-2 py-1.5 px-2 rounded-lg text-gray-600 hover:text-brand-navy hover:bg-brand-sage-light/50 transition-all duration-200';
        a.setAttribute('data-target', id);
        a.innerHTML = `
          <span class="w-1.5 h-1.5 rounded-full mt-1.5 shrink-0 transition-colors duration-200 ${isH2 ? 'bg-brand-sage/60 group-hover:bg-brand-sage' : 'bg-gray-300'}"></span>
          <span class="leading-snug ${isH2 ? 'font-semibold text-brand-navy text-[13px]' : 'text-gray-500 text-[12px]'}">${h.textContent}</span>
        `;

        li.appendChild(a);
        tocList.appendChild(li);
      });
    }

    // Set scroll-margin-top on all article headings to prevent navbar overlap
    article.querySelectorAll('h2, h3').forEach((h) => {
      (h as HTMLElement).style.scrollMarginTop = '100px';
    });

    // Smooth scroll navigation with target pulse feedback
    tocList.querySelectorAll<HTMLAnchorElement>('.toc-link').forEach(anchor => {
      anchor.addEventListener('click', (e) => {
        e.preventDefault();
        const targetId = anchor.getAttribute('href')?.substring(1);
        if (targetId) {
          const targetEl = document.getElementById(targetId);
          if (targetEl) {
            targetEl.scrollIntoView({ behavior: 'smooth' });
            
            // Brief visual highlight pulse on target heading
            targetEl.classList.add('transition-all', 'duration-500', 'bg-brand-sage-light/40', 'rounded-lg', 'px-2');
            setTimeout(() => {
              targetEl.classList.remove('bg-brand-sage-light/40', 'px-2');
            }, 1200);

            // Update URL hash without jump
            history.pushState(null, '', `#${targetId}`);
          }
        }
      });
    });

    // Back to top button
    if (backToTopBtn) {
      backToTopBtn.addEventListener('click', () => {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    }

    // Live Reading Progress Bar Calculation
    function updateProgress() {
      if (!article || !progressBar || !progressText) return;
      const rect = article.getBoundingClientRect();
      const articleHeight = rect.height;
      const windowHeight = window.innerHeight;
      
      const start = rect.top;
      const totalDist = articleHeight - windowHeight;
      let progress = 0;

      if (totalDist > 0) {
        progress = Math.min(Math.max(Math.round((-start / totalDist) * 100), 0), 100);
      } else if (start <= 0) {
        progress = 100;
      }

      progressBar.style.width = `${progress}%`;
      progressText.textContent = `${progress}% Read`;
    }

    window.addEventListener('scroll', updateProgress, { passive: true });
    updateProgress();

    // Active Section Intersection Observer
    const links = tocList.querySelectorAll<HTMLAnchorElement>('.toc-link');
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        const id = entry.target.getAttribute('id');
        if (entry.isIntersecting && id) {
          links.forEach(l => {
            l.classList.remove('bg-brand-sage-light', 'text-brand-navy', 'font-bold', 'shadow-xs');
            l.classList.add('text-gray-600');
            const dot = l.querySelector('span:first-child');
            if (dot) {
              dot.classList.remove('bg-brand-sage', 'scale-125');
              dot.classList.add('bg-gray-300');
            }
          });

          const activeLink = tocList.querySelector(`.toc-link[data-target="${id}"]`);
          if (activeLink) {
            activeLink.classList.remove('text-gray-600');
            activeLink.classList.add('bg-brand-sage-light', 'text-brand-navy', 'font-bold', 'shadow-xs');
            const activeDot = activeLink.querySelector('span:first-child');
            if (activeDot) {
              activeDot.classList.remove('bg-gray-300');
              activeDot.classList.add('bg-brand-sage', 'scale-125');
            }

            // Reposition the left active indicator line
            if (activeIndicator) {
              const navRect = tocList.getBoundingClientRect();
              const linkRect = activeLink.getBoundingClientRect();
              activeIndicator.style.opacity = '1';
              activeIndicator.style.top = `${linkRect.top - navRect.top}px`;
              activeIndicator.style.height = `${linkRect.height}px`;
            }
          }
        }
      });
    }, { rootMargin: '-80px 0px -65% 0px' });

    article.querySelectorAll('h2, h3').forEach(heading => {
      if (heading.id) observer.observe(heading);
    });
  }

  // Initialize on initial load and client transitions
  initSmartTOC();
  document.addEventListener('astro:page-load', initSmartTOC);
</script>

<style>
  /* Custom thin scrollbar for long tables of contents */
  .no-scrollbar::-webkit-scrollbar {
    width: 3px;
  }
  .no-scrollbar::-webkit-scrollbar-track {
    background: transparent;
  }
  .no-scrollbar::-webkit-scrollbar-thumb {
    background: #E6DFD3;
    border-radius: 9999px;
  }
  .no-scrollbar::-webkit-scrollbar-thumb:hover {
    background: #3C6E5A;
  }
</style>
