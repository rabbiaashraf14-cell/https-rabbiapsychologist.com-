---
import type { CityLocation } from '../../../data/locations/locationTypes';
import { getCityInsights } from '../../../data/locations/cityInsights';

interface Props {
  city: CityLocation;
}

const { city } = Astro.props;
const insights = getCityInsights(city.countrySlug, city.publicationRegion, city.citySlug);
---

<section class="py-14 bg-gradient-to-b from-gray-50 to-white border-t border-b border-gray-100">
  <div class="max-w-4xl mx-auto px-6 lg:px-8">
    
    <!-- Section Header with Community Badge -->
    <div class="text-center max-w-2xl mx-auto mb-10">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-100/80 text-[#0A233F] text-xs font-bold tracking-wide uppercase mb-3">
        <svg class="w-4 h-4 text-orange-500" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0zm5.01 4.744c.688 0 1.25.561 1.25 1.249a1.25 1.25 0 0 1-2.498.056l-2.597-.547-.8 3.747c1.824.07 3.48.632 4.674 1.488.308-.309.73-.491 1.207-.491.968 0 1.754.786 1.754 1.754 0 .716-.435 1.333-1.01 1.614a3.111 3.111 0 0 1 .042.52c0 2.694-3.13 4.87-7.004 4.87-3.874 0-7.004-2.176-7.004-4.87 0-.183.015-.366.043-.534A1.748 1.748 0 0 1 4.028 12c0-.968.786-1.754 1.754-1.754.463 0 .898.196 1.207.49 1.207-.883 2.878-1.43 4.744-1.487l.885-4.182a.342.342 0 0 1 .14-.197.35.35 0 0 1 .238-.042l2.906.617a1.214 1.214 0 0 1 1.108-.702zM9.25 12C8.561 12 8 12.562 8 13.25c0 .687.561 1.248 1.25 1.248.687 0 1.248-.561 1.248-1.249 0-.688-.561-1.249-1.249-1.249zm5.5 0c-.687 0-1.248.561-1.248 1.25 0 .687.561 1.248 1.249 1.248.688 0 1.249-.561 1.249-1.249 0-.687-.562-1.249-1.25-1.249zm-4.966 3.99a.327.327 0 0 0-.231.096.327.327 0 0 0 0 .463c.693.694 1.626 1.057 2.447 1.057.828 0 1.754-.363 2.447-1.057a.327.327 0 0 0 0-.463.327.327 0 0 0-.463 0c-.573.572-1.35.856-1.984.856-.635 0-1.412-.284-1.984-.856a.327.327 0 0 0-.232-.096z"/>
        </svg>
        <span>Parent Community & Forum Realities</span>
      </div>
      <h2 class="text-2xl sm:text-3xl font-bold text-[#0A233F] tracking-tight">
        What Parents in {city.cityName} are Discussing
      </h2>
      <p class="text-sm sm:text-base text-gray-600 mt-2">
        Real insights from parenting forums, regional subreddits, and local support networks facing child development and neurodivergence challenges in {city.cityName}, {city.countryName}.
      </p>
    </div>

    <!-- Forum Insight Cards Grid -->
    <div class="space-y-4 mb-8">
      {insights.redditThemes.map((theme, index) => (
        <div class="bg-white rounded-2xl p-6 border border-gray-200/90 shadow-xs hover:border-blue-200 transition-all duration-200">
          <div class="flex items-start gap-4">
            <div class="w-8 h-8 rounded-xl bg-orange-50 border border-orange-200/60 flex items-center justify-center shrink-0 mt-0.5 text-orange-600 font-bold text-xs">
              #{index + 1}
            </div>
            <div class="space-y-2 flex-1">
              <h3 class="text-base font-bold text-[#0A233F] flex flex-wrap items-center gap-2">
                <span>{theme.topic}</span>
              </h3>
              
              <!-- Quote / Community Voice -->
              <blockquote class="text-xs sm:text-sm text-gray-700 bg-gray-50/80 rounded-xl p-3 border-l-3 border-orange-400 italic">
                "{theme.communityQuoteOrTheme}"
              </blockquote>

              <!-- Clinical Response / How Rabbia Helps -->
              <div class="text-xs sm:text-sm text-emerald-900 bg-emerald-50/70 rounded-xl p-3 border border-emerald-100 flex items-start gap-2">
                <svg class="w-4 h-4 text-emerald-600 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <div>
                  <strong class="font-semibold text-emerald-950">How Our Clinical Team Helps: </strong>
                  <span>{theme.clinicalSolution}</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Cultural & Community Meaning Box -->
    <div class="bg-[#FAF7F2] rounded-2xl p-6 sm:p-8 border border-[#E6DFD3] text-[#18222C]">
      <div class="flex items-start gap-3">
        <svg class="w-6 h-6 text-[#3C6E5A] shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <div>
          <h3 class="text-lg font-bold text-[#0A233F] mb-2">
            Cultural Meaning & Local Family Dynamics in {city.cityName}
          </h3>
          <p class="text-xs sm:text-sm text-gray-700 leading-relaxed mb-3">
            {city.culturalContext || insights.culturalContextExtended}
          </p>
          {city.multilingualFamilyContext && (
            <div class="mt-3 pt-3 border-t border-[#E6DFD3]/80 text-xs sm:text-sm text-gray-700">
              <strong class="text-[#0A233F]">Bilingual & Multilingual Realities:</strong> {city.multilingualFamilyContext}
            </div>
          )}
        </div>
      </div>
    </div>

  </div>
</section>
