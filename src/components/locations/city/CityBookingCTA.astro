---
import type { CityLocation } from '../../../data/locations/locationTypes';
import { regionalPricing } from '../../../data/pricing';

interface Props {
  city: CityLocation;
}

const { city } = Astro.props;
const isPakistan = city.countrySlug === 'pakistan';
const priceDisplay = isPakistan 
  ? `PKR ${regionalPricing.parentGuidance.pakistan.price.toLocaleString()}` 
  : `$${regionalPricing.parentGuidance.international.price} USD / ~£65 GBP`;
---

<section class="bg-gradient-to-b from-[#0A233F] via-[#102D4E] to-[#0A233F] py-16 sm:py-20 text-center text-white px-6 relative overflow-hidden">
  <!-- Specular Ambient Highlight -->
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-3/4 h-24 bg-[#3C6E5A]/20 blur-3xl pointer-events-none"></div>

  <div class="max-w-3xl mx-auto relative z-10">
    <div class="inline-flex items-center gap-2 bg-emerald-500/15 border border-emerald-400/30 px-3.5 py-1.5 rounded-full text-xs font-semibold text-emerald-300 mb-6">
      <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
      <span>Available This Week in {city.cityName} • No GP Referral Required</span>
    </div>

    <h2 class="text-3xl sm:text-4xl font-serif font-bold mb-4 text-white leading-tight">
      {city.bookingCallToAction || `Ready to Support Your Child's Development in ${city.cityName}?`}
    </h2>
    
    <p class="text-white/80 mb-6 text-base sm:text-lg max-w-2xl mx-auto leading-relaxed">
      You don't need to wait 18 months on public health waitlists to get clarity. Book a 50-minute private strategy session with Clinical Psychologist Rabbia Ashraf and receive a personalized 3-step action roadmap within 24 hours.
    </p>

    <!-- Pricing Badge -->
    <div class="inline-flex items-center gap-2 bg-white/10 px-4 py-1.5 rounded-xl border border-white/15 text-xs sm:text-sm font-semibold text-white/90 mb-8">
      <span>Private Session Fee:</span>
      <span class="text-emerald-300 font-bold">{priceDisplay}</span>
      <span class="text-white/60 text-xs hidden sm:inline">• 50-Min 1-on-1 Call</span>
    </div>

    <!-- Dual Action Buttons -->
    <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
      <a 
        href="/book/" 
        class="w-full sm:w-auto bg-emerald-600 hover:bg-emerald-500 text-white font-bold py-3.5 px-8 rounded-xl shadow-lg transition-all duration-200 text-sm sm:text-base inline-flex items-center justify-center gap-2"
      >
        <span>Self-Schedule Consultation</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
      </a>

      <a 
        href={`https://wa.me/923364114002?text=Hi%20Rabbia,%20I%20am%20based%20in%20${encodeURIComponent(city.cityName)}%20and%20would%20like%20to%20enquire%20about%20booking%20a%20consultation.`}
        target="_blank"
        rel="noopener noreferrer"
        class="w-full sm:w-auto bg-white/10 hover:bg-white/20 text-white font-semibold py-3.5 px-6 rounded-xl border border-white/20 transition-all duration-200 text-sm sm:text-base inline-flex items-center justify-center gap-2"
      >
        <svg class="w-4 h-4 text-[#25D366]" fill="currentColor" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg>
        <span>Message via WhatsApp</span>
      </a>
    </div>

    <p class="mt-4 text-xs text-white/50">
      50-Minute Video Session • Off-Screen Child Protocol • Encrypted Telehealth
    </p>
  </div>
</section>