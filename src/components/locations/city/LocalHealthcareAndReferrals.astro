---
import type { CityLocation } from '../../../data/locations/locationTypes';
import { getCityInsights } from '../../../data/locations/cityInsights';

interface Props {
  city: CityLocation;
}

const { city } = Astro.props;
const insights = getCityInsights(city.countrySlug, city.publicationRegion, city.citySlug);
---

<section class="py-14 bg-white">
  <div class="max-w-4xl mx-auto px-6 lg:px-8">
    
    <!-- Header -->
    <div class="text-center max-w-2xl mx-auto mb-10">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-50 text-emerald-800 text-xs font-bold tracking-wide uppercase mb-3 border border-emerald-200/80">
        <svg class="w-4 h-4 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
        </svg>
        <span>Healthcare Infrastructure & Referrals</span>
      </div>
      <h2 class="text-2xl sm:text-3xl font-bold text-[#0A233F] tracking-tight">
        Local Healthcare Centers & Next Steps in {city.cityName}
      </h2>
      <p class="text-sm sm:text-base text-gray-600 mt-2">
        Navigating pediatric assessments, hospital clinics, and next developmental steps for children in {city.cityName}, {city.countryName}.
      </p>
    </div>

    <!-- Prominent Regional Hospitals Grid -->
    <div class="mb-12">
      <h3 class="text-lg font-bold text-[#0A233F] mb-4 flex items-center gap-2">
        <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
        <span>Key Pediatric & Neurodevelopmental Hospitals Serving {city.cityName}</span>
      </h3>

      <div class="grid sm:grid-cols-2 gap-4">
        {insights.hospitals.map(h => (
          <div class="bg-gray-50/70 border border-gray-200/90 rounded-2xl p-5 hover:bg-white hover:shadow-xs transition-all duration-200">
            <div class="flex items-start justify-between gap-2 mb-1.5">
              <h4 class="font-bold text-sm sm:text-base text-[#0A233F]">{h.name}</h4>
              <span class="text-[11px] font-semibold px-2 py-0.5 rounded-full bg-blue-100/70 text-blue-800 shrink-0">
                {h.type}
              </span>
            </div>
            <p class="text-xs sm:text-sm text-gray-600 leading-relaxed">{h.notes}</p>
          </div>
        ))}
      </div>
      <p class="text-[11px] text-gray-500 mt-3 italic">
        *Note: Mention of hospital facilities is provided for parent geographical awareness and health literacy. Rabbia Psychologist provides independent private telehealth parent guidance and is not affiliated with these third-party statutory institutions.
      </p>
    </div>

    <!-- Where to Get Help Next Roadmap (Flowchart) -->
    <div class="bg-gradient-to-br from-blue-50/50 via-white to-emerald-50/40 rounded-2xl p-6 sm:p-8 border border-blue-100 shadow-xs">
      <div class="max-w-2xl mb-6">
        <span class="text-xs font-bold text-blue-700 uppercase tracking-wider">Clinical Roadmap</span>
        <h3 class="text-xl sm:text-2xl font-bold text-[#0A233F] mt-1">
          Where to Get Help Next: 4-Stage Pathway for Families
        </h3>
        <p class="text-xs sm:text-sm text-gray-600 mt-1">
          A clear, step-by-step roadmap to avoid feeling lost while securing support for your child.
        </p>
      </div>

      <div class="grid sm:grid-cols-2 gap-4">
        {insights.nextSteps.map(step => (
          <div class="bg-white rounded-xl p-5 border border-gray-200/80 shadow-2xs relative overflow-hidden">
            <div class="flex items-center gap-2 mb-2">
              <span class="w-6 h-6 rounded-full bg-[#0A233F] text-white flex items-center justify-center font-bold text-xs shrink-0">
                {step.step}
              </span>
              <h4 class="font-bold text-sm text-[#0A233F]">{step.title}</h4>
            </div>
            <p class="text-xs text-gray-600 leading-relaxed">
              {step.description}
            </p>
          </div>
        ))}
      </div>

      <!-- Interim Bridge Box -->
      <div class="mt-6 bg-white border-l-4 border-emerald-500 rounded-r-xl p-4 text-xs sm:text-sm text-gray-700">
        <strong class="text-emerald-950 font-semibold">How Our Team Bridges the Gap:</strong> While you navigate public waitlists or arrange local clinic appointments in {city.cityName}, our team led by Ms. Rabbia Ashraf provides direct, parent-implemented strategies to de-escalate meltdowns, build home visual routines, and support school collaboration today.
      </div>
    </div>

  </div>
</section>
