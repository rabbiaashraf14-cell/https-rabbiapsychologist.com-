---
import '../styles/global.css';
import SEO from '../components/seo/SEO.astro';
import Header from '../components/global/Header.astro';
import Footer from '../components/global/Footer.astro';
import StickyMobileBookingCTA from '../components/global/StickyMobileBookingCTA.astro';
import SanctuaryRibbon from '../components/global/SanctuaryRibbon.astro';
import FloatingWhatsApp from '../components/global/FloatingWhatsApp.astro';
import RegionDetector from '../components/global/RegionDetector.astro';

interface Props {
  title: string;
  description?: string;
  canonicalURL?: string;
  type?: string;
  image?: string;
  noindex?: boolean;
  schema?: any;
  keywords?: string;
}

const { title, description, canonicalURL, type, image, noindex, schema, keywords } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SEO
      title={title}
      description={description || "Rabbia Psychologist Child Development Services offers global parent guidance, child development support, and specialist consultation."}
      canonical={canonicalURL}
      type={type}
      image={image}
      noindex={noindex}
      schema={schema}
      keywords={keywords}
    />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest/" />
    <meta name="theme-color" content="#0F2742" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="LLM Context" />
    <link rel="alternate" type="text/plain" href="/llms-full.txt" title="Full LLM Context" />
    <RegionDetector />
    <slot name="head" />

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-BVBXVT9DMN" is:inline></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-BVBXVT9DMN');
    </script>
  </head>
  <body class="bg-brand-cream text-brand-navy font-sans antialiased flex flex-col min-h-screen">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:px-4 focus:py-2 focus:bg-brand-navy focus:text-white focus:rounded-md">
      Skip to main content
    </a>
    <SanctuaryRibbon />
    <Header />
    <main id="main-content" class="flex-grow pb-24 md:pb-0">
      <slot />
    </main>
    <Footer />
    <StickyMobileBookingCTA />
    <FloatingWhatsApp />

    <!--Start of Tawk.to Script-->
    <script type="text/javascript">
    var Tawk_API=Tawk_API||{}, Tawk_LoadStart=new Date();
    (function(){
    var s1=document.createElement("script"),s0=document.getElementsByTagName("script")[0];
    s1.async=true;
    s1.src='https://embed.tawk.to/6a3e8d8f84036f1d4819a7c2/default';
    s1.charset='UTF-8';
    s1.setAttribute('crossorigin','*');
    s0.parentNode.insertBefore(s1,s0);
    })();
    </script>
    <!--End of Tawk.to Script-->

    <!-- Analytics Tracking Script -->
    <script is:inline>
      document.addEventListener('DOMContentLoaded', () => {
        // Track Sanctuary Ribbon Impressions and Clicks
        const sanctuaryRibbon = document.getElementById('sanctuary-top-ribbon');
        if (sanctuaryRibbon) {
          if (typeof gtag === 'function') {
            gtag('event', 'promotion_impression', {
              promotion_id: 'sanctuary_top_ribbon',
              promotion_name: 'Sanctuary Live Intake Ribbon'
            });
          }
        }

        // Track Booking Button Clicks
        const bookingButtons = document.querySelectorAll('a[href^="/book"], a[href^="https://calendar.app.google"]');
        bookingButtons.forEach(btn => {
          btn.addEventListener('click', () => {
            if (typeof gtag === 'function') {
              gtag('event', 'begin_checkout', {
                event_category: 'booking',
                event_label: btn.getAttribute('href') || 'booking_button'
              });
            }
          });
        });

        // Track WhatsApp Clicks
        const whatsappButtons = document.querySelectorAll('a[href^="https://wa.me"]');
        whatsappButtons.forEach(btn => {
          btn.addEventListener('click', () => {
            if (typeof gtag === 'function') {
              gtag('event', 'generate_lead', {
                event_category: 'contact',
                event_label: 'whatsapp_click'
              });
            }
          });
        });
      });
    </script>

    <!-- Global Blog Enhancer: Automatic Apple-style TOC & Visible Dates for AEO/GEO/E-E-A-T -->
    <script is:inline>
      function enhanceBlogPage() {
        if (!window.location.pathname.startsWith('/blog/') || window.location.pathname === '/blog/' || window.location.pathname === '/blog') return;
        const article = document.querySelector('article');
        if (!article) return;

        // 1. Ensure visible Published & Updated dates in header if missing
        const header = document.querySelector('header.mb-8') || article.parentElement?.querySelector('header');
        if (header && !header.querySelector('.blog-date-badge')) {
          let pubDate = '';
          let modDate = '';
          document.querySelectorAll('script[type="application/ld+json"]').forEach(s => {
            try {
              const data = JSON.parse(s.textContent || '{}');
              if (data['@type'] === 'Article') {
                pubDate = data.datePublished || '';
                modDate = data.dateModified || '';
              }
            } catch (e) {}
          });

          if (pubDate || modDate) {
            const dateBar = document.createElement('div');
            dateBar.className = 'blog-date-badge flex flex-wrap items-center gap-2 text-xs text-gray-500 mt-2 mb-4';
            if (pubDate) {
              dateBar.innerHTML += `<span class="apple-pill !py-1 !px-2.5 bg-gray-50 text-gray-600">Published: ${pubDate}</span>`;
            }
            if (modDate && modDate !== pubDate) {
              dateBar.innerHTML += `<span class="apple-pill !py-1 !px-2.5 bg-emerald-50 text-emerald-800 border border-emerald-200/60">Updated: ${modDate}</span>`;
            } else if (pubDate) {
              dateBar.innerHTML += `<span class="apple-pill !py-1 !px-2.5 bg-emerald-50 text-emerald-800 border border-emerald-200/60">Clinically Reviewed</span>`;
            }
            const authorBox = header.querySelector('.border-b') || header;
            authorBox.appendChild(dateBar);
          }
        }

        // 2. Ensure AEO / AI Direct Summary exists for AI search engines & parents
        let articleDesc = document.querySelector('meta[name="description"]')?.getAttribute('content') || '';
        if (articleDesc && !document.getElementById('aeo-quick-facts')) {
          const aeoBox = document.createElement('div');
          aeoBox.id = 'aeo-quick-facts';
          aeoBox.className = 'ai-summary p-5 lg:p-6 rounded-2xl bg-[#FAF7F2] border border-[#2F6352]/30 mb-8 shadow-2xs';
          aeoBox.innerHTML = `
            <div class="flex items-center justify-between gap-2 mb-2 pb-2 border-b border-[#2F6352]/15">
              <span class="inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-[#2F6352]">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                Direct Clinical Summary (AEO)
              </span>
              <span class="text-[11px] font-medium text-[#18222C]/60">Verified by Rabbia Ashraf (ADOS-2 Certified)</span>
            </div>
            <p class="text-sm sm:text-[15px] text-[#18222C]/85 leading-relaxed m-0 font-medium">${articleDesc}</p>
            <div class="mt-3 pt-2.5 flex items-center justify-between text-xs">
              <span class="text-[#2F6352] font-semibold">Zero Waitlist Bridge Model</span>
              <a href="/book/" class="font-bold text-[#0A233F] hover:text-[#2F6352] inline-flex items-center gap-1 transition-colors">
                <span>Book 50-Min Guidance Call</span>
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
              </a>
            </div>
          `;
          article.parentNode.insertBefore(aeoBox, article);
        }

        // 3. Ensure Table of Contents exists (Modern Apple-Glass Full-Width Layout)
        if (!document.getElementById("smart-toc-container")) {
          const headings = article.querySelectorAll("h2, h3");
          if (headings.length >= 2) {
            const tocWrapper = document.createElement("div");
            tocWrapper.id = "smart-toc-container";
            tocWrapper.className = "apple-glass-card p-5 sm:p-6 mb-8 w-full max-w-full text-left select-none";
            tocWrapper.innerHTML = `
              <div class="flex items-center justify-between pb-3 border-b border-brand-border/60">
                <div class="flex items-center gap-2.5">
                  <span class="flex h-2.5 w-2.5 relative">
                    <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-brand-sage opacity-75"></span>
                    <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-brand-sage"></span>
                  </span>
                  <span class="text-xs font-bold uppercase tracking-wider text-brand-navy">Table of Contents</span>
                </div>
                <span id="toc-reading-progress" class="text-[11px] font-semibold text-brand-sage bg-brand-sage-light px-2.5 py-0.5 rounded-full transition-all duration-200">
                  0% Read
                </span>
              </div>

              <div class="w-full bg-brand-border/40 h-1.5 rounded-full overflow-hidden mt-2.5 mb-4">
                <div id="toc-progress-bar" class="h-full bg-brand-sage transition-all duration-150 rounded-full w-0"></div>
              </div>

              <nav class="relative my-2 w-full overflow-y-auto pr-1 text-left no-scrollbar" aria-label="Table of contents">
                <ul id="smart-toc-list" class="grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-1.5 text-xs border-l-2 border-brand-border/60 pl-3.5 m-0 list-none w-full"></ul>
              </nav>

              <div class="pt-3 mt-3 border-t border-brand-border/60 flex items-center justify-between text-[11px] text-gray-500 w-full">
                <button id="toc-back-to-top" type="button" class="hover:text-brand-navy flex items-center gap-1.5 font-medium transition-colors cursor-pointer group" title="Scroll back to top">
                  <svg class="w-3.5 h-3.5 text-gray-400 group-hover:text-brand-navy transition-colors transform group-hover:-translate-y-0.5 duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 10l7-7m0 0l7 7m-7-7v18" /></svg>
                  <span>Top</span>
                </button>
                <a href="/book/" class="text-brand-sage font-semibold hover:text-brand-green flex items-center gap-1 transition-colors" title="Book consultation">
                  <span>Ask Rabbia</span>
                  <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" /></svg>
                </a>
              </div>
            `;

            const list = tocWrapper.querySelector("#smart-toc-list");
            headings.forEach((h, index) => {
              if (h.closest(".no-toc") || h.closest("footer")) return;
              let id = h.getAttribute("id");
              if (!id) {
                id = h.textContent?.toLowerCase().trim().replace(/[^\w\s-]/g, "").replace(/\s+/g, "-") || ("section-" + index);
                h.setAttribute("id", id);
              }
              const isH2 = h.tagName.toLowerCase() === "h2";
              const cleanText = (h.textContent || "").replace(/-/g, " ").replace(/\s+/g, " ").trim();
              const li = document.createElement("li");
              li.className = "m-0 p-0 transition-colors duration-150 " + (isH2 ? "font-medium" : "pl-2 text-gray-500");
              li.innerHTML = '<a href="#' + id + '" class="toc-link group flex items-start gap-2 py-1.5 px-2 rounded-lg text-gray-600 hover:text-brand-navy hover:bg-brand-sage-light/50 transition-all duration-200 w-full" data-target="' + id + '"><span class="w-1.5 h-1.5 rounded-full mt-1.5 shrink-0 transition-colors duration-200 ' + (isH2 ? 'bg-brand-sage/60 group-hover:bg-brand-sage' : 'bg-gray-300') + '"></span><span class="leading-snug break-words ' + (isH2 ? 'font-semibold text-brand-navy text-[13px]' : 'text-gray-500 text-[12px]') + '">' + cleanText + '</span></a>';
              list.appendChild(li);
            });

            // Prepend before article
            article.parentNode.insertBefore(tocWrapper, article);

            // Back to top handler
            const btt = tocWrapper.querySelector("#toc-back-to-top");
            if (btt) {
              btt.addEventListener("click", () => window.scrollTo({ top: 0, behavior: "smooth" }));
            }

            // Smooth scroll handler
            tocWrapper.querySelectorAll(".toc-link").forEach(anchor => {
              anchor.addEventListener("click", (e) => {
                e.preventDefault();
                const targetId = anchor.getAttribute("href")?.substring(1);
                if (targetId) {
                  const el = document.getElementById(targetId);
                  if (el) {
                    const y = el.getBoundingClientRect().top + window.pageYOffset - 100;
                    window.scrollTo({ top: y, behavior: "smooth" });
                  }
                }
              });
            });

            // Live progress calculation
            const progressBar = tocWrapper.querySelector("#toc-progress-bar");
            const progressText = tocWrapper.querySelector("#toc-reading-progress");
            const updateProgress = () => {
              if (!progressBar || !progressText) return;
              const rect = article.getBoundingClientRect();
              const dist = rect.height - window.innerHeight;
              let prog = 0;
              if (dist > 0) prog = Math.min(Math.max(Math.round((-rect.top / dist) * 100), 0), 100);
              else if (rect.top <= 0) prog = 100;
              progressBar.style.width = prog + "%";
              progressText.textContent = prog + "% Read";
            };
            window.addEventListener("scroll", updateProgress, { passive: true });
            updateProgress();
          }
        }

        // 4. Ensure Visible FAQs exist if FAQPage schema is present in document
        const existingFaq = article.querySelector("#faq-section") || article.querySelector("details[name='faq-accordion']") || document.querySelector("#faq-section");
        if (!existingFaq) {
          const schemaScripts = document.querySelectorAll('script[type="application/ld+json"]');
          let faqData = null;
          schemaScripts.forEach(script => {
            try {
              const json = JSON.parse(script.textContent || "{}");
              if (json["@type"] === "FAQPage" && Array.isArray(json.mainEntity)) {
                faqData = json.mainEntity;
              }
            } catch (e) {}
          });

          if (faqData && faqData.length > 0) {
            const faqContainer = document.createElement("section");
            faqContainer.id = "faq-section";
            faqContainer.className = "my-12 not-prose";
            let itemsHtml = "";
            faqData.forEach(item => {
              const q = item.name || "";
              const a = (item.acceptedAnswer && item.acceptedAnswer.text) || "";
              if (q && a) {
                itemsHtml += '<details class="group bg-white rounded-xl border border-brand-border/80 shadow-2xs mb-3 overflow-hidden transition-all duration-200" name="faq-accordion"><summary class="flex justify-between items-center font-bold cursor-pointer list-none p-5 sm:p-6 text-brand-navy hover:bg-brand-cream/40 transition-colors select-none text-left"><span class="text-base sm:text-lg pr-4 font-serif text-brand-navy font-bold leading-snug">' + q + '</span><span class="transition-transform duration-300 group-open:rotate-180 shrink-0 text-brand-sage"><svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"></path></svg></span></summary><div class="px-5 pb-5 sm:px-6 sm:pb-6 pt-1 text-gray-700 leading-relaxed border-t border-brand-border/30 text-sm sm:text-base"><p class="m-0 leading-relaxed">' + a + '</p></div></details>';
              }
            });

            faqContainer.innerHTML = '<div class="flex items-center gap-2 mb-6"><span class="w-2.5 h-2.5 rounded-full bg-brand-sage"></span><h2 class="text-2xl sm:text-3xl font-bold font-serif text-brand-navy m-0">Frequently Asked Questions</h2></div><div class="space-y-3">' + itemsHtml + '</div>';

            const insertTarget = article.querySelector(".mt-12") || article.lastElementChild;
            if (insertTarget && insertTarget.parentNode === article) {
              article.insertBefore(faqContainer, insertTarget);
            } else {
              article.appendChild(faqContainer);
            }
          }
        }
      }

      document.addEventListener("DOMContentLoaded", enhanceBlogPage);
      document.addEventListener("astro:page-load", enhanceBlogPage);
    </script>
  </body>
</html>
