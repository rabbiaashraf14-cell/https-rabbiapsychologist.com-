---
import '../styles/global.css';
import SEO from '../components/seo/SEO.astro';
import Header from '../components/global/Header.astro';
import Footer from '../components/global/Footer.astro';
import StickyMobileBookingCTA from '../components/global/StickyMobileBookingCTA.astro';
import CountdownBanner from '../components/global/CountdownBanner.astro';
import FloatingWhatsApp from '../components/global/FloatingWhatsApp.astro';
import RegionDetector from '../components/global/RegionDetector.astro';

interface Props {
  title: string;
  description?: string;
  canonicalURL?: string;
  type?: string;
  image?: string;
  noindex?: boolean;
  schema?: any;
  keywords?: string;
}

const { title, description, canonicalURL, type, image, noindex, schema, keywords } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SEO
      title={title}
      description={description || "Rabbia Psychologist Child Development Services offers global parent guidance, child development support, and specialist consultation."}
      canonical={canonicalURL}
      type={type}
      image={image}
      noindex={noindex}
      schema={schema}
      keywords={keywords}
    />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#0F2742" />
    <meta name="generator" content={Astro.generator} />
    <RegionDetector />
    <slot name="head" />

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-BVBXVT9DMN" is:inline></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-BVBXVT9DMN');
    </script>
  </head>
  <body class="bg-brand-cream text-brand-navy font-sans antialiased flex flex-col min-h-screen">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:px-4 focus:py-2 focus:bg-brand-navy focus:text-white focus:rounded-md">
      Skip to main content
    </a>
    <Header />
    <main id="main-content" class="flex-grow pb-24 md:pb-0">
      <slot />
    </main>
    <Footer />
    <CountdownBanner />
    <StickyMobileBookingCTA />
    <FloatingWhatsApp />

    <!--Start of Tawk.to Script-->
    <script type="text/javascript">
    var Tawk_API=Tawk_API||{}, Tawk_LoadStart=new Date();
    (function(){
    var s1=document.createElement("script"),s0=document.getElementsByTagName("script")[0];
    s1.async=true;
    s1.src='https://embed.tawk.to/6a3e8d8f84036f1d4819a7c2/default';
    s1.charset='UTF-8';
    s1.setAttribute('crossorigin','*');
    s0.parentNode.insertBefore(s1,s0);
    })();
    </script>
    <!--End of Tawk.to Script-->

    <!-- Analytics Tracking Script -->
    <script is:inline>
      document.addEventListener('DOMContentLoaded', () => {
        // Track Sale Banner Impressions and Clicks
        const promoBanner = document.getElementById('promo-banner');
        if (promoBanner) {
          if (typeof gtag === 'function') {
            gtag('event', 'promotion_impression', {
              promotion_id: 'promo_banner',
              promotion_name: 'Parent Consultation Promo'
            });
          }

          promoBanner.addEventListener('click', (e) => {
            const target = e.target;
            if (!target.closest('#close-promo') && typeof gtag === 'function') {
              gtag('event', 'select_promotion', {
                promotion_id: 'promo_banner',
                promotion_name: 'Parent Consultation Promo'
              });
            }
          });
        }

        // Track Booking Button Clicks
        const bookingButtons = document.querySelectorAll('a[href^="/book"], a[href^="https://calendar.app.google"]');
        bookingButtons.forEach(btn => {
          btn.addEventListener('click', () => {
            if (typeof gtag === 'function') {
              gtag('event', 'begin_checkout', {
                event_category: 'booking',
                event_label: btn.getAttribute('href') || 'booking_button'
              });
            }
          });
        });

        // Track WhatsApp Clicks
        const whatsappButtons = document.querySelectorAll('a[href^="https://wa.me"]');
        whatsappButtons.forEach(btn => {
          btn.addEventListener('click', () => {
            if (typeof gtag === 'function') {
              gtag('event', 'generate_lead', {
                event_category: 'contact',
                event_label: 'whatsapp_click'
              });
            }
          });
        });
      });
    </script>
  </body>
</html>
